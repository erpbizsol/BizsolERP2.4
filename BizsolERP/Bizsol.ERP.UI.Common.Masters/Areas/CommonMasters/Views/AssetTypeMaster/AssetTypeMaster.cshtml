@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<style>
    .im-page-wrapper { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; padding: 0 18px 30px; background: #f1f3fb; min-height: 100%; }
    .im-card { background: #fff; border-radius: 16px; border: 1px solid #e5e7f0; box-shadow: 0 4px 24px rgba(99,102,241,0.09); overflow: hidden; }
    .im-card-header { background: linear-gradient(130deg, #5b5ef4 0%, #8b5cf6 55%, #a855f7 100%); padding: 14px 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; position: relative; overflow: hidden; }
    .im-header-left { display: flex; align-items: center; gap: 14px; position: relative; z-index: 1; }
    .im-header-icon { width: 46px; height: 46px; border-radius: 13px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 20px; }
    .im-header-title { color: #fff; font-size: 18px; font-weight: 700; }
    .im-btn-new { display: inline-flex; align-items: center; gap: 8px; padding: 9px 20px; border-radius: 999px; border: 2px solid rgba(255,255,255,0.48); background: rgba(255,255,255,0.14); color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; position: relative; z-index: 1; }
    .im-card-body { padding: 18px 20px 26px; }
    .im-table-wrapper { border-radius: 12px; border: 1px solid #e4e7f0; overflow: auto; height: 388px; background: #fff; box-shadow: 0 2px 12px rgba(91,94,244,0.06); }
    .im-table-wrapper thead th { position: sticky; top: 0; z-index: 10; background: linear-gradient(90deg, #6f5bf5 0%, #7c6ef7 100%) !important; color: #fff !important; font-size: 11.5px !important; font-weight: 700 !important; padding: 5px 14px !important; text-transform: none; }
    .im-table-wrapper td { padding: 5px 10px !important; font-size: 13px; border-bottom: 1px solid #f0f2f9; }
    #AssetTypeMasterGrid th:first-child,
    #AssetTypeMasterGrid td:first-child {
        width: 52px !important;
        max-width: 56px !important;
        min-width: 48px !important;
        text-align: center !important;
        white-space: nowrap;
        padding-left: 6px !important;
        padding-right: 6px !important;
    }
    tbody tr:nth-child(even) { background: #f8f9ff; }
    tbody tr:hover { background: linear-gradient(90deg, #eef0ff, #f3f4ff) !important; }
    .im-btn-view, .im-btn-edit, .im-btn-delete { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 6px; border: none; cursor: pointer; font-size: 11px; margin-right: 2px; }
    .im-btn-edit { background: #eef2ff; color: #5b5ef4; }
    .im-btn-delete { background: #fef2f2; color: #ef4444; }
    .im-btn-new:disabled,
    .im-btn-view:disabled, .im-btn-edit:disabled, .im-btn-delete:disabled {
        opacity: 0.42; cursor: not-allowed; pointer-events: none;
        transform: none !important; box-shadow: none !important;
    }
    .im-btn-view.im-btn-verify,
    .im-btn-view.im-btn-verified-mark { padding: 0; line-height: 1; vertical-align: middle; }
    .im-btn-view.im-btn-verify { background: #f1f5f9; color: #1f2937; }
    .im-btn-view.im-btn-verify:hover { background: #eef2ff; }
    .im-btn-view.im-btn-verify i { font-size: 17px; display: block; }
    .im-btn-view.im-btn-verified-mark { cursor: default; opacity: 1 !important; background: transparent; color: #16a34a; pointer-events: auto; }
    .im-btn-view.im-btn-verified-mark i { font-size: 18px; display: block; }
    .im-backdrop { position: fixed; inset: 0; background: rgba(8,12,36,0.54); backdrop-filter: blur(5px); display: none; align-items: center; justify-content: center; z-index: 1060; padding: 24px 16px; overflow-y: auto; }
    .im-backdrop.show { display: flex !important; }
    .im-modal { width: 560px; max-width: calc(100vw - 20px); background: #fff; border-radius: 18px; box-shadow: 0 20px 56px rgba(8,12,36,0.24); display: flex; flex-direction: column; overflow: hidden; animation: im-up 0.24s cubic-bezier(0.34,1.46,0.64,1); }
    @@keyframes im-up { from { transform: translateY(22px) scale(0.97); opacity: 0; } to { transform: translateY(0) scale(1); opacity: 1; } }
    .im-modal-header { background: linear-gradient(130deg, #5b5ef4, #a855f7); padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; position: relative; overflow: hidden; }
    .im-modal-header::before { content: ''; position: absolute; top: -18px; right: -18px; width: 80px; height: 80px; border-radius: 50%; background: rgba(255,255,255,0.08); pointer-events: none; }
    .im-modal-header-title { color: #fff; font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 9px; position: relative; z-index: 1; }
    .im-modal-close { width: 30px; height: 30px; border-radius: 50%; border: none; background: rgba(255,255,255,0.18); color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; position: relative; z-index: 1; }
    .im-modal-close:hover { background: rgba(255,255,255,0.32); }
    .im-modal-body { padding: 20px 22px 14px; overflow-y: auto; }
    .im-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
    .im-form-group { display: flex; flex-direction: column; gap: 5px; }
    .im-form-group label { font-size: 11px; font-weight: 700; color: #4b5563; letter-spacing: 0.04em; text-transform: uppercase; }
    .im-required { color: #ef4444; margin-left: 2px; }
    .im-input { width: 100%; padding: 9px 12px; border-radius: 9px; border: 1.5px solid #dde0ee; font-size: 13px; color: #111827; background: #f8f9fc; outline: none; transition: border-color 0.13s, box-shadow 0.13s, background 0.13s; }
    .im-input:focus { border-color: #5b5ef4; box-shadow: 0 0 0 3px rgba(91,94,244,0.12); background: #fff; }
    .im-input.im-input-error { border-color: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,0.10); }
    .im-input[readonly] { background: #f3f4f6; color: #6b7280; cursor: not-allowed; }
    .im-err-text { font-size: 11px; color: #ef4444; display: none; align-items: center; gap: 4px; }
    .im-radio-row { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; padding: 8px 0 2px; }
    .im-radio-row label.im-radio-opt { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #374151; text-transform: none; letter-spacing: 0; cursor: pointer; }
    .im-radio-row input[type="radio"] { width: 16px; height: 16px; accent-color: #5b5ef4; }
    .im-modal-footer { padding: 12px 22px 18px; display: flex; justify-content: flex-end; align-items: center; gap: 10px; border-top: 1px solid #f0f1f8; }
    .im-modal-footer-right { display: flex; align-items: center; gap: 10px; }
    .im-btn-cancel { padding: 8px 20px; border-radius: 999px; border: 1.5px solid #d4d7e8; background: #fff; color: #374151; font-size: 13px; font-weight: 500; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .im-btn-save { padding: 8px 20px; border-radius: 999px; border: none; background: linear-gradient(130deg, #5b5ef4, #a855f7); color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; box-shadow: 0 5px 16px rgba(91,94,244,0.34); display: inline-flex; align-items: center; gap: 7px; }
    .im-delete-modal {
        width: 370px; max-width: calc(100vw - 20px); background: #fff; border-radius: 18px;
        box-shadow: 0 20px 56px rgba(8,12,36,0.24); text-align: center; padding: 32px 24px 24px;
        animation: im-up 0.24s cubic-bezier(0.34,1.46,0.64,1);
    }
    .im-delete-icon-wrap {
        width: 62px; height: 62px; border-radius: 50%;
        background: linear-gradient(135deg, #fef2f2, #fee2e2);
        display: flex; align-items: center; justify-content: center;
        font-size: 26px; color: #ef4444; margin: 0 auto 14px;
        box-shadow: 0 5px 16px rgba(239,68,68,0.16);
    }
    .im-delete-title { font-size: 17px; font-weight: 700; color: #111827; margin-bottom: 7px; }
    .im-delete-text { font-size: 13px; color: #6b7280; line-height: 1.5; margin-bottom: 22px; }
    .im-delete-actions { display: flex; gap: 10px; justify-content: center; }
    .im-delete-reason { margin: 0 0 18px; text-align: left; }
    .im-delete-reason-label {
        display: flex; align-items: center; gap: 6px;
        font-size: 11px; font-weight: 700; color: #4b5563;
        letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 6px;
    }
    .im-delete-reason-input {
        width: 100%; padding: 9px 12px; border-radius: 9px; border: 1.5px solid #dde0ee;
        font-size: 13px; color: #111827; background: #f8f9fc; outline: none;
        transition: border-color 0.13s, box-shadow 0.13s;
    }
    .im-delete-reason-input:focus {
        border-color: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,0.10); background: #fff;
    }
    .im-delete-reason-input::placeholder { color: #9ca3af; }
    .im-btn-confirm-delete {
        padding: 9px 22px; border-radius: 999px; border: none;
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff; font-size: 13px; font-weight: 600; cursor: pointer;
        box-shadow: 0 5px 16px rgba(239,68,68,0.32); transition: all 0.14s;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .im-btn-confirm-delete:hover { box-shadow: 0 7px 22px rgba(239,68,68,0.48); transform: translateY(-1px); }

    #atEntryPanel .at-entry-wrap {
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        padding: 0 18px 30px; background: #f1f3fb; min-height: 100%;
        box-sizing: border-box; width: 100%; max-width: 100%; overflow-x: hidden;
    }
    #atEntryPanel .at-entry-wrap *, #atEntryPanel .at-entry-wrap *::before, #atEntryPanel .at-entry-wrap *::after { box-sizing: border-box; }
    #atEntryPanel .at-card { background: #fff; border-radius: 16px; border: 1px solid #e5e7f0; box-shadow: 0 4px 24px rgba(99,102,241,0.09); overflow: hidden; margin-bottom: 18px; max-width: 100%; }
    #atEntryPanel .at-card-header { background: linear-gradient(130deg, #5b5ef4 0%, #8b5cf6 55%, #a855f7 100%); padding: 14px 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    #atEntryPanel .at-header-title { color: #fff; font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1 1 auto; }
    #atEntryPanel .at-card-body { padding: 16px 18px 18px; max-width: 100%; }
    #atEntryPanel .at-form-grid { display: grid; gap: 10px 12px; }
    #atEntryPanel .at-form-main { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; }
    #atEntryPanel .at-form-group { display: flex; flex-direction: column; gap: 3px; }
    #atEntryPanel .at-form-group label { font-size: 11px; font-weight: 700; color: #374151; }
    #atEntryPanel .at-required { color: #ef4444; }
    #atEntryPanel .at-input {
        width: 100%; min-height: 32px; height: 32px; padding: 4px 10px; border-radius: 6px;
        border: 1px solid #64748b; font-size: 12px; background: #fff; outline: none;
    }
    #atEntryPanel .at-input.at-input-error { border-color: #ef4444; }
    #atEntryPanel .at-err { font-size: 11px; color: #ef4444; display: none; }
    #atEntryPanel .at-detail-table-wrap { border: 1px solid #e4e7f0; border-radius: 12px; overflow-x: auto; max-height: 360px; width: 100%; }
    #atEntryPanel .at-detail-table { width: 100%; border-collapse: collapse; font-size: 12px; min-width: 680px; }
    #atEntryPanel .at-detail-table thead th { background: #f3f4f6; font-size: 11px; font-weight: 700; padding: 6px; border-bottom: 1px solid #e5e7eb; }
    #atEntryPanel .at-detail-table td { padding: 4px 6px; border-bottom: 1px solid #f0f2f9; vertical-align: middle; }
    #atEntryPanel .at-btn-del-row { width: 28px; height: 28px; border: none; border-radius: 6px; background: #fef2f2; color: #ef4444; cursor: pointer; }
    #atEntryPanel .at-btn-add-row { margin-top: 10px; padding: 6px 14px; border-radius: 6px; border: none; background: #8b5cf6; color: #fff; font-size: 12px; font-weight: 600; cursor: pointer; }
    #atEntryPanel .at-footer { display: flex; justify-content: flex-end; gap: 10px; padding-top: 8px; }
    #atEntryPanel .at-btn-back, #atEntryPanel .at-btn-save { min-height: 34px; padding: 0 18px; border-radius: 999px; font-size: 12px; font-weight: 600; cursor: pointer; }
    #atEntryPanel .at-card-header .at-btn-back { border: 2px solid rgba(255,255,255,0.48); background: rgba(255,255,255,0.14); color: #fff; }
    #atEntryPanel .at-btn-back { border: 1.5px solid #d4d7e8; background: #fff; color: #374151; }
    #atEntryPanel .at-btn-save { border: none; background: linear-gradient(130deg, #5b5ef4, #a855f7); color: #fff; }
    #atEntryPanel .select2-container { width: 100% !important; }
</style>

<div id="atListPanel" class="im-page-wrapper">
    <span id="ERPHeading" style="display:none"></span>
    <div class="im-card">
        <div class="im-card-header">
            <div class="im-header-left">
                <div class="im-header-icon"><i class="fas fa-tags"></i></div>
                <div class="im-header-title">Asset Type Master</div>
            </div>
            <button type="button" id="btnNewAssetType" class="im-btn-new">
                <i class="fas fa-plus"></i><span>New</span>
            </button>
        </div>
        <div class="im-card-body">
            <div id="tblAssetTypeMaster">
                <div class="im-table-wrapper table-wrapper">
                    <table id="AssetTypeMasterGrid" style="width:100%;border-collapse:collapse;font-size:13px;">
                        <thead id="AssetTypeMaster-header"></thead>
                        <tbody id="AssetTypeMaster-body"></tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-AssetTypeMasterGrid"></div>
            </div>
        </div>
    </div>
</div>

<div id="atEntryPanel" style="display:none;">
    <div class="at-entry-wrap">
        <div class="at-card">
            <div class="at-card-header">
                <div class="at-header-title"><i class="fas fa-tags"></i><span id="entryPageTitle">Asset Type Master</span></div>
                <button type="button" class="at-btn-back" id="btnBackToList"><i class="fas fa-arrow-left"></i> Back to List</button>
            </div>
            <div class="at-card-body">
                <div class="at-form-grid at-form-main" autocomplete="off">
                    <div class="at-form-group">
                        <label for="txtAssetTypeName">Asset Type Name <span class="at-required">*</span></label>
                        <input type="text" id="txtAssetTypeName" class="at-input" maxlength="150" autocomplete="off" />
                        <span class="at-err" id="err_AssetTypeName">Asset Type Name is required.</span>
                    </div>
                    <div class="at-form-group">
                        <label for="txtDepreciationPercentage">Dep % <span class="at-required">*</span></label>
                        <input type="number" id="txtDepreciationPercentage" class="at-input" min="0" step="0.01" autocomplete="off" />
                        <span class="at-err" id="err_DepPercentage">Dep % is required.</span>
                    </div>
                    <div class="at-form-group">
                        <label for="ddlDepreciationMethod">Dep Method <span class="at-required">*</span></label>
                        <select id="ddlDepreciationMethod" class="at-input js-search-select"><option value="">-- Select --</option></select>
                        <span class="at-err" id="err_DepMethod">Dep Method is required.</span>
                    </div>
                    <div class="at-form-group">
                        <label for="txtPrefix">Prefix <span class="at-required">*</span></label>
                        <input type="text" id="txtPrefix" class="at-input" maxlength="3" autocomplete="off" />
                        <span class="at-err" id="err_Prefix">Prefix is required.</span>
                    </div>
                    <div class="at-form-group">
                        <label for="ddlAssetGroup">Asset Group <span class="at-required">*</span></label>
                        <select id="ddlAssetGroup" class="at-input js-search-select"><option value="">-- Select --</option></select>
                        <span class="at-err" id="err_AssetGroup">Asset Group is required.</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="at-card">
            <div class="at-card-body">
                <div class="at-detail-table-wrap">
                    <table class="at-detail-table">
                        <thead>
                            <tr>
                                <th style="width:28%">Maintenance Type Name <span class="at-required">*</span></th>
                                <th style="width:18%">Maintenance Planning</th>
                                <th style="width:28%">Desp</th>
                                <th style="width:22%">Remark</th>
                                <th style="width:52px">Delete</th>
                            </tr>
                        </thead>
                        <tbody id="assetTypeDetailBody"></tbody>
                    </table>
                </div>
                <button type="button" class="at-btn-add-row" id="btnAddDetailRow"><i class="fas fa-plus"></i> Add New Row</button>
                <div class="at-footer" style="margin-top:20px;">
                    <button type="button" class="at-btn-back" id="btnCancelEntry">Cancel</button>
                    <button type="button" class="at-btn-save" id="btnSaveEntry"><i class="fas fa-floppy-disk"></i> <span id="btnSaveEntryText">Save</span></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="deleteConfirmBackdrop" class="im-backdrop">
    <div class="im-delete-modal">
        <div class="im-delete-icon-wrap">
            <i class="fas fa-trash-can"></i>
        </div>
        <div class="im-delete-title">Delete this Asset Type?</div>
        <div class="im-delete-text">
            This action cannot be undone.<br>The asset type record will be permanently removed.
        </div>
        <div class="im-delete-reason">
            <label class="im-delete-reason-label">
                <i class="fas fa-comment-dots"></i> Reason for Delete <span class="im-required">*</span>
            </label>
            <input type="text" id="reasonForDeleteInput" class="im-delete-reason-input"
                   placeholder="Enter reason for deletion…" autocomplete="off" maxlength="500" />
        </div>
        <div class="im-delete-actions">
            <button type="button" class="im-btn-cancel" id="btnCancelDelete">
                <i class="fas fa-times"></i> Cancel
            </button>
            <button type="button" class="im-btn-confirm-delete" onclick="DoDeleteAssetType()">
                <i class="fas fa-trash-can"></i> Yes, Delete
            </button>
        </div>
    </div>
</div>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Common.Masters/js/AssetTypeMaster.js?v=asset-type-combined-v1"></script>
