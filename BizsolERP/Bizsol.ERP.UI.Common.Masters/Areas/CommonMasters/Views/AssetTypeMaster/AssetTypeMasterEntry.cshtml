@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<style>
    .at-entry-wrap {
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        padding: 0 18px 30px; background: #f1f3fb; min-height: 100%;
        box-sizing: border-box; width: 100%; max-width: 100%; overflow-x: hidden;
    }
    .at-entry-wrap *, .at-entry-wrap *::before, .at-entry-wrap *::after { box-sizing: border-box; }
    .at-card { background: #fff; border-radius: 16px; border: 1px solid #e5e7f0; box-shadow: 0 4px 24px rgba(99,102,241,0.09); overflow: hidden; margin-bottom: 18px; max-width: 100%; }
    .at-card-header { background: linear-gradient(130deg, #5b5ef4 0%, #8b5cf6 55%, #a855f7 100%); padding: 14px 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .at-header-title { color: #fff; font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1 1 auto; }
    .at-header-title span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .at-card-body { padding: 16px 18px 18px; max-width: 100%; }
    .at-form-grid { display: grid; gap: 10px 12px; }
    .at-form-main { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; }
    .at-form-group--spacer { visibility: hidden; min-height: 0; padding: 0; margin: 0; pointer-events: none; }
    @@media (max-width: 768px) {
        .at-entry-wrap { padding: 0 10px 20px; }
        .at-card { border-radius: 12px; margin-bottom: 12px; }
        .at-card-header { padding: 12px 14px; gap: 10px; }
        .at-header-title { font-size: 16px; flex: 1 1 100%; }
        .at-card-header .at-btn-back { flex: 1 1 100%; width: 100%; justify-content: center; min-height: 36px; font-size: 12px; padding: 0 12px; }
        .at-card-body { padding: 14px 12px 16px; }
        .at-form-main { grid-template-columns: 1fr; }
        .at-form-group label { font-size: 13px; }
        .at-input, .at-entry-wrap .select2-container .select2-selection--single { min-height: 34px; }
        .at-detail-table-wrap {
            max-height: none; width: 100%; max-width: 100%;
            overflow-x: auto; overflow-y: visible; -webkit-overflow-scrolling: touch;
            border-radius: 10px;
        }
        .at-detail-table { min-width: 640px; font-size: 12px; }
        .at-detail-table thead th { font-size: 11px; padding: 8px 6px; }
        .at-detail-table td { padding: 6px; }
        .at-btn-add-row { width: 100%; justify-content: center; margin-top: 10px; }
        .at-footer { flex-direction: column; align-items: stretch; gap: 8px; margin-top: 16px !important; }
        .at-footer .at-btn-back, .at-footer .at-btn-save { width: 100%; justify-content: center; min-height: 44px; }
    }
    .at-form-group { display: flex; flex-direction: column; gap: 3px; }
    .at-form-group label { font-size: 11px; font-weight: 700; color: #374151; letter-spacing: 0; text-transform: none; }
    .at-required { color: #ef4444; }
    .at-input {
        width: 100%; min-height: 32px; height: 32px; padding: 4px 10px; border-radius: 6px;
        border: 1px solid #64748b; font-size: 12px; line-height: 1.25; background: #fff; outline: none;
        box-sizing: border-box;
    }
    .at-input:focus { border-color: #5b5ef4; box-shadow: 0 0 0 2px rgba(91,94,244,0.12); background: #fff; }
    .at-input.at-input-error { border-color: #ef4444; }
    .at-err { font-size: 11px; color: #ef4444; display: none; }
    .at-detail-table-wrap {
        border: 1px solid #e4e7f0; border-radius: 12px;
        overflow-x: auto; overflow-y: auto; max-height: 360px;
        width: 100%; max-width: 100%; -webkit-overflow-scrolling: touch;
    }
    .at-detail-table { width: 100%; border-collapse: collapse; font-size: 12px; min-width: 680px; }
    .at-detail-table thead th { background: #f3f4f6; color: #374151; font-size: 11px; font-weight: 700; text-transform: none; padding: 6px 6px; border-bottom: 1px solid #e5e7eb; white-space: nowrap; }
    .at-detail-table td { padding: 4px 6px; border-bottom: 1px solid #f0f2f9; vertical-align: middle; }
    .at-detail-table .at-input { width: 100%; min-height: 32px; height: 32px; padding: 4px 8px; }
    .at-detail-table select.at-input { min-width: 120px; padding-right: 24px; }
    .at-detail-table select.at-input.at-input-error { border-color: #ef4444; box-shadow: 0 0 0 2px rgba(239,68,68,0.12); }
    .at-entry-wrap .select2-container { width: 100% !important; }
    .at-entry-wrap .select2-container--default .select2-selection--single {
        min-height: 32px !important; height: 32px !important;
        border: 1px solid #64748b !important; border-radius: 6px !important; background: #fff !important;
    }
    .at-entry-wrap .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 30px !important; padding-left: 10px !important; padding-right: 24px !important;
        font-size: 12px; color: #111827;
    }
    .at-entry-wrap .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 30px !important; top: 1px !important;
    }
    .at-entry-wrap .select2-container--default.select2-container--focus .select2-selection--single,
    .at-entry-wrap .select2-container--default.select2-container--open .select2-selection--single {
        border-color: #5b5ef4 !important; box-shadow: 0 0 0 2px rgba(91,94,244,0.12);
    }
    .at-entry-wrap .select2-dropdown { font-size: 12px; }
    .at-entry-wrap .select2-results__option { padding: 4px 10px; min-height: 28px; }
    .at-entry-wrap .select2-container.at-input-error .select2-selection { border-color: #ef4444 !important; box-shadow: 0 0 0 2px rgba(239,68,68,0.12); }
    .at-btn-del-row { width: 28px; height: 28px; border: none; border-radius: 6px; background: #fef2f2; color: #ef4444; font-size: 12px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
    .at-btn-add-row {
        margin-top: 10px; padding: 6px 14px; border-radius: 6px; border: none;
        background: #8b5cf6; color: #fff; font-size: 12px; font-weight: 600; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center; gap: 8px; line-height: 1.2;
    }
    .at-btn-add-row:hover { background: #7c3aed; }
    .at-footer { display: flex; justify-content: flex-end; align-items: center; gap: 10px; padding-top: 8px; }
    .at-btn-back, .at-btn-save {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        line-height: 1.2; min-height: 34px; padding: 0 18px; border-radius: 999px;
        font-size: 12px; font-weight: 600; cursor: pointer; box-sizing: border-box;
    }
    .at-btn-back { border: 1.5px solid #d4d7e8; background: #fff; color: #374151; font-weight: 500; }
    .at-card-header .at-btn-back {
        border: 2px solid rgba(255,255,255,0.48); background: rgba(255,255,255,0.14);
        color: #fff; font-weight: 600; min-height: 38px; padding: 0 18px;
    }
    .at-card-header .at-btn-back:hover { background: rgba(255,255,255,0.22); }
    .at-btn-save { border: none; background: linear-gradient(130deg, #5b5ef4, #a855f7); color: #fff; }
    .at-btn-save i, .at-btn-back i { line-height: 1; }
</style>

<div class="at-entry-wrap">
    <span id="ERPHeading" style="display:none"></span>
    <div class="at-card">
        <div class="at-card-header">
            <div class="at-header-title">
                <i class="fas fa-tags"></i>
                <span id="entryPageTitle">Asset Type Master</span>
            </div>
            <button type="button" class="at-btn-back" id="btnBackToList"><i class="fas fa-arrow-left"></i> Back to List</button>
        </div>
        <div class="at-card-body">
            <div class="at-form-grid at-form-main" autocomplete="off">
                <div class="at-form-group">
                    <label for="txtAssetTypeName">Asset Type Name <span class="at-required">*</span></label>
                    <input type="text" id="txtAssetTypeName" class="at-input" name="at_asset_type_name" maxlength="150" autocomplete="off" autocapitalize="off" spellcheck="false" />
                    <span class="at-err" id="err_AssetTypeName">Asset Type Name is required.</span>
                </div>
                <div class="at-form-group">
                    <label for="txtDepreciationPercentage">Dep % <span class="at-required">*</span></label>
                    <input type="number" id="txtDepreciationPercentage" class="at-input" name="at_dep_pct" min="0" step="0.01" autocomplete="off" />
                    <span class="at-err" id="err_DepPercentage">Dep % is required.</span>
                </div>
                <div class="at-form-group">
                    <label for="ddlDepreciationMethod">Dep Method <span class="at-required">*</span></label>
                    <select id="ddlDepreciationMethod" class="at-input js-search-select"><option value="">-- Select --</option></select>
                    <span class="at-err" id="err_DepMethod">Dep Method is required.</span>
                </div>
                <div class="at-form-group">
                    <label for="txtPrefix">Prefix <span class="at-required">*</span></label>
                    <input type="text" id="txtPrefix" class="at-input" name="at_prefix" maxlength="3" autocomplete="off" autocapitalize="characters" spellcheck="false" />
                    <span class="at-err" id="err_Prefix">Prefix is required.</span>
                </div>
                <div class="at-form-group">
                    <label for="ddlAssetGroup">Asset Group <span class="at-required">*</span></label>
                    <select id="ddlAssetGroup" class="at-input js-search-select"><option value="">-- Select --</option></select>
                    <span class="at-err" id="err_AssetGroup">Asset Group is required.</span>
                </div>
                <div class="at-form-group at-form-group--spacer" aria-hidden="true"></div>
            </div>
        </div>
    </div>

    <div class="at-card">
        <div class="at-card-body">
            <div class="at-detail-table-wrap">
                <table class="at-detail-table">
                    <thead>
                        <tr>
                            <th style="width:28%">Maintenance Type Name <span class="at-required">*</span></th>
                            <th style="width:18%">Maintenance Planning</th>
                            <th style="width:28%">Desp</th>
                            <th style="width:22%">Remark</th>
                            <th style="width:52px">Delete</th>
                        </tr>
                    </thead>
                    <tbody id="assetTypeDetailBody"></tbody>
                </table>
            </div>
            <button type="button" class="at-btn-add-row" id="btnAddDetailRow"><i class="fas fa-plus"></i> Add New Row</button>
            <div class="at-footer" style="margin-top:20px;">
                <button type="button" class="at-btn-back" id="btnCancelEntry">Cancel</button>
                <button type="button" class="at-btn-save" id="btnSaveEntry"><i class="fas fa-floppy-disk"></i> <span id="btnSaveEntryText">Save</span></button>
            </div>
        </div>
    </div>
</div>

<script type="module" src="~/_content/Bizsol.WebERP.UI.Common.Masters/js/AssetTypeMasterEntry.js?v=asset-type-entry-v21"></script>
