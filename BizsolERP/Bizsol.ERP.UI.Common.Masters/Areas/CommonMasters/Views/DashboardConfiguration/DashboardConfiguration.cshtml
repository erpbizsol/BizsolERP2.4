@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Common.Masters/js/DashboardConfiguration.js?v=20260729b"></script>

<style>
    #DashboardConfigurationPage {
        --dc-ink: #0f172a;
        --dc-muted: #64748b;
        --dc-line: #e2e8f0;
        --dc-primary: #4f46e5;
        --dc-soft: #eef2ff;
        font-family: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
        padding: 8px 12px 20px;
        color: #334155;
        max-width: 100%;
        box-sizing: border-box;
        background:
            radial-gradient(ellipse 800px 400px at 0% 0%, rgba(99, 102, 241, 0.09), transparent 55%),
            linear-gradient(160deg, #f0f4ff 0%, #f8fafc 50%, #f1f5f9 100%);
        min-height: calc(100vh - 110px);
        border-radius: 12px;
    }

    #DashboardConfigurationPage *,
    #DashboardConfigurationPage *::before,
    #DashboardConfigurationPage *::after { box-sizing: border-box; }

    .dc-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid rgba(226, 232, 240, 0.95);
        box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.04), 0 18px 36px -14px rgba(79, 70, 229, 0.14);
        /* visible so Dashboard Detail dropdown panel is not clipped */
        overflow: visible;
    }

    .dc-card-header {
        background: linear-gradient(135deg, #4f46e5 0%, #6d28d9 50%, #7c3aed 100%);
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 14px;
        position: relative;
        overflow: hidden;
        border-radius: 18px 18px 0 0;
    }

    .dc-card-header::after {
        content: '';
        position: absolute;
        right: -28px; top: -36px;
        width: 160px; height: 160px;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
        pointer-events: none;
    }

    .dc-header-icon {
        width: 46px; height: 46px; border-radius: 13px;
        background: rgba(255,255,255,0.18);
        border: 1px solid rgba(255,255,255,0.28);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 19px; flex-shrink: 0;
        position: relative; z-index: 1;
    }

    .dc-header-title {
        margin: 0; color: #fff; font-size: 1.22rem; font-weight: 800;
        letter-spacing: -0.02em; position: relative; z-index: 1;
    }

    .dc-header-sub {
        margin-top: 4px; color: rgba(255,255,255,0.84);
        font-size: 12.5px; font-weight: 500; position: relative; z-index: 1;
    }

    .dc-card-body {
        padding: 18px 20px 20px;
        overflow: visible;
        position: relative;
        z-index: 1;
    }

    .dc-filter-bar {
        display: grid;
        grid-template-columns: minmax(220px, 0.9fr) minmax(280px, 1.35fr);
        gap: 14px;
        padding: 14px;
        border: 1px solid var(--dc-line);
        border-radius: 14px;
        background: linear-gradient(180deg, #fff, #f8fafc);
        margin-bottom: 16px;
        overflow: visible;
        position: relative;
        z-index: 5;
    }

    .dc-fg {
        position: relative;
        min-width: 0;
    }

    .dc-fg label {
        display: flex; align-items: center; gap: 8px;
        font-size: 12px; font-weight: 750; color: #334155; margin-bottom: 6px;
    }

    .dc-fg label .dc-badge {
        font-size: 9.5px; font-weight: 800; letter-spacing: .04em;
        color: #4338ca; background: var(--dc-soft); border: 1px solid #c7d2fe;
        border-radius: 999px; padding: 2px 7px;
    }

    .dc-fg .select2-container { width: 100% !important; }

    .dc-fg .select2-container--default .select2-selection--single,
    .dc-fg .select2-container--default .select2-selection--multiple {
        min-height: 44px; padding: 5px 10px;
        border-radius: 12px !important;
        border: 1.5px solid #cbd5e1 !important;
        background: #fff !important;
    }

    .dc-fg .select2-container--default.select2-container--focus .select2-selection--single,
    .dc-fg .select2-container--default.select2-container--focus .select2-selection--multiple {
        border-color: #818cf8 !important;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.14);
    }

    .dc-fg .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 32px; font-size: 13.5px; font-weight: 650; color: var(--dc-ink); padding-left: 2px;
    }

    .dc-fg .select2-container--default .select2-selection--single .select2-selection__arrow { height: 42px; }

    /* Dashboard Detail — looks like User select; checkbox list only when open */
    .dc-multi-checkbox-root {
        position: relative;
        width: 100%;
        z-index: 1;
    }

    .dc-multi-checkbox-root.is-open {
        z-index: 100;
    }

    .dc-multi-trigger {
        min-height: 44px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 5px 12px;
        border-radius: 12px;
        border: 1.5px solid #cbd5e1;
        background: #fff;
        cursor: pointer;
        font-family: inherit;
        text-align: left;
        transition: border-color .14s ease, box-shadow .14s ease;
    }

    .dc-multi-trigger:hover {
        border-color: #a5b4fc;
    }

    .dc-multi-checkbox-root.is-open .dc-multi-trigger {
        border-color: #818cf8 !important;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.14);
    }

    .dc-multi-trigger-text {
        flex: 1;
        min-width: 0;
        font-size: 13.5px;
        font-weight: 650;
        color: var(--dc-ink);
        line-height: 32px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dc-multi-trigger-text.is-placeholder {
        color: #94a3b8;
        font-weight: 550;
    }

    .dc-multi-trigger-arrow {
        color: #64748b;
        font-size: 12px;
        flex-shrink: 0;
        transition: transform .14s ease;
    }

    .dc-multi-checkbox-root.is-open .dc-multi-trigger-arrow {
        transform: rotate(180deg);
    }

    .dc-multi-panel {
        display: none;
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 4px);
        z-index: 200;
        border: 1.5px solid #c7d2fe;
        border-radius: 12px;
        background: #fff;
        padding: 10px;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.16);
        min-height: 120px;
    }

    .dc-multi-checkbox-root.is-open .dc-multi-panel {
        display: block;
    }

    .dc-multi-empty {
        padding: 14px 8px;
        text-align: center;
        color: #94a3b8;
        font-size: 12.5px;
        font-weight: 650;
    }

    .dc-multi-checkbox-search {
        margin-bottom: 8px;
    }

    .dc-multi-checkbox-search input {
        width: 100%;
        height: 36px;
        border: 1px solid #d7dee8;
        border-radius: 8px;
        padding: 0 11px;
        font-size: 12.5px;
        font-family: inherit;
        outline: none;
    }

    .dc-multi-checkbox-search input:focus {
        border-color: #818cf8;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }

    .dc-multi-checkbox-selectall {
        margin-bottom: 8px;
        padding-bottom: 8px;
        border-bottom: 1px dashed #e2e8f0;
    }

    .dc-multi-checkbox-selectall label {
        display: inline-flex !important;
        align-items: center;
        gap: 7px;
        margin: 0 !important;
        font-size: 12.5px !important;
        font-weight: 700 !important;
        color: #4338ca !important;
        cursor: pointer;
    }

    .dc-multi-checkbox-selectall input {
        width: 15px;
        height: 15px;
        accent-color: #4f46e5;
        margin: 0;
        cursor: pointer;
    }

    .dc-multi-checkbox-list {
        max-height: min(220px, 32vh);
        overflow: auto;
        border: 1px solid #e6e6e6;
        padding: 6px 8px;
        border-radius: 8px;
        background: #fff;
    }

    .dc-multi-checkbox-item {
        padding: 5px 2px;
    }

    .dc-multi-checkbox-item label {
        display: flex !important;
        align-items: center;
        gap: 8px;
        margin: 0 !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        color: #0f172a !important;
        cursor: pointer;
    }

    .dc-multi-checkbox-item input[type="checkbox"] {
        width: 15px;
        height: 15px;
        accent-color: #4f46e5;
        margin: 0;
        cursor: pointer;
        flex-shrink: 0;
    }

    .dc-multi-checkbox-item.is-hidden {
        display: none !important;
    }

    .dc-tiles-section { display: none; }
    .dc-tiles-section.is-visible { display: block; animation: dcFade .18s ease; }

    @@keyframes dcFade {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: none; }
    }

    .dc-toolbar {
        display: flex; align-items: center; justify-content: space-between;
        gap: 10px; flex-wrap: wrap; margin-bottom: 12px;
    }

    .dc-toolbar-left {
        display: flex; align-items: center; gap: 10px; flex-wrap: wrap; min-width: 0; flex: 1;
    }

    .dc-toolbar-title {
        margin: 0; font-size: 14.5px; font-weight: 800; color: #1e293b;
        display: flex; align-items: center; gap: 8px; white-space: nowrap;
    }

    .dc-toolbar-title i {
        width: 30px; height: 30px; border-radius: 9px;
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--dc-soft); color: var(--dc-primary); font-size: 12px;
    }

    .dc-jump-chips {
        display: flex; flex-wrap: wrap; gap: 6px;
    }

    .dc-jump-chip {
        border: 1px solid var(--dc-line);
        background: #fff;
        color: #475569;
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 11.5px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .12s ease;
    }

    .dc-jump-chip:hover { border-color: #c7d2fe; color: #3730a3; background: #f8fafc; }

    .dc-jump-chip .dot {
        width: 8px; height: 8px; border-radius: 50%; background: var(--dc-g, #6366f1); flex-shrink: 0;
    }

    .dc-toolbar-right {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    }

    .dc-search {
        position: relative;
    }

    .dc-search i {
        position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
        color: #94a3b8; font-size: 12px; pointer-events: none;
    }

    .dc-search input {
        width: min(240px, 70vw);
        height: 36px;
        border: 1.5px solid #cbd5e1;
        border-radius: 999px;
        padding: 0 12px 0 32px;
        font-size: 12.5px;
        font-family: inherit;
        outline: none;
        background: #fff;
    }

    .dc-search input:focus {
        border-color: #818cf8;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }

    .dc-count-badge {
        font-size: 12px; font-weight: 750; color: var(--dc-muted);
        background: #fff; border: 1px solid var(--dc-line);
        border-radius: 999px; padding: 6px 11px;
    }

    .dc-count-badge.has-selection {
        color: #3730a3; background: var(--dc-soft); border-color: #c7d2fe;
    }

    .dc-tool-btn {
        border: 1px solid var(--dc-line); background: #fff; color: #334155;
        font-size: 12px; font-weight: 700; border-radius: 999px;
        padding: 7px 12px; cursor: pointer; font-family: inherit;
    }

    .dc-tool-btn:hover { background: #f1f5f9; }
    .dc-tool-btn.is-primary { background: var(--dc-soft); border-color: #c7d2fe; color: #4338ca; }

    .dc-tiles-panel {
        position: relative;
        border: 1px solid var(--dc-line);
        border-radius: 16px;
        background: #f8fafc;
        padding: 12px;
        max-height: min(62vh, 560px);
        overflow-x: hidden;
        overflow-y: auto;
        scrollbar-gutter: stable;
    }

    .dc-tiles-panel::-webkit-scrollbar {
        width: 8px;
    }

    .dc-tiles-panel::-webkit-scrollbar-track {
        background: #eef2ff;
        border-radius: 999px;
    }

    .dc-tiles-panel::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, #818cf8, #6366f1);
        border-radius: 999px;
    }

    /* ALWAYS stacked full-width sections */
    .dc-tiles-list {
        display: block !important;
        width: 100% !important;
    }

    .dc-section {
        --dc-g: #6366f1;
        display: block !important;
        width: 100% !important;
        margin-bottom: 12px;
        background: #fff;
        border: 1px solid #e5eaf2;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
    }

    .dc-section:last-child { margin-bottom: 0; }

    .dc-section[data-accent="0"] { --dc-g: #6366f1; }
    .dc-section[data-accent="1"] { --dc-g: #0284c7; }
    .dc-section[data-accent="2"] { --dc-g: #059669; }
    .dc-section[data-accent="3"] { --dc-g: #d97706; }
    .dc-section[data-accent="4"] { --dc-g: #db2777; }
    .dc-section[data-accent="5"] { --dc-g: #7c3aed; }

    .dc-section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 12px 14px;
        border-left: 5px solid var(--dc-g);
        background: linear-gradient(90deg, rgba(99, 102, 241, 0.06), transparent 55%), #fafbff;
        border-bottom: 1px solid #eef2f7;
    }

    .dc-section-title {
        margin: 0;
        font-size: 13.5px;
        font-weight: 800;
        color: var(--dc-ink);
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .dc-section-title .ico {
        width: 28px; height: 28px; border-radius: 9px;
        display: inline-flex; align-items: center; justify-content: center;
        background: #fff; border: 1px solid #e8eef6; color: var(--dc-g); font-size: 12px;
    }

    .dc-section-meta {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    }

    .dc-section-count {
        font-size: 11.5px; font-weight: 750; color: #475569;
        background: #fff; border: 1px solid var(--dc-line);
        border-radius: 999px; padding: 4px 9px;
    }

    .dc-section-link {
        border: none; background: transparent; color: var(--dc-primary);
        font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit;
        text-decoration: underline; text-underline-offset: 2px; padding: 2px 4px;
    }

    .dc-section-body {
        padding: 12px 14px 14px;
        max-height: none;
        overflow: visible;
    }

    .dc-section.is-empty .dc-section-body {
        padding: 14px;
    }

    .dc-tile-grid {
        display: grid !important;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 10px;
        width: 100%;
    }

    .dc-tile-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 13px;
        min-height: 50px;
        border-radius: 12px;
        /* Matches header: indigo → violet → purple (lighter for readability) */
        background: linear-gradient(135deg, #6366f1 0%, #7c3aed 52%, #8b5cf6 100%);
        border: none;
        cursor: pointer;
        user-select: none;
        transition: all .14s ease;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.22);
        position: relative;
        overflow: hidden;
    }

    .dc-tile-item::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 12% -20%, rgba(255, 255, 255, 0.28), transparent 45%),
            radial-gradient(circle at 100% 120%, rgba(255, 255, 255, 0.12), transparent 40%);
        pointer-events: none;
    }

    .dc-tile-item.is-hidden { display: none !important; }

    .dc-tile-item:hover {
        transform: translateY(-1px);
        filter: brightness(1.05);
        box-shadow: 0 8px 18px rgba(79, 70, 229, 0.32);
    }

    .dc-tile-item.is-checked {
        background: linear-gradient(135deg, #4f46e5 0%, #6d28d9 48%, #7c3aed 100%);
        box-shadow: 0 6px 16px rgba(79, 70, 229, 0.28);
    }

    /* Soft variants still in header purple family */
    .dc-section[data-accent="0"] .dc-tile-item.is-checked {
        background: linear-gradient(135deg, #4f46e5 0%, #6d28d9 50%, #7c3aed 100%);
    }

    .dc-section[data-accent="1"] .dc-tile-item.is-checked {
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 45%, #7c3aed 100%);
    }

    .dc-section[data-accent="2"] .dc-tile-item.is-checked {
        background: linear-gradient(135deg, #5b5ef4 0%, #6d28d9 50%, #8b5cf6 100%);
    }

    .dc-section[data-accent="3"] .dc-tile-item.is-checked {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 55%, #9333ea 100%);
    }

    .dc-section[data-accent="4"] .dc-tile-item.is-checked {
        background: linear-gradient(135deg, #6366f1 0%, #7c3aed 50%, #a855f7 100%);
    }

    .dc-section[data-accent="5"] .dc-tile-item.is-checked {
        background: linear-gradient(135deg, #4f46e5 0%, #6d28d9 45%, #8b5cf6 100%);
    }

    .dc-tile-item:not(.is-checked) {
        background: linear-gradient(135deg, #c7d2fe 0%, #ddd6fe 55%, #e9d5ff 100%);
        opacity: 0.85;
        box-shadow: none;
    }

    .dc-tile-item input[type="checkbox"] {
        position: absolute; opacity: 0; width: 0; height: 0; pointer-events: none;
    }

    .dc-tile-check {
        position: relative;
        z-index: 1;
        width: 20px; height: 20px; border-radius: 6px;
        border: 1.5px solid rgba(255, 255, 255, 0.55);
        background: rgba(255, 255, 255, 0.22);
        display: inline-flex; align-items: center; justify-content: center;
        color: transparent; font-size: 10px; flex-shrink: 0;
    }

    .dc-tile-item.is-checked .dc-tile-check {
        background: #fff;
        border-color: #fff;
        color: #5b21b6;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.14);
    }

    .dc-tile-label {
        position: relative;
        z-index: 1;
        font-size: 12.8px; font-weight: 750; color: #fff;
        line-height: 1.3; flex: 1;
        text-shadow: 0 1px 2px rgba(49, 46, 129, 0.25);
    }

    .dc-tile-item.is-checked .dc-tile-label {
        color: #fff;
    }

    .dc-tile-item:not(.is-checked) .dc-tile-label {
        color: #3730a3;
        text-shadow: none;
    }

    .dc-tile-item:not(.is-checked) .dc-tile-check {
        border-color: #a5b4fc;
        background: #fff;
        color: transparent;
    }

    .dc-section-empty {
        display: flex; align-items: center; gap: 8px;
        color: #94a3b8; font-size: 12.5px; font-weight: 650;
        padding: 8px 10px; border: 1px dashed #d7dee8; border-radius: 10px; background: #f8fafc;
    }

    .dc-no-match {
        display: none;
        text-align: center;
        color: #94a3b8;
        font-size: 12.5px;
        font-weight: 650;
        padding: 16px 8px;
    }

    .dc-no-match.is-visible { display: block; }

    .dc-tiles-loading {
        display: none; position: absolute; inset: 0; border-radius: 16px;
        background: rgba(255,255,255,0.72); align-items: center; justify-content: center;
        gap: 8px; color: #4338ca; font-size: 13px; font-weight: 750; z-index: 2;
    }

    .dc-tiles-loading.is-visible { display: flex; }

    .dc-tiles-empty {
        display: none; text-align: center; padding: 26px 8px;
        color: var(--dc-muted); font-size: 13px; font-weight: 650;
    }

    .dc-tiles-empty.is-visible { display: block; }

    .dc-actions {
        margin-top: 14px;
        display: flex; align-items: center; justify-content: flex-end; gap: 12px;
        padding: 13px 15px; border: 1px solid var(--dc-line); border-radius: 14px; background: #fff;
    }

    .dc-hint {
        margin-right: auto; font-size: 12.5px; color: var(--dc-muted); font-weight: 550;
        display: flex; align-items: center; gap: 8px;
    }

    .dc-hint i { color: var(--dc-primary); }

    .dc-btn-save {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 11px 22px; border: none; border-radius: 999px;
        background: linear-gradient(130deg, #4f46e5, #7c3aed);
        color: #fff; font-size: 13.5px; font-weight: 750; cursor: pointer;
        font-family: inherit; box-shadow: 0 8px 18px rgba(79, 70, 229, 0.3);
    }

    .dc-btn-save:hover { transform: translateY(-1px); }
    .dc-btn-save:disabled { opacity: .6; cursor: not-allowed; transform: none; }

    @@media (max-width: 900px) {
        .dc-filter-bar { grid-template-columns: 1fr; }
    }

    @@media (max-width: 576px) {
        .dc-tile-grid { grid-template-columns: 1fr; }
        .dc-tiles-panel { max-height: min(58vh, 480px); }
        .dc-actions { flex-direction: column; align-items: stretch; }
        .dc-hint { margin: 0 0 4px; }
        .dc-btn-save { justify-content: center; }
    }
</style>

<div id="DashboardConfigurationPage">
    <div class="dc-card">
        <div class="dc-card-header">
            <div class="dc-header-icon"><i class="fas fa-gauge-high"></i></div>
            <div>
                <h1 class="dc-header-title">Dashboard Configuration</h1>
                <div class="dc-header-sub">Uncheck tiles &amp; Save — yahan list mein unchecked dikhengi; us user ke actual dashboard pe nahi dikhengi</div>
            </div>
        </div>

        <div class="dc-card-body">
            <div class="dc-filter-bar">
                <div class="dc-fg">
                    <label for="ddlUser">User <span class="text-danger">*</span></label>
                    <select id="ddlUser"></select>
                </div>
                <div class="dc-fg">
                    <label>
                        Dashboard Detail <span class="text-danger">*</span>
                        <span class="dc-badge">MULTI</span>
                    </label>
                    <div id="dcDashboardMulti" class="dc-multi-checkbox-root">
                        <button type="button" id="btnDashboardTrigger" class="dc-multi-trigger" aria-haspopup="listbox" aria-expanded="false">
                            <span id="dcDashboardTriggerText" class="dc-multi-trigger-text is-placeholder">Search or select dashboard detail…</span>
                            <i class="fas fa-chevron-down dc-multi-trigger-arrow" aria-hidden="true"></i>
                        </button>
                        <div id="dcDashboardPanel" class="dc-multi-panel" role="listbox">
                            <div class="dc-multi-checkbox-search">
                                <input type="text" id="txtDashboardSearch" placeholder="Search..." autocomplete="off" />
                            </div>
                            <div class="dc-multi-checkbox-selectall">
                                <label>
                                    <input type="checkbox" id="chkDashboardSelectAll" />
                                    Select All
                                </label>
                            </div>
                            <div id="dcDashboardCheckList" class="dc-multi-checkbox-list"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="dcTilesSection" class="dc-tiles-section">
                <div class="dc-toolbar">
                    <div class="dc-toolbar-left">
                        <h2 class="dc-toolbar-title"><i class="fas fa-th-large"></i> Dashboard Tiles</h2>
                        <div id="dcJumpChips" class="dc-jump-chips"></div>
                    </div>
                    <div class="dc-toolbar-right">
                        <div class="dc-search">
                            <i class="fas fa-search"></i>
                            <input type="search" id="txtTileSearch" placeholder="Search tiles…" autocomplete="off" />
                        </div>
                        <span id="dcSelectedCount" class="dc-count-badge">0 / 0 selected</span>
                        <button type="button" class="dc-tool-btn is-primary" id="btnSelectAllTiles">Select all</button>
                        <button type="button" class="dc-tool-btn" id="btnClearAllTiles">Clear</button>
                    </div>
                </div>

                <div class="dc-tiles-panel">
                    <div id="dcTilesLoading" class="dc-tiles-loading">
                        <i class="fas fa-spinner fa-spin"></i> Loading tiles…
                    </div>
                    <div id="dcTilesList" class="dc-tiles-list"></div>
                    <div id="dcTilesEmpty" class="dc-tiles-empty">No tiles found for selected dashboard(s).</div>
                </div>

                <div class="dc-actions">
                    <div class="dc-hint">
                        <i class="fas fa-info-circle"></i>
                        Uncheck → Save. Is page pe woh tiles unchecked aayengi; actual dashboard pe nahi dikhengi.
                    </div>
                    <button type="button" class="dc-btn-save" id="btnSaveDashboardConfig">
                        <i class="fas fa-check"></i>
                        <span id="btnSaveDashboardConfigText">Save Configuration</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
