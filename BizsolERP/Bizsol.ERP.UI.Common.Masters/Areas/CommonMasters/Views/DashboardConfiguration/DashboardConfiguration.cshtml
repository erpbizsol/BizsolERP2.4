                            <i class="fas fa-search"></i>
                            <input type="search" id="txtTileSearch" placeholder="Search tiles…" autocomplete="off" />
                        </div>
                        <button type="button" class="dc-tool-btn is-primary" id="btnSelectAllTiles">
                            <i class="fas fa-check-square"></i> Select all
                        </button>
                        <button type="button" class="dc-tool-btn" id="btnClearAllTiles">
