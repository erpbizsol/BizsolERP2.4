                <div class="dc-actions">
                    <button type="button" class="dc-btn-save" id="btnSaveDashboardConfig">
                        <i class="fas fa-floppy-disk"></i>
                        <span id="btnSaveDashboardConfigText">Save Configuration</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
