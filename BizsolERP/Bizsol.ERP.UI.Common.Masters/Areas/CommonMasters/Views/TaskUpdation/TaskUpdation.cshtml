@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<script type="module" src="~/_content/Bizsol.WebERP.UI.Common.Masters/js/TaskUpdation.js"></script>

<style>
/* ═══════════════════════════════════════════════
   PAGE SHELL
═══════════════════════════════════════════════ */
#TaskUpdationPage {
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    width: 100%;
    box-sizing: border-box;
    padding: 8px 16px 0;
    height: calc(100vh - 174px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: linear-gradient(145deg, #eef2ff 0%, #f5f3ff 50%, #ede9fe 100%);
}

/* ═══════════════════════════════════════════════
   MAIN CARD
═══════════════════════════════════════════════ */
.tu-card {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    border-radius: 20px;
    box-shadow:
        0 20px 60px rgba(99,102,241,.18),
        0 4px 16px rgba(0,0,0,.08);
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.6);
}

/* ═══════════════════════════════════════════════
   ANIMATED HEADER
═══════════════════════════════════════════════ */
.tu-header {
    background: linear-gradient(120deg, #312e81 0%, #4f46e5 30%, #7c3aed 65%, #9333ea 100%);
    background-size: 300% 300%;
    animation: tu-grad-shift 8s ease infinite;
    padding: 16px 24px 0;
    position: relative;
    overflow: hidden;
}

@@keyframes tu-grad-shift {
    0%   { background-position: 0% 50%;   }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%;   }
}

/* decorative circles */
.tu-header::before {
    content: '';
    position: absolute;
    width: 260px; height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,.1) 0%, transparent 70%);
    top: -120px; right: -60px;
    pointer-events: none;
}
.tu-header::after {
    content: '';
    position: absolute;
    width: 180px; height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,.07) 0%, transparent 70%);
    bottom: -40px; left: 20px;
    pointer-events: none;
}

/* top row: icon+title  |  toolbar */
.tu-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
}

.tu-hero-left { display: flex; align-items: center; gap: 16px; }

.tu-hero-icon {
    width: 52px; height: 52px;
    border-radius: 16px;
    background: rgba(255,255,255,.15);
    border: 2px solid rgba(255,255,255,.3);
    display: flex; align-items: center; justify-content: center;
    color: #fff;
    font-size: 22px;
    box-shadow: 0 6px 20px rgba(0,0,0,.2);
    flex-shrink: 0;
    backdrop-filter: blur(6px);
}

.tu-hero-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
    letter-spacing: .3px;
    text-shadow: 0 1px 4px rgba(0,0,0,.2);
}
.tu-hero-sub {
    font-size: 0.75rem;
    color: rgba(255,255,255,.72);
    margin-top: 3px;
}

/* toolbar */
.tu-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
}

.tu-emp-name {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(255,255,255,.14);
    border: 1.5px solid rgba(255,255,255,.28);
    color: #fff;
    font-weight: 700;
    padding: 7px 16px;
    border-radius: 50px;
    font-size: 0.82rem;
    backdrop-filter: blur(8px);
}

.tu-user-select,
.tu-date-picker {
    border: 1.5px solid rgba(255,255,255,.35);
    background: rgba(255,255,255,.92);
    color: #4f46e5;
    font-weight: 700;
    border-radius: 50px;
    padding: 7px 16px;
    font-size: 0.82rem;
    cursor: pointer;
    outline: none;
    box-shadow: 0 3px 10px rgba(0,0,0,.12);
    transition: box-shadow .2s, transform .15s;
    backdrop-filter: blur(4px);
}
.tu-user-select { min-width: 180px; }
.tu-user-select:focus,
.tu-date-picker:focus { box-shadow: 0 0 0 3px rgba(255,255,255,.45); transform: translateY(-1px); }
.tu-user-select:disabled { opacity: 1; cursor: not-allowed; -webkit-text-fill-color: #4f46e5; }

/* ── Stats cards strip (compact) ── */
.tu-stats-strip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 0 10px;
    position: relative;
    z-index: 2;
    flex-wrap: wrap;
}

.tu-stat-card {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(255,255,255,.14);
    border: 1.5px solid rgba(255,255,255,.22);
    border-radius: 50px;
    padding: 5px 14px 5px 8px;
    backdrop-filter: blur(8px);
    transition: background .2s;
}
.tu-stat-card:hover { background: rgba(255,255,255,.22); }

.tu-stat-icon {
    width: 26px; height: 26px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
}
.tu-stat-card.total .tu-stat-icon { background: rgba(255,255,255,.2); color: #fff; }
.tu-stat-card.done  .tu-stat-icon { background: rgba(74,222,128,.3);  color: #4ade80; }
.tu-stat-card.pend  .tu-stat-icon { background: rgba(251,191,36,.3);  color: #fbbf24; }

.tu-stat-num {
    font-size: 1rem;
    font-weight: 900;
    color: #fff;
    line-height: 1;
}
.tu-stat-lbl {
    font-size: 0.68rem;
    color: rgba(255,255,255,.72);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .4px;
}

/* progress bar */
.tu-progress-wrap {
    flex: 1;
    min-width: 100px;
}
.tu-progress-track {
    height: 7px;
    background: rgba(255,255,255,.2);
    border-radius: 50px;
    overflow: hidden;
    position: relative;
}
.tu-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #4ade80, #22d3ee);
    border-radius: 50px;
    transition: width .6s cubic-bezier(.4,0,.2,1);
    width: 0%;
    position: relative;
}
.tu-progress-bar::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,.35) 50%, transparent 100%);
    animation: tu-shimmer 2s infinite;
}
@@keyframes tu-shimmer {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(100%);  }
}
.tu-progress-pct {
    font-size: 0.68rem;
    color: rgba(255,255,255,.75);
    font-weight: 700;
    text-align: right;
    margin-top: 2px;
}

/* ═══════════════════════════════════════════════
   LEGEND BAR
═══════════════════════════════════════════════ */
.tu-legend {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    background: #fff;
    border-bottom: 1px solid #e8edf5;
    flex-wrap: wrap;
}
.tu-legend-label {
    font-size: 10.5px;
    font-weight: 800;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: .8px;
    margin-right: 6px;
}
.tu-leg-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 11px;
    border-radius: 50px;
    font-size: 11px;
    font-weight: 600;
    border: 1.5px solid transparent;
    transition: transform .15s;
}
.tu-leg-pill:hover { transform: translateY(-1px); }
.tu-leg-pill.done { background: #f0fdf4; color: #16a34a; border-color: #bbf7d0; }
.tu-leg-pill.pend { background: #eff6ff; color: #2563eb; border-color: #bfdbfe; }
.tu-leg-pill.lock { background: #fff1f2; color: #dc2626; border-color: #fecaca; }
.tu-leg-pill.wknd { background: #fff7ed; color: #ea580c; border-color: #fed7aa; }
.tu-leg-pill.todaypill { background: #eef2ff; color: #4f46e5; border-color: #c7d2fe; }

/* ═══════════════════════════════════════════════
   GRID WRAPPER
═══════════════════════════════════════════════ */
.tu-grid-wrap {
    background: #fff;
    flex: 1;
    min-height: 0;
    overflow: auto;
}

/* scrollbar */
.tu-grid-wrap::-webkit-scrollbar { width: 6px; height: 6px; }
.tu-grid-wrap::-webkit-scrollbar-track { background: #f8faff; }
.tu-grid-wrap::-webkit-scrollbar-thumb { background: #c7d2fe; border-radius: 50px; }
.tu-grid-wrap::-webkit-scrollbar-thumb:hover { background: #818cf8; }

/* ═══════════════════════════════════════════════
   TABLE
═══════════════════════════════════════════════ */
table.tu-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 12.5px;
}

/* thead – row 1 (month label) */
table.tu-table thead th {
    position: sticky;
    top: 0;
    z-index: 5;
    background: linear-gradient(135deg, #4338ca 0%, #6d28d9 100%);
    color: #fff;
    font-weight: 700;
    padding: 10px 8px;
    text-align: center;
    white-space: nowrap;
    border-right: 1px solid rgba(255,255,255,.12);
    font-size: 12px;
    letter-spacing: .3px;
}

/* thead – row 2 (day numbers) */
table.tu-table thead tr:last-child th {
    padding: 7px 5px;
    font-size: 11px;
    background: linear-gradient(135deg, #3730a3 0%, #5b21b6 100%);
    /* top: 41px; */
}

/* sticky left columns – header */
table.tu-table thead th.tu-col-sno,
table.tu-table thead th.tu-col-task,
table.tu-table thead th.tu-col-freq {
    position: sticky;
    z-index: 8;
}
table.tu-table thead th.tu-col-sno  { left: 0;     min-width: 46px;  width: 46px;  text-align: center; }
table.tu-table thead th.tu-col-task { left: 46px;  min-width: 260px; text-align: left; padding-left: 14px; }
table.tu-table thead th.tu-col-freq { left: 306px; min-width:323px; text-align: left; padding-left: 12px; }

/* tbody */
table.tu-table tbody tr {
    transition: all .14s ease;
}
table.tu-table tbody tr:hover td { background: #f0f4ff !important; }

table.tu-table tbody td {
    border-bottom: 1px solid #eef1f8;
    border-right: 1px solid #eef1f8;
    padding: 0 4px;
    height: 38px;
    text-align: center;
    vertical-align: middle;
}

/* sticky body columns */
table.tu-table tbody td.tu-col-sno,
table.tu-table tbody td.tu-col-task,
table.tu-table tbody td.tu-col-freq {
    position: sticky;
    z-index: 3;
    background: #fff;
    transition: background .14s;
}
table.tu-table tbody tr:nth-child(even) td.tu-col-sno,
table.tu-table tbody tr:nth-child(even) td.tu-col-task,
table.tu-table tbody tr:nth-child(even) td.tu-col-freq { background: #fafbff; }

/* S.No bubble */
table.tu-table tbody td.tu-col-sno {
    left: 0;
    width: 46px;
    border-right: 2px solid #e0e7ff;
    padding: 0;
}
.tu-sno-bubble {
    width: 26px; height: 26px;
    border-radius: 8px;
    background: linear-gradient(135deg, #ede9fe, #ddd6fe);
    color: #6d28d9;
    font-weight: 800;
    font-size: 11px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 3px rgba(109,40,217,.15);
}

/* Task cell */
table.tu-table tbody td.tu-col-task {
    left: 46px;
    text-align: left;
    padding-left: 0;
    border-right: 1px solid #e8edf5;
}
.tu-task-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 8px 0 10px;
}
.tu-task-bar {
    width: 3px;
    height: 22px;
    border-radius: 4px;
    background: linear-gradient(180deg, #818cf8, #c4b5fd);
    flex-shrink: 0;
}
.tu-task-name {
    font-weight: 600;
    color: #1e293b;
    font-size: 12.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 220px;
}

/* Frequency cell */
table.tu-table tbody td.tu-col-freq {
    left: 306px;
    text-align: left;
    padding-left: 12px;
    border-right: 2px solid #e0e7ff;
}
.tu-freq-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
    border: 1.5px solid transparent;
}
.tu-freq-badge.daily   { background: #ede9fe; color: #7c3aed; border-color: #ddd6fe; }
.tu-freq-badge.weekly  { background: #dbeafe; color: #1d4ed8; border-color: #bfdbfe; }
.tu-freq-badge.monthly { background: #fce7f3; color: #be185d; border-color: #fbcfe8; }
.tu-freq-badge.other   { background: #f0fdf4; color: #15803d; border-color: #bbf7d0; }

/* Day cells */
.tu-day-cell {
    width: 62px; min-width: 62px;
    background: #f5f3ff;
}
.tu-day-cell.tu-weekend {
    background: linear-gradient(180deg, #fff7ed, #ffedd5) !important;
}
.tu-day-cell.tu-past {
    background: linear-gradient(180deg, #fff1f2, #ffe4e6) !important;
}
.tu-day-cell.tu-done {
    background: linear-gradient(180deg, #dcfce7, #bbf7d0) !important;
}
.tu-day-cell.tu-today {
    background: linear-gradient(180deg, #ede9fe, #ddd6fe) !important;
    box-shadow: inset 0 0 0 2px #8b5cf6;
}

/* Override: thead th must always keep the dark header gradient, never the body cell colour */
table.tu-table thead th.tu-day-cell {
    background: linear-gradient(135deg, #3730a3 0%, #5b21b6 100%) !important;
    box-shadow: none !important;
    color: #fff !important;
}

/* Today column header */
table.tu-table thead th.tu-today-hdr {
    background: linear-gradient(135deg, #7c3aed, #a855f7) !important;
    box-shadow: inset 0 -3px 0 #c084fc !important;
    font-weight: 900 !important;
    color: #fff !important;
}

/* ── Custom checkbox ── */
.tu-chk-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
}
.tu-chk {
    appearance: none;
    -webkit-appearance: none;
    width: 22px; height: 22px;
    border: 2px solid #a78bfa;
    border-radius: 6px;
    cursor: pointer;
    background: rgba(255,255,255,.85);
    transition: all .18s ease;
    position: relative;
    flex-shrink: 0;
    box-shadow: 0 1px 4px rgba(139,92,246,.15);
}
.tu-chk:hover:not(:disabled) {
    border-color: #7c3aed;
    background: #ede9fe;
    box-shadow: 0 0 0 3px rgba(124,58,237,.2);
    transform: scale(1.12);
}
.tu-chk:checked {
    background: linear-gradient(135deg, #059669, #10b981);
    border-color: #059669;
    box-shadow: 0 3px 10px rgba(5,150,105,.4);
}
.tu-chk:checked::after {
    content: '';
    position: absolute;
    left: 6px; top: 2px;
    width: 7px; height: 12px;
    border: 2.5px solid #fff;
    border-top: none;
    border-left: none;
    transform: rotate(45deg);
}
.tu-chk:disabled {
    cursor: not-allowed;
    opacity: 0.45;
    background: #f8fafc;
    border-color: #cbd5e1;
    box-shadow: none;
}
.tu-chk:disabled:checked {
    background: linear-gradient(135deg, #6ee7b7, #34d399);
    border-color: #6ee7b7;
    opacity: 0.7;
}

/* ── Empty state ── */
.tu-empty {
    text-align: center;
    padding: 70px 20px;
    color: #94a3b8;
    font-size: 13px;
}
.tu-empty i { font-size: 2.5rem; display: block; margin-bottom: 12px; color: #c7d2fe; }
</style>

<div id="TaskUpdationPage">
    <div class="tu-card">

        <!-- ════ HEADER ════ -->
        <div class="tu-header">
            <div class="tu-header-top">
                <div class="tu-hero-left">
                    <div class="tu-hero-icon"><i class="fas fa-calendar-check"></i></div>
                    <div>
                        <div class="tu-hero-title">Task Updation</div>
                        <div class="tu-hero-sub">Mark your daily work-to-do completion</div>
                    </div>
                </div>
                <div class="tu-toolbar">
                    <span class="tu-emp-name" id="tuEmpName"><i class="fas fa-user-circle"></i>&nbsp;--</span>
                    <select class="tu-user-select" id="tuUserSelect" title="Select user" style="display:none;"></select>
                    <input type="date" class="tu-date-picker" id="tuDatePicker" title="Pick a date" />
                </div>
            </div>

            <!-- Stat cards + progress -->
            <div class="tu-stats-strip">
                <div class="tu-stat-card total">
                    <div class="tu-stat-icon"><i class="fas fa-layer-group"></i></div>
                    <div>
                        <div class="tu-stat-num" id="tuStatTotal">0</div>
                        <div class="tu-stat-lbl">Total Tasks</div>
                    </div>
                </div>
                <div class="tu-stat-card done">
                    <div class="tu-stat-icon"><i class="fas fa-circle-check"></i></div>
                    <div>
                        <div class="tu-stat-num" id="tuStatDone">0</div>
                        <div class="tu-stat-lbl">Completed</div>
                    </div>
                </div>
                <div class="tu-stat-card pend">
                    <div class="tu-stat-icon"><i class="fas fa-hourglass-half"></i></div>
                    <div>
                        <div class="tu-stat-num" id="tuStatPending">0</div>
                        <div class="tu-stat-lbl">Pending</div>
                    </div>
                </div>
                <div class="tu-progress-wrap">
                    <div class="tu-progress-track">
                        <div class="tu-progress-bar" id="tuProgressBar"></div>
                    </div>
                    <div class="tu-progress-pct" id="tuProgressPct">0% done</div>
                </div>
            </div>
        </div>

        <!-- ════ LEGEND ════ -->
        <div class="tu-legend">
            <span class="tu-legend-label">Legend</span>
            <span class="tu-leg-pill done"><i class="fas fa-circle-check"></i> Done</span>
            <span class="tu-leg-pill pend"><i class="fas fa-circle-dot"></i> Pending</span>
            <span class="tu-leg-pill lock"><i class="fas fa-lock"></i> Locked</span>
            <span class="tu-leg-pill wknd"><i class="fas fa-umbrella-beach"></i> Weekend</span>
            <span class="tu-leg-pill todaypill"><i class="fas fa-calendar-day"></i> Today</span>
        </div>

        <!-- ════ GRID ════ -->
        <div class="tu-grid-wrap">
            <table class="tu-table" id="tuTable">
                <thead id="tuTableHead"></thead>
                <tbody id="tuTableBody">
                    <tr>
                        <td class="tu-empty" colspan="4">
                            <i class="fas fa-spinner fa-spin"></i>
                            Loading task calendar…
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>
