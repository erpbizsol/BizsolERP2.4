@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<script type="module" src="~/_content/Bizsol.WebERP.UI.Common.Masters/js/UserDashboardMenu.js?v=20260903d"></script>
<style>
    #UserDashboardMenuPage {
        --udm-ink: var(--text-dark, #1e293b);
        --udm-body: var(--text-primary, #334155);
        --udm-muted: var(--text-muted, #64748b);
        --udm-line: var(--border-color, #e2e8f0);
        --udm-primary: var(--accent-primary, #667eea);
        --udm-surface: var(--white-bg, #ffffff);
        --udm-bg: var(--light-bg, #f0f4f8);
        --udm-brand: var(--primary-gradient, linear-gradient(135deg, #667eea 0%, #764ba2 100%));
        --udm-shadow: var(--shadow-md, 0 4px 16px rgba(0,0,0,.08));
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        padding: 16px 16px 32px;
        color: var(--udm-body);
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        background:
            radial-gradient(ellipse 80% 60% at 0% 0%, rgba(102,126,234,.12) 0%, transparent 55%),
            radial-gradient(ellipse 70% 50% at 100% 0%, rgba(118,75,162,.1) 0%, transparent 50%),
            var(--udm-bg);
        min-height: calc(100vh - var(--erp-header-height, 55px) - var(--erp-footer-height, 34px));
    }

    #UserDashboardMenuPage *,
    #UserDashboardMenuPage *::before,
    #UserDashboardMenuPage *::after { box-sizing: border-box; }

    .udm-card-wrap {
        background: var(--udm-surface);
        border-radius: 16px;
        border: 1px solid rgba(102,126,234,.18);
        box-shadow: 0 8px 32px rgba(102,126,234,.1), var(--udm-shadow);
        overflow: hidden;
    }

    .udm-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 16px 22px;
        background: var(--udm-brand);
        box-shadow: var(--shadow-primary, 0 8px 24px rgba(102,126,234,.3));
    }

    .udm-header-left { display: flex; align-items: center; gap: 14px; }
    .udm-header-icon {
        width: 44px; height: 44px; border-radius: 12px;
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.32);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 17px;
    }
    .udm-header-title { margin: 0; font-size: 1.25rem; font-weight: 800; color: #fff; letter-spacing: -.02em; }
    .udm-header-sub { margin: 2px 0 0; font-size: 12px; color: rgba(255,255,255,.78); font-weight: 500; }

    .udm-header-badge {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 6px 12px; border-radius: 999px;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.28);
        color: #fff; font-size: 12px; font-weight: 700;
    }

    .udm-body { padding: 20px 22px 24px; }

    .udm-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .udm-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 16px 16px 14px;
        min-height: 88px;
        text-decoration: none;
        color: inherit;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        border-left: 4px solid var(--udm-accent, #667eea);
        box-shadow: 0 2px 8px rgba(15,23,42,.04);
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }
    .udm-card:hover {
        transform: translateY(-2px);
        border-color: #c7d2fe;
        box-shadow: 0 8px 20px rgba(102,126,234,.14);
        text-decoration: none;
        color: inherit;
    }
    .udm-card.is-disabled {
        opacity: .65;
        cursor: not-allowed;
        transform: none;
    }
    .udm-card.is-default {
        border-color: #fcd34d;
        box-shadow: 0 4px 16px rgba(217, 119, 6, .14);
    }
    .udm-default-badge {
        display: inline-block;
        margin-left: 8px;
        padding: 1px 7px;
        border-radius: 999px;
        background: #fef3c7;
        border: 1px solid #fcd34d;
        color: #92400e;
        font-size: 10px;
        font-style: normal;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
        vertical-align: middle;
    }

    .udm-accent-0 { --udm-accent: #667eea; --udm-soft: #eef2ff; }
    .udm-accent-1 { --udm-accent: #0284c7; --udm-soft: #e0f2fe; }
    .udm-accent-2 { --udm-accent: #059669; --udm-soft: #d1fae5; }
    .udm-accent-3 { --udm-accent: #d97706; --udm-soft: #fef3c7; }
    .udm-accent-4 { --udm-accent: #db2777; --udm-soft: #fce7f3; }
    .udm-accent-5 { --udm-accent: #7c3aed; --udm-soft: #ede9fe; }

    .udm-card-icon {
        width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--udm-soft, #eef2ff);
        color: var(--udm-accent, #667eea);
        font-size: 16px;
    }
    .udm-card-body { flex: 1; min-width: 0; }
    .udm-card-title {
        display: block;
        font-size: 15px; font-weight: 800; color: var(--udm-ink);
        line-height: 1.3;
    }
    .udm-card-go {
        width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--udm-soft, #eef2ff);
        color: var(--udm-accent, #667eea);
        font-size: 12px;
    }

    .udm-loading, .udm-empty {
        display: none;
        text-align: center;
        padding: 48px 16px;
        color: var(--udm-muted);
        font-weight: 600;
    }
    .udm-loading i, .udm-empty i { display: block; font-size: 28px; margin-bottom: 12px; color: var(--udm-primary); }

    @@media (max-width: 1100px) {
        .udm-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media (max-width: 640px) {
        #UserDashboardMenuPage { padding: 10px 10px 20px; }
        .udm-body { padding: 14px; }
        .udm-grid { grid-template-columns: 1fr; }
        .udm-header { padding: 14px 16px; }
    }
</style>

<div id="UserDashboardMenuPage">
    <div class="udm-card-wrap">
        <div class="udm-header">
            <div class="udm-header-left">
                <div class="udm-header-icon"><i class="fas fa-gauge-high"></i></div>
                <div>
                    <h1 class="udm-header-title" id="ERPHeading">User Dashboard Menu</h1>
                    <p class="udm-header-sub">Your default dashboard opens first. Click another name to switch.</p>
                </div>
            </div>
            <div class="udm-header-badge">
                <i class="fas fa-user"></i>
                User Code <span id="udm-user-code">—</span>
                <span>·</span>
                <span id="udm-count">0</span> dashboard(s)
            </div>
        </div>
        <div class="udm-body">
            <div id="udm-loading" class="udm-loading">
                <i class="fas fa-spinner fa-spin"></i>
                Loading your dashboards…
            </div>
            <div id="udm-empty" class="udm-empty">
                <i class="fas fa-inbox"></i>
                <div id="udm-empty-text">No dashboard is assigned to your user.</div>
            </div>
            <div id="udm-grid" class="udm-grid" style="display:none;"></div>
        </div>
    </div>
</div>
