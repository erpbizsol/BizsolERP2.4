@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<style>
    .im-page-wrapper { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; padding: 0 18px 30px; background: #f1f3fb; min-height: 100%; }
    .im-card { background: #fff; border-radius: 16px; border: 1px solid #e5e7f0; box-shadow: 0 4px 24px rgba(99,102,241,0.09); overflow: hidden; }
    .im-card-header { background: linear-gradient(130deg, #5b5ef4 0%, #8b5cf6 55%, #a855f7 100%); padding: 14px 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; position: relative; overflow: hidden; }
    .im-header-left { display: flex; align-items: center; gap: 14px; position: relative; z-index: 1; }
    .im-header-icon { width: 46px; height: 46px; border-radius: 13px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 20px; }
    .im-header-title { color: #fff; font-size: 18px; font-weight: 700; }
    .im-btn-new { display: inline-flex; align-items: center; gap: 8px; padding: 9px 20px; border-radius: 999px; border: 2px solid rgba(255,255,255,0.48); background: rgba(255,255,255,0.14); color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; position: relative; z-index: 1; }
    .im-card-body { padding: 18px 20px 26px; }
    .im-table-wrapper { border-radius: 12px; border: 1px solid #e4e7f0; overflow: auto; height: 388px; background: #fff; box-shadow: 0 2px 12px rgba(91,94,244,0.06); }
    .im-table-wrapper thead th { position: sticky; top: 0; z-index: 10; background: linear-gradient(90deg, #6f5bf5 0%, #7c6ef7 100%) !important; color: #fff !important; font-size: 11.5px !important; font-weight: 700 !important; padding: 5px 14px !important; text-transform: none; }
    .im-table-wrapper td { padding: 5px 10px !important; font-size: 13px; border-bottom: 1px solid #f0f2f9; }
    #MaintenanceTypeMasterGrid th:first-child,
    #MaintenanceTypeMasterGrid td:first-child {
        width: 52px !important;
        max-width: 56px !important;
        min-width: 48px !important;
        text-align: center !important;
        white-space: nowrap;
        padding-left: 6px !important;
        padding-right: 6px !important;
    }
    tbody tr:nth-child(even) { background: #f8f9ff; }
    tbody tr:hover { background: linear-gradient(90deg, #eef0ff, #f3f4ff) !important; }
    .im-btn-view, .im-btn-edit, .im-btn-delete { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 6px; border: none; cursor: pointer; font-size: 11px; margin-right: 2px; }
    .im-btn-edit { background: #eef2ff; color: #5b5ef4; }
    .im-btn-delete { background: #fef2f2; color: #ef4444; }
    .im-btn-new:disabled,
    .im-btn-view:disabled, .im-btn-edit:disabled, .im-btn-delete:disabled {
        opacity: 0.42; cursor: not-allowed; pointer-events: none;
        transform: none !important; box-shadow: none !important;
    }
    .im-btn-view.im-btn-verify,
    .im-btn-view.im-btn-verified-mark { padding: 0; line-height: 1; vertical-align: middle; }
    .im-btn-view.im-btn-verify { background: #f1f5f9; color: #1f2937; }
    .im-btn-view.im-btn-verify:hover { background: #eef2ff; }
    .im-btn-view.im-btn-verify i { font-size: 17px; display: block; }
    .im-btn-view.im-btn-verified-mark { cursor: default; opacity: 1 !important; background: transparent; color: #16a34a; pointer-events: auto; }
    .im-btn-view.im-btn-verified-mark i { font-size: 18px; display: block; }
    .im-backdrop { position: fixed; inset: 0; background: rgba(8,12,36,0.54); backdrop-filter: blur(5px); display: none; align-items: center; justify-content: center; z-index: 1060; padding: 24px 16px; overflow-y: auto; }
    .im-backdrop.show { display: flex !important; }
    .im-modal { width: 560px; max-width: calc(100vw - 20px); background: #fff; border-radius: 18px; box-shadow: 0 20px 56px rgba(8,12,36,0.24); display: flex; flex-direction: column; overflow: hidden; animation: im-up 0.24s cubic-bezier(0.34,1.46,0.64,1); }
    @@keyframes im-up { from { transform: translateY(22px) scale(0.97); opacity: 0; } to { transform: translateY(0) scale(1); opacity: 1; } }
    .im-modal-header { background: linear-gradient(130deg, #5b5ef4, #a855f7); padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; position: relative; overflow: hidden; }
    .im-modal-header-title { color: #fff; font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 9px; position: relative; z-index: 1; }
    .im-modal-close { width: 30px; height: 30px; border-radius: 50%; border: none; background: rgba(255,255,255,0.18); color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; position: relative; z-index: 1; }
    .im-modal-body { padding: 20px 22px 14px; overflow-y: auto; }
    .im-form-grid { display: grid; grid-template-columns: 1fr; gap: 14px 16px; }
    .im-form-group { display: flex; flex-direction: column; gap: 5px; }
    .im-form-group label { font-size: 11px; font-weight: 700; color: #4b5563; letter-spacing: 0.04em; text-transform: uppercase; }
    .im-required { color: #ef4444; margin-left: 2px; }
    .im-input { width: 100%; padding: 9px 12px; border-radius: 9px; border: 1.5px solid #dde0ee; font-size: 13px; color: #111827; background: #f8f9fc; outline: none; }
    .im-input:focus { border-color: #5b5ef4; box-shadow: 0 0 0 3px rgba(91,94,244,0.12); background: #fff; }
    .im-input.im-input-error { border-color: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,0.10); }
    .im-input[readonly] { background: #f3f4f6; color: #6b7280; cursor: not-allowed; }
    .im-err-text { font-size: 11px; color: #ef4444; display: none; align-items: center; gap: 4px; }
    .im-modal-footer { padding: 12px 22px 18px; display: flex; justify-content: flex-end; align-items: center; gap: 10px; border-top: 1px solid #f0f1f8; }
    .im-btn-cancel { padding: 8px 20px; border-radius: 999px; border: 1.5px solid #d4d7e8; background: #fff; color: #374151; font-size: 13px; font-weight: 500; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .im-btn-save { padding: 8px 20px; border-radius: 999px; border: none; background: linear-gradient(130deg, #5b5ef4, #a855f7); color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; box-shadow: 0 5px 16px rgba(91,94,244,0.34); display: inline-flex; align-items: center; gap: 7px; }
    .im-delete-modal { width: 370px; max-width: calc(100vw - 20px); background: #fff; border-radius: 18px; box-shadow: 0 20px 56px rgba(8,12,36,0.24); text-align: center; padding: 32px 24px 24px; animation: im-up 0.24s cubic-bezier(0.34,1.46,0.64,1); }
    .im-delete-icon-wrap { width: 62px; height: 62px; border-radius: 50%; background: linear-gradient(135deg, #fef2f2, #fee2e2); display: flex; align-items: center; justify-content: center; font-size: 26px; color: #ef4444; margin: 0 auto 14px; }
    .im-delete-title { font-size: 17px; font-weight: 700; color: #111827; margin-bottom: 7px; }
    .im-delete-text { font-size: 13px; color: #6b7280; line-height: 1.5; margin-bottom: 22px; }
    .im-delete-actions { display: flex; gap: 10px; justify-content: center; }
    .im-delete-reason { margin: 0 0 18px; text-align: left; }
    .im-delete-reason-label { display: flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; color: #4b5563; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 6px; }
    .im-delete-reason-input { width: 100%; padding: 9px 12px; border-radius: 9px; border: 1.5px solid #dde0ee; font-size: 13px; color: #111827; background: #f8f9fc; outline: none; }
    .im-btn-confirm-delete { padding: 9px 22px; border-radius: 999px; border: none; background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
</style>

<div class="im-page-wrapper">
    <span id="ERPHeading" style="display:none"></span>
    <div class="im-card">
        <div class="im-card-header">
            <div class="im-header-left">
                <div class="im-header-icon"><i class="fas fa-screwdriver-wrench"></i></div>
                <div class="im-header-title">Maintenance Type Master</div>
            </div>
            <button type="button" id="btnNewMaintenanceType" class="im-btn-new">
                <i class="fas fa-plus"></i><span>New</span>
            </button>
        </div>
        <div class="im-card-body">
            <div id="tblMaintenanceTypeMaster">
                <div class="im-table-wrapper table-wrapper">
                    <table id="MaintenanceTypeMasterGrid" style="width:100%;border-collapse:collapse;font-size:13px;">
                        <thead id="MaintenanceTypeMaster-header"></thead>
                        <tbody id="MaintenanceTypeMaster-body"></tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-MaintenanceTypeMasterGrid"></div>
            </div>
        </div>
    </div>
</div>

<div id="maintenanceTypeDialogBackdrop" class="im-backdrop">
    <div class="im-modal" id="maintenanceTypeFormContainer">
        <div class="im-modal-header">
            <div class="im-modal-header-title">
                <i class="fas fa-screwdriver-wrench"></i>
                <span id="formModalTitle">Add New Maintenance Type</span>
            </div>
            <button type="button" class="im-modal-close" id="btnModalClose" title="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="im-modal-body">
            <div class="im-form-grid">
                <div class="im-form-group">
                    <label for="txtMaintenanceTypeName">Maintenance Type (Ex:- ????) <span class="im-required">*</span></label>
                    <input type="text" id="txtMaintenanceTypeName" class="im-input" maxlength="100" autocomplete="off" placeholder="Enter maintenance type name" />
                    <span class="im-err-text" id="err_MaintenanceTypeName"><i class="fas fa-circle-exclamation"></i> Maintenance Type is required.</span>
                </div>
                <div class="im-form-group">
                    <label for="txtDesp">Description <span class="im-required">*</span></label>
                    <input type="text" id="txtDesp" class="im-input" maxlength="500" autocomplete="off" placeholder="Enter description" />
                    <span class="im-err-text" id="err_Desp"><i class="fas fa-circle-exclamation"></i> Description is required.</span>
                </div>
            </div>
        </div>
        <div class="im-modal-footer">
            <button type="button" class="im-btn-cancel" id="btnCancelMaintenanceType">
                <i class="fas fa-times"></i> Cancel
            </button>
            <button type="button" class="im-btn-save" id="btnSaveMaintenanceType">
                <i class="fas fa-floppy-disk"></i>
                <span id="btnSaveText">Save Maintenance Type</span>
            </button>
        </div>
    </div>
</div>

<div id="deleteConfirmBackdrop" class="im-backdrop">
    <div class="im-delete-modal">
        <div class="im-delete-icon-wrap"><i class="fas fa-trash-can"></i></div>
        <div class="im-delete-title">Delete this Maintenance Type?</div>
        <div class="im-delete-text">This action cannot be undone.<br>The record will be permanently removed.</div>
        <div class="im-delete-reason">
            <label class="im-delete-reason-label">
                <i class="fas fa-comment-dots"></i> Reason for Delete <span class="im-required">*</span>
            </label>
            <input type="text" id="reasonForDeleteInput" class="im-delete-reason-input" placeholder="Enter reason for deletion…" autocomplete="off" maxlength="500" />
        </div>
        <div class="im-delete-actions">
            <button type="button" class="im-btn-cancel" id="btnCancelDelete"><i class="fas fa-times"></i> Cancel</button>
            <button type="button" class="im-btn-confirm-delete" onclick="DoDeleteMaintenanceType()"><i class="fas fa-trash-can"></i> Yes, Delete</button>
        </div>
    </div>
</div>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Common.Masters/js/MaintenanceTypeMaster.js?v=maintenance-type-v26"></script>
