<div>
    <div class="row">
        <div class="col-md-6 form-group">
            <label><b>Country Name</b></label>
            <input type="text" Id="txtCode" class="form-control" value="0" style="display:none" autocomplete="off" tabindex="0" />
            <select id="ddlCountry" class="form-control"></select>
        </div>
        <div class="col-md-6">
            <label><b>State Name</b></label>
            <input type="text" Id="txtState" class="form-control" placeholder="State" autocomplete="off" tabindex="0" />
        </div>
        <div class="col-md-6">
            <label><b>State Initial</b></label>
            <input type="text" Id="txtStateInitial" class="form-control" minlength="2" maxlength="2" autocomplete="off" placeholder="State Initial" tabindex="1" />
        </div>
        <div class="col-md-6">
            <label><b>State Code</b></label>
            <input type="text" Id="txtStateCode" class="form-control" maxlength="2" placeholder="State Code" autocomplete="off" onkeypress="allowNumberOnly(event)" tabindex="2" />
        </div>
       
    </div>

    <div class="row mt-5">
        <div class="col-md-8" style="margin: 0 auto">
            <div class="row">
                <div class="col-md-5 toolbar">
                    <button id="First" onclick="First()" class="btn btn-success nav-btn">
                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true" width="24" height="24">
                            <path d="M18.41 16.59L13.82 12l4.59-4.59L17 6l-6 6 6 6zM6 6h2v12H6z"></path>
                        </svg>
                    </button>
                    <button id="Previous" onclick="Previous()" class="btn btn-success nav-btn">
                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true" width="24" height="24">
                            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path>
                        </svg>
                    </button>
                    <button id="Next" onclick="Next()" class="btn btn-success nav-btn">
                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true" width="24" height="24">
                            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"></path>
                        </svg>
                    </button>
                    <button id="Last" onclick="Last()" class="btn btn-success nav-btn">
                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true" width="24" height="24">
                            <path d="M5.59 7.41L10.18 12l-4.59 4.59L7 18l6-6-6-6zM16 6h2v12h-2z"></path>
                        </svg>
                    </button>
                </div>
                <div class="col-md-7 toolbar ">
                    <button id="btnSave" onclick="Save()" class="btn btn-success nav-btn">
                        <svg width="24" height="24" viewBox="0 0 24 24" style="fill: rgba(0, 0, 0, 1);">
                            <path d="M5 21h14a2 2 0 0 0 2-2V8a1 1 0 0 0-.29-.71l-4-4A1 1 0 0 0 16 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2zm10-2H9v-5h6zM13 7h-2V5h2zM5 5h2v4h8V5h.59L19 8.41V19h-2v-5a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2v5H5z"></path>
                        </svg>
                     </button>
                    <button id="btnDelete" onclick="Delete()" class="btn btn-danger nav-btn">
                        <svg width="24" height="24" viewBox="0 0 24 24" style="fill: rgba(0, 0, 0, 1);">
                            <path d="M6 7H5v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7H6zm4 12H8v-9h2v9zm6 0h-2v-9h2v9zm.618-15L15 2H9L7.382 4H3v2h18V4z"></path>
                        </svg>
                    </button>
                    <button id="btnBack" onclick="Back()" class="btn btn-success nav-btn">
                        <svg width="24" height="24" viewBox="0 0 24 24" style="fill: rgba(0, 0, 0, 1);">
                            <path d="M19 21a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14zM12 7v4h5v2h-5v4l-5-5 5-5z"></path>
                        </svg>
                    </button>
                    <button id="btnPrint" onclick="Print()" class="btn btn-success nav-btn">
                        <svg width="24" height="24" viewBox="0 0 24 24" style="fill: rgba(0, 0, 0, 1);">
                            <path d="M19 7h-1V2H6v5H5c-1.654 0-3 1.346-3 3v7c0 1.103.897 2 2 2h2v3h12v-3h2c1.103 0 2-.897 2-2v-7c0-1.654-1.346-3-3-3zM8 4h8v3H8V4zm8 16H8v-4h8v4zm4-3h-2v-3H6v3H4v-7c0-.551.449-1 1-1h14c.552 0 1 .449 1 1v7z"></path>
                            <path d="M14 10h4v2h-4z"></path>
                        </svg>
                    </button>
                    <button id="btnAttachment" onclick="ViewAttachment()" class="btn btn-success nav-btn">
                        <svg width="24" height="24" viewBox="0 0 24 24" style="fill: rgba(0, 0, 0, 1);">
                            <path d="M19.903 8.586a.997.997 0 0 0-.196-.293l-6-6a.997.997 0 0 0-.293-.196c-.03-.014-.062-.022-.094-.033a.991.991 0 0 0-.259-.051C13.04 2.011 13.021 2 13 2H6c-1.103 0-2 .897-2 2v16c0 1.103.897 2 2 2h12c1.103 0 2-.897 2-2V9c0-.021-.011-.04-.013-.062a.952.952 0 0 0-.051-.259c-.01-.032-.019-.063-.033-.093zM16.586 8H14V5.414L16.586 8zM6 20V4h6v5a1 1 0 0 0 1 1h5l.002 10H6z"></path>
                            <path d="M8 12h8v2H8zm0 4h8v2H8zm0-8h2v2H8z"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/assets/script/filter.js"></script>
<script>
    const queryString = window.location.search;
    const urlParams = new URLSearchParams(queryString);
    let editValue = urlParams.get('Edit');
    let currentIndex = urlParams.get('Index');
    let codeValues = JSON.parse(decodeURIComponent(urlParams.get('codeValues')));
    const authToken = '{"ERPDBConStr":"Data Source=220.158.165.98,65446;Connection Timeout=0;Persist Security Info=true;Initial Catalog=BizSolERPDBBizDev; User ID=sa;pwd=biz1981;Packet Size=32000","ERPMainDBConStr":"data source = 220.158.165.98,65446; initial catalog = BizSolERPMainDB_BizDev; uid = sa; PWD = biz1981; Max Pool Size = 5000","ERPDMSDBConStr":"data source = 220.158.165.98,65446; initial catalog = BizSolERPDMSDB_BizDev; uid = sa; PWD = biz1981; Max Pool Size = 5000","ERPDB_Name":"BizSolERPDBBizDev","ERPMainDB_Name":"BizSolERPMainDB_BizDev","ERPDMSDB_Name":"BizSolERPDMSDB_BizDev","AuthToken":"xyz","UserMaster_Code":"145","CompanyCode":"104"}';

    $(document).ready(function () {
        $('#ddlCountry').on('keydown', function (e) {
            if (e.key === "Enter") {
                $("#txtState").focus();
            }
        });
        $('#txtState').on('keydown', function (e) {
            if (e.key === "Enter") {
                $("#txtStateInitial").focus();
            }
        });
        $('#txtStateInitial').on('keydown', function (e) {
            if (e.key === "Enter") {
                $("#txtStateCode").focus();
            }
        });
        $('#txtStateCode').on('keydown', function (e) {
            if (e.key === "Enter") {
                $("#ddlCountry").focus();
            }
        });

       

        $.ajax({
            url: 'https://web.bizsol.in/erpapidev/api/Country/GetCountryMasterList',
            type: 'GET',
            contentType: 'json',
            beforeSend: function (xhr) {
                xhr.setRequestHeader('Auth-Key', authToken);
            },
            success: function (response) {
                data = response;
                let Country = '';
                const rows = data.map(item => {
                    return `<option>${item.CountryName}</option > `;
                }).join('');
                $('#ddlCountry').html(rows);
            },
            error: function (error) {
                console.error('Error fetching data:', error);
            }
        });
        if (editValue != null && editValue != '') {
            EditData(editValue)
        } else {
            NavigationButtonsControll();
            ClearData();
        }
    });

    function displayCode() {
        $('#currentCode').text(codeValues[currentIndex]);
        EditData(codeValues[currentIndex]);
        toggleNavigationButtons()
    }

    function First() {
        currentIndex = 0;
        displayCode();
    };

    function Previous() {
        if (currentIndex > 0) {
            currentIndex--;
            displayCode();
        }
    };

    function Next() {
        if (currentIndex < codeValues.length - 1) {
            currentIndex++;
            displayCode();
        }
    };

    function Last() {
        currentIndex = codeValues.length - 1;
        displayCode();
    };

    function EditData(editValue) {
        $.ajax({
            url: 'https://web.bizsol.in/erpapidev/api/State/' + editValue,
            type: 'GET',
            contentType: 'json',
            beforeSend: function (xhr) {
                xhr.setRequestHeader('Auth-Key', authToken);
            },
            success: function (response) {
                if (response) {
                    $("#txtCode").val(response.Code);
                    $("#ddlCountry").val(response.CountryName);
                    $("#txtState").val(response.StateName);
                    $("#txtStateInitial").val(response.StateShortName);
                    $("#txtStateCode").val(response.StateCode);
                } else {
                    alert('No states found.');
                }
            },
            error: function (error) {
                console.error('Error fetching data:', error);
            }
        });
    }

    function Save() {
        var Data = {
            Code: $("#txtCode").val(),
            CountryName: $("#ddlCountry").val(),
            StateName: $("#txtState").val(),
            StateShortName: $("#txtStateInitial").val(),
            StateCode: $("#txtStateCode").val()
        };

        $.ajax({
            url: 'https://web.bizsol.in/erpapidev/api/State/SaveStateMaster',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(Data),
            beforeSend: function (xhr) {
                xhr.setRequestHeader('Auth-Key', authToken);
            },
            success: function (response) {
                if (response) {
                    alert(response.Msg);
                    Back();
                } else {
                    alert('No states found.');
                }
            },
            error: function (error) {
                console.error('Error saving data:', error);
            }
        });
    }

    function Delete() {
        var code = $("#txtCode").val();
        $.ajax({
            url: `https://web.bizsol.in/erpapidev/api/State/DeleteStateMaster?Code=${code}&UserMaster_Code=145&ReasonForDelete=Test&IPAddress=1&Location=1`,
            type: 'Post',
            contentType: 'application/json',
            beforeSend: function (xhr) {
                xhr.setRequestHeader('Auth-Key', authToken);
            },
            success: function (response) {
                if (response) {
                    Back();
                    alert(response.Msg);
                } else {
                    alert('No states found.');
                }
            },
            error: function (error) {
                console.error('Error deleting data:', error);
            }
        });
    }

    function Back() {
        window.location.href = '/CommonMasters/statemaster/StateList';
    }

    function ClearData() {
        $("#txtCode").val('0');
        $("#ddlCountry").val('');
        $("#txtState").val('');
        $("#txtStateInitial").val('');
        $("#txtStateCode").val('');
    }

    function toggleNavigationButtons() {
        if (currentIndex === 0) {
            $('#First').prop('disabled', true);
            $('#Previous').prop('disabled', true);
        } else {
            $('#First').prop('disabled', false);
            $('#Previous').prop('disabled', false);
        }

        if (currentIndex === codeValues.length - 1) {
            $('#Next').prop('disabled', true);
            $('#Last').prop('disabled', true);
        } else {
            $('#Next').prop('disabled', false);
            $('#Last').prop('disabled', false);
        }
    }
    function NavigationButtonsControll(){
        $('#First').prop('disabled', true);
        $('#Previous').prop('disabled', true);
        $('#Next').prop('disabled', true);
        $('#Last').prop('disabled', true);
        $('#btnDelete').prop('disabled', true);
        $('#btnPrint').prop('disabled', true);
        $('#btnAttachment').prop('disabled', true);
    }
</script>
