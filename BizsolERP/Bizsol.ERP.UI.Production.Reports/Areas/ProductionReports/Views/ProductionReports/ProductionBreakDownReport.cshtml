@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Production.Reports/Script/ProductionBreakDownReport.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<style>
    :root {
        --pbdr-header: #3d5cce;
        --pbdr-header-dark: #2a45a8;
    }

    html {
        overflow: hidden !important;
        height: 100% !important;
    }

    body {
        overflow: hidden !important;
        height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .pbdr-page {
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    #pbdr-filter-bar {
        background: linear-gradient(135deg, #f8faff 0%, #eef2fb 100%);
        border-bottom: 2px solid #dde4f5;
        padding: 0.75rem 1.25rem;
        flex-shrink: 0;
    }

    #pbdr-filter-bar .pbdr-field-label {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #5a6a8a;
        margin-bottom: 0.3rem;
    }

    #pbdr-filter-bar .pbdr-filter-field {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }

    #pbdr-filter-bar .form-control,
    #pbdr-filter-bar .form-select {
        border: 1.5px solid #c8d2e8;
        border-radius: 0.375rem;
        font-size: 0.825rem;
        height: 34px !important;
        min-height: 34px;
        max-height: 34px;
        line-height: 1.25;
        background: #fff;
        box-shadow: none;
        padding: 0 0.65rem;
        box-sizing: border-box;
    }

    #pbdr-filter-bar .form-control:focus,
    #pbdr-filter-bar .form-select:focus {
        border-color: var(--pbdr-header);
        box-shadow: 0 0 0 3px rgba(61, 92, 206, 0.12);
    }

    #pbdr-filter-bar .btn-pbdr-show {
        background: #198754;
        border-color: #198754;
        color: #fff;
        font-size: 0.825rem;
        font-weight: 600;
        height: 34px;
        padding: 0 1.25rem;
        border-radius: 0.375rem;
    }

    #pbdr-filter-bar .btn-pbdr-show:hover {
        background: #157347;
    }

    #pbdr-filter-bar .btn-pbdr-dl {
        background: var(--pbdr-header);
        border-color: var(--pbdr-header);
        color: #fff;
        font-size: 0.825rem;
        font-weight: 600;
        height: 34px;
        padding: 0 1rem;
        border-radius: 0.375rem;
    }

    #pbdr-filter-bar .btn-pbdr-dl:hover {
        background: var(--pbdr-header-dark);
    }

    #dvTableProductionBreakDown {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #fff;
        padding: 8px;
    }

    #pbdrTableWrapper.table-wrapper {
        flex: 1;
        min-height: 350px;
        overflow: auto;
        position: relative;
    }

    #tblProductionBreakDown {
        font-size: 0.8rem;
        width: max-content;
        min-width: 100%;
        margin-bottom: 0;
    }

    #tblProductionBreakDown:not(.pbdr-month-mode) thead th {
        background-color: #558bc0 !important;
        color: #fff !important;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    #tblProductionBreakDown.pbdr-month-mode {
        --pbdr-hdr-r1: 36px;
        --pbdr-hdr-r2: 30px;
        border-collapse: collapse;
    }

    #tblProductionBreakDown.pbdr-month-mode thead {
        background-color: #558bc0;
    }

    #tblProductionBreakDown.pbdr-month-mode thead tr {
        background-color: #558bc0;
    }

    #tblProductionBreakDown.pbdr-month-mode thead th {
        background-color: #558bc0 !important;
        color: #fff !important;
        white-space: nowrap;
        border-color: #4a7db5 !important;
        padding: 6px 8px;
        vertical-align: middle;
        line-height: 1.2;
        box-shadow: none;
    }

    #tblProductionBreakDown.pbdr-month-mode thead .pbdr-month-header-top th {
        position: sticky;
        top: 0;
        z-index: 12;
        height: var(--pbdr-hdr-r1);
        min-height: var(--pbdr-hdr-r1);
        border-bottom: 1px solid #6391c3 !important;
    }

    #tblProductionBreakDown.pbdr-month-mode thead .pbdr-month-header-top th[rowspan="2"] {
        z-index: 13;
    }

    #tblProductionBreakDown.pbdr-month-mode thead .pbdr-month-header-sub th {
        position: sticky;
        top: var(--pbdr-hdr-r1);
        z-index: 11;
        height: var(--pbdr-hdr-r2);
        min-height: var(--pbdr-hdr-r2);
        background-color: #4a7db5 !important;
        font-size: 0.72rem;
        font-weight: 600;
        border-top: 0 !important;
        padding-top: 5px;
        padding-bottom: 5px;
    }

    #tblProductionBreakDown.pbdr-month-mode .pbdr-month-group {
        text-align: center;
        background-color: #3d6fa8 !important;
    }

    #tblProductionBreakDown.pbdr-month-mode .pbdr-sub-col {
        text-align: center;
        min-width: 72px;
    }

    #tblProductionBreakDown.pbdr-month-mode .pbdr-static-col {
        vertical-align: middle;
        min-width: 90px;
    }

    #tblProductionBreakDown.pbdr-month-mode thead .pbdr-summary-col {
        background-color: #3d6fa8 !important;
        color: #fff !important;
        font-weight: 600;
    }

    #tblProductionBreakDown.pbdr-month-mode tbody .pbdr-summary-col,
    #tblProductionBreakDown.pbdr-month-mode .pbdr-month-total-row .pbdr-summary-col {
        background-color: #eef4fb;
        color: inherit;
        font-weight: 600;
    }

    #tblProductionBreakDown.pbdr-month-mode .pbdr-month-total-row td {
        background-color: #f0f4fa;
        border-top: 2px solid #558bc0;
    }

    #paginator-tblProductionBreakDown {
        flex-shrink: 0;
    }
</style>

<div class="pbdr-page">
    <div id="pbdr-filter-bar">
        <div class="d-flex align-items-end flex-wrap gap-2">
            <div class="pbdr-filter-field" style="width:150px; flex:0 0 150px;">
                <div class="pbdr-field-label">From Date <span class="text-danger">*</span></div>
                <input type="date" id="txtFromDate" class="form-control" autocomplete="off" />
            </div>
            <div class="pbdr-filter-field" style="width:150px; flex:0 0 150px;">
                <div class="pbdr-field-label">To Date <span class="text-danger">*</span></div>
                <input type="date" id="txtToDate" class="form-control" autocomplete="off" />
            </div>
            <div class="pbdr-filter-field" style="width:200px; flex:0 0 200px;">
                <div class="pbdr-field-label">Machine</div>
                <select id="ddlMachineNo" class="form-select">
                    <option value="0">ALL</option>
                </select>
            </div>
            <div class="pbdr-filter-field" style="width:120px; flex:0 0 120px;">
                <div class="pbdr-field-label">Mode</div>
                <select id="ddlMode" class="form-select">
                    <option value="Day" selected>Day</option>
                    <option value="Month">Month</option>
                    <option value="Reasonwise">Reasonwise</option>
                </select>
            </div>
            <div class="pbdr-filter-field" style="flex:0 0 auto; margin-left:auto;">
                <div class="pbdr-field-label" style="visibility:hidden;">.</div>
                <div class="d-flex gap-2">
                    <button type="button" id="btnSearch" class="btn btn-pbdr-show">
                        <i class="fas fa-search"></i> Show
                    </button>
                    <button type="button" id="btnExportExcel" class="btn btn-pbdr-dl d-none" onclick="ExportExcel();">
                        <i class="fas fa-download"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="dvTableProductionBreakDown" class="card p-1">
        <div class="table-wrapper" id="pbdrTableWrapper">
            <table id="tblProductionBreakDown" class="fixed-width-table table table-bordered">
                <thead id="table-header"></thead>
                <tbody id="table-body">
                    <tr>
                        <td colspan="100" class="text-center text-muted py-4">
                            Select filters and click <strong>Show</strong> to generate the report
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="paginator" id="paginator-tblProductionBreakDown"></div>
    </div>
</div>
