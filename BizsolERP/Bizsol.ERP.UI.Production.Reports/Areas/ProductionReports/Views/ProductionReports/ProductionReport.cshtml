@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script type="module" src="~/_content/Bizsol.WebERP.UI.Production.Reports/Script/ProductionReport.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<style>
    /* ── filter bar ── */
    #pr-filter-bar {
        background: linear-gradient(135deg, #f8faff 0%, #eef2fb 100%);
        border-bottom: 2px solid #dde4f5;
        padding: 0.75rem 1.25rem;
        flex-shrink: 0;
    }

    #pr-filter-bar .pr-field-label {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #5a6a8a;
        margin-bottom: 0.3rem;
    }

    #pr-filter-bar .form-control {
        border: 1.5px solid #c8d2e8;
        border-radius: 0.375rem;
        font-size: 0.825rem;
        height: 34px;
        background: #fff;
        box-shadow: none;
        padding-top: 0;
        padding-bottom: 0;
    }

    #pr-filter-bar .form-control:focus {
        border-color: #3d5cce;
        box-shadow: 0 0 0 3px rgba(61,92,206,.12);
    }

    #pr-filter-bar .btn-pr-show {
        background: #198754; border-color: #198754; color: #fff;
        font-size: 0.825rem; font-weight: 600; height: 34px;
        padding: 0 1.25rem; border-radius: 0.375rem;
    }
    #pr-filter-bar .btn-pr-show:hover { background: #157347; }

    #pr-filter-bar .btn-pr-dl {
        background: #0d6efd; border-color: #0d6efd; color: #fff;
        font-size: 0.825rem; font-weight: 600; height: 34px;
        padding: 0 1.25rem; border-radius: 0.375rem;
    }
    #pr-filter-bar .btn-pr-dl:hover { background: #0b5ed7; }

    /* ── table ── */
    #tblProductionReport {
        font-size: 0.78rem;
        border-collapse: collapse;
        width: max-content;
        min-width: 100%;
    }

    #tblProductionReport th {
        background: #3d5cce;
        color: #fff;
        text-align: center;
        padding: 6px 10px;
        white-space: nowrap;
        border: 1px solid #2a45a8;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    #tblProductionReport th.th-mill {
        background: #1e3a8a;
    }

    #tblProductionReport td {
        padding: 4px 8px;
        border: 1px solid #dee2e6;
        white-space: nowrap;
    }

    #tblProductionReport td.td-date {
        font-weight: 700;
        background: #eef3ff;
        color: #1e3a8a;
        text-align: center;
        vertical-align: middle;
    }

    #tblProductionReport td.td-row-label {
        font-weight: 600;
        color: #374151;
        padding-left: 1rem;
        background: #f9fafb;
    }

    #tblProductionReport td.td-num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    /* yield colour coding */
    #tblProductionReport td.yield-green  { background: #bbf7d0 !important; color: #14532d; font-weight: 600; }
    #tblProductionReport td.yield-amber  { background: #fef08a !important; color: #713f12; font-weight: 600; }
    #tblProductionReport td.yield-red    { background: #fecaca !important; color: #7f1d1d; font-weight: 600; }

    /* placeholder */
    #pr-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 160px;
        color: #94a3b8;
        font-size: 0.875rem;
    }

    /* layout */
    #pr-page-wrap {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 120px);
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* ── Content column: daily grid on top, summary below ── */
    #pr-content-row {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    #pr-table-wrap {
        overflow: auto;
        height: 320px;
        flex-shrink: 0;
        border-bottom: 2px solid #dde4f5;
    }

    /* ── Summary section (avg yield + red yield tables) ── */
    #pr-summary-section {
        border-top: 2px solid #dde4f5;
        padding: 0.75rem 1rem 1rem;
        overflow-x: auto;
        background: #f8faff;
    }

    .sum-group-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #5a6a8a;
        margin-bottom: 0.4rem;
    }

    .sum-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .sum-table-wrap {
        border: 2px solid #c0392b;
        border-radius: 4px;
        overflow: hidden;
        min-width: 220px;
    }

    .sum-table-title {
        background: #c0392b;
        color: #fff;
        font-weight: 700;
        font-size: 0.7rem;
        text-align: center;
        padding: 4px 10px;
        letter-spacing: 0.06em;
        white-space: nowrap;
    }

    .tbl-sum {
        font-size: 0.73rem;
        border-collapse: collapse;
        width: 100%;
    }

    .tbl-sum th {
        background: #3d5cce;
        color: #fff;
        text-align: center;
        padding: 4px 8px;
        border: 1px solid #2a45a8;
        white-space: nowrap;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .tbl-sum td {
        padding: 3px 8px;
        border: 1px solid #dee2e6;
        white-space: nowrap;
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .tbl-sum td.td-week {
        text-align: left;
        font-weight: 600;
        background: #f9fafb;
        color: #374151;
        min-width: 56px;
    }

    .tbl-sum td.yield-green { background: #bbf7d0 !important; color: #14532d; font-weight: 600; }
    .tbl-sum td.yield-amber { background: #fef08a !important; color: #713f12; font-weight: 600; }
    .tbl-sum td.yield-red   { background: #fecaca !important; color: #7f1d1d; font-weight: 600; }
</style>



    <!-- ── Filter bar ── -->
    <div id="pr-filter-bar">
        <div class="d-flex align-items-end flex-wrap gap-2">
            <div style="width:160px; flex:0 0 160px;">
                <div class="pr-field-label">From Date <span class="text-danger">*</span></div>
                <input type="date" id="txtPrFromDate" class="form-control" autocomplete="off" required />
            </div>
            <div style="width:160px; flex:0 0 160px;">
                <div class="pr-field-label">To Date <span class="text-danger">*</span></div>
                <input type="date" id="txtPrToDate" class="form-control" autocomplete="off" required />
            </div>
            <div style="flex:0 0 auto; margin-left:auto;">
                <div class="pr-field-label" style="visibility:hidden">.</div>
                <div class="d-flex gap-2">
                    <button type="button" id="btnPrShow" class="btn btn-pr-show">&#9654; Show</button>
                    <button type="button" id="btnPrDownload" class="btn btn-pr-dl d-none">&#8595; Download</button>
                </div>
            </div>
        </div>
    </div>
    <div id="pr-content-row">
        <div id="pr-table-wrap">
            <div id="pr-placeholder">
                <span><i class="fas fa-table me-2"></i>Select date range and click <strong>Show</strong> to load the report.</span>
            </div>
            <table id="tblProductionReport" class="table table-bordered d-none">
                <thead id="pr-thead"></thead>
                <tbody id="pr-tbody"></tbody>
            </table>
        </div>
        <div id="pr-summary-section" class="d-none">
            <div class="sum-group-label">Yield Average — by Week &amp; Machine</div>
            <div id="avg-yield-container" class="sum-row"></div>

            <div class="sum-group-label">No. of Red Yields — by Week &amp; Machine</div>
            <div id="red-yield-container" class="sum-row"></div>
        </div>
    </div>

