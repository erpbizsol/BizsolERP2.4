@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Production.Transactions/Script/RollingPlanSheet.js"></script>

<style>

    /* Hide page scrollbar */
    html {
        overflow: hidden !important;
        height: 100% !important;
    }
    
    body {
        overflow: hidden !important;
        height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
    }
    
    /* Ensure main content area fits viewport without scrolling */
    .row {
        margin: 0 !important;
        height: 100% !important;
    }
    
    .col-sm-12 {
        height: 100% !important;
        display: flex !important;
        flex-direction: column !important;
    }

    /* Tab design */
    .nav-tabs { border-bottom: none; gap: 6px; }
    .nav-tabs .nav-link {
        border: 1px solid #dee2e6;
        border-radius: 5px;
        background: #f8f9fa;
        color: #495057;
        font-weight: 600;
        height: 31px;              /* fixed height for tab button */
        padding: 0 .9rem;          /* no vertical padding, only horizontal */
        transition: background .2s ease, color .2s ease, box-shadow .2s ease, border-color .2s ease;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }
    .nav-tabs .nav-link:hover:not(.active) {
        background: #eceaff;
        color: #2d2a52;
        border-color: #c9c5ff;
    }

    .nav-tabs .nav-link.active {
        background: #558bc0;
        color: #fff;
        border-color: #578dc3;
        box-shadow: 0 2px 6px rgb(83 135 188);
    }
    .nav-tabs .nav-link i { opacity: .9; }
    .nav-tabs {
        flex-shrink: 0;
    }
    
    #rmStockTabContent { 
        margin-top: .5rem;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 150px);
        min-height: 400px;
        overflow: hidden;
        flex: 1;
    }

    /* Prevent filter bars and buttons from growing */
    #date-filter-bar,
    #from-date-to-date-filter-bar,
    #btnDownload,
    .paginator {
        flex-shrink: 0;
    }
    
    
    
    
    .fixed-width-table th:nth-child(1), .fixed-width-table td:nth-child(1) { min-width: 20px; } /* SNo */
    .fixed-width-table th:nth-child(2), .fixed-width-table td:nth-child(2) { min-width: 100px; } /* Order No */
    .fixed-width-table th:nth-child(3), .fixed-width-table td:nth-child(3) { min-width: 80px; } /* Order Date */
    .fixed-width-table th:nth-child(4), .fixed-width-table td:nth-child(4) { min-width: 80px; } /* Dispatch Date */
    .fixed-width-table th:nth-child(5), .fixed-width-table td:nth-child(5) { min-width: 80px; } /* Item Name */
    .fixed-width-table th:nth-child(6), .fixed-width-table td:nth-child(6) { min-width: 20px; } /* Size */
    .fixed-width-table th:nth-child(7), .fixed-width-table td:nth-child(7) { min-width: 20px; } /* Thickness */
    .fixed-width-table th:nth-child(8), .fixed-width-table td:nth-child(8) { min-width: 80px; } /* Marketing Man */
    .fixed-width-table th:nth-child(9), .fixed-width-table td:nth-child(9) { min-width: 20px; } /* Total Qty */
    .fixed-width-table th:nth-child(10), .fixed-width-table td:nth-child(10) { min-width: 20px; } /* Order Bal Qty */
    .fixed-width-table th:nth-child(11), .fixed-width-table td:nth-child(11) { min-width: 20px; } /* Rolled Qty */
    .fixed-width-table th:nth-child(12), .fixed-width-table td:nth-child(12) { min-width: 20px; } /* Bal Qty */
    .fixed-width-table th:nth-child(13), .fixed-width-table td:nth-child(13) { min-width: 20px; } /* Planned Qty */
    .fixed-width-table th:nth-child(14), .fixed-width-table td:nth-child(14) { min-width: 20px;}/* Plan St */
        .fixed-width-table th:nth-child(15), .fixed-width-table td:nth-child(15) {
            min-width: 20px;
        }
        /* Plan St */
        .fixed-width-table th:nth-child(16), .fixed-width-table td:nth-child(16) {
            min-width: 20px;
        }
    /* Plan St */
        .fixed-width-table th:nth-child(19), .fixed-width-table td:nth-child(19) {
            min-width: 20px;
        }

   
    
    .totals-row th {
        background-color: #e8f4fd !important;
        font-weight: bold !important;
        border: 1px solid #ddd !important;
        padding: 4px 10px !important;
        font-size: 8pt !important;
        height: 16px !important;
        vertical-align: middle !important;
    }
    
    /* Remove gap between totals row and header row */
    .totals-row {
        margin-bottom: 0 !important;
        border-bottom: none !important;
    }
    
    /* Remove bottom border from totals row cells to eliminate gap */
    .totals-row th {
        border-bottom: none !important;
    }
    
    #tblTable thead {
        border-collapse: collapse !important;
    }
    
    #tblTable thead tr {
        margin: 0 !important;
        border-spacing: 0 !important;
    }
    
    /* Ensure no gap between totals row and column header row */
    .totals-row + tr th {
        border-top: none !important;
    }
    
    .totals-row th:first-child {
        background-color: #d5dde5 !important;
        font-weight: bold !important;
        text-align: center !important;
    }
    
    .totals-row th[style*="background-color: #fff2cc"] {
        background-color: #fff2cc !important;
        font-weight: bold !important;
        text-align: right !important;
    }
    /* Prevent background scroll when Bootstrap modal is open */
    body.modal-open { overflow: hidden !important; }
    .rps-detail-modal .modal-dialog { max-width: 760px; }
    .rps-detail-modal .modal-header { padding: 8px 12px; background: #1f6fb2; color: #fff; }
    .rps-detail-modal .modal-title { font-size: 13px; font-weight: 600; }
    .rps-detail-modal .modal-body { padding: 8px 10px; max-height: 65vh; overflow: auto; }
    .rps-detail-modal .modal-footer { padding: 6px 10px; }

    .form-check-input {
        background-color: #e9ecef;
        border: 2px solid #6c757d;
        border-radius: 4px;
    }

        .form-check-input:focus {
            box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25);
        }

    .form-check-label {
        font-weight: 600;
        color: #495057;
    }

    #PlanNoDetailTable tfoot th,
    #PlanNoDetailTable tfoot td {
        color: #fff !important;
        background-color: #5c95ce !important;
        border-color: #5c95ce !important;
        font-weight: 600;
    }

    #tblTable tfoot th,
    #tblTable tfoot td {
        color: #fff !important;
        background-color: #5c95ce !important;
        border-color: #5c95ce !important;
        font-weight: 600;
    }

    /* Fixed header styles for all tables */
    .table-wrapper {
        position: relative;
        overflow: auto;
        flex: 1;
        min-height: 0;
        /* Table wrapper takes remaining space and scrolls internally */
    }

    /* Ensure table takes full width and height of wrapper */
    #tblTable {
        width: 100%;
        margin-bottom: 0;
    }

    /* Responsive height adjustments for smaller screens */
    @@media (max-height: 800px) {
        #rmStockTabContent {
            max-height: calc(100vh - 150px);
        }
        .table-wrapper {
            min-height: 300px;
        }
    }

    @@media (max-height: 600px) {
        #rmStockTabContent {
            max-height: calc(100vh - 120px);
        }
        .table-wrapper {
            min-height: 250px;
        }
    }

    /* Fixed header for main table */
    #tblTable thead {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: #fff;
    }

    #tblTable thead th {
        background-color: #558bc0 !important;
        color: #fff !important;
        position: sticky;
        top: 0;
        z-index: 11;
        border-bottom: 2px solid #dee2e6;
        padding-right: 15px !important;
    }

    /* Fixed header for DetailTable in modal */
    #DetailTable thead {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: #fff;
    }

    #DetailTable thead th {
        background-color: #558bc0 !important;
        color: #fff !important;
        position: sticky;
        top: 0;
        z-index: 11;
        border-bottom: 2px solid #dee2e6;
        padding-right: 15px !important;
    }

    /* Fixed header for PlanNoDetailTable in modal */
    #PlanNoDetailTable thead {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: #fff;
    }

    #PlanNoDetailTable thead th {
        background-color: #558bc0 !important;
        color: #fff !important;
        position: sticky;
        top: 0;
        z-index: 11;
        border-bottom: 2px solid #dee2e6;
        padding-right: 15px !important;
    }

    /* Ensure table wrapper in modal has proper overflow */
    .rps-detail-modal .table-wrapper {
        height: calc(65vh - 100px);
        min-height: 300px;
        max-height: 500px;
        overflow: auto;
    }

    .modal-body .table-wrapper {
        height: calc(65vh - 100px);
        min-height: 300px;
        max-height: 500px;
        overflow: auto;
    }

    /* Responsive modal table heights */
    @@media (max-height: 800px) {
        .rps-detail-modal .table-wrapper,
        .modal-body .table-wrapper {
            height: calc(60vh - 80px);
            min-height: 250px;
        }
    }

    @@media (max-height: 600px) {
        .rps-detail-modal .table-wrapper,
        .modal-body .table-wrapper {
            height: calc(55vh - 60px);
            min-height: 200px;
        }
    }

</style>
<div class="row">
    <div class="col-sm-12">
        <div class="nav nav-tabs">
            <div class="nav-item" role="presentation">
                <button class="nav-link active" id="current-stock-tab" data-bs-toggle="tab" data-bs-target="#current-stock" type="button" role="tab" aria-controls="current-stock" aria-selected="true">
                    <i class="fa fa-file-text" aria-hidden="true"></i> O2D sheet
                </button>
            </div>
            <div class="nav-item" role="presentation">
                <button class="nav-link" id="dispatch-tab" data-bs-toggle="tab" data-bs-target="#dispatch" type="button" role="tab" aria-controls="dispatch" aria-selected="false">
                    <i class="fas fa-truck"></i> Date Wise Mill Wise Report
                </button>
            </div>
            <div class="nav-item" role="presentation">
                <button class="nav-link" id="pipe-stock-tab" data-bs-toggle="tab" data-bs-target="#pipe-stock" type="button" role="tab" aria-controls="pipe-stock" aria-selected="false">
                    <i class="fas fa-industry"></i> Pipe Stock
                </button>
            </div>
            <div class="nav-item" role="presentation">
                <button class="nav-link" id="pending-plans-tab" data-bs-toggle="tab" data-bs-target="#pending-plans" type="button" role="tab" aria-controls="pending-plans" aria-selected="false">
                    <i class="fas fa-clipboard-list"></i> Rolling Plan Details
                </button>
            </div>
            <div class="nav-item" role="presentation">
                <button class="nav-link" id="ageing-report-tab" data-bs-toggle="tab" data-bs-target="#pending-plans" type="button" role="tab" aria-controls="ageing-report" aria-selected="false">
                    <i class="fas fa-clipboard-list"></i> Ageing Report
                </button>
            </div>
            

        </div>
        <div class="card p-1" id="rmStockTabContent">
            <div id="date-filter-bar" class="row mb-1" style="display:none">
                <div class="col-md-3">
                    <label for="rpToDate" class="form-label">Date</label>
                    <input type="date" id="rpToDate" class="form-control form-control-sm box_border" />
                </div>
                <div class="col-md-2" style="margin-top:1.8rem">
                    <button type="button" id="btnShowDateMillReport" class="btn btn-primary btn-height">Show</button>
                </div>
            </div> 
            <div id="from-date-to-date-filter-bar" class="row mb-1" style="display:none">
                <div class="col-md-3">
                    <label for="fromDate" class="form-label">From Date</label>
                    <input type="date" id="fromDate" class="form-control form-control-sm box_border" />
                </div>
                <div class="col-md-3">
                    <label for="toDate" class="form-label">To Date</label>
                    <input type="date" id="toDate" class="form-control form-control-sm box_border" />
                </div>
                <div class="col-md-3">
                    <label for="ddlStatus" class="form-label">Status</label>
                    <select id="ddlStatus" class="form-control form-control-sm box_border">
                        <option value="Pending">Pending</option>
                        <option value="Complete">Complete</option>
                        <option value="Both">Both</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="ddlItemName" class="form-label">Item Name</label>
                    <select id="ddlItemName" class="form-control form-control-sm box_border">
                    </select>
                </div>
                <div class="col-md-1" style="margin-top:5px">
                    <button type="button" id="btnShowDatePendingPlansReport" class="btn btn-primary btn-height">Show</button>
                </div>
            </div>
            <div id="from-date-to-date-filter-bar-Ageing" class="row mb-1" style="display:none">
                <div class="col-md-3">
                    <label for="txtfromDate" class="form-label">From Date</label>
                    <input type="date" id="txtfromDate" class="form-control form-control-sm box_border" />
                </div>
                <div class="col-md-3">
                    <label for="txttoDate" class="form-label">To Date</label>
                    <input type="date" id="txttoDate" class="form-control form-control-sm box_border" />
                </div>
              
            </div>
            <div id="btnDownload" class="row mb-1" style="display:block" >
                <div class="col-md-12" style="text-align:right">
                    <button type="button" id="btn" class="btn btn-primary btn-height" onclick="ExportExcel();">Download</button>
                </div> 
            </div>
            <div class="table-wrapper">
                <table id="tblTable" class="fixed-width-table table">
                    <thead id="table-head">
                    </thead>
                    <tbody id="table-body"> 
                    </tbody>
                    <tfoot id="table-foot">
                    </tfoot>
                </table>
            </div>
            <div class="paginator" id="paginator-tblTable">
            </div>
        </div>
    </div>
</div>
<div class="modal fade rps-detail-modal" id="DetailModal" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-scroll="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-modal-title">Details</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="table-wrapper">
                    <table id="DetailTable" class="fixed-width-table table">
                        <thead id="DetailTable-head">
                        </thead>
                        <tbody id="DetailTable-body">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-DetailTable">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger icon-height" onclick="CloseModal()">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="planNoDetails" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" >
        <div class="modal-content modal-content-width-sm" style="min-width:550px">
            <div class="modal-header">
                <h5 class="modal-title">Plan No Issue Details</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="table-wrapper">
                    <table id="PlanNoDetailTable" class="fixed-width-table table">
                        <thead id="PlanNoDetailTable-head">
                        </thead>
                        <tbody id="PlanNoDetailTable-body">
                        </tbody>
                        <tfoot id="PlanNoDetailTable-foot">
                        </tfoot>
                    </table>
                </div>
                <div class="paginator" id="paginator-PlanNoDetailTable">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger icon-height" onclick="PlanNoCloseModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="ProductionDetails" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm" style="min-width:550px">
            <div class="modal-header">
                <h5 class="modal-title">Rolling Plan Production Details</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="table-wrapper">
                    <table id="ProductionDetailsTable" class="fixed-width-table table">
                        <thead id="ProductionDetailsTable-head">
                        </thead>
                        <tbody id="ProductionDetails-body">
                        </tbody>
                        <tfoot id="ProductionDetails-foot">
                        </tfoot>
                    </table>
                </div>
                <div class="paginator" id="paginator-ProductionDetailsTable">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger icon-height" onclick="ProductionDetailsCloseModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
