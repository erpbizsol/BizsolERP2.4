@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/BizSolInputControl.js"></script>
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Production.Transactions/Script/PalletPacking.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<script src="https://cdn.rawgit.com/rainabba/jquery-table2excel/1.1.0/dist/jquery.table2excel.min.js"></script>
<style>
    .modal-dialog {
        max-width: 350px;
    }
    .highlighted-date {
        background-color: #3926B6;
        color: white;
        border-radius: 30px;
    }
    .datepicker td, .datepicker th {
        border-radius: 20px !important;
    }
    .datepicker table tr td, .datepicker table tr td {
        padding: 8px 9px !important;
        height: 16px !important;
    }
    .datepicker table tfoot {
        display: none;
    }
    #hidetexbox {
        display: none;
    }
    .btn:not(:disabled):not(.disabled) {
        cursor: pointer !important;
    }
    .without-label-field {
        margin-top: 2.1rem;
    }

    input[type="checkbox"] {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        width: 20px;
        height: 20px;
        border: 2px solid #ccc;
        border-radius: 4px;
        position: relative !important;
        top: 0 !important;
        cursor: pointer;
    }

    /* When checkbox is checked, make the background green */
    input[type="checkbox"]:checked {
        background-color: green;
        border-color: green;
    }

    th input[type="checkbox"]:checked {
        position: relative !important;
        top: 5px !important;
        left: 5px;
    }

    /* Adding a checkmark when checked */
    input[type="checkbox"]:checked::after {
        content: '✔';
        color: white;
        font-size: 12px;
        position: absolute;
        top: 0px;
        left: 3px;
    }
</style>
<div id="dateAndOrderByPallet">
<div class="card">
    <div class="card-header">
        <div class="row">
            <input type="hidden" name="Code" class="form-control" value="0">
            <div class="form-group col-md-3">
                <span class="radioSection">
                    <input type="radio" id="dateWise" name="filterType" class="col-form-label-sm fw-bold" value="dateWise" checked> Date Wise
                    <input type="radio" id="orderWise" name="filterType" class="col-form-label-sm fw-bold" value="orderWise"> Order Wise
                </span>
            </div>
        </div>
        <form class="form-card">
            <!-- Date Filter Section -->
            <div class="row" id="dateWiseSection">
                <div class="col-md-2 pe-0">
                    <label for="txtdate" class="col-form-label-sm fw-bold">Pallet Date:<span class="text-danger">*</span></label>
                    <input id="txtdate" name="txtdate" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Date" required />
                </div>
                <div class="col-md-10 without-label-field ">
                    <input type="button" onclick="CreateNew()" class="btn btn-primary btn-height" value="Create New" /> &nbsp;
                    <input type="button" onclick="PalletPacking_Print('Grid','N')" class="btn btn-primary btn-height" value="Print" />&nbsp;
                    <input type="button" onclick="PalletPacking_Print('Grid','Y')" class="btn btn-primary btn-height" value="Print Download" />&nbsp;
                    <input type="button" id="btnExport" class="btn btn-primary btn-height" value="Export">
                </div>
            </div>
            <div class="row" id="orderWiseSection" style="display:none;">
                <div class="col-md-2 pe-0">
                    <label for="txtorderNo" class="col-form-label-sm fw-bold">Order No:<span class="text-danger">*</span></label>
                        <select id="txtOrderNo" class="form-control form-control-sm box_border"></select>
                </div>                    
                    <div class="col-md-4 without-label-field">
                        <input type="button" onclick="CreateNew()" class="btn btn-primary btn-height" value="Create New" /> &nbsp;
                        <input type="button" onclick="PalletPacking_Print('Grid','N')" class="btn btn-primary btn-height" value="Print" />&nbsp;
                        <input type="button" onclick="PalletPacking_Print('Grid','Y')" class="btn btn-primary btn-height" value="Print Download" />&nbsp;
                        <input type="button" id="btnExport" class="btn btn-primary btn-height" value="Export" onclick="Export()">
                    </div>
            </div>

        </form>
    </div>
</div>
<div id="tblDateOrderPallet">
<div class="table-wrapper fixed-height-table">
    <table id="PalletPacking" class="fixed-width-table table">
        <thead id="table-header-PalletPacking">
        </thead>
        <tbody id="table-body-PalletPacking">
        </tbody>
    </table>
</div>
<div class="paginator" id="paginator-PalletPacking">
</div>
</div>
</div>
<div id="newCreateForm" class="card" style="display:none">
    <form class="card-body">
        <div class="row">
            <input type="hidden" name="Code" id="Code" class="form-control" value="0">
            <!-- Pallet Date -->
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtdate" class="col-form-label-sm fw-bold"><b>Pallet Date:<span class="text-danger">*</span></b></label>
                    <input id="txtPalletdate" name="txtPalletdate" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Date" value="" readonly required />
                </div>
            </div>

            <!-- Pallet No -->
            <div class="col-md-3">
                <div class="form-group">
                    <label class="col-form-label-sm fw-bold required"><b>Pallet No:<span class="text-danger">*</span></b></label>
                    <input type="text" name="palletNo" id="palletNo" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Pallet No" readonly />
                </div>
            </div>

            <!-- Warehouse -->
            <div class="col-md-3">
                <div class="form-group">
                    <label class="col-form-label-sm fw-bold required"><b>Warehouse:</b><span class="text-danger">*</span></label>
                    <select id="txtWarehouse" class="form-control form-control-sm box_border"></select>
                </div>
            </div>

            <!-- Packing Weight -->
            <div class="col-md-3">
                <div class="form-group">
                    <label class="col-form-label-sm fw-bold required"><b>Packing Wt:</b><span class="text-danger">*</span></label>
                    <input type="text" name="packingWt" id="packingWt" class="box_border form-control form-control-sm" autocomplete="off" maxlength="8" oninput="this.value = this.value.replace(/[^0-9]/g, '');" placeholder="Packing Wt" required />
                </div>
            </div>

            <!-- Reference No -->
            <div class="col-md-3">
                <div class="form-group">
                    <label class="col-form-label-sm fw-bold required"><b>Reference No:</b><span class="text-danger">*</span></label>
                    <input type="text" name="referenceNo" id="referenceNo" class="box_border form-control form-control-sm" autocomplete="off" oninput="this.value = this.value.replace(/[^0-9]/g, '');"  placeholder="Reference No" maxlength="8" required />
                </div>
            </div>

            <!-- Pallet Type -->
            <div class="col-md-3">
                <div class="form-group">
                    <label class="col-form-label-sm fw-bold required"><b>Pallet Type:</b><span class="text-danger">*</span></label>
                    <select id="txtPalletType" class="form-control form-control-sm box_border"></select>
                </div>
            </div>

            <!-- Order No -->
            <div class="col-md-3">
                <div class="form-group">
                    <label class="col-form-label-sm fw-bold required"><b>Order No:</b><span class="text-danger">*</span></label>
                    <select id="txtOrderNo1" class="form-control form-control-sm box_border"></select>
                </div>
            </div>

            <!-- Scan Identification No -->
            <div class="col-md-3">
                <div class="form-group">
                    <label class="col-form-label-sm fw-bold required"><b>Scan Identification No:</b><span class="text-danger">*</span></label>
                    <input type="text" id="txtScanIdentificationNo" name="txtCheckInTime" class="box_border BizSolFormControl form-control form-control-sm" value="" autocomplete="off" />
                    <ul id="txtScanIdentificationNoList" class="AutoSuggestion-list"></ul>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-2 text-end">
                        <button type="button" title="Print" onclick="PalletPacking_Print('Single','N')" class="btn btn-primary btn-height">Print</button>
                        <button type="button" onclick="CreateNew()" title="Create New" class="btn btn-primary btn-height">Create New</button>
                        <button type="button" class="btn btn-primary btn-height" title="Back" onclick="Close()">BACK</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
<div id="tdlScanIdentification" style="display: none;">
    <div class="table-wrapper fixed-height-table">
        <table id="ScanIdentification" class="fixed-width-table table">
            <thead id="table-header-ScanIdentification">
            </thead>
            <tbody id="table-body-ScanIdentification">
            </tbody>
        </table>
    </div>
    <div class="paginator" id="paginator-ScanIdentification">
    </div>
</div>
<div class="table-wrapper fixed-height-table" hidden="hidden">
    <table id="tblReport" hidden="hidden">
        <thead id="table-headerPrint">
            <tr></tr>
        </thead>
        <tbody id="table-bodyPrint">
        </tbody>
    </table>
</div>

<div class="modal fade" id="ExportModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title">Please Choose Button</h5>
                <button type="button" class="close modal-close" aria-label="Close" onclick="Close_ExportModal()"<span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <button type="button" id="btnDownload" class="btn btn-primary btn-height" onclick="ExportSummary()">Export Summary</button>
                <button type="button" id="btnDownloadDetails" class="btn btn-primary btn-height" onclick="DownloadPalletPacking()">Export Details</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger btn-height" onclick="Close_ExportModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="ViewInIDPallet" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title">Pallet No </h5>
                <button type="button" class="close modal-close" aria-label="Close" onclick="Close_ViewIdInPalletModal()"<span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="table-wrapper">
                    <table id="ViewInIdPalletTable" class="fixed-width-table table">
                        <thead id="table-header-ViewInIdPalletTable">
                        </thead>
                        <tbody id="table-body-ViewInIdPalletTable">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-ViewInIdPalletTable">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger btn-height" onclick="Close_ViewIdInPalletModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>