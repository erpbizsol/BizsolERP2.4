@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Production.Transactions/Script/PhysicalStockTaking.js"></script> 
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<script src="https://cdn.rawgit.com/rainabba/jquery-table2excel/1.1.0/dist/jquery.table2excel.min.js"></script>
<style>
    .modal-dialog {
        max-width: 750px;
    }
    .highlighted-date {
        background-color: #3926B6;
        color: white;
        border-radius: 30px;
    }

    .datepicker td, .datepicker th {
        border-radius: 20px !important;
    }

    .datepicker table tr td, .datepicker table tr td {
        padding: 8px 9px !important;
        height: 16px !important;
    }

    .datepicker table tfoot {
        display: none;
    }

    #hidetexbox {
        display: none;
    }

    .btn:not(:disabled):not(.disabled) {
        cursor: pointer !important;
    }

    .without-label-field {
        margin-top: 2.1rem;
    }
</style>
<div id="dateWisePhysicalStock">
    <div class="row">
        @* <div class="col-sm-3 col-6"> *@
        @*     <label for="from-date">From Date</label> *@
        @*     <input type="date" class="form-control form-control-sm" id="txtFromDate"> *@
        @* </div> *@
        @* <div class="col-sm-3 col-6"> *@
        @*     <label for="to-date">To Date</label> *@
        @*     <input type="date" class="form-control form-control-sm" id="txtToDate"> *@
        @* </div> *@
        <div class="col-md-12 text-end">
            <button type="button" onclick="CreateNew('0')" title="Create New" class="btn btn-primary btn-height">Create New</button>
        </div>
    </div>
    <div id="tbldateWisePhysicalStock" class="mt-1">
        <div class="table-wrapper fixed-height-table">
            <table id="PhysicalStockTable" class="fixed-width-table table">
                <thead id="table-header-tbldateWisePhysicalStock">
                </thead>
                <tbody id="table-body-tbldateWisePhysicalStock">
                </tbody>
            </table>
        </div>
        <div class="paginator" id="paginator-PhysicalStockTable">
        </div>
    </div>
</div>

<div id="newCreateForm" class="card" style="display:none">
    <form class="card-body">
        <div class="row">
            <input type="hidden" name="Code" id="Code" class="form-control" value="0">

            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtEntryNo" class="col-form-label-sm fw-bold">Entry No:<span class="text-danger">*</span></label>
                    <input id="txtEntryNo" name="txtEntryNo" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Entry No" required readonly/>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtdate" class="col-form-label-sm fw-bold">Entry Date:<span class="text-danger">*</span></label>
                    <input id="txtdate" name="txtdate" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Date" required />
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="remarks" class="col-form-label-sm fw-bold required">Entry Desp:<span class="text-danger">*</span></label>
                    <input type="text" name="remarks" id="remarks" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Remarks" required />
                </div>
            </div>

            <div class="col-md-3" id="PerameterBasedHideAndShow">
                <div class="form-group" >
                    <label for="ddlPhysicalWarehouse" class="col-form-label-sm fw-bold required">Physical Warehouse:<span class="text-danger">*</span></label>
                    <select id="ddlPhysicalWarehouse" class="form-control form-control-sm box_border">
                    </select>
                </div>
            </div>
        </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                    <label for="ddlPhysicalType" class="col-form-label-sm fw-bold required">Physical Type:<span class="text-danger">*</span></label>
                    <select id="ddlPhysicalType" class="form-control form-control-sm box_border" onchange="GetPhysicalType()">
                        <option value="A">All</option>
                        <option value="ID">ID</option>
                        <option value="Bu">Bundle</option>
                        <option value="B">Batch</option>
                    </select>
                    </div>
                </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlItemName" class="col-form-label-sm fw-bold required">Item Name:<span class="text-danger">*</span></label>
                    <select id="ddlItemName" class="form-control form-control-sm box_border">
                    </select>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtScanIdentificationNo" class="col-form-label-sm fw-bold required">Scan Identification No:<span class="text-danger">*</span></label>
                    <input list="txtScanIdentificationNoList" id="txtScanIdentificationNo" type="text" name="txtScanIdentificationNo" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Scan Identification No" maxlength="50" required />
                    <datalist id="txtScanIdentificationNoList"></datalist>
                </div>
            </div>
            <div class="col-md-3 text-end" style="margin-top:2rem">
                <button type="button" class="btn btn-primary icon-height" onclick="PhysicalStock_Back()">Back</button>
            </div>
        </div>
    </form>
</div>

<div id="tblPhysicalStockTaking">
    <div class="table-wrapper fixed-height-table">
        <table id="PhysicalStockTaking" class="fixed-width-table table">
            <thead id="table-header-PhysicalStockTaking">
            </thead>
            <tbody id="table-body-PhysicalStockTaking">
            </tbody>
        </table>
    </div>
    <div class="paginator" id="paginator-PhysicalStockTaking">
    </div>
</div>

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Item</h5>
                <button type="button" class="close modal-close" aria-label="Close" onclick="CloseModal()">
                    <span aria-hidden="true">x</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-wrapper">
                    <table class="table">
                        <tr>
                            <th>Item Size</th>
                            <th>Size Desp</th>
                            <th>New Size</th>
                            <th>Qty PC</th>
                            <th>Qty MT</th>
                            <th>Action</th>
                        </tr>
                        <tr>
                            <td style="width:80px"><select id="ddlItemSize" class="form-control form-control-sm box_border"></select></td>                         
                            <td><label id="ddlItemSize1"></label></td>
                            <td><input type="button" class="form-control form-control-sm box_border btn btn-primary icon-height" value="New Size" onclick="NewSizeAddControl()" /></td>
                            <td><input type="text" placeholder="Qty PC" id="SizeControlQtyPC" autocomplete="off" class="form-control form-control-sm box_border" oninput="validateInput(this)" maxlength="7" style="text-align:right" /></td>
                            <td><input type="text" placeholder="Qty MT" id="SizeControlQtyMT" autocomplete="off" class="form-control form-control-sm box_border" oninput="validateDecimalInput(this)" style="text-align:right" /></td>
                            <td><input type="button" class="form-control form-control-sm box_border btn btn-primary icon-height" value="ADD" onclick="NewAddSizePhysical_Stock()"/></td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger btn-height" onclick="CloseModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div id="tblAddPhysicalStock">
    <div class="table-wrapper fixed-height-table">
        <table id="tblAddPhysicalStock" class="fixed-width-table table">
            <thead id="table-header-tblAddPhysicalStock">
            </thead>
            <tbody id="table-body-tblAddPhysicalStock">
            </tbody>
        </table>
    </div>
    <div class="paginator" id="paginator-tblAddPhysicalStock">
    </div>
</div>
<div class="modal fade" id="ViewModal_Open" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Stock Audit Report</h5>
                <button type="button" class="close modal-close" aria-label="Close" onclick="CloseModalView_Physical()">
                    <span aria-hidden="true">x</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-wrapper fixed-height-table">
                    <table id="tblViewModal_Open" class="fixed-width-table table">
                        <thead id="table-header-tblViewModal_Open">
                        </thead>
                        <tbody id="table-body-tblViewModal_Open">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-tblViewModal_Open">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-height" onclick="Physical_ExportButton()">Export</button>
                <button type="button" class="btn btn-danger btn-height" onclick="CloseModalView_Physical()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div id="DivSizeControlmodal"></div>
<div class="table-wrapper fixed-height-table" hidden="hidden">
    <table id="tblReport" hidden="hidden">
        <thead id="table-headerPrint">
            <tr></tr>
        </thead>
        <tbody id="table-bodyPrint">
        </tbody>
    </table>
</div>