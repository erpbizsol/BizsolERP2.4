@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<script src="~/assets/js/jquery-3.6.0.min.js"></script>
<script src="~/assets/script/filter.js"></script>
<link href="~/assets/css/filter.css" rel="stylesheet" />
<script type="module" src="~/_content/Bizsol.WebERP.UI.Purchase.Transactions/js/POApproval.js"></script>

<div style="text-align:right">
    <input type="button" onclick="CreateNew()" class="btn btn-primary" value="Create New" />
</div>

<div class="table-wrapper mt-2">
    <table id="table" class="fixed-width-table">
        <thead id="table-header">
        </thead>
        <tbody id="table-body">
        </tbody>
    </table>
</div>

<div class="paginator" id="paginator">
</div>

<button type="button" class="btn btn-primary" onclick="OpenModal()">Open Modal</button>

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">View History</h5>
                <button type="button" class="btn-close" onclick="CloseModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="table-wrapper mt-2">
                    <table id="modal-table" class="fixed-width-table">
                        <thead id="modal-table-header">
                        </thead>
                        <tbody id="modal-table-body">
                        </tbody>
                    </table>
                </div>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div>
