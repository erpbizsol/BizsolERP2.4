@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Purchase.Transactions/Script/SaleOrderApproval.js"></script> 
<style>
    /* ── PAGE HEADER ──────────────────────────────────────────── */
    .pla-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 14px;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 14px;
        box-shadow: 0 4px 18px rgba(102,126,234,0.28);
    }
    .pla-header h5  { margin: 0; color: #fff; font-weight: 700; font-size: 1rem; }
    .pla-header small { color: rgba(255,255,255,0.78); font-size: 0.78rem; display: block; margin-top: 3px; }

    .pla-stat-chip {
        background: rgba(255,255,255,0.18);
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 10px;
        padding: 5px 14px;
        text-align: center;
        min-width: 78px;
    }
    .pla-stat-chip .val { font-size: 1.1rem; font-weight: 800; color: #fff; line-height: 1; }
    .pla-stat-chip .lbl { font-size: 0.64rem; color: rgba(255,255,255,0.8); text-transform: uppercase; letter-spacing: 0.06em; }

    .section-entry-animation { animation: fadeSlideIn 0.3s ease both; }
    @@keyframes fadeSlideIn {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .modal-dialog {
        max-width: 1100px;
    }
    /* Sale Order Detail — wider readable layout */
    #myModal .modal-dialog.modal-lg {
        max-width: 940px;
        height: calc(100vh - 2.5rem);
        max-height: 880px;
        margin: 1.25rem auto;
    }

    #myModal .modal-content {
        border: none;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 22px 55px rgba(15, 23, 42, 0.22);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    #myModal .modal-header {
        position: relative;
        display: flex;
        align-items: center;
        flex-shrink: 0;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        border-bottom: none;
        padding: 0.85rem 3.25rem 0.85rem 1.25rem;
        gap: 0.75rem;
    }

    #myModal .sod-modal-header-main {
        flex: 1 1 auto;
        min-width: 0;
        text-align: center;
    }

    #myModal .modal-header .modal-title {
        margin: 0;
        padding: 0 0.25rem;
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: 0.02em;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    #myModal .sod-modal-header-date {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 0.2rem;
        font-size: 0.72rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.92);
        letter-spacing: 0.02em;
    }

    #myModal .sod-modal-header-date .sod-od-chip {
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.32);
        border-radius: 6px;
        padding: 0.12rem 0.55rem;
        font-weight: 700;
    }

    #myModal .modal-header button.close,
    #myModal .modal-header button.modal-close {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #fff !important;
        opacity: 1 !important;
        text-shadow: none;
        font-size: 1.25rem;
        font-weight: 400;
        line-height: 1;
        padding: 0.35rem 0.55rem;
        margin: 0;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.45);
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.25rem;
        min-height: 2.25rem;
        cursor: pointer;
    }

    #myModal .modal-header button.close span,
    #myModal .modal-header button.modal-close span {
        color: #fff !important;
        line-height: 1;
        font-size: 1.5rem;
        font-weight: 300;
    }

    #myModal .modal-header button.close:hover,
    #myModal .modal-header button.modal-close:hover,
    #myModal .modal-header button.close:focus,
    #myModal .modal-header button.modal-close:focus {
        color: #fff !important;
        opacity: 1 !important;
        background: rgba(255, 255, 255, 0.24);
        border-color: rgba(255, 255, 255, 0.75);
        outline: none;
        transform: translateY(-50%);
    }

    #myModal .modal-body {
        background: #eef2f7;
        padding: 1rem 1.15rem 1.1rem;
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        display: grid;
        grid-template-rows: auto minmax(130px, 1fr) auto;
        gap: 0.75rem;
    }

    #myModal .sod-modal-verify {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 0.85rem;
        border-radius: 10px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #b45309;
        font-size: 0.8125rem;
        font-weight: 600;
        margin-bottom: 0;
        flex-shrink: 0;
    }

    #myModal .sod-modal-verify .fa {
        flex-shrink: 0;
        opacity: 0.95;
    }

    #myModal .sod-modal-section {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        padding: 0.65rem 0.75rem 0.75rem;
        margin-bottom: 0;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
        flex-shrink: 0;
    }

    #myModal .sod-modal-section--lineitems {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    #myModal .sod-modal-section__title {
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #64748b;
        margin-bottom: 0.5rem;
        padding: 0 0 0.35rem 0.55rem;
        border-bottom: 1px solid #f1f5f9;
        border-left: 3px solid #ef4444;
        flex-shrink: 0;
    }

    #myModal .sod-table-scroll {
        flex: 1 1 auto;
        min-height: 90px;
        max-height: 100%;
        overflow-y: auto;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #fff;
    }

    /* Bottom: Delivery (left) | Packing (right) — 50/50 with red center partition */
    #myModal .sod-modal-bottom-partition {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: stretch;
        flex-shrink: 0;
        min-height: 0;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        background: #fff;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
        position: relative;
    }

    #myModal .sod-modal-bottom-partition::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 0.45rem;
        bottom: 0.45rem;
        width: 2px;
        background: #ef4444;
        transform: translateX(-50%);
        z-index: 2;
        pointer-events: none;
    }

    #myModal .sod-modal-bottom-partition .sod-modal-section {
        min-width: 0;
        margin-bottom: 0;
        border: none;
        border-radius: 0;
        box-shadow: none;
        padding: 0.65rem 0.8rem 0.75rem;
    }

    #myModal .sod-modal-bottom-partition .sod-modal-section--terms {
        padding-right: 0.95rem;
        padding-left: 0.65rem;
    }

    #myModal .sod-modal-bottom-partition .sod-modal-section--charges {
        padding-left: 0.95rem;
        padding-right: 0.65rem;
    }

    #myModal .sod-modal-bottom-partition #saleOrderDetailHeaderPanel.sod-charge-panel {
        border: none;
        box-shadow: none;
        padding: 0.15rem 0 0;
        background: transparent;
    }

    #myModal .sod-modal-bottom-partition .sod-charge-grid {
        grid-template-columns: 4.25rem minmax(0, 1fr) 2.85rem 3.35rem;
        gap: 0.32rem 0.35rem;
    }

    #myModal .sod-modal-bottom-partition .sod-charge-col-h {
        font-size: 0.58rem;
    }

    #myModal .sod-modal-bottom-partition .form-control-sm {
        font-size: 0.72rem;
        min-height: calc(1.4em + 0.3rem + 2px);
        padding: 0.22rem 0.4rem;
    }

    #myModal .sod-modal-bottom-partition .sod-g-lbl {
        font-size: 0.72rem;
        padding-right: 0.45rem;
    }

    #myModal .sod-modal-section--terms .sod-terms-scroll {
        max-height: none;
        overflow-x: hidden;
        overflow-y: auto;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
    }

    #myModal .sod-party-outstanding-panel {
        margin-top: 0.55rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.45rem;
    }

    #myModal .sod-party-outstanding-item {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.45rem 0.55rem;
        min-width: 0;
    }

    #myModal .sod-party-outstanding-item--out {
        border-left: 3px solid #667eea;
    }

    #myModal .sod-party-outstanding-item--over {
        border-left: 3px solid #ef4444;
    }

    #myModal .sod-party-outstanding-lbl {
        display: block;
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        margin-bottom: 0.15rem;
    }

    #myModal .sod-party-outstanding-val {
        display: block;
        font-size: 0.82rem;
        font-weight: 800;
        color: #0f172a;
        word-break: break-word;
    }

    #myModal .sod-party-outstanding-item--out .sod-party-outstanding-val {
        color: #667eea;
    }

    #myModal .sod-party-outstanding-item--over .sod-party-outstanding-val {
        color: #dc2626;
    }

    #myModal .sod-party-outstanding-val.is-loading {
        color: #94a3b8;
        font-weight: 600;
        font-size: 0.75rem;
    }

    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable {
        width: 100%;
        min-width: 0;
        table-layout: fixed;
        margin-bottom: 0;
    }

    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable th,
    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable td {
        white-space: normal;
        word-break: break-word;
        font-size: 0.72rem;
        padding: 5px 6px;
        vertical-align: top;
    }

    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable th:nth-child(1),
    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable td:nth-child(1) {
        width: 28%;
    }

    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable th:nth-child(2),
    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable td:nth-child(2),
    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable th:nth-child(3),
    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable td:nth-child(3) {
        width: 18%;
    }

    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable th:nth-child(4),
    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable td:nth-child(4),
    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable th:nth-child(5),
    #myModal .sod-modal-section--terms #SaleOrderDeliveryTermsTable td:nth-child(5) {
        width: 18%;
    }

    #myModal .sod-modal-section--terms .sod-terms-scroll .table-wrapper {
        margin-bottom: 0;
        overflow: visible;
    }

    #myModal .sod-modal-section .table-wrapper {
        margin-bottom: 0;
    }

    #myModal .sod-modal-section--lineitems .sod-table-scroll .table-wrapper {
        margin-bottom: 0;
        overflow: visible;
    }

    /* Mobile card views — hidden on desktop */
    .sod-lineitems-mobile-cards,
    .sod-terms-mobile-cards,
    .sod-charges-mobile-cards {
        display: none;
    }

    .sod-li-mobile-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 3px solid #667eea;
        border-radius: 10px;
        padding: 0.6rem 0.65rem;
        margin-bottom: 0.55rem;
    }

    .sod-li-mobile-card:last-child { margin-bottom: 0; }

    .sod-li-mobile-head {
        display: flex;
        align-items: flex-start;
        gap: 0.45rem;
        margin-bottom: 0.35rem;
    }

    .sod-li-mobile-sno {
        flex-shrink: 0;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
        font-size: 0.65rem;
        font-weight: 800;
        border-radius: 6px;
        padding: 0.15rem 0.45rem;
    }

    .sod-li-mobile-item {
        font-size: 0.8rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.35;
        word-break: break-word;
    }

    .sod-li-mobile-size {
        font-size: 0.73rem;
        color: #475569;
        margin-bottom: 0.4rem;
        padding: 0.35rem 0.45rem;
        background: #fff;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        word-break: break-word;
    }

    .sod-li-mobile-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.35rem 0.45rem;
    }

    .sod-li-mobile-kv {
        background: #fff;
        border: 1px solid #eef2f7;
        border-radius: 6px;
        padding: 0.32rem 0.45rem;
        min-width: 0;
    }

    .sod-li-mobile-kv--full { grid-column: 1 / -1; }

    .sod-li-mobile-lbl {
        display: block;
        font-size: 0.58rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #94a3b8;
        margin-bottom: 0.1rem;
    }

    .sod-li-mobile-val {
        display: block;
        font-size: 0.76rem;
        font-weight: 600;
        color: #334155;
        word-break: break-word;
    }

    .sod-li-mobile-val.is-num {
        text-align: right;
        color: #667eea;
    }

    .sod-dt-mobile-card,
    .sod-charge-mobile-block {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.55rem 0.65rem;
    }

    .sod-dt-mobile-kv,
    .sod-charge-mobile-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 0.38rem 0;
        border-bottom: 1px solid #eef2f7;
    }

    .sod-dt-mobile-kv:last-child,
    .sod-charge-mobile-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .sod-dt-mobile-lbl,
    .sod-charge-mobile-lbl {
        flex: 0 0 44%;
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #64748b;
        line-height: 1.35;
    }

    .sod-dt-mobile-val,
    .sod-charge-mobile-val {
        flex: 1 1 auto;
        text-align: right;
        font-size: 0.76rem;
        font-weight: 600;
        color: #1e293b;
        word-break: break-word;
    }

    .sod-charge-mobile-group {
        margin-bottom: 0.55rem;
    }

    .sod-charge-mobile-group:last-child { margin-bottom: 0; }

    .sod-charge-mobile-group-title {
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #475569;
        margin-bottom: 0.35rem;
        padding-left: 0.45rem;
        border-left: 3px solid #ef4444;
    }

    #myModal .sod-modal-section .paginator {
        margin-top: 0.5rem;
        margin-bottom: 0;
    }

    #myModal #SaleOrderApprovalTable thead th,
    #myModal #SaleOrderDeliveryTermsTable thead th {
        background: linear-gradient(180deg, #5b4fcf 0%, #4338ca 100%) !important;
        color: #fff !important;
        font-weight: 700 !important;
        font-size: 0.7rem !important;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-color: #6d5fe0 !important;
        vertical-align: middle;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    #myModal #SaleOrderApprovalTable tbody tr:nth-child(even),
    #myModal #SaleOrderDeliveryTermsTable tbody tr:nth-child(even) {
        background: #f8fafc;
    }

    #myModal #SaleOrderApprovalTable tbody td,
    #myModal #SaleOrderDeliveryTermsTable tbody td {
        font-size: 0.8125rem;
        vertical-align: middle;
        border-color: #e8ecf1;
    }

    /* Bar stays right-aligned; only the word “Close” is centered inside the button */
    #myModal .modal-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 0.5rem;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        padding: 0.7rem 1.15rem;
        flex-shrink: 0;
    }

    /* Verify action lives inside the detail modal; keep it on the left */
    #myModal .modal-footer .btn-sod-verify.btn {
        margin-right: auto;
        min-width: 7rem;
        font-weight: 700;
        font-size: 0.875rem;
        border-radius: 8px;
        padding: 0.45rem 1.35rem;
        color: #fff !important;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        border: none !important;
        box-shadow: 0 3px 12px rgba(16, 185, 129, 0.35);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    #myModal .modal-footer .btn-sod-verify.btn:hover,
    #myModal .modal-footer .btn-sod-verify.btn:focus {
        color: #fff !important;
        transform: translateY(-1px);
        box-shadow: 0 5px 16px rgba(16, 185, 129, 0.5);
    }

    #myModal .modal-footer .btn-sod-verify.btn:active {
        transform: scale(0.98);
    }

    /* Solid footer button — theme overrides often break outline-secondary (invisible text) */
    #myModal .modal-footer .btn-sod-close.btn {
        min-width: 6.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        border-radius: 8px;
        padding: 0.45rem 1.15rem;
        color: #fff !important;
        background-color: #334155 !important;
        border: 1px solid #1e293b !important;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.12);
        text-align: center;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    #myModal .modal-footer .btn-sod-close.btn:hover,
    #myModal .modal-footer .btn-sod-close.btn:focus {
        color: #fff !important;
        background-color: #1e293b !important;
        border-color: #0f172a !important;
    }

    #myModal .modal-footer .btn-sod-close.btn:active {
        color: #fff !important;
        background-color: #0f172a !important;
    }

    #myModal .sod-modal-section--charges #saleOrderDetailHeaderPanel.sod-charge-panel {
        margin-top: 0;
        margin-bottom: 0;
        border-radius: 8px;
    }

    /* Charge panel: 4-column grid — label | description | value | amount (aligned rows) */
    #saleOrderDetailHeaderPanel.sod-charge-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.75rem 0.9rem 0.85rem;
        font-size: 0.8125rem;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    #saleOrderDetailHeaderPanel.sod-charge-panel .form-control-sm {
        font-size: 0.8125rem;
        min-height: calc(1.5em + 0.35rem + 2px);
        padding: 0.28rem 0.5rem;
        border-radius: 6px;
        border-color: #cbd5e1;
    }

    #saleOrderDetailHeaderPanel.sod-charge-panel .form-control-sm[readonly] {
        background-color: #f8fafc;
        cursor: default;
        color: #334155;
    }

    #saleOrderDetailHeaderPanel.sod-charge-panel .sod-charge-grid {
        display: grid;
        grid-template-columns: 6.5rem minmax(5.5rem, 1fr) 5.25rem 5.75rem;
        gap: 0.45rem 0.5rem;
        align-items: center;
        justify-content: stretch;
    }

    #saleOrderDetailHeaderPanel.sod-charge-panel .sod-charge-col-h {
        font-size: 0.62rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #94a3b8;
        padding-bottom: 0.15rem;
        border-bottom: 1px solid #f1f5f9;
        margin-bottom: 0.1rem;
    }

    #saleOrderDetailHeaderPanel.sod-charge-panel .sod-charge-col-h--spacer {
        border-bottom: none;
        margin: 0;
        padding: 0;
        min-height: 0;
    }

    /* Placeholder cell so “Other charges” amount lines up under Packing amount */
    #saleOrderDetailHeaderPanel.sod-charge-panel .sod-charge-mid {
        min-height: calc(1.5em + 0.35rem + 2px);
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        border: 1px dashed #cbd5e1;
        border-radius: 6px;
        color: #94a3b8;
        font-size: 0.7rem;
        font-weight: 600;
    }

    #saleOrderDetailHeaderPanel.sod-charge-panel .sod-g-h {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #5c6c7d;
        line-height: 1.2;
        padding-bottom: 0.1rem;
        border-bottom: 1px solid #c5dce8;
        margin-bottom: 0.1rem;
    }

    #saleOrderDetailHeaderPanel.sod-charge-panel .sod-g-h-muted {
