<div class="modal fade" id="myModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sale Order Detail</h5>
            </div>
            <div class="modal-body">
                <div class="table-wrapper mt-2">
                    <table id="table1" class="fixed-width-table">
                        <thead id="table-header1">
                        </thead>
                        <tbody id="table-body1">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-table1">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" onclick="closeModal()" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
