@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Purchase.Transactions/Script/FMSReport.js"></script>
<style>
    /* ── PAGE HEADER ──────────────────────────────────────────── */
    .pla-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 14px;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 14px;
        box-shadow: 0 4px 18px rgba(102,126,234,0.28);
    }
    .pla-header h5  { margin: 0; color: #fff; font-weight: 700; font-size: 1rem; }
    .pla-header small { color: rgba(255,255,255,0.78); font-size: 0.78rem; display: block; margin-top: 3px; }

    .pla-stat-chip {
        background: rgba(255,255,255,0.18);
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 10px;
        padding: 5px 14px;
        text-align: center;
        min-width: 78px;
    }
    .pla-stat-chip .val { font-size: 1.1rem; font-weight: 800; color: #fff; line-height: 1; }
    .pla-stat-chip .lbl { font-size: 0.64rem; color: rgba(255,255,255,0.8); text-transform: uppercase; letter-spacing: 0.06em; }

    .section-entry-animation { animation: fadeSlideIn 0.3s ease both; }
    @@keyframes fadeSlideIn {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ── FMS REPORT CARDS (aligned with Sale Order Approval) ─── */
    .fmsr-list-wrap {
        margin-bottom: 14px;
    }

    .sopa-cards {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .sopa-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(15, 23, 42, 0.08);
        border: 1px solid #eef0f4;
        border-left: 4px solid #667eea;
        overflow: hidden;
        transition: box-shadow 0.2s ease, transform 0.15s ease;
    }

    .sopa-card:hover {
        box-shadow: 0 6px 22px rgba(102, 126, 234, 0.16);
        transform: translateY(-1px);
    }

    .sopa-card-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 1rem;
        padding: 1rem 1.15rem 0.85rem;
        border-bottom: 1px solid #f0f2f6;
    }

    .sopa-po-badge {
        flex: 0 0 auto;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        border-radius: 12px;
        padding: 0.45rem 0.75rem;
        min-width: 7.5rem;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.35);
    }

    .sopa-po-label {
        display: block;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        opacity: 0.9;
        text-transform: uppercase;
    }

    .sopa-po-no {
        display: block;
        font-size: 0.95rem;
        font-weight: 800;
        line-height: 1.2;
        word-break: break-all;
    }

    .sopa-company-block {
        flex: 1 1 200px;
        min-width: 0;
    }

    .sopa-company-title {
        font-size: 1rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.35;
        display: flex;
        align-items: flex-start;
        gap: 0.4rem;
    }

    .sopa-company-title .fa-cube {
        color: #667eea;
        margin-top: 0.15rem;
        flex-shrink: 0;
    }

    .sopa-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 0.85rem;
        margin-top: 0.35rem;
        font-size: 0.78rem;
        color: #64748b;
    }

    .sopa-meta .fa-calendar-alt {
        margin-right: 0.25rem;
        opacity: 0.85;
    }

    .sopa-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.15rem 0.45rem;
        border-radius: 6px;
        border: 1px solid rgba(102, 126, 234, 0.18);
        background: rgba(102, 126, 234, 0.08);
        color: #667eea;
        font-weight: 600;
        font-size: 0.72rem;
    }

    .sopa-amount-block {
        flex: 0 0 auto;
        text-align: right;
        min-width: 7rem;
    }

    .sopa-amount {
        font-size: 1.05rem;
        font-weight: 800;
        color: #667eea;
        line-height: 1.2;
    }

    .sopa-status {
        display: inline-block;
        margin-top: 0.35rem;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .sopa-status--pending {
        background: #fef3c7;
        color: #b45309;
    }

    .sopa-metrics {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem 0.75rem;
        padding: 0.65rem 1.15rem;
        background: #f8fafc;
        border-top: 1px solid #f0f2f6;
    }

    .sopa-metric {
        text-align: center;
        min-width: 0;
    }

    .sopa-metric-lbl {
        display: block;
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
        margin-bottom: 0.2rem;
    }

    .sopa-metric-val {
        font-size: 0.875rem;
        font-weight: 700;
        color: #0f172a;
        word-break: break-word;
    }

    .sopa-card-foot {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        padding: 0.65rem 1.15rem 1rem;
        background: linear-gradient(180deg, #fafbfc 0%, #fff 100%);
        border-top: 1px solid #f0f2f6;
    }

    .sopa-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.8125rem;
        font-weight: 700;
        padding: 0.45rem 1rem;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .sopa-btn:active {
        transform: scale(0.98);
    }

    .sopa-btn--primary {
        background: linear-gradient(180deg, #10b981 0%, #059669 100%);
        color: #fff;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
    }

    .sopa-btn--primary:hover {
        color: #fff;
        box-shadow: 0 6px 18px rgba(16, 185, 129, 0.4);
    }

    .sopa-empty {
        text-align: center;
        padding: 2rem 1rem;
        color: #64748b;
        font-size: 0.9rem;
        background: #fff;
        border-radius: 14px;
        border: 1px dashed #e2e8f0;
    }

    .sopa-paginator {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.5rem 1rem;
        margin-top: 1rem;
        padding: 0.5rem 0;
    }

    .sopa-paginator__info {
        font-size: 0.8125rem;
        color: #475569;
        font-weight: 600;
    }

    .sopa-paginator__nav {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .sopa-paginator__btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: none;
        background: #667eea;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.7rem;
        transition: opacity 0.15s ease;
    }

    .sopa-paginator__btn:hover:not(:disabled) {
        opacity: 0.88;
    }

    .sopa-paginator__btn:disabled {
        opacity: 0.35;
        cursor: not-allowed;
    }

    .sopa-page-size {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.8125rem;
        color: #475569;
    }

    .sopa-page-size select {
        padding: 0.2rem 0.4rem;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
    }

    @@media (max-width: 575.98px) {
        .sopa-metrics {
            grid-template-columns: repeat(2, 1fr);
        }

        .sopa-card-head {
            flex-direction: column;
            align-items: stretch;
            gap: 0.65rem;
        }

        .sopa-company-block {
            flex: 0 0 auto;
        }

        .sopa-amount-block {
            text-align: left;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.5rem;
        }

        .sopa-status {
            margin-top: 0;
        }

        .sopa-card-foot {
            justify-content: stretch;
        }

        .sopa-btn {
            flex: 1 1 auto;
            justify-content: center;
            width: 100%;
        }
    }
</style>

<!-- PAGE HEADER -->
<div class="pla-header section-entry-animation">
    <div>
        <h5><i class="fa fa-clipboard-check me-2"></i><span id="fmsPageTitle">FMS Report Approval</span></h5>
        <small id="fmsPageSubtitle">Review and verify pending indent items</small>
    </div>
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
        <div class="pla-stat-chip">
            <div class="val" id="statPendingFMS">—</div>
            <div class="lbl">Pending</div>
        </div>
    </div>
</div>

<div id="FMSReportList" class="fmsr-list-wrap section-entry-animation">
    <div id="FMSReportCards" class="sopa-cards" role="list"></div>
    <div id="fmsr-cards-paginator" class="sopa-paginator"></div>
</div>

<div class="table-wrapper fixed-height-table d-none" aria-hidden="true">
    <table id="FMSReport" class="fixed-width-table table">
        <thead id="table-header-FMSReport">
        </thead>
        <tbody id="table-body-FMSReport">
        </tbody>
    </table>
</div>
<div class="paginator d-none" id="paginator-FMSReport" aria-hidden="true">
</div>
