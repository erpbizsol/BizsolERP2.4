@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />





<div class="row">
    <div class="col-sm-3">
        <label for="txtSacnQRText">Sacn Text</label>
        <input type="text" class="form-control form-control-sm" id="txtSacnQRText" autocomplete="off">
    </div>
    <div class="col-sm-6 without-label-field">

        <a class="btn btn-secondary btn-height" id="btnScanQR" onclick="QRQualityCheck_btnScanQR()">
