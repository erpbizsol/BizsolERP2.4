</div>
<div class="table-wrapper mt-2 fixed-height-table">
    <table id="tbQRQualityCheck" class="table fixed-width-table">
        <thead id="tbQRQualityCheckHeader">
        </thead>
        <tbody id="tbQRQualityCheckBody">
        </tbody>
    </table>
</div>
<div class="paginator" id="paginator-tbQRQualityCheck">
</div>

<div id="DivScanQRCodeByCameraControlModal"></div>

<script src="~/_content/Bizsol.WebERP.UI.Shared/js/BizSolInputControl.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
