@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />





<div class="row">
    <div class="col-sm-3">
        <label for="from-date">From Date</label>
        <input type="date" class="form-control form-control-sm" id="txtFromDate" onchange="GateEntryGirdByDates()">
    </div>
    <div class="col-sm-3">
        <label for="to-date">To Date</label>
        <input type="date" class="form-control form-control-sm" id="txtToDate" onchange="GateEntryGirdByDates()">
    </div>
    <div class="col-sm-6 text-end">

        <button type="button" class="btn btn-primary icon-height">Show</button>
        @* <button type="button" class="btn btn-primary icon-height">DOWNLOAD</button> *@

    </div>
</div>
<div class="table-wrapper mt-2">
    <table id="tbGateEntyVehiclesStatus" class="table fixed-width-table">
        <thead id="tbGateEntyVehiclesStatusHeader">
        </thead>
        <tbody id="tbGateEntyVehiclesStatusBody">
        </tbody>
    </table>
</div>
<div class="paginator" id="paginator-tbGateEntyVehiclesStatus">
</div>


<script src="~/_content/Bizsol.WebERP.UI.Shared/js/BizSolInputControl.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Purchase.Transactions/Script/VehiclesStatus.js"></script>

