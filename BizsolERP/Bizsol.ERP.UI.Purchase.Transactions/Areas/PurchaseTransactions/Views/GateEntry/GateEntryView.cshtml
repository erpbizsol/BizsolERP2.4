                <div class="col-sm-6" id="DivfrmEmptyOut">
                    <div class="row">
                        <div class="col-4">
                            Date Out
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyOut_txtDateOut" class="BizSolFormControl form-control form-control-sm" type="date" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off" readonly>
                        </div>
                    </div>
                    <div class="row" id="RowfrmEmptyOutVehicleEmptyWeight">
                        <div class="col-4">
                            Vehicle Empty Weight(KG)
                        </div>
                        <div class="col-8">
                            
                            <input id="frmEmptyOut_txtVehicleEmptyWeight" class="BizSolFormControl form-control form-control-sm" type="text" onchange="BizSolInputControl.OnChangeFloatTextBox(this,2)" onkeypress="return BizSolInputControl.OnKeyDownPressFloatTextBox(event,this);" autocomplete="off">
                        </div>
                    </div>
                    <div class="row" id="RowfrmEmptyOutWeightmentSlipNoLoaded">
                        <div class="col-4">
                            Weightment Slip No.(Empty)
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyOut_txtWeightmentSlipNoLoaded" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            Vehicle Out Time
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyOut_txtOutTime" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off" readonly>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Vehicle Photo
                        </div>
                        <div class="col-8">
                            <div class="input-group">
                                <span class="input-group-text" onclick="document.getElementById('frmEmptyOut_fileVehiclePhoto').click()" style="cursor: pointer;height: 28px;">
                                    <i class="fa fa-camera"></i>
                                </span>
                                <input id="frmEmptyOut_fileVehiclePhoto" asp-for="Attachment" type="file" accept=".jpg, .png, .jpeg" class="form-control form-control-sm" onkeypress="BizSolhandleEnterKey(event)" />
                            </div>

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Remarks
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyOut_txtRemarks" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12 text-end">
                            <button type="button" id="frmEmptyOut_btnSave" class="btn btn-primary icon-height" onclick="GateEntry_SaveData('UpdateLoadedInSave')">Save</button> &nbsp;
                            <button type="button" id="frmEmptyOut_btnCancel" class="btn btn-danger icon-height" onclick="GateEntyMode_GateEntry('grid','')">Cancel</button>
