                            <input id="frmLoadedIn_txtEWayBillNo" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            E-Way Bill Date.
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedIn_txtEWayBillDate" class="BizSolFormControl form-control form-control-sm" type="date" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Remarks
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedIn_txtRemarks" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
