@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Purchase.Transactions/Script/ProjectCategoryMaster.js"></script>

<style>
    .pcm-page { font-family: 'Segoe UI', system-ui, sans-serif; padding: 4px 0 32px; }
    .pcm-hero { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; margin-bottom: 20px; }
    .pcm-hero-left { display: flex; align-items: center; gap: 14px; }
    .pcm-hero-icon { width: 50px; height: 50px; border-radius: 14px; background: var(--primary-gradient); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 22px; box-shadow: var(--shadow-primary); }
    .pcm-hero-title { font-size: 21px; font-weight: 800; color: var(--text-dark); }
    .pcm-card { background: var(--white-bg); border: 1px solid var(--border-color); border-radius: 20px; box-shadow: var(--shadow-md); overflow: hidden; position: relative; }
    .pcm-card::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--primary-gradient); }
    .pcm-card-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 18px 22px 16px; border-bottom: 1px solid var(--border-light); }
    .pcm-search-wrap { position: relative; flex: 1; min-width: 200px; max-width: 340px; }
    .pcm-search-wrap i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
    #pcmSearch { width: 100%; padding: 9px 14px 9px 38px; border-radius: 10px; border: 1.5px solid var(--border-color); font-size: 13.5px; outline: none; background: var(--light-bg); }
    #pcmSearch:focus { border-color: var(--accent-primary); background: #fff; box-shadow: 0 0 0 3px rgba(102,126,234,.15); }
    .pcm-btn-new { display: inline-flex; align-items: center; gap: 8px; border: none; padding: 10px 22px; border-radius: 12px; background: var(--primary-gradient); color: #fff; font-size: 14px; font-weight: 700; cursor: pointer; box-shadow: var(--shadow-primary); }
    .pcm-table-wrap { overflow-x: auto; max-height: calc(100vh - 280px); overflow-y: auto; }
    .pcm-table { width: 100%; border-collapse: collapse; font-size: 13.5px; min-width: 760px; }
    .pcm-table thead {
        position: sticky;
        top: 0;
        z-index: 4;
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
        --bs-table-bg: transparent;
        --bs-table-striped-bg: transparent;
        --bs-table-hover-bg: transparent;
    }
    .pcm-table thead th {
        color: #fff !important;
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
        background-color: #667eea !important;
        font-weight: 700;
        padding: 13px 16px;
        text-align: left;
        white-space: nowrap;
        border: none !important;
        font-size: 12px;
        letter-spacing: .04em;
        text-transform: uppercase;
        position: sticky;
        top: 0;
        z-index: 5;
    }
    .pcm-table thead th.center { text-align: center; }
    .pcm-table tbody tr:nth-child(even) { background: var(--light-bg) !important; }
    .pcm-table tbody tr:hover { background: rgba(102,126,234,.07) !important; }
    .pcm-table td { padding: 12px 16px; border-bottom: 1px solid var(--border-light) !important; vertical-align: middle; }
    .pcm-table td.center { text-align: center; }
    .pcm-sno { width: 28px; height: 28px; border-radius: 8px; background: var(--primary-gradient); color: #fff; font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
    .pcm-yesno { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
    .pcm-yesno.y { background: rgba(16,185,129,.12); color: #059669; border: 1px solid rgba(16,185,129,.25); }
    .pcm-yesno.n { background: rgba(148,163,184,.15); color: #64748b; border: 1px solid rgba(148,163,184,.25); }
    .pcm-actions { display: flex; gap: 6px; justify-content: center; }
    .pcm-icon-btn { width: 32px; height: 32px; border-radius: 9px; border: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; }
    .pcm-icon-btn.view { background: rgba(6,182,212,.12); color: var(--accent-info); border: 1px solid rgba(6,182,212,.25); }
    .pcm-icon-btn.edit { background: rgba(102,126,234,.12); color: var(--accent-primary); border: 1px solid rgba(102,126,234,.25); }
    .pcm-icon-btn.del { background: rgba(239,68,68,.1); color: #ef4444; border: 1px solid rgba(239,68,68,.2); }
    .pcm-empty { text-align: center; padding: 56px 20px; }
    .pcm-modal .modal-content { border-radius: 20px; border: 1px solid var(--border-color); box-shadow: var(--shadow-xl); overflow: hidden; }
    .pcm-modal .modal-header { background: var(--primary-gradient); color: #fff; border-bottom: none; padding: 18px 22px; display: flex; align-items: center; gap: 12px; }
    .pcm-modal .modal-title { color: #fff; font-weight: 700; font-size: 17px; margin: 0; flex: 1; }
    .pcm-close-btn { background: rgba(255,255,255,.15); border: none; color: #fff; width: 34px; height: 34px; border-radius: 9px; cursor: pointer; }
    .pcm-modal .modal-body { padding: 22px 24px; background: var(--light-bg); }
    .pcm-modal .modal-footer { border-top: 1px solid var(--border-color); padding: 14px 24px; display: flex; justify-content: flex-end; gap: 10px; background: var(--white-bg); }
    .pcm-form-section { background: var(--white-bg); border-radius: 14px; border: 1px solid var(--border-color); padding: 20px; }
    .pcm-form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 18px; }
    .pcm-fg { display: flex; flex-direction: column; gap: 6px; }
    .pcm-fg.span2 { grid-column: span 2; }
    .pcm-fg label { font-size: 12.5px; font-weight: 700; color: var(--text-primary); }
    .pcm-fg input, .pcm-fg select { padding: 10px 13px; border-radius: 10px; border: 1.5px solid var(--border-color); font-size: 13.5px; outline: none; width: 100%; box-sizing: border-box; }
    .pcm-fg input:focus, .pcm-fg select:focus { border-color: var(--accent-primary); box-shadow: 0 0 0 3px rgba(102,126,234,.15); }
    .pcm-fg input[readonly] { background: var(--light-bg); color: var(--text-muted); cursor: not-allowed; }
    .pcm-check-row { display: flex; flex-wrap: wrap; gap: 18px 28px; grid-column: span 2; padding-top: 4px; }
    .pcm-check-item { display: inline-flex; align-items: center; gap: 10px; cursor: pointer; user-select: none; margin: 0; font-size: 13.5px; font-weight: 600; color: var(--text-dark); }
    .pcm-check-item input[type="checkbox"] { width: 18px; height: 18px; margin: 0; cursor: pointer; accent-color: var(--accent-primary); flex-shrink: 0; }
    .pcm-btn { display: inline-flex; align-items: center; gap: 7px; border: none; padding: 10px 24px; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; min-height: 40px; }
    .pcm-btn.primary { background: var(--primary-gradient); color: #fff; box-shadow: var(--shadow-primary); }
    .pcm-btn.secondary { background: var(--light-bg); color: var(--text-muted); border: 1.5px solid var(--border-color); }
    .pcm-btn.danger { background: linear-gradient(135deg, #ef4444, #f87171); color: #fff; }
    .pcm-view-row { display: flex; gap: 12px; margin-bottom: 12px; }
    .pcm-view-lbl { font-size: 11.5px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; min-width: 180px; }
    .pcm-view-val { font-size: 14px; font-weight: 600; color: var(--text-dark); }
    .pcm-view-divider { height: 1px; background: var(--border-light); margin: 10px 0; }
    @@media (max-width: 580px) { .pcm-form-grid { grid-template-columns: 1fr; } .pcm-fg.span2 { grid-column: span 1; } }
</style>

<div class="pcm-page">
    <div class="pcm-hero">
        <div class="pcm-hero-left">
            <div class="pcm-hero-icon"><i class="fas fa-tags"></i></div>
            <div class="pcm-hero-title">Project Category Master</div>
        </div>
        <button class="pcm-btn-new" id="btnCreateCategory" type="button">
            <span>+</span><span>New Category</span>
        </button>
    </div>

    <div class="pcm-card">
        <div class="pcm-card-toolbar">
            <div class="pcm-search-wrap">
                <i class="fas fa-search"></i>
                <input type="text" id="pcmSearch" placeholder="Search by name or description…" autocomplete="off" />
            </div>
        </div>
        <div class="pcm-table-wrap">
            <table class="pcm-table" id="tblProjectCategory">
                <thead>
                    <tr>
                        <th class="center" style="width:60px;">#</th>
                        <th style="min-width:120px;">Category</th>
                        <th style="min-width:220px;">Project Description</th>
                        <th class="center" style="min-width:110px;">Tol. Qty</th>
                        <th class="center" style="min-width:110px;">Tol. Rate</th>
                        <th class="center" style="min-width:110px;">Tol. Amount</th>
                        <th class="center" style="width:115px;">Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create / Edit -->
<div class="modal fade pcm-modal" id="dvCategoryModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" style="max-width:560px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="category-modal-title">New Project Category</h5>
                <button type="button" class="pcm-close-btn" data-bs-dismiss="modal" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <div class="pcm-form-section">
                    <div class="pcm-form-grid">
                        <div class="pcm-fg">
                            <label for="txtCategoryName">Category <span class="text-danger">*</span></label>
                            <input type="text" id="txtCategoryName" maxlength="50" placeholder="e.g. A, B, C" autocomplete="off" />
                        </div>
                        <div class="pcm-fg span2">
                            <label for="txtProjectDesp">Project Description <span class="text-danger">*</span></label>
                            <input type="text" id="txtProjectDesp" maxlength="80" placeholder="Same as category" autocomplete="off" readonly />
                        </div>
                        <div class="pcm-check-row">
                            <label class="pcm-check-item" for="chkTolOnQty">
                                <input type="checkbox" id="chkTolOnQty" />
                                <span>Tolerance on PO Qty</span>
                            </label>
                            <label class="pcm-check-item" for="chkTolOnRate">
                                <input type="checkbox" id="chkTolOnRate" />
                                <span>Tolerance on PO Rate</span>
                            </label>
                            <label class="pcm-check-item" for="chkTolOnAmount">
                                <input type="checkbox" id="chkTolOnAmount" />
                                <span>Tolerance on PO Amount</span>
                            </label>
                        </div>
                    </div>
                    <input type="hidden" id="hfCategoryCode" value="0" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="pcm-btn secondary" data-bs-dismiss="modal"><i class="fas fa-times"></i> Cancel</button>
                <button type="button" class="pcm-btn primary" id="btnSaveCategory"><i class="fas fa-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>

<!-- View -->
<div class="modal fade pcm-modal" id="dvCategoryViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
        <div class="modal-content">
            <div class="modal-header" style="background: var(--info-gradient);">
                <h5 class="modal-title">Category Details</h5>
                <button type="button" class="pcm-close-btn" data-bs-dismiss="modal"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <div class="pcm-form-section">
                    <div class="pcm-view-row"><span class="pcm-view-lbl">Category</span><span class="pcm-view-val" id="viewCategoryName">—</span></div>
                    <div class="pcm-view-divider"></div>
                    <div class="pcm-view-row"><span class="pcm-view-lbl">Project Description</span><span class="pcm-view-val" id="viewProjectDesp">—</span></div>
                    <div class="pcm-view-divider"></div>
                    <div class="pcm-view-row"><span class="pcm-view-lbl">Tolerance on PO Qty</span><span class="pcm-view-val" id="viewTolOnQty">—</span></div>
                    <div class="pcm-view-divider"></div>
                    <div class="pcm-view-row"><span class="pcm-view-lbl">Tolerance on PO Rate</span><span class="pcm-view-val" id="viewTolOnRate">—</span></div>
                    <div class="pcm-view-divider"></div>
                    <div class="pcm-view-row"><span class="pcm-view-lbl">Tolerance on PO Amount</span><span class="pcm-view-val" id="viewTolOnAmount">—</span></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="pcm-btn secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete -->
<div class="modal fade pcm-modal" id="dvDeleteConfirmModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg,#dc2626,#ef4444);">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="pcm-close-btn" data-bs-dismiss="modal"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body" style="background:#fff;">
                <label for="reasonForDeleteInput" style="font-size:12.5px; font-weight:700;">Reason for Deletion <span class="text-danger">*</span></label>
                <input type="text" id="reasonForDeleteInput" class="form-control mt-2" placeholder="Enter reason for deletion" autocomplete="off" />
                <input type="hidden" id="hfDeleteCode" value="0" />
            </div>
            <div class="modal-footer">
                <button type="button" class="pcm-btn secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="pcm-btn danger" id="btnConfirmDelete"><i class="fas fa-trash-alt"></i> Delete</button>
            </div>
        </div>
    </div>
</div>
