                </button>
                <button type="button" class="btn btn-sm btn-danger" id="gpaBtnConfirmDelete"
                        style="border-radius:8px;padding:6px 18px;background:linear-gradient(135deg,#ef4444,#dc2626);border:none;">
                    <i class="fa fa-trash me-1"></i> Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ── ATTACHMENT CONTROL PLACEHOLDER ── -->
<div id="GRNPaymentEntry_AttachmentControlmodal"></div>

<script>
    (function () {
        const sidebar = document.getElementById('modern-sidebar');
      
        const bar = document.getElementById('floatBar');
        if (!sidebar || !bar) return;
        function syncMargin() {
            if (window.innerWidth <= 768) { bar.style.marginLeft = ''; return; }
            bar.style.marginLeft = sidebar.classList.contains('collapsed') ? '70px' : '280px';
        }
        syncMargin();
        new MutationObserver(syncMargin).observe(sidebar, { attributes: true, attributeFilter: ['class'] });
        window.addEventListener('resize', syncMargin);
    })();
</script>
