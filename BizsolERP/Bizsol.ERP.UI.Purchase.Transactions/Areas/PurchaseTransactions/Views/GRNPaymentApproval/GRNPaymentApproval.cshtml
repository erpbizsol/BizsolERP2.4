    .gpa-pay-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 10px;
        font-size: 0.74rem;
        color: #64748b;
    }
    .gpa-pay-level-chip {
        background: rgba(102,126,234,0.08);
        border: 1px solid rgba(102,126,234,0.18);
        border-radius: 6px;
        padding: 1px 7px;
        color: #667eea;
        font-weight: 600;
    }
    .gpa-pay-card-right {
        flex-shrink: 0;
        text-align: right;
        display: flex;
        flex-direction: column;
        gap: 5px;
        align-items: flex-end;
    }
    .gpa-pay-amount { font-size: 0.92rem; font-weight: 800; color: #667eea; }
    .gpa-pay-status-badge {
        font-size: 0.68rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        display: inline-block;
    }
    .gpa-pay-card-levels {
        padding: 8px 16px 10px;
        border-top: 1px solid #f0f4ff;
        background: #fafbff;
    }
    .gpa-pay-level-label {
        font-size: 0.73rem;
        color: #64748b;
        margin-bottom: 8px;
    }
    .gpa-stepper {
        display: flex;
        align-items: center;
        overflow-x: auto;
        gap: 0;
        padding-bottom: 2px;
    }
    .gpa-step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        flex-shrink: 0;
    }
    .gpa-step-circle {
        width: 28px; height: 28px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.72rem; font-weight: 800;
        border: 2px solid transparent;
        transition: all 0.2s;
    }
    .gpa-step-done     { background: linear-gradient(135deg,#10b981,#059669); color:#fff; box-shadow:0 2px 8px rgba(16,185,129,0.35); }
    .gpa-step-active   { background: linear-gradient(135deg,#667eea,#764ba2); color:#fff; box-shadow:0 2px 8px rgba(102,126,234,0.4); animation: gpePulseStep 1.6s infinite; }
    .gpa-step-rejected { background: linear-gradient(135deg,#dc2626,#ef4444); color:#fff; box-shadow:0 2px 8px rgba(220,38,38,0.35); }
    .gpa-step-pending  { background: #f1f5f9; color:#94a3b8; border-color:#e2e8f0; }
    @@keyframes gpePulseStep {
        0%,100% { box-shadow: 0 2px 8px rgba(102,126,234,0.4); }
        50%     { box-shadow: 0 2px 18px rgba(102,126,234,0.75); }
    }
    .gpa-step-lbl { font-size: 0.63rem; color: #94a3b8; font-weight: 600; }
    .gpa-step-connector {
        flex: 1; height: 3px; min-width: 18px; max-width: 56px;
        border-radius: 2px; margin-bottom: 12px;
    }
    .gpa-step-line-done    { background: linear-gradient(90deg,#10b981,#059669); }
    .gpa-step-line-pending { background: #e2e8f0; }
    .gpa-pay-card-footer {
        padding: 8px 16px 12px;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .gpa-pay-card-print-btns {
        display: flex;
        gap: 6px;
        align-items: center;
        flex-wrap: wrap;
    }
    .btn-gpa-print-icon {
        width: 36px; height: 32px;
        border: none; border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        cursor: pointer; font-size: 0.85rem;
        transition: transform 0.15s, box-shadow 0.15s;
    }
    .btn-gpa-print-prev {
        background: #64748b; color: #fff;
        box-shadow: 0 2px 8px rgba(100,116,139,0.35);
    }
    .btn-gpa-print-go {
        background: #1e293b; color: #fff;
        box-shadow: 0 2px 8px rgba(30,41,59,0.35);
    }
    .btn-gpa-print-icon:hover { transform: translateY(-1px); color: #fff; }
    @@media (max-width: 600px) {
        .gpa-pay-card-header { flex-wrap: wrap; }
        .gpa-pay-card-right { flex-direction: row; align-items: center; }
        .gpa-pay-card-footer { flex-direction: column; align-items: stretch; }
        .gpa-pay-card-print-btns { width: 100%; justify-content: flex-start; }
    }
</style>

