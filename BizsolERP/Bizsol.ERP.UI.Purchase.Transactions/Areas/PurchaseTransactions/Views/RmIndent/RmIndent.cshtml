@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Purchase.Transactions/Script/RmIndent.js"></script>
<style>
    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
    }

    .form-control, .form-select {
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

    .btn-height{
        height: 28px;
    }

    #locateIndentMaster .rmi-filter-row {
        --rmi-lbl-h: 20px;
        --rmi-field-h: 32px;
    }

    #locateIndentMaster .rmi-field {
        display: flex;
        flex-direction: column;
    }

    #locateIndentMaster .rmi-field > label,
    #locateIndentMaster .rmi-field > .rmi-lbl-space {
        display: block;
        height: var(--rmi-lbl-h);
        line-height: var(--rmi-lbl-h);
        margin: 0 0 4px 0;
        white-space: nowrap;
        overflow: hidden;
    }

    #locateIndentMaster .rmi-control {
        position: relative;
        height: var(--rmi-field-h);
        min-height: var(--rmi-field-h);
        max-height: var(--rmi-field-h);
    }

    #locateIndentMaster .rmi-control > .form-control,
    #locateIndentMaster .rmi-control > .form-control-sm,
    #locateIndentMaster .rmi-control > select,
    #locateIndentMaster .rmi-control > input,
    #locateIndentMaster .rmi-control > .select2-container,
    #locateIndentMaster .rmi-control > .btn {
        position: absolute;
        top: 0;
        left: 0;
        height: var(--rmi-field-h) !important;
        min-height: var(--rmi-field-h) !important;
        max-height: var(--rmi-field-h) !important;
        margin: 0 !important;
        box-sizing: border-box !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        line-height: 30px !important;
    }

    #locateIndentMaster .rmi-control > .form-control,
    #locateIndentMaster .rmi-control > .form-control-sm,
    #locateIndentMaster .rmi-control > select,
    #locateIndentMaster .rmi-control > input,
    #locateIndentMaster .rmi-control > .select2-container {
        right: 0;
        width: 100% !important;
    }

    #locateIndentMaster .rmi-control > .btn {
        right: auto;
        width: auto !important;
        padding-left: 14px !important;
        padding-right: 14px !important;
    }

    #locateIndentMaster .rmi-control .select2-container .select2-selection--single {
        height: var(--rmi-field-h) !important;
        min-height: var(--rmi-field-h) !important;
        box-sizing: border-box !important;
    }

    #locateIndentMaster .rmi-control .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 30px !important;
    }

    #locateIndentMaster .rmi-control .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 30px !important;
        top: 0;
    }

    #tblRMIndent {
        width: 100%;
        max-width: 100%;
    }

    #tblRMIndent .table-wrapper {
        width: 100%;
        max-width: 100%;
        display: block;
    }

    #paginator-RMIndent {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }

    /* Phone: lock to screen height so table scrolls and paginator stays visible */
    @@media (max-width: 768px) {
        #locateIndentMaster {
            height: var(--rmi-screen-h, calc(100dvh - 210px));
            max-height: var(--rmi-screen-h, calc(100dvh - 210px));
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-width: 0;
            box-sizing: border-box;
        }

        #locateIndentMaster > .card {
            flex: 0 0 auto;
            margin-bottom: 0.4rem;
        }

        #locateIndentMaster .card-body {
            padding: 0.45rem 0.65rem !important;
        }

        #locateIndentMaster .rmi-show-btn {
            margin-top: 0 !important;
        }

        #locateIndentMaster > .rmi-grid-row {
            flex: 1 1 auto;
            min-height: 0;
            min-width: 0;
            width: 100%;
            margin-left: 0;
            margin-right: 0;
            display: flex;
            flex-direction: column;
        }

        #locateIndentMaster > .rmi-grid-row > [class*="col-"] {
            flex: 1 1 auto;
            min-height: 0;
            min-width: 0;
            width: 100%;
            max-width: 100%;
            padding-left: 0;
            padding-right: 0;
            display: flex;
            flex-direction: column;
        }

        #tblRMIndent {
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
            min-height: 0;
            min-width: 0;
            width: 100%;
            max-width: 100%;
            overflow: hidden;
        }

        #tblRMIndent .table-wrapper,
        #tblRMIndent .fixed-height-table,
        #tblRMIndent .table-wrapper.filtered {
            flex: 1 1 auto;
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            height: auto !important;
            max-height: none !important;
            min-height: 0 !important;
            overflow: auto !important;
            display: block !important;
            -webkit-overflow-scrolling: touch;
        }

        #paginator-RMIndent {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: wrap;
            align-items: center;
            flex: 0 0 auto;
            width: 100% !important;
            max-width: 100%;
            min-width: 0;
            margin-top: 4px;
            margin-bottom: 0;
            padding: 8px 4px 10px;
            background: #fff;
            border-top: 1px solid #e8eef6;
            position: relative;
            z-index: 6;
        }

        #paginator-RMIndent .page-size-select,
        #paginator-RMIndent .page-info {
            margin: 0 6px 0 0;
        }
    }
</style>
<div id="locateIndentMaster">
    <div class="card col-md-12">
        <div class="card-body">
            <div class="row g-2 rmi-filter-row">
                <div class="col-6 col-md-2 rmi-field">
                    <label for="ddlStatus" class="col-form-label-sm fw-bold">Status:<span class="text-danger">*</span></label>
                    <div class="rmi-control">
                        <select id="ddlStatus" name="ddlStatus" class="box_border form-control form-control-sm" required></select>
                    </div>
                </div>
                <div class="col-6 col-md-2 rmi-field">
                    <label for="txtDateType" class="col-form-label-sm fw-bold">Date Type:<span class="text-danger">*</span></label>
                    <div class="rmi-control">
                        <select id="txtDateType" name="txtDateType" class="box_border form-control form-control-sm" required>
                            <option value="Purchased Date" >Purchased Date</option>
                            <option value="Indent Date" selected>Indent Date</option>
                        </select>
                    </div>
                </div>
                <div class="col-6 col-md-2 rmi-field">
                    <label for="txtFromDate" class="col-form-label-sm fw-bold">From Date:<span class="text-danger">*</span></label>
                    <div class="rmi-control">
                        <input type="date" id="txtFromDate" name="txtFromDate" class="box_border form-control form-control-sm" required />
                    </div>
                </div>
                <div class="col-6 col-md-2 rmi-field">
                    <label for="txtToDate" class="col-form-label-sm fw-bold">To Date:<span class="text-danger">*</span></label>
                    <div class="rmi-control">
                        <input type="date" id="txtToDate" name="txtToDate" class="box_border form-control form-control-sm" required />
                    </div>
                </div>
                <div class="col-12 col-md-2 rmi-field rmi-show-btn">
                    <span class="rmi-lbl-space" aria-hidden="true">&nbsp;</span>
                    <div class="rmi-control">
                        <button type="button" onclick="ListStatus_IndentMaster()" title="Show" class="btn btn-primary btn-height">Show</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
<div class="row rmi-grid-row">
    <div class="col-md-12">
        <div id="tblRMIndent">
            <div class="table-wrapper fixed-height-table">
                <table id="RMIndent" class="table">
                    <thead id="table-header-RMIndent">
                    </thead>
                    <tbody id="table-body-RMIndent">
                    </tbody>
                </table>
            </div>
            <div class="paginator" id="paginator-RMIndent">
            </div>
        </div>
    </div>
</div>
</div>
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-lg">
            <div class="modal-header">
                <h5 class="modal-title">Vender Entry Details</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                            <label for="ddlVenderName" class="col-form-label-sm fw-bold">Vender Name:<span class="text-danger">*</span></label>
                            <select id="ddlVenderName" name="ddlVenderName" class="box_border form-control form-control-sm" required></select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                            <label for="txtQtyMT" class="col-form-label-sm fw-bold">Qty MT:<span class="text-danger">*</span></label>
                            <input id="txtQtyMT" name="txtQtyMT" class="box_border form-control form-control-sm text-end" oninput="validateDecimalInput(this)" autocomplete="off" required />
                            <input id="hfCode" type="hidden" name="txtQtyMT" class="box_border form-control form-control-sm" autocomplete="off" required />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="txtGrade" class="col-form-label-sm fw-bold">Grade:<span class="text-danger">*</span></label>
                            <input id="txtGrade" name="txtGrade" class="box_border form-control form-control-sm" readonly/>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="txtMake" class="col-form-label-sm fw-bold">Make:<span class="text-danger">*</span></label>
                            <input id="txtMake" name="txtMake" class="box_border form-control form-control-sm" readonly/>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                            <label for="txtWidth" class="col-form-label-sm fw-bold">Width:<span class="text-danger">*</span></label>
                            <input id="txtWidth" name="txtWidth" class="box_border form-control form-control-sm" readonly/>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="txtRate" class="col-form-label-sm fw-bold">Rate:<span class="text-danger">*</span></label>
                            <input id="txtRate" name="txtRate" class="box_border form-control form-control-sm text-end" oninput="validateDecimalRateInput(this)" autocomplete="off" required />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                            <label for="txtRemarks" class="col-form-label-sm fw-bold">Remarks:<span class="text-danger">*</span></label>
                            <input id="txtRemarks" name="txtRemarks" class="box_border form-control form-control-sm" autocomplete="off" required />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                            <label for="txtSizeControl" class="col-form-label-sm fw-bold">Update Size :<span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input id="txtSizeControl" name="txtSizeControl" class="box_border form-control form-control-sm" readonly/>&nbsp;
                                <button type="button" id="btnShowSizeControl" class="btn btn-primary btn-height" title="New Size" onclick="ShowSizeControlModal(this);"> <i class="fa fa-plus-square"></i></button>
                            </div>
                            <input id="hfSizeControlCode" type="hidden" name="hfSizeControlCode"/>
                            <input id="hfItemMasterCode" type="hidden" name="hfItemMasterCode"/>
                    </div>
                </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success icon-height" onclick="SaveModal_IndentMaster()">Verify</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseModal_IndentMaster()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div id="DivSizeControlmodal"></div>