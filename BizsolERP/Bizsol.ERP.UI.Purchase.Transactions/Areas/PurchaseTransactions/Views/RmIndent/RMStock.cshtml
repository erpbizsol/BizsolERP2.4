@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Purchase.Transactions/Script/RMStock.js"></script>

<style>
    .nav-tabs .nav-link {
        border: 1px solid transparent;
        border-top-left-radius: 0.375rem;
        border-top-right-radius: 0.375rem;
        color: #6c757d;
        font-weight: 500;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .nav-tabs .nav-link:hover {
        border-color: #e9ecef #e9ecef #dee2e6;
        color: #495057;
        background-color: #f8f9fa;
    }
    
    .nav-tabs .nav-link.active {
        color: #fff;
        background-color: #007bff;
        border-color: #007bff #007bff #fff;
        font-weight: 600;
    }
    
    .nav-tabs .nav-link {
        color: #6c757d;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        margin:2px;
    }
    
    .nav-tabs .nav-link:hover:not(.active) {
        color: #495057;
        background-color: #e9ecef;
        border-color: #adb5bd;
    }
    
    .nav-tabs .nav-link i {
        margin-right: 0.5rem;
    }
    
    .tab-content {
        border: 1px solid #dee2e6;
        border-top: none;
        border-radius: 0 0 0.375rem 0.375rem;
        padding: 1.5rem;
        background-color: #fff;
    }
    
    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
    
    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }
    
    .card-title {
        color: #495057;
        font-weight: 600;
    }
    
    .table th {
        background-color: #f8f9fa;
        border-top: none;
        font-weight: 600;
        color: white;
    }
    
    .btn-height {
        height: 25px;
        line-height: 1;
    }
    
    .icon-height {
        height: 25px;
        /* padding: 0.5rem 1rem; */
    }
    
    .text-end {
        text-align: right;
    }
    
    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
    }
    
    .form-control, .form-select {
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    
    .box_border {
        border: 1px solid #ced4da !important;
    }
    
    .text-danger {
        color: #dc3545 !important;
    }
    
    .text-primary {
        color: #0d6efd !important;
    }
    
    .text-success {
        color: #198754 !important;
    }
    
    .text-warning {
        color: #fd7e14 !important;
    }
    
    .text-info {
        color: #0dcaf0 !important;
    }
    
    .bg-light {
        background-color: #f8f9fa !important;
    }
    
    /* Checkbox styling with background color */
    .form-check-input {
        background-color: #e9ecef;
        border: 2px solid #6c757d;
        border-radius: 4px;
    }
    
    .form-check-input:focus {
        box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25);
    }
    
    .form-check-label {
        font-weight: 600;
        color: #495057;
    }
</style>

