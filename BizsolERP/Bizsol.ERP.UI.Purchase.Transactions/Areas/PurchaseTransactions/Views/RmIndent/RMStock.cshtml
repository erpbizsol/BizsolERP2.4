<!-- Add Source Modal -->
<div class="modal fade" id="PlannedMyModal" tabindex="-1" aria-labelledby="PlannedMyModal" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="PlannedMyModal">Plan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                        <div class="col-sm-12">
                            <div class="form-check">
                                <label class="form-check-label" for="despSize">
                                    Size:
                                </label>
                                <span class="form-check-label1" id="despSize">{despSize}</span>
                            </div>
                        </div>
                 </div>
                <div class="row">
                    <div class="col-sm-3">
                        <div class="">
                            <label for="ddlMachineNo" class="col-form-label-sm fw-bold">Machine No:<span class="text-danger">*</span></label>
                            <select id="ddlMachineNo" name="ddlMachineNo" class="box_border form-control form-control-sm" required></select>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="">
                            <label for="txtDate" class="col-form-label-sm fw-bold">Date:<span class="text-danger">*</span></label>
                            <input id="txtDate" type="date" name="txtDate" class="box_border form-control form-control-sm" autocomplete="off" required />
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="">
                            <label for="txtIdentificationNo" class="col-form-label-sm fw-bold">Identification No:</label>
                            <input id="txtIdentificationNo" name="txtIdentificationNo" class="box_border form-control form-control-sm" readonly/>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="">
                            <label for="txtWidth" class="col-form-label-sm fw-bold">Actual Weight:</label>
                            <input id="txtWidth" name="txtWidth" class="box_border form-control form-control-sm text-end" autocomplete="off" readonly />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="CopyFromPrevious" />
                            <label class="form-check-label" for="CopyFromPrevious">
                                Copy From Previous
                            </label>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="AllowManualWeight" />
                            <label class="form-check-label" for="AllowManualWeight">
                                Allow Manual Weight
                            </label>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="PartingCase" />
                            <label class="form-check-label" for="PartingCase">
                                Parting Case
                            </label>
                        </div>
                    </div>
                    @* <div class="col-sm-4">
                        <div class="form-check">
                            <label class="form-check-label" for="despSize">
                                Size:
                            </label>
                                    <span class="form-check-label1" id="despSize">{despSize}</span>
                        </div>
                    </div> *@
                    <div class="table-responsive">
                        <table id="RMStockCurrentPlanned" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th style="min-width:170px">Item Name</th>
                                    <th style="min-width:170px">Slit Width</th>
                                    <th style="min-width:170px">OD</th>
                                    <th style="min-width:100px">No Of Slits</th>
                                    <th style="min-width:100px">Weight Per Slit</th>
                                    <th>Total Weight</th>
                                    <th style="min-width:80px">Action</th>
                                </tr>

                            </thead>
                            <tbody id="RMStocktbody">
                            </tbody>
                            <tfoot>
                                <tr class="table-info">
                                    <td><strong>Total</strong></td>
                                    <td class="text-end"><strong></strong></td>
                                    <td class="text-end"><strong></strong></td>
                                    <td class="text-end"><strong id="totalNoOfSlits">0</strong></td>
                                    <td class="text-end"><strong id="totalWeightPerSlit">0</strong></td>
                                    <td class="text-end"><strong id="totalWeight">0</strong></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
