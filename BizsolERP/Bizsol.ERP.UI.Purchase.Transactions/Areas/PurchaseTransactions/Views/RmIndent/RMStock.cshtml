<script src="https://cdn.rawgit.com/rainabba/jquery-table2excel/1.1.0/dist/jquery.table2excel.min.js"></script>
<style>
    .fixed-width-table th, .fixed-width-table td {
        white-space: nowrap;
        min-width: auto;
    }
    .nav-tabs .nav-link {
        border: 1px solid transparent;
        border-top-left-radius: 0.375rem;
        border-top-right-radius: 0.375rem;
        color: #6c757d;
        font-weight: 500;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .nav-tabs .nav-link:hover {
            border-color: #e9ecef #e9ecef #dee2e6;
            color: #495057;
            background-color: #f8f9fa;
        }

        .nav-tabs .nav-link.active {
            color: #fff;
            background-color: #007bff;
            border-color: #007bff #007bff #fff;
            font-weight: 600;
        }

    .nav-tabs .nav-link {
        color: #6c757d;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        margin: 2px;
    }

        .nav-tabs .nav-link:hover:not(.active) {
            color: #495057;
            background-color: #e9ecef;
            border-color: #adb5bd;
        }

        .nav-tabs .nav-link i {
            margin-right: 0.5rem;
        }

    .tab-content {
        border: 1px solid #dee2e6;
        border-top: none;
        border-radius: 0 0 0.375rem 0.375rem;
        padding: 1.5rem;
        background-color: #fff;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); 
        margin-bottom: 0.3rem;
    }

    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }

    .card-title {
        color: #495057;
        font-weight: 600;
    }

    .table th {
        background-color: #f8f9fa;
        border-top: none;
        font-weight: 600;
        color: white;
    }

    .btn-height {
        height: 25px;
        line-height: 1;
    }

    .icon-height {
        height: 25px;
        /* padding: 0.5rem 1rem; */
    }

    /* Compact spacing for dispatch date filters */
    .card {
        --bs-card-spacer-y: 0rem !important;
        --bs-card-spacer-x: 1rem !important;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
    }

    .form-control, .form-select {
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

    .box_border {
        border: 1px solid #ced4da !important;
    }

    .text-danger {
        color: #dc3545 !important;
    }

    .text-primary {
        color: #0d6efd !important;
    }

    .text-success {
        color: #198754 !important;
    }

    .text-warning {
        color: #fd7e14 !important;
    }

    .text-info {
        color: #0dcaf0 !important;
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }

    /* Checkbox styling with background color */
    .form-check-input {
        background-color: #e9ecef;
        border: 2px solid #6c757d;
        border-radius: 4px;
    }

        .form-check-input:focus {
            box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25);
        }

    .form-check-label {
        font-weight: 600;
        color: #495057;
    }
    .form-check-label1 {
        font-weight: 200;
        color: #495057;
        background-color: #e9ecef;
        border: 2px solid #6c757d;
        border-radius: 4px;
    }

    .fixed-height-table{
        height:460px;
    }
    #RMStockCurrent tfoot td,
    #RMStockCurrent tfoot th,
    #Slitted tfoot td,
    #Slitted tfoot th,
    #Slitted_Coil_Stock tfoot td,
    #Slitted_Coil_Stock tfoot th,
    #JobWorkData tfoot td,
    #JobWorkData tfoot th,
    #SummaryData tfoot td,
    #SummaryData tfoot th{
        color: #fff !important;
        background-color: #5c95ce !important;
        border-color: #5c95ce !important;
        font-weight: 600;
    }
</style>

