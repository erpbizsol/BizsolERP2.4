 <!-- Add Source Modal -->
<div class="modal fade" id="PlannedMyModal" tabindex="-1" aria-labelledby="PlannedMyModal" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="PlannedMyModal">Plan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="CopyFromPrevious" />
                            <label class="form-check-label" for="CopyFromPrevious">
                                Copy From Previous
                            </label>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="AllowManualWeight" />
                            <label class="form-check-label" for="AllowManualWeight">
                                Allow Manual Weight
                            </label>
                        </div>
                    </div>
                    @* <div class="col-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="PartingCase" />
                            <label class="form-check-label" for="PartingCase">
                                Parting Case
                            </label>
                        </div>
                    </div> *@
                    <div class="table-responsive">
                        <table id="RMStockCurrentPlanned" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th style="min-width:170px">Item Name</th>
                                    <th style ="min-width:170px">Slit Width</th>
                                    <th style="min-width:100px">No Of Slits</th>
                                    <th style="min-width:100px">Weight Per Slit</th>
                                    <th>Total Weight</th>
                                    <th style="min-width:80px">Action</th>
                                </tr>
                                <tr>
                                    <td><select id="ddlItemName" name="ddlItemName" class="box_border form-control form-control-sm" required></select></td>
                                    <td><select id="ddlSlitWidth" name="ddlSlitWidth" class="box_border form-control form-control-sm" required></select></td>
                                    <td><input id="txtNoOfSlits" name="txtNoOfSlits" class="box_border form-control form-control-sm text-end" oninput="validateIntegerInput(this)" autocomplete="off" required /></td>
                                    <td><input id="txtWeightPerSlit" name="txtWeightPerSlit" class="box_border form-control form-control-sm text-end" oninput="validateDecimalRateInput(this)" autocomplete="off" required disabled /></td>
                                    <td><input id="txtTotalWeight" name="txtTotalWeight" class="box_border form-control form-control-sm text-end" required readonly/></td>
                                    <td><button type="button" onclick="Save_PlannedSlitting()" title="Show" class="btn btn-success btn-height"><i class="fas fa-save"></i></button></td>
                                </tr>
                            </thead>
                            <tbody>
                                
                            </tbody>
                            <tfoot>
                                <tr class="table-info">
                                    <td><strong>Total</strong></td>
                                    <td></td>
                                    <td class="text-end"><strong id="totalNoOfSlits">0</strong></td>
                                    <td class="text-end"><strong id="totalWeightPerSlit">0</strong></td>
                                    <td class="text-end"><strong id="totalWeight">0</strong></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger icon-height" onclick="CloseModal_RMStock()">Cancel</button>
            </div>
        </div>
    </div>
</div> 
</div>
<div class="modal fade" id="myModalDelete" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Reason</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <input type="text" id="deleteReason" class="form-control" placeholder="Enter reason" autocomplete="off" />
                <input type="hidden" id="txtcode" class="form-control" placeholder="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success icon-height" onclick="DeleteModal()">Ok</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>
