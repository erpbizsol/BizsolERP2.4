                <a  class="btn btn-secondary btn-sm" data-bs-dismiss="modal"
                        style="border:none;color:#fff;
                               border-radius:8px;padding:7px 18px;font-size:0.82rem;font-weight:700;
                               box-shadow:0 3px 10px rgba(2,132,199,0.3);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;">
                    <i class="fa fa-times me-1"></i>Cancel
                </a>
                <a  onclick="ConfirmPrintPO()"
                        style="background:linear-gradient(135deg,#0ea5e9,#0284c7);border:none;color:#fff;
                               border-radius:8px;padding:7px 18px;font-size:0.82rem;font-weight:700;
                               box-shadow:0 3px 10px rgba(2,132,199,0.3);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;">
                    <i class="fa fa-search-plus me-1"></i>Preview / Print
                </a>
            </div>

        </div>
    </div>
</div>