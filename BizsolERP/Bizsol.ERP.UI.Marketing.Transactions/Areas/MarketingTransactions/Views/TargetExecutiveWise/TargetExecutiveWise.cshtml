            <div>
                <div class="pm-stat-val" id="statTotal">0</div>
                <div class="pm-stat-lbl">Total Records</div>
            </div>
        </div>
        <div class="pm-stat-chip">
            <div class="pm-stat-icon"><i class="fas fa-user-tie"></i></div>
