                <div class="pm-stat-val" id="statLeads">0</div>
                <div class="pm-stat-lbl">Leads Target</div>
            </div>
        </div>
    </div> -->

    <div class="pm-filter-card">
        <div class="pm-filter-grid">
            <div class="pm-fg">
                <label for="ddlMarketingMan">Marketing Man <span class="text-danger">*</span></label>
                <select id="ddlMarketingMan"></select>
            </div>
            <div class="pm-fg">
                <label for="ddlFinYear">Fin Year <span class="text-danger">*</span></label>
                <select id="ddlFinYear"></select>
            </div>
            <div class="pm-fg">
                <label for="ddlMonth">Month</label>
                <select id="ddlMonth"></select>
            </div>
            <div class="pm-fg" style="justify-content:flex-end;">
                <button type="button" class="pm-btn primary" id="btnShow" style="width:100%; justify-content:center;">
                    <i class="fas fa-search"></i> Show
                </button>
            </div>
        </div>
    </div>

    <div class="pm-card">
        <div class="pm-card-toolbar">
            <div class="pm-search-wrap">
                <i class="fas fa-search"></i>
                <input type="text" id="pmSearch" placeholder="Search by marketing man or month…" autocomplete="off" />
            </div>
        </div>

        <div class="pm-table-wrap">
            <table class="pm-table" id="tblTarget">
                <thead>
                    <tr>
                        <th class="center" style="width:60px;">#</th>
                        <th style="min-width:180px;">Marketing Man</th>
                        <th class="center" style="min-width:110px;">Fin Year</th>
                        <th class="center" style="min-width:110px;">Month</th>
                        <th class="right" style="min-width:140px;">Dream Client Target</th>
                        <th class="right" style="min-width:120px;">Leads Target</th>
                        <th class="center" style="width:115px;">Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

</div>

<!-- CREATE / EDIT MODAL -->
<div class="modal fade pm-modal" id="dvTargetModal" tabindex="-1" role="dialog"
     aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width:min(620px, calc(100vw - 2rem));">
        <div class="modal-content">
            <div class="modal-header">
                <div class="pm-modal-hdr-icon">
                    <i class="fas fa-bullseye"></i>
                </div>
                <h5 class="modal-title" id="target-modal-title">New Target</h5>
                <button type="button" class="pm-close-btn" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="pm-form-section">
                    <div class="pm-form-section-title">
                        <i class="fas fa-info-circle"></i> Target Information
                    </div>
                    <div class="pm-form-grid">
                        <div class="pm-fg">
                            <label for="ddlModalMarketingMan">Marketing Man <span class="text-danger">*</span></label>
                            <select id="ddlModalMarketingMan"></select>
                        </div>
                        <div class="pm-fg">
                            <label for="ddlModalFinYear">Fin Year <span class="text-danger">*</span></label>
                            <select id="ddlModalFinYear"></select>
                        </div>
                        <div class="pm-fg">
                            <label for="ddlModalMonth">Month <span class="text-danger">*</span></label>
                            <select id="ddlModalMonth"></select>
                        </div>
                        <div class="pm-fg">
                            <label for="txtDreamClientTarget">Dream Client Target <span class="text-danger">*</span></label>
                            <input type="number" id="txtDreamClientTarget" min="0" step="1" inputmode="numeric" placeholder="0" style="text-align:right;" />
                        </div>
                        <div class="pm-fg">
                            <label for="txtLeadsTarget">Leads Target <span class="text-danger">*</span></label>
                            <input type="number" id="txtLeadsTarget" min="0" step="1" inputmode="numeric" placeholder="0" style="text-align:right;" />
                        </div>
                    </div>
                    <input type="hidden" id="hfTargetCode" value="0" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="pm-btn secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="pm-btn primary" id="btnSaveTarget">
                    <i class="fas fa-save"></i> Save Target
                </button>
            </div>
        </div>
    </div>
</div>

<!-- VIEW MODAL -->
<div class="modal fade pm-modal" id="dvTargetViewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:min(480px, calc(100vw - 2rem));">
        <div class="modal-content">
            <div class="modal-header" style="background: var(--info-gradient);">
                <div class="pm-modal-hdr-icon">
                    <i class="fas fa-eye"></i>
                </div>
                <h5 class="modal-title">Target Details</h5>
                <button type="button" class="pm-close-btn" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="pm-form-section">
                    <div class="pm-form-section-title">
                        <i class="fas fa-info-circle"></i> Target Information
                    </div>
                    <div class="pm-view-row">
                        <span class="pm-view-lbl">Marketing Man</span>
                        <span class="pm-view-val" id="viewMarketingMan">—</span>
                    </div>
                    <div class="pm-view-divider"></div>
                    <div class="pm-view-row">
                        <span class="pm-view-lbl">Fin Year</span>
                        <span class="pm-view-val" id="viewFinYear">—</span>
                    </div>
                    <div class="pm-view-divider"></div>
                    <div class="pm-view-row">
                        <span class="pm-view-lbl">Month</span>
                        <span class="pm-view-val" id="viewMonth">—</span>
                    </div>
                    <div class="pm-view-divider"></div>
                    <div class="pm-view-row">
                        <span class="pm-view-lbl">Dream Client Target</span>
                        <span class="pm-view-val" id="viewDreamClientTarget">—</span>
                    </div>
                    <div class="pm-view-divider"></div>
                    <div class="pm-view-row">
                        <span class="pm-view-lbl">Leads Target</span>
                        <span class="pm-view-val" id="viewLeadsTarget">—</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="pm-btn secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- DELETE CONFIRM MODAL -->
<div class="modal fade pm-modal" id="dvDeleteConfirmModal" tabindex="-1" role="dialog"
     aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg,#dc2626,#ef4444);">
                <div class="pm-modal-hdr-icon">
                    <i class="fas fa-trash-alt"></i>
                </div>
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="pm-close-btn" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body" style="background:#fff; text-align:center; padding:28px 24px 20px;">
                <div class="pm-del-icon-wrap">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div style="font-size:15px; font-weight:700; color:var(--text-dark); margin-bottom:8px;">
                    Delete Target?
                </div>
                <div style="text-align:left;">
                    <label for="reasonForDeleteInput" style="font-size:12.5px; font-weight:700; color:var(--text-primary); margin-bottom:6px; display:block;">
                        Reason for Deletion <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="reasonForDeleteInput" autocomplete="off"
                           placeholder="Enter reason for deletion"
                           style="width:100%; padding:10px 13px; border-radius:10px; border:1.5px solid var(--border-color);
                                  font-size:13.5px; outline:none; background:#fff; color:var(--text-dark);
                                  box-sizing:border-box;" />
                </div>
                <input type="hidden" id="hfDeleteCode" value="0" />
            </div>
            <div class="modal-footer" style="justify-content:center; gap:12px; background:#fff; border-top:1px solid #fee2e2;">
                <button type="button" class="pm-btn secondary" data-bs-dismiss="modal">
                    <i class="fas fa-ban"></i> Cancel
                </button>
                <button type="button" class="pm-btn danger" id="btnConfirmDelete">
                    <i class="fas fa-trash-alt"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>
