@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Marketing.Transactions/Script/TargetExecutiveWise.js"></script>

<style>
    .pm-page {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        padding: 4px 0 32px;
    }

    .pm-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 20px;
    }

    .pm-hero-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .pm-hero-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: var(--primary-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
        box-shadow: var(--shadow-primary);
        flex-shrink: 0;
    }

    .pm-hero-title {
        font-size: 21px;
        font-weight: 800;
        color: var(--text-dark);
        letter-spacing: -.025em;
        line-height: 1.2;
    }

    .pm-stats {
        display: flex;
        gap: 14px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .pm-stat-chip {
        flex: 1;
        min-width: 150px;
        background: var(--white-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 16px 20px;
        box-shadow: var(--shadow-sm);
        display: flex;
        align-items: center;
        gap: 14px;
        transition: transform .2s ease, box-shadow .2s ease;
        position: relative;
        overflow: hidden;
    }

    .pm-stat-chip::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: var(--primary-gradient);
    }

    .pm-stat-chip:nth-child(2)::before { background: linear-gradient(135deg, #059669, #10b981); }
    .pm-stat-chip:nth-child(3)::before { background: var(--warning-gradient); }

    .pm-stat-chip:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-primary);
    }

    .pm-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
        background: var(--primary-gradient);
        color: #fff;
        box-shadow: var(--shadow-primary);
    }

    .pm-stat-chip:nth-child(2) .pm-stat-icon { background: linear-gradient(135deg, #059669, #10b981); box-shadow: 0 8px 24px rgba(16,185,129,.3); }
    .pm-stat-chip:nth-child(3) .pm-stat-icon { background: var(--warning-gradient); box-shadow: 0 8px 24px rgba(245,158,11,.3); }

    .pm-stat-val {
        font-size: 22px;
        font-weight: 800;
        color: var(--text-dark);
        line-height: 1.1;
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .pm-stat-lbl {
        font-size: 11px;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: .06em;
        font-weight: 600;
        margin-top: 2px;
    }

    .pm-filter-card {
        background: var(--white-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        padding: 16px 20px;
        margin-bottom: 18px;
        position: relative;
        overflow: hidden;
    }

    .pm-filter-card::before {
        content: '';
        position: absolute;
        inset: 0 0 auto 0;
        height: 3px;
        background: var(--primary-gradient);
    }

    .pm-filter-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr) auto;
        gap: 14px;
        align-items: end;
    }

    .pm-fg { display: flex; flex-direction: column; gap: 6px; }

    .pm-fg label {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .pm-fg select,
    .pm-fg input {
        padding: 9px 12px;
        border-radius: 10px;
        border: 1.5px solid var(--border-color);
        font-size: 13.5px;
        outline: none;
        background: var(--white-bg);
        color: var(--text-dark);
        width: 100%;
        box-sizing: border-box;
    }

    .pm-fg select:focus,
    .pm-fg input:focus {
        border-color: var(--accent-primary);
        box-shadow: 0 0 0 3px rgba(102,126,234,.15);
    }

    .pm-card {
        background: var(--white-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
        position: relative;
    }

    .pm-card::before {
        content: '';
        position: absolute;
        inset: 0 0 auto 0;
        height: 3px;
        background: var(--primary-gradient);
        border-radius: 20px 20px 0 0;
    }

    .pm-card-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 18px 22px 16px;
        border-bottom: 1px solid var(--border-light);
    }

    .pm-search-wrap {
        position: relative;
        flex: 1;
        min-width: 200px;
        max-width: 340px;
    }

    .pm-search-wrap i {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 13px;
        pointer-events: none;
    }

    #pmSearch {
        width: 100%;
        padding: 9px 14px 9px 38px;
        border-radius: 10px;
        border: 1.5px solid var(--border-color);
        font-size: 13.5px;
        outline: none;
        background: var(--light-bg);
        color: var(--text-dark);
    }

    #pmSearch:focus {
        border-color: var(--accent-primary);
        background: #fff;
        box-shadow: 0 0 0 3px rgba(102,126,234,.15);
    }

    .pm-btn-new {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        outline: none;
        padding: 10px 22px;
        border-radius: 12px;
        background: var(--primary-gradient);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: var(--shadow-primary);
        transition: transform .15s, box-shadow .15s;
        white-space: nowrap;
    }

    .pm-btn-new:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(102,126,234,.45); }

    .pm-btn-new .pm-plus {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: rgba(255,255,255,.22);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 700;
        line-height: 1;
    }

    .pm-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: none;
        outline: none;
        padding: 10px 22px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: transform .14s, box-shadow .14s;
        min-height: 40px;
    }

    .pm-btn:hover { transform: translateY(-1px); }
    .pm-btn.primary {
        background: var(--primary-gradient);
        color: #fff;
        box-shadow: var(--shadow-primary);
    }
    .pm-btn.secondary {
        background: var(--light-bg);
        color: var(--text-muted);
        border: 1.5px solid var(--border-color);
    }
    .pm-btn.danger {
        background: linear-gradient(135deg, #ef4444, #f87171);
        color: #fff;
        box-shadow: 0 4px 14px rgba(239,68,68,.32);
    }

    .pm-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-height: calc(100vh - 420px);
        overflow-y: auto;
    }

    .pm-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
        min-width: 720px;
    }

    .pm-table thead {
        position: sticky;
        top: 0;
        z-index: 4;
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
    }

    .pm-table thead th {
        color: #fff !important;
        background: transparent !important;
        font-weight: 700;
        padding: 13px 16px;
        text-align: left;
        white-space: nowrap;
        border: none !important;
        font-size: 12px;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .pm-table thead th.center { text-align: center; }
    .pm-table thead th.right  { text-align: right; }

    .pm-table tbody tr:nth-child(even) { background: var(--light-bg) !important; }
    .pm-table tbody tr:nth-child(odd)  { background: #fff !important; }
    .pm-table tbody tr:hover           { background: rgba(102,126,234,.07) !important; }

    .pm-table td {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border-light) !important;
        color: var(--text-dark) !important;
        vertical-align: middle;
        white-space: nowrap;
    }

    .pm-table td.center { text-align: center; }
    .pm-table td.right  { text-align: right; }

    .pm-sno {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: var(--primary-gradient);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .pm-code-badge {
        display: inline-block;
        padding: 3px 11px;
        border-radius: 20px;
        background: rgba(102,126,234,.1);
        color: var(--accent-primary);
        font-size: 12px;
        font-weight: 700;
        border: 1px solid rgba(102,126,234,.2);
    }

    .pm-days-chip {
        display: inline-block;
        padding: 3px 11px;
        border-radius: 20px;
        background: rgba(6,182,212,.1);
        color: var(--accent-info);
        font-size: 12px;
        font-weight: 700;
        border: 1px solid rgba(6,182,212,.2);
    }

    .pm-empty {
        text-align: center;
        padding: 56px 20px;
    }

    .pm-empty-icon {
        width: 68px;
        height: 68px;
        border-radius: 20px;
        background: var(--primary-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-size: 28px;
        color: #fff;
        box-shadow: var(--shadow-primary);
        opacity: .7;
    }

    .pm-empty-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 6px;
    }

    .pm-empty-sub {
        font-size: 13px;
        color: var(--text-muted);
    }

    .pm-actions {
        display: flex;
        gap: 6px;
        align-items: center;
        justify-content: center;
    }

    .pm-icon-btn {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        transition: transform .14s, box-shadow .14s;
        outline: none;
    }

    .pm-icon-btn:hover { transform: translateY(-2px); }

    .pm-icon-btn.view {
        background: rgba(6,182,212,.12);
        color: var(--accent-info);
        border: 1px solid rgba(6,182,212,.25);
    }
    .pm-icon-btn.edit {
        background: rgba(102,126,234,.12);
        color: var(--accent-primary);
        border: 1px solid rgba(102,126,234,.25);
    }
    .pm-icon-btn.del {
        background: rgba(239,68,68,.1);
        color: #ef4444;
        border: 1px solid rgba(239,68,68,.2);
    }

    .pm-modal .modal-content {
        border-radius: 20px;
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-xl);
        overflow: hidden;
    }

    .pm-modal .modal-header {
        background: var(--primary-gradient);
        color: #fff;
        border-bottom: none;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .pm-modal-hdr-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(255,255,255,.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

    .pm-modal .modal-title {
        color: #fff;
        font-weight: 700;
        font-size: 17px;
        flex: 1;
        margin: 0;
    }

    .pm-close-btn {
        background: rgba(255,255,255,.15);
        border: none;
        color: #fff;
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        cursor: pointer;
        outline: none;
        flex-shrink: 0;
    }

    .pm-modal .modal-body {
        padding: 22px 24px 14px;
        background: var(--light-bg);
    }

    .pm-modal .modal-footer {
        border-top: 1px solid var(--border-color);
        padding: 14px 24px;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        background: var(--white-bg);
    }

    .pm-form-section {
        background: var(--white-bg);
        border-radius: 14px;
        border: 1px solid var(--border-color);
        padding: 20px 20px 6px;
        box-shadow: var(--shadow-sm);
    }

    .pm-form-section-title {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--accent-primary);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .pm-form-section-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border-color);
    }

    .pm-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px 18px;
        margin-bottom: 16px;
    }

    .pm-view-row {
        display: flex;
        gap: 12px;
        margin-bottom: 12px;
        align-items: flex-start;
    }

    .pm-view-lbl {
        font-size: 11.5px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: .05em;
        min-width: 145px;
        flex-shrink: 0;
    }

    .pm-view-val {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-dark);
        word-break: break-word;
    }

    .pm-view-divider { height: 1px; background: var(--border-light); margin: 10px 0; }

    .pm-del-icon-wrap {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: rgba(239,68,68,.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-size: 30px;
        color: #ef4444;
        border: 3px solid rgba(239,68,68,.25);
    }

    @@media (max-width: 992px) {
        .pm-filter-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 580px) {
        .pm-filter-grid { grid-template-columns: 1fr; }
        .pm-form-grid { grid-template-columns: 1fr; }
        .pm-card-toolbar { flex-direction: column; align-items: stretch; }
        .pm-search-wrap { max-width: 100%; }
        .pm-btn-new { width: 100%; justify-content: center; }
    }
</style>

<div class="pm-page">

    <div class="pm-hero">
        <div class="pm-hero-left">
            <div class="pm-hero-icon">
                <i class="fas fa-bullseye"></i>
            </div>
            <div>
                <div class="pm-hero-title">Target (Executive Wise)</div>
            </div>
        </div>
        <button class="pm-btn-new" id="btnCreateTarget" type="button">
            <span class="pm-plus">+</span>
            <span>New Target</span>
        </button>
    </div>

