@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Marketing.Transactions/Script/BuyingCapacity.js"></script>
<style>
    .fixed-width-table th, .fixed-width-table td {
        white-space: nowrap;
        min-width: auto;
    }
</style>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <label for="ddlMarketingMan" class="form-label">Sales Person <span class="text-danger">*</span></label>
                <select id="ddlMarketingMan" name="ddlMarketingMan" class="form-control form-control-sm box_border" autocomplete="off" required></select>
                @* <input list="ddlSalesPersonList" id="ddlMarketingMan" name="ddlMarketingMan" class="form-control form-control-sm box_border" onclick="$(this).val('');" placeholder="Sales Person" autocomplete="off" required>
                <datalist id="ddlSalesPersonList"></datalist> *@
            </div>

            <div class="col-md-3 without-label-field">
                <button type="button" id="btnShow" class="btn btn-primary btn-height btn-width">Show</button>
            </div>
        </div>
    </div>
</div>
<div class="table-wrapper ">
    <table id="BuyingCapacity" class="fixed-width-table table">
        <thead id="table-header-BuyingCapacity">
        </thead>
        <tbody id="table-body-BuyingCapacity">
        </tbody>
    </table>
</div>
<div class="paginator" id="paginator-BuyingCapacity">
</div>