@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Marketing.Transactions/Script/BuyingCapacity.js"></script>
<style>
    /* Hide page scrollbar */
    html {
        overflow: hidden !important;
        height: 100% !important;
    }
    
    body {
        overflow: hidden !important;
        height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    /* Remove card and table margins */
    .card {
        margin: 0 !important;
        margin-bottom: 0 !important;
    }

    .card-body {
        margin: 0 !important;
        padding: 1rem !important;
    }

    .fixed-width-table th, .fixed-width-table td {
        white-space: nowrap;
        min-width: auto;
    }

    /* Table wrapper with dynamic height based on screen */
    .table-wrapper {
        position: relative;
        overflow: auto;
        max-height: calc(100vh - 260px);
        min-height: 300px;
        margin: 0 !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }

    /* Ensure table takes full width */
    #BuyingCapacity {
        width: 100%;
        margin: 0 !important;
        margin-bottom: 0 !important;
    }

    /* Sticky table header */
    #BuyingCapacity thead {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: #fff;
    }

    #BuyingCapacity thead th {
        background-color: #558bc0 !important;
        color: #fff !important;
        position: sticky;
        top: 0;
        z-index: 11;
        border-bottom: 2px solid #dee2e6;
        padding-right: 15px !important;
    }

    /* Responsive height adjustments for smaller screens */
    @@media (max-height: 800px) {
        .table-wrapper {
            max-height: calc(100vh - 200px);
            min-height: 300px;
        }
    }

    @@media (max-height: 600px) {
        .table-wrapper {
            max-height: calc(100vh - 180px);
            min-height: 250px;
        }
    }
</style>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <label for="ddlMarketingMan" class="form-label">Sales Person <span class="text-danger">*</span></label>
                <select id="ddlMarketingMan" name="ddlMarketingMan" class="form-control form-control-sm box_border" autocomplete="off" required></select>
            </div>

            <div class="col-md-3 without-label-field">
                <button type="button" id="btnShow" class="btn btn-primary btn-height btn-width">Show</button>
            </div>
        </div>
    </div>
</div>
<div class="table-wrapper ">
    <table id="BuyingCapacity" class="fixed-width-table table">
        <thead id="table-header-BuyingCapacity">
        </thead>
        <tbody id="table-body-BuyingCapacity">
        </tbody>
    </table>
</div>
<div class="paginator" id="paginator-BuyingCapacity">
</div>