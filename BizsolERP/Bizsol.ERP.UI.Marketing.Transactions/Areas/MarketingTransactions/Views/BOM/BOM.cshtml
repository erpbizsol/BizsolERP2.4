@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Marketing.Transactions/Script/BOM.js"></script>
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/BizSolInputControl.js"></script>

<style>
    .bom-page {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        padding: 4px 0 32px;
    }

    .bom-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 20px;
    }

    .bom-hero-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .bom-hero-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: var(--primary-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
        box-shadow: var(--shadow-primary);
        flex-shrink: 0;
    }

    .bom-hero-title {
        font-size: 21px;
        font-weight: 800;
        color: var(--text-dark);
        letter-spacing: -.025em;
        line-height: 1.2;
    }

    .bom-hero-sub {
        font-size: 13px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .bom-card {
        background: var(--white-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
        position: relative;
    }

    .bom-card::before {
        content: '';
        position: absolute;
        inset: 0 0 auto 0;
        height: 3px;
        background: var(--primary-gradient);
        border-radius: 20px 20px 0 0;
    }

    .bom-card-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 14px 18px;
        align-items: flex-end;
        padding: 18px 22px 14px;
        border-bottom: 1px solid var(--border-light);
    }

    .bom-fg {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 220px;
    }

    .bom-fg label {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .bom-fg select {
        padding: 9px 13px;
        border-radius: 10px;
        border: 1.5px solid var(--border-color);
        font-size: 13.5px;
        outline: none;
        background: var(--white-bg);
        color: var(--text-dark);
        transition: border-color .2s, box-shadow .2s;
        min-width: 220px;
    }

    .bom-fg select:focus {
        border-color: var(--accent-primary);
        box-shadow: 0 0 0 3px rgba(102,126,234,.15);
    }

    .bom-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-height: calc(100vh - 320px);
        overflow-y: auto;
    }

    .bom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
        min-width: 920px;
    }

    .bom-table thead {
        position: sticky;
        top: 0;
        z-index: 3;
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
    }

    .bom-table thead th {
        color: #fff !important;
        background: transparent !important;
        font-weight: 700;
        padding: 11px 10px;
        text-align: left;
        white-space: nowrap;
        border: none !important;
        font-size: 12px;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .bom-table thead th.center {
        text-align: center;
    }

    .bom-table thead th.right {
        text-align: right;
    }

    .bom-table tbody tr {
        transition: background .12s;
    }

    .bom-table tbody tr:nth-child(even) {
        background: var(--light-bg) !important;
    }

    .bom-table tbody tr:nth-child(odd) {
        background: #fff !important;
    }

    .bom-table tbody tr:hover {
        background: rgba(102,126,234,.07) !important;
    }

    .bom-table td {
        padding: 8px 8px;
        border-bottom: 1px solid var(--border-light) !important;
        color: var(--text-dark) !important;
        background: transparent !important;
        vertical-align: middle;
    }

    .bom-table td.center {
        text-align: center;
    }

    .bom-table td.right {
        text-align: right;
    }

    .bom-input,
    .bom-select {
        width: 100%;
        box-sizing: border-box;
        padding: 6px 8px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        font-size: 13px;
        outline: none;
        background: #fff;
    }

    .bom-input:focus,
    .bom-select:focus {
        border-color: var(--accent-primary);
        box-shadow: 0 0 0 2px rgba(102,126,234,.18);
    }

    .bom-input[readonly],
    .bom-input[disabled] {
        background: #f5f5f5;
        cursor: not-allowed;
    }

    .bom-actions {
        display: flex;
        gap: 6px;
        justify-content: center;
    }

    .bom-btn {
        border: none;
        outline: none;
        border-radius: 8px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }

    .bom-btn.save {
        background: var(--primary-gradient);
        color: #fff;
        box-shadow: var(--shadow-primary);
    }

    .bom-btn.verify {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        color: #fff;
    }

    .bom-btn:disabled {
        opacity: .6;
        cursor: default;
        box-shadow: none;
    }

    .bom-pill {
        font-size: 11px;
        padding: 3px 9px;
        border-radius: 999px;
        background: rgba(15,118,110,.1);
        color: #0f766e;
        border: 1px solid rgba(15,118,110,.2);
        display: inline-block;
    }

    /* ── Shared ProjectMaster-style components for grid ─────── */
    .pm-card {
        background: var(--white-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
        position: relative;
    }

    .pm-card::before {
        content: '';
        position: absolute;
        inset: 0 0 auto 0;
        height: 3px;
        background: var(--primary-gradient);
        border-radius: 20px 20px 0 0;
    }

    .pm-card-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 18px 22px 16px;
        border-bottom: 1px solid var(--border-light);
    }

    .pm-search-wrap {
        position: relative;
        flex: 1;
        min-width: 200px;
        max-width: 340px;
    }

    .pm-search-wrap i {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 13px;
        pointer-events: none;
    }

    #bomSearch {
        width: 100%;
        padding: 9px 14px 9px 38px;
        border-radius: 10px;
        border: 1.5px solid var(--border-color);
        font-size: 13.5px;
        outline: none;
        background: var(--light-bg);
        color: var(--text-dark);
        transition: border-color .2s, box-shadow .2s, background .2s;
    }

    #bomSearch:focus {
        border-color: var(--accent-primary);
        background: #fff;
        box-shadow: 0 0 0 3px rgba(102,126,234,.15);
    }

    .pm-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-height: calc(100vh - 360px);
        overflow-y: auto;
    }

    .pm-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
        min-width: 680px;
    }

    .pm-table thead {
        position: sticky;
        top: 0;
        z-index: 4;
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
    }

    .pm-table thead th {
        color: #fff !important;
        background: transparent !important;
        font-weight: 700;
        padding: 13px 16px;
        text-align: left;
        white-space: nowrap;
        border: none !important;
        font-size: 12px;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .pm-table thead th.center { text-align: center; }
    .pm-table thead th.right  { text-align: right; }

    .pm-table tbody tr { transition: background .12s; }
    .pm-table tbody tr:nth-child(even) { background: var(--light-bg) !important; }
    .pm-table tbody tr:nth-child(odd)  { background: #fff !important; }
    .pm-table tbody tr:hover           { background: rgba(102,126,234,.07) !important; }

    .pm-table td {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border-light) !important;
        color: var(--text-dark) !important;
        background: transparent !important;
        vertical-align: middle;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pm-table td.center { text-align: center; }
    .pm-table td.right  { text-align: right; }
    .pm-table tbody tr:last-child td { border-bottom: none !important; }

    .pm-sno {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: var(--primary-gradient);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .pm-code-badge {
        display: inline-block;
        padding: 3px 11px;
        border-radius: 20px;
        background: rgba(102,126,234,.1);
        color: var(--accent-primary);
        font-size: 12px;
        font-weight: 700;
        border: 1px solid rgba(102,126,234,.2);
        letter-spacing: .03em;
    }

    .pm-budget {
        font-weight: 700;
        color: var(--accent-primary-dark);
    }

    .pm-days-chip {
        display: inline-block;
        padding: 3px 11px;
        border-radius: 20px;
        background: rgba(6,182,212,.1);
        color: var(--accent-info);
        font-size: 12px;
        font-weight: 700;
        border: 1px solid rgba(6,182,212,.2);
    }

    .pm-empty {
        text-align: center;
        padding: 56px 20px;
    }

    .pm-empty-icon {
        width: 68px;
        height: 68px;
        border-radius: 20px;
        background: var(--primary-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-size: 28px;
        color: #fff;
        box-shadow: var(--shadow-primary);
        opacity: .7;
    }

    .pm-empty-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 6px;
    }

    .pm-empty-sub {
        font-size: 13px;
        color: var(--text-muted);
    }

    .pm-btn-new {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        outline: none;
        padding: 10px 22px;
        border-radius: 12px;
        background: var(--primary-gradient);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: var(--shadow-primary);
        transition: transform .15s, box-shadow .15s;
        white-space: nowrap;
    }

    .pm-btn-new:hover  { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(102,126,234,.45); }
    .pm-btn-new:active { transform: translateY(0); }

    .pm-btn-new .pm-plus {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: rgba(255,255,255,.22);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 700;
        line-height: 1;
    }

    @@media (max-width: 768px) {
        .bom-card-toolbar {
            padding: 14px 14px 10px;
        }

        .bom-fg {
            width: 100%;
        }
    }
</style>

<div class="bom-page">
    <div class="bom-hero">
        <div class="bom-hero-left">
            <div class="bom-hero-icon">
                <i class="fas fa-clipboard-list"></i>
            </div>
            <div>
                <div class="bom-hero-title">Bill of Material</div>
                <div class="bom-hero-sub">
                    Manage and verify BOM entries for projects.
                </div>
            </div>
        </div>
        <button class="pm-btn-new" id="btnCreateBOM" type="button">
            <span class="pm-plus">+</span>
            <span>New BOM</span>
        </button>
    </div>

    <div class="pm-card" id="dvBOMGrid">
        <div class="pm-card-toolbar">
            <div class="pm-search-wrap">
                <i class="fas fa-search"></i>
                <input type="text" id="bomSearch" placeholder="Search by project or sub project…" autocomplete="off" />
            </div>
        </div>

        <div class="pm-table-wrap">
            <table class="pm-table" id="tblBOMList">
                <thead>
                    <tr>
                        <th class="center" style="width:60px;">#</th>
                        <th style="min-width:220px;">Project Name</th>
                        <th style="min-width:220px;">Sub Project Name</th>
                        <th class="right" style="min-width:140px;">Total Amount</th>
                        <th class="center" style="width:120px;">Status</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════
     CREATE / EDIT BOM MODAL
════════════════════════════════════════════════════════ -->
<div class="modal fade pm-modal" id="dvBOMModal" tabindex="-1" role="dialog"
     aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width: 1100px;">
        <div class="modal-content">

            <div class="modal-header">
                <div class="pm-modal-hdr-icon">
                    <i class="fas fa-clipboard-list"></i>
                </div>
                <h5 class="modal-title" id="bom-modal-title">New BOM</h5>
                <button type="button" class="pm-close-btn" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="bom-card">
                    <div class="bom-card-toolbar">
                        <div class="bom-fg">
                            <label for="ddlProject">Project Name</label>
                            <select id="ddlProject">
                                <option value="">Loading…</option>
                            </select>
                        </div>
                        <div class="bom-fg">
                            <label for="ddlSubProject">Sub Project Name</label>
                            <select id="ddlSubProject">
                                <option value="">Select project first</option>
                            </select>
                        </div>
                        <span class="bom-pill" style="margin-left:auto; margin-right:4px;">
                            <i class="fas fa-info-circle"></i>
                            &nbsp;Amount = Qty Required × Est. Rate
                        </span>
                    </div>

                    <div class="bom-table-wrap">
                        <table class="bom-table" id="tblBOM">
                            <thead>
                                <tr>
                                    <th class="center" style="width:50px;">#</th>
                                    <th style="min-width:120px;">Project Category</th>
                                    <th style="min-width:110px;">Work Type</th>
                                    <th style="min-width:200px;">Work Material / Service Desp (Item Name)</th>
                                    <th style="min-width:80px;">UOM</th>
                                    <th style="min-width:90px;" class="right">Tolerance</th>
                                    <th style="min-width:110px;" class="right">Qty Required</th>
                                    <th style="min-width:110px;" class="right">Rate Tol (%)</th>
                                    <th style="min-width:110px;" class="right">EST. Rate</th>
                                    <th style="min-width:120px;" class="right">Amount</th>
                                    <th class="center" style="min-width:120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="pm-btn secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Close
                </button>
            </div>

        </div>
    </div>
</div>
