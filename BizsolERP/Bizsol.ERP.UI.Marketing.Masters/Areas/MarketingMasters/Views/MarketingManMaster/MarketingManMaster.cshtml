                <label for="mmmReasonForDelete" class="form-label" style="font-size:12.5px;font-weight:700;">Reason for deletion <span class="text-danger">*</span></label>
                <input type="text" id="mmmReasonForDelete" class="form-control" autocomplete="off" placeholder="Enter reason" />
