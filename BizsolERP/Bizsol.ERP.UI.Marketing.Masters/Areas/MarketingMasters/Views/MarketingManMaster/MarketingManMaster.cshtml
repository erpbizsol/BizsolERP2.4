<div class="mmm-page" id="MarketingManMasterPage">

    <div id="mmmListPanel">
        <div class="mmm-po-list-header">
            <div class="mmm-po-header-top">
                <div class="mmm-hero-left">
                    <div class="mmm-hero-icon">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div>
                        <div class="mmm-hero-title">Marketing Executive Master</div>
                        <div class="mmm-hero-sub">Marketing persons and client links</div>
                    </div>
                </div>
                <button type="button" class="mmm-po-create-btn" id="btnCreateMarketingMan">
                    <span class="pm-plus">+</span>
                    <span class="mmm-po-create-label">Create New</span>
                </button>
            </div>
        </div>

        <div class="mmm-list-grid-wrap">
            <div class="pm-card-toolbar">
                <div class="pm-search-wrap">
                    <i class="fas fa-search"></i>
                    <input type="text" id="mmmSearch" placeholder="Search by name, mobile or email…" autocomplete="off" />
                </div>
            </div>
            <div class="pm-table-wrap table-wrapper">
                <table class="pm-table" id="MarketingManMaster">
                    <thead id="table-header-MarketingManMaster"></thead>
                    <tbody id="table-body-MarketingManMaster"></tbody>
                </table>
            </div>
            <div class="paginator" id="paginator-MarketingManMaster"></div>
        </div>
    </div>

    <div id="mmmDetailPanel" class="mmm-detail-panel mmm-ci-entry-wrap" style="display:none;">
        <input type="hidden" id="hfMarketingManMaster_Code" value="0" />
        <input type="hidden" id="hfClientAccountCodes" value="" />

        <div class="mmm-ci-po-list-header">
            <div class="mmm-ci-po-header-top">
                <div>
                    <h5 class="mmm-ci-entry-title">Marketing Executive Master</h5>
                    <small class="mmm-ci-entry-sub">Enter user link, level, and assignment details</small>
                </div>
                <div class="mmm-ci-po-footer-right">
                    <button type="button" class="mmm-ci-po-back-btn" id="btnBackToMarketingManList" title="Back to list">
                        <i class="fas fa-arrow-left"></i> <span class="mmm-ci-po-back-label">Back</span>
                    </button>
                    <button type="button" class="mmm-ci-po-back-btn" id="btnClearMarketingMan">
                        <i class="fas fa-eraser"></i> Clear
                    </button>
                    <button type="button" class="btn-mmm-ci-po-save" id="btnSaveMarketingMan">
                        <i class="fas fa-check"></i> Save
                    </button>
                </div>
            </div>
        </div>

        <div class="mmm-ci-po-step-card">
            <div class="mmm-ci-po-step-header">
                <span class="mmm-ci-po-step-num">1</span>
                <span class="mmm-ci-po-step-title">Details</span>
                <i class="fas fa-id-card mmm-ci-po-step-icon" aria-hidden="true"></i>
            </div>
            <div class="mmm-ci-po-step-body">
                <div class="mmm-form-section mmm-form-section--plain">
                    <div class="mmm-form-section-title">
                        <i class="fas fa-info-circle"></i> Marketing person
                    </div>

                    <div class="mmm-form-grid">
                        <div class="mmm-fg">
                            <label for="ddlUserId">User ID</label>
                            <select id="ddlUserId"></select>
                        </div>
                        <div class="mmm-fg">
                            <label for="txtPersonName">Person Name</label>
                            <input type="text" id="txtPersonName" autocomplete="off" maxlength="40" placeholder="Person name" />
                        </div>
                        <div class="mmm-fg">
                            <label for="txtDesignation">Designation</label>
                            <input type="text" id="txtDesignation" autocomplete="off" maxlength="30" placeholder="Designation" />
                        </div>
                        <div class="mmm-fg">
                            <label for="txtMobile">Mobile</label>
                            <input type="tel" id="txtMobile" autocomplete="off" maxlength="10" placeholder="Mobile" />
                        </div>
                        <div class="mmm-fg span2">
                            <label for="txtEMail">E-Mail</label>
                            <input type="email" id="txtEMail" autocomplete="off" maxlength="150" placeholder="email@company.com" />
                        </div>
                    </div>

                    <div class="mmm-form-band" role="group" aria-label="Invoice and level">
                        <div class="mmm-check" style="display:flex;align-items:center;gap:8px;">
                            <input type="checkbox" id="chkEmailInvoiceCopy" />
                            <label for="chkEmailInvoiceCopy">Email Invoice Copy</label>
                        </div>
                        <div class="mmm-inline-cluster" style="margin-left:auto;">
                            <span class="mmm-field-label">Level</span>
                            <div class="mmm-radio-group" role="radiogroup" aria-label="Senior or Junior">
                                <div class="mmm-radio-inline">
                                    <input type="radio" name="radSeniority" id="radSenior" value="S" checked />
                                    <label for="radSenior">Senior</label>
                                </div>
                                <div class="mmm-radio-inline">
                                    <input type="radio" name="radSeniority" id="radJunior" value="J" />
                                    <label for="radJunior">Junior</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mmm-form-grid">
                        <div class="mmm-fg">
                            <label for="ddlSeniorName">Senior Name <span id="lblSeniorRequired" class="text-danger" style="display:none;" title="Required for junior">*</span></label>
                            <select id="ddlSeniorName"></select>
                        </div>
                        <div class="mmm-fg">
                            <label for="ddlEmployeeName">Employee Name</label>
                            <select id="ddlEmployeeName"></select>
                        </div>
                        <div class="mmm-fg">
                            <label for="ddlCostCenter">Cost Center ID</label>
                            <select id="ddlCostCenter"></select>
                        </div>
                        <div class="mmm-fg">
                            <label for="txtEmployeeLeaveDate">Employee Leave Date</label>
                            <input type="date" id="txtEmployeeLeaveDate" />
                        </div>
                        <div class="mmm-fg">
                            <label for="ddlZone">Zone</label>
                            <select id="ddlZone"></select>
                        </div>
                        <div class="mmm-fg">
                            <label for="ddlExpenseCategory">Expense Category <span class="text-danger">*</span></label>
                            <select id="ddlExpenseCategory" aria-required="true" data-required="true"></select>
                        </div>
                    </div>

                    <div class="mmm-form-band" role="group" aria-label="Status and party list">
                        <div class="mmm-inline-cluster">
                            <span class="mmm-field-label">Status</span>
                            <div class="mmm-radio-group" role="radiogroup" aria-label="Status">
                                <div class="mmm-radio-inline">
                                    <input type="radio" name="radStatus" id="radActive" value="Y" checked />
                                    <label for="radActive">Active</label>
                                </div>
                                <div class="mmm-radio-inline">
                                    <input type="radio" name="radStatus" id="radInactive" value="N" />
                                    <label for="radInactive">Inactive</label>
                                </div>
                            </div>
                        </div>
                        <div class="mmm-check" style="display:flex;align-items:center;gap:8px;margin-left:auto;">
                            <input type="checkbox" id="chkShowAllParty" />
                            <label for="chkShowAllParty">Show All Party</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mmm-ci-po-step-card" id="dvClientCard">
            <div class="mmm-ci-po-step-header">
                <span class="mmm-ci-po-step-num">2</span>
                <span class="mmm-ci-po-step-title">Linked clients</span>
                <i class="fas fa-building mmm-ci-po-step-icon" aria-hidden="true"></i>
            </div>
            <div class="mmm-ci-po-step-body" style="padding-top:0;">
                <div class="mmm-table-wrap">
                    <table class="mmm-table" id="tblClient">
                        <thead>
                            <tr>
                                <th class="center" style="width:64px;">#</th>
                                <th>Client</th>
                                <th class="center" style="width:72px;" title="Link client to this marketing executive">Link</th>
                            </tr>
                        </thead>
                        <tbody id="tblClientBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

</div>

<div class="modal fade pm-modal" id="dvMMMDeleteModal" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-trash-alt me-2"></i>Confirm Delete</h5>
