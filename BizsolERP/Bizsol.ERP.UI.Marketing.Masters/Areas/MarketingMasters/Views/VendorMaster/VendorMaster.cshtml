    /* ═══════════════════════════════════════════════════
       AUTOCOMPLETE DROPDOWN
    ═══════════════════════════════════════════════════ */
    .vm-ac-wrap {
        position: relative;
    }

    .vm-ac-dropdown {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #fff;
        border: 1.5px solid #dde0ee;
        border-radius: 10px;
        box-shadow: 0 8px 28px rgba(91,94,244,0.14), 0 2px 8px rgba(0,0,0,0.07);
        z-index: 2000;
        max-height: 210px;
        overflow-y: auto;
        overflow-x: hidden;
        display: none;
        padding: 4px 0;
        -webkit-overflow-scrolling: touch;
    }

        .vm-ac-dropdown.open {
            display: block;
        }

        .vm-ac-dropdown::-webkit-scrollbar {
            width: 4px;
        }

        .vm-ac-dropdown::-webkit-scrollbar-thumb {
            background: #c7d2fe;
            border-radius: 4px;
        }

    .vm-ac-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 8px 12px;
        font-size: 13px;
        color: #111827;
        cursor: pointer;
        border-radius: 0;
        transition: background 0.1s;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .vm-ac-item:hover,
        .vm-ac-item.vm-ac-active {
            background: #eef2ff;
            color: #3730a3;
        }

        .vm-ac-item i {
            font-size: 11px;
            color: #5b5ef4;
            flex-shrink: 0;
        }

        .vm-ac-item mark {
            background: none;
            color: #5b5ef4;
            font-weight: 700;
            padding: 0;
        }

    .vm-ac-sub {
        font-size: 10px;
        color: #9ca3af;
        margin-left: auto;
        flex-shrink: 0;
        letter-spacing: 0.03em;
    }

    .vm-ac-empty {
        padding: 10px 12px;
        font-size: 12px;
        color: #9ca3af;
        text-align: center;
        font-style: italic;
    }

    /* Pincode auto-fill hint */
    .vm-pin-hint {
        display: none;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        color: #5b5ef4;
        font-weight: 600;
