        }
</style>

<div class="vm-page-wrapper">
    <div class="vm-card">

        <!-- ── Header ── -->
        <div class="vm-card-header">
            <div class="vm-header-left">
                <div class="vm-header-icon">
                    <i class="fas fa-store"></i>
                </div>
                <div>
                    <div class="vm-header-title">Vendor Master</div>
                    <div class="vm-header-sub">Manage your vendor records</div>
                </div>
            </div>
            <button type="button" class="vm-btn-new" onclick="OpenNewVendor()">
                <i class="fas fa-plus"></i>
                <span>New Vendor</span>
            </button>
        </div>

        <!-- ── Table ── -->
        <div class="vm-card-body">
            <div id="tblVendorMaster">
                <div class="vm-table-wrapper">
                    <table id="VendorMaster" style="width:100%;border-collapse:collapse;font-size:13px;">
                        <thead id="VendorMaster-header"></thead>
                        <tbody id="VendorMaster-body"></tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-VendorMaster"></div>
            </div>
        </div>

    </div>
</div>

<!-- ═══════════════ FORM MODAL ═══════════════ -->
<div id="vendorDialogBackdrop" class="vm-backdrop">
    <div class="vm-modal" id="vendorFormContainer">

        <div class="vm-modal-header">
            <div class="vm-modal-header-title">
                <i class="fas fa-store"></i>
                <span id="vmFormModalTitle">Add New Vendor</span>
            </div>
            <button type="button" class="vm-modal-close" id="vmBtnModalClose" title="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="vm-modal-body">

            <!-- ── Basic Info ── -->
            <div class="vm-section-label">
                <i class="fas fa-info-circle"></i> Basic Information
            </div>
            <div class="vm-form-grid">

                <div class="vm-form-group">
                    <label for="AccountDesp">Vendor Name <span class="vm-required">*</span></label>
                    <input type="text" id="AccountDesp" class="vm-input" placeholder="Enter vendor name" autocomplete="off" />
                    <span class="vm-err-text" id="err_AccountDesp"><i class="fas fa-circle-exclamation"></i> Vendor Name is required.</span>
                    <span class="vm-dup-warning" id="dup_AccountDesp"><i class="fas fa-triangle-exclamation"></i> Already exists.</span>
                </div>

                <div class="vm-form-group">
                    <label for="BillName">Display Name</label>
                    <input type="text" id="BillName" class="vm-input" placeholder="Enter display name" autocomplete="off" />
                </div>

                <div class="vm-form-group">
                    <label for="GSTNNo">GST Number</label>
                    <input type="text" id="GSTNNo" class="vm-input" placeholder="e.g. 22AAAAA0000A1Z5" autocomplete="off" maxlength="15" style="text-transform:uppercase;" />
                    <span class="vm-err-text" id="err_GSTNNo" style="display:none;"><i class="fas fa-circle-exclamation"></i> Invalid GST format.</span>
                </div>

            </div>

            <!-- ── Contact Info ── -->
            <div class="vm-section-label" style="margin-top:18px;">
                <i class="fas fa-address-book"></i> Contact Details
            </div>
            <div class="vm-form-grid">

                <div class="vm-form-group">
                    <label for="EMail">Email Address</label>
                    <input type="email" id="EMail" class="vm-input" placeholder="e.g. vendor@example.com" autocomplete="off" />
                    <span class="vm-err-text" id="err_EMail" style="display:none;"><i class="fas fa-circle-exclamation"></i> Invalid email address.</span>
                </div>

                <div class="vm-form-group">
                    <label for="PhoneNo">Phone Number</label>
                    <input type="text" id="PhoneNo" class="vm-input" placeholder="e.g. 9876543210" autocomplete="off" inputmode="numeric" maxlength="15" />
                    <span class="vm-err-text" id="err_PhoneNo" style="display:none;"><i class="fas fa-circle-exclamation"></i> Invalid phone number (10 digits required).</span>
                </div>

            </div>

            <!-- ── Address Info ── -->
            <div class="vm-section-label" style="margin-top:18px;">
                <i class="fas fa-location-dot"></i> Address Details
            </div>
            <div class="vm-form-grid">
                <div class="vm-form-group">
                    <label for="Nation">Nation / Country</label>
                    <div class="vm-ac-wrap">
                        @* <input type="text" id="Nation" class="vm-input" placeholder="Type to search country…" autocomplete="off" /> *@
                        <select id="Nation" class="vm-input" autocomplete="off" tabindex="1" maxlength="50"> </select>
                        <ul class="vm-ac-dropdown" id="ac_Nation"></ul>
                    </div>
                </div>
                <div class="vm-form-group">
                    <label for="City">City</label>
                    <div class="vm-ac-wrap">
                        @*  <input type="text" id="City" class="vm-input" placeholder="Type to search city…" autocomplete="off" /> *@
                        <select id="City" class="vm-input" autocomplete="off" tabindex="1" maxlength="50"> </select>
                        <ul class="vm-ac-dropdown" id="ac_City"></ul>
                    </div>
                </div>

                <div class="vm-form-group">
                    <label for="State">State</label>
                    <div class="vm-ac-wrap">
                        @* <input type="text" id="State" class="vm-input" placeholder="Type to search state…" autocomplete="off" /> *@
                        <select id="State" class="vm-input" autocomplete="off" tabindex="1" maxlength="50"> </select>
                        <ul class="vm-ac-dropdown" id="ac_State"></ul>
                    </div>
                </div>
                <div class="vm-form-group">
                    <label for="PinCode">Pincode</label>
                    <input type="text" id="PinCode" class="vm-input" tabindex="1" autocomplete="off" inputmode="numeric" maxlength="6" />
                    <span class="vm-pin-hint" id="pin_hint"><i class="fas fa-circle-check"></i> <span id="pin_hint_text"></span></span>
                    <span class="vm-err-text" id="err_PinCode" style="display:none;"><i class="fas fa-circle-exclamation"></i> Invalid pincode.</span>
                </div>

            </div>

        </div>

        <div class="vm-modal-footer">
            <button type="button" class="vm-btn-cancel" id="vmBtnCancelVendor">
                <i class="fas fa-times"></i> Cancel
            </button>
            <button type="button" class="vm-btn-save" id="vmBtnSaveVendor" onclick="SaveVendor()">
                <i class="fas fa-floppy-disk"></i>
                <span id="vmBtnSaveText">Save Vendor</span>
            </button>
        </div>

    </div>
</div>

