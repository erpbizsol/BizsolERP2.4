        </div>
        <div class="vm-success-title" id="vmSuccessModalTitle">Done!</div>
        <div class="vm-success-text" id="vmSuccessModalText">Operation completed successfully.</div>
        <button type="button" class="vm-btn-success-ok" onclick="CloseVendorSuccessModal()">
            <i class="fas fa-check"></i> OK
        </button>
    </div>
</div>

