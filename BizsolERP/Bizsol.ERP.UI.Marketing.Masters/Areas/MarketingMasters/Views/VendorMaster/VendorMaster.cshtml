                    <div class="vm-view-field-icon"><i class="fas fa-location-pin"></i></div>
                    <div class="vm-view-field-info">
                        <div class="vm-view-field-label">Pincode</div>
                        <div class="vm-view-field-value" id="vf_Pincode">—</div>
                    </div>
                </div>

                <div class="vm-view-field">
                    <div class="vm-view-field-icon"><i class="fas fa-receipt"></i></div>
                    <div class="vm-view-field-info">
                        <div class="vm-view-field-label">GST Number</div>
                        <div class="vm-view-field-value" id="vf_GSTNo">—</div>
                    </div>
                </div>

                <div class="vm-view-field">
                    <div class="vm-view-field-icon"><i class="fas fa-envelope"></i></div>
