@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<script src="~/assets/js/jquery-3.6.0.min.js"></script>
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />

<style>
    /* ═══════════════════════════════════════════════════
           BASE
        ═══════════════════════════════════════════════════ */
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .vm-page-wrapper {
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        min-height: 100%;
        background: #f1f3fb;
    }

    /* ═══════════════════════════════════════════════════
           MAIN CARD
        ═══════════════════════════════════════════════════ */
    .vm-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e5e7f0;
        box-shadow: 0 4px 24px rgba(99,102,241,0.09), 0 1px 4px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    /* ── Card Header ── */
    .vm-card-header {
        background: linear-gradient(130deg, #5b5ef4 0%, #8b5cf6 55%, #a855f7 100%);
        padding: 5px 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        position: relative;
        overflow: hidden;
    }

        .vm-card-header::before {
            content: '';
            position: absolute;
            top: -40px;
            right: -40px;
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: rgba(255,255,255,0.07);
            pointer-events: none;
        }

        .vm-card-header::after {
            content: '';
            position: absolute;
            bottom: -50px;
            right: 90px;
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            pointer-events: none;
        }

    .vm-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
        position: relative;
        z-index: 1;
    }

    .vm-header-icon {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        background: rgba(255,255,255,0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #fff;
        flex-shrink: 0;
    }

    .vm-header-title {
        color: #fff;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.2;
    }

    .vm-header-sub {
        color: rgba(255,255,255,0.68);
        font-size: 12px;
        margin-top: 2px;
    }

    .vm-btn-new {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 20px;
        border-radius: 999px;
        border: 2px solid rgba(255,255,255,0.48);
        background: rgba(255,255,255,0.14);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.14s;
        white-space: nowrap;
        position: relative;
        z-index: 1;
    }

        .vm-btn-new:hover {
            background: rgba(255,255,255,0.26);
            border-color: rgba(255,255,255,0.80);
            transform: translateY(-1px);
        }

    /* ── Card Body ── */
    .vm-card-body {
        padding: 18px 20px 26px;
    }

    .vm-card-body {
        padding: 18px 20px 26px;
    }

    /* ── Grid Wrapper ── */
    .vm-table-wrapper {
        border-radius: 12px;
        border: 1px solid #e4e7f0;
        overflow-x: hidden;
        height: 388px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        box-shadow: 0 2px 12px rgba(91,94,244,0.06);
        background: #fff;
        position: relative;
    }

        .vm-table-wrapper thead th {
            position: sticky;
            top: 0;
            z-index: 10;
        }

    /* Filter dropdown — fixed positioning via JS */
    .vm-filter-fixed {
        position: fixed !important;
        z-index: 99999 !important;
    }

    /* ── Table base ── */
    .vm-table-wrapper table {
        width: 100%;
        border-collapse: collapse;
        min-width: 600px;
    }
    /* ── Table ── */
    th {
        background: linear-gradient(135deg, #5b5ef4, #5b5ef4) !important;
        color: #fff !important;
        font-size: 12px !important;
        font-weight: 600 !important;
        padding: 5px 14px !important;
        white-space: nowrap;
        position: relative;
        min-width: 99px !important;
        letter-spacing: 0.02em;
        transition: background 0.18s, color 0.18s !important;
        cursor: default;
        text-transform: uppercase;
    }

        th:hover {
            background: linear-gradient(90deg, #e6091f 0%, #6b5ee6 100%) !important;
        }


    td {
        font-size: 13px;
        color: #374151;
        border-bottom: 1px solid #f3f4f6;
        vertical-align: middle;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:nth-child(even) {
        background: #fafbff;
    }

    tbody tr:nth-child(odd) {
        background: #ffffff;
    }

    tbody tr:hover {
        background: #eef2ff !important;
        transition: background 0.12s;
    }

    /* ── Action Buttons ── */
    /* Action column: keep View / Edit / Delete on one row (grid sets inline width) */
    #VendorMaster tbody td:last-child {
        white-space: nowrap;
    }

    .vm-btn-view, .vm-btn-edit, .vm-btn-delete, .vm-btn-verify {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: all 0.13s;
        margin-right: 3px;
        vertical-align: middle;
    }

    .vm-btn-view {
        background: #ecfeff;
        color: #0891b2;
    }

    .vm-btn-edit {
        background: #eef2ff;
        color: #5b5ef4;
    }

    .vm-btn-delete {
        background: #fef2f2;
        color: #ef4444;
        margin-right: 0;
    }

    .vm-btn-view:hover {
        background: #0891b2;
        color: #fff;
        transform: scale(1.10);
        box-shadow: 0 3px 10px rgba(8,145,178,0.30);
    }

    .vm-btn-edit:hover {
        background: #5b5ef4;
        color: #fff;
        transform: scale(1.10);
        box-shadow: 0 3px 10px rgba(91,94,244,0.30);
    }

    .vm-btn-delete:hover {
        background: #ef4444;
        color: #fff;
        transform: scale(1.10);
        box-shadow: 0 3px 10px rgba(239,68,68,0.30);
    }

    .vm-btn-verify {
        background: #ecfdf5;
        color: #059669;
    }

    .vm-btn-verify:hover {
        background: #059669;
        color: #fff;
        transform: scale(1.10);
        box-shadow: 0 3px 10px rgba(5, 150, 105, 0.35);
    }

    .vm-verify-status--done {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: #047857;
        background: linear-gradient(180deg, #ecfdf5 0%, #d1fae5 100%);
        border: 1px solid #34d399;
        white-space: nowrap;
        box-shadow: 0 1px 3px rgba(5, 80, 60, 0.12);
    }

    .vm-verify-status--with-detail {
        cursor: pointer;
        -webkit-tap-highlight-color: rgba(5, 150, 105, 0.18);
        user-select: none;
    }

    .paginator {
        margin-top: 14px;
    }

    /* ═══════════════════════════════════════════════════
           BACKDROP
        ═══════════════════════════════════════════════════ */
    .vm-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(8,12,36,0.54);
        backdrop-filter: blur(5px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 20px 12px;
        overflow: hidden;
    }

        .vm-backdrop.show {
            display: flex;
        }

    /* Modal open hone par body scroll band — scroll sirf modal me */
    body:has(.vm-backdrop.show) {
        overflow: hidden;
    }

    .vm-modal,
    .vm-view-modal,
    .vm-delete-modal,
    .vm-verify-modal,
    .vm-success-modal {
        margin: auto;
    }

    @@keyframes vm-up {
        from {
            transform: translateY(22px) scale(0.97);
            opacity: 0;
        }

        to {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
    }

    @@keyframes vm-pop {
        from {
            transform: scale(0.55);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* ═══════════════════════════════════════════════════
           FORM MODAL
        ═══════════════════════════════════════════════════ */
    .vm-modal {
        width: 720px;
        max-width: calc(100vw - 24px);
        max-height: calc(100vh - 40px);
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 20px 56px rgba(8,12,36,0.24);
        display: flex;
        flex-direction: column;
        animation: vm-up 0.24s cubic-bezier(0.34,1.46,0.64,1);
        overflow: hidden;
    }

    .vm-modal-header {
        background: linear-gradient(130deg, #5b5ef4, #a855f7);
        padding: 4px 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
        position: relative;
        overflow: hidden;
    }

        .vm-modal-header::before {
            content: '';
            position: absolute;
            top: -18px;
            right: -18px;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(255,255,255,0.08);
            pointer-events: none;
        }

    .vm-modal-header-title {
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 9px;
        position: relative;
        z-index: 1;
    }

    .vm-modal-close {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: none;
        background: rgba(255,255,255,0.18);
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        transition: background 0.13s;
        position: relative;
        z-index: 1;
    }

        .vm-modal-close:hover {
            background: rgba(255,255,255,0.32);
        }

    .vm-modal-body {
        padding: 20px 22px 14px;
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

        .vm-modal-body::-webkit-scrollbar {
            width: 8px;
        }

        .vm-modal-body::-webkit-scrollbar-thumb {
            background: #c4c8d4;
            border-radius: 4px;
        }

        .vm-modal-body::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

    /* ── Section Label ── */
    .vm-section-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        font-weight: 700;
        color: #5b5ef4;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 12px;
        margin-top: 4px;
    }

        .vm-section-label i {
            font-size: 12px;
        }

        .vm-section-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, #eef2ff, transparent);
        }

    .vm-form-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px 16px;
    }

    .vm-form-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px 16px;
        margin-top: 14px;
    }

    .vm-form-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .vm-form-group label {
            font-size: 11px;
            font-weight: 700;
            color: #4b5563;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

    .vm-required {
        color: #ef4444;
        margin-left: 2px;
    }

    .vm-input {
        width: 100%;
        padding: 9px 12px;
        border-radius: 9px;
        border: 1.5px solid #dde0ee;
        font-size: 13px;
        color: #111827;
        background: #f8f9fc;
        outline: none;
        transition: border-color 0.13s, box-shadow 0.13s, background 0.13s;
        appearance: none;
        -webkit-appearance: none;
    }

        .vm-input:focus {
            border-color: #5b5ef4;
            box-shadow: 0 0 0 3px rgba(91,94,244,0.12);
            background: #fff;
        }

        .vm-input.vm-input-error {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239,68,68,0.10);
        }

        .select2-container.vm-select-error .select2-selection--single {
            border-color: #ef4444 !important;
            box-shadow: 0 0 0 3px rgba(239,68,68,0.10);
        }

        .vm-input[readonly] {
            background: #f3f4f6;
            color: #6b7280;
            cursor: not-allowed;
        }

    /* ── Error / Dup text ── */
    .vm-err-text, .vm-dup-warning {
        display: none;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 600;
        margin-top: 2px;
    }

    .vm-err-text {
        color: #ef4444;
    }

    .vm-dup-warning {
        color: #f59e0b;
    }

    /* ── Modal Footer ── */
    .vm-modal-footer {
        padding: 12px 22px 18px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #eef2ff;
        flex-shrink: 0;
    }

    .vm-btn-cancel {
        padding: 9px 20px;
        border-radius: 999px;
        border: 1.5px solid #d4d7e8;
        background: #fff;
        color: #374151;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.13s;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .vm-btn-cancel:hover {
            background: #f5f5fb;
            border-color: #9ca3af;
        }

    .vm-btn-save {
        padding: 9px 24px;
        border-radius: 999px;
        border: none;
        background: linear-gradient(130deg, #5b5ef4, #a855f7);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 5px 16px rgba(91,94,244,0.32);
        transition: all 0.14s;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .vm-btn-save:hover {
            box-shadow: 0 7px 22px rgba(91,94,244,0.48);
            transform: translateY(-1px);
        }

        .vm-btn-save:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

    /* ═══════════════════════════════════════════════════
           VIEW MODAL
        ═══════════════════════════════════════════════════ */
    .vm-view-modal {
        width: 520px;
        max-width: calc(100vw - 20px);
        max-height: calc(100vh - 40px);
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 20px 56px rgba(8,12,36,0.24);
        display: flex;
        flex-direction: column;
        animation: vm-up 0.24s cubic-bezier(0.34,1.46,0.64,1);
        overflow: hidden;
    }

    .vm-view-header {
        background: linear-gradient(130deg, #5b5ef4, #a855f7);
        padding: 18px 46px 16px 20px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
        position: relative;
        overflow: hidden;
        flex-shrink: 0;
    }

        .vm-view-header::before {
            content: '';
            position: absolute;
            top: -20px;
            right: -20px;
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: rgba(255,255,255,0.07);
            pointer-events: none;
        }

    .vm-view-close-btn {
        position: absolute;
        top: 12px;
        right: 14px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: none;
        background: rgba(255,255,255,0.18);
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        transition: background 0.13s;
        z-index: 1;
    }

        .vm-view-close-btn:hover {
            background: rgba(255,255,255,0.32);
        }

    .vm-view-avatar {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: rgba(255,255,255,0.22);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        color: #fff;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
    }

    .vm-view-header-text {
        flex: 1;
        min-width: 0;
        position: relative;
        z-index: 1;
    }

    .vm-view-header-code {
        font-size: 10px;
        color: rgba(255,255,255,0.65);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 3px;
    }

    .vm-view-header-name {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 5px;
    }

    .vm-view-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .vm-view-badge {
        padding: 3px 10px;
        border-radius: 999px;
        background: rgba(255,255,255,0.18);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.03em;
    }

    .vm-view-body {
        padding: 18px 20px 10px;
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

        .vm-view-body::-webkit-scrollbar {
            width: 4px;
        }

        .vm-view-body::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 4px;
        }

    .vm-view-section-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 10px;
        font-weight: 700;
        color: #9ca3af;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

        .vm-view-section-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, #e5e7eb, transparent);
        }

    .vm-view-fields-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
    }

    .vm-view-field {
        display: flex;
        align-items: center;
        gap: 11px;
        background: #f9fafb;
        border-radius: 11px;
        padding: 11px 14px;
        border: 1px solid #f0f1f6;
        position: relative;
        overflow: hidden;
        transition: all 0.13s;
    }

        .vm-view-field::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            border-radius: 0 3px 3px 0;
        }

        .vm-view-field:nth-child(1)::before {
            background: linear-gradient(#5b5ef4,#818cf8);
        }

        .vm-view-field:nth-child(2)::before {
            background: linear-gradient(#5b5ef4,#818cf8);
        }

        .vm-view-field:nth-child(3)::before {
            background: linear-gradient(#0891b2,#22d3ee);
        }

        .vm-view-field:nth-child(4)::before {
            background: linear-gradient(#f59e0b,#fcd34d);
        }

        .vm-view-field:nth-child(5)::before {
            background: linear-gradient(#a855f7,#c084fc);
        }

        .vm-view-field:nth-child(6)::before {
            background: linear-gradient(#ef4444,#fca5a5);
        }

        .vm-view-field:nth-child(7)::before {
            background: linear-gradient(#06b6d4,#67e8f9);
        }

        .vm-view-field:hover {
            background: #fff;
            box-shadow: 0 3px 12px rgba(91,94,244,0.09);
            transform: translateX(2px);
            border-color: #e5e7eb;
        }

    .vm-view-field-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .vm-view-field:nth-child(1) .vm-view-field-icon {
        background: #eef2ff;
        color: #5b5ef4;
    }

    .vm-view-field:nth-child(2) .vm-view-field-icon {
        background: #eef2ff;
        color: #5b5ef4;
    }

    .vm-view-field:nth-child(3) .vm-view-field-icon {
        background: #ecfeff;
        color: #0891b2;
    }

    .vm-view-field:nth-child(4) .vm-view-field-icon {
        background: #fffbeb;
        color: #f59e0b;
    }

    .vm-view-field:nth-child(5) .vm-view-field-icon {
        background: #faf5ff;
        color: #a855f7;
    }

    .vm-view-field:nth-child(6) .vm-view-field-icon {
        background: #fef2f2;
        color: #ef4444;
    }

    .vm-view-field:nth-child(7) .vm-view-field-icon {
        background: #ecfeff;
        color: #06b6d4;
    }

    .vm-view-field-info {
        min-width: 0;
        flex: 1;
    }

    .vm-view-field-label {
        font-size: 10px;
        font-weight: 700;
        color: #9ca3af;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 3px;
    }

    .vm-view-field-value {
        font-size: 13px;
        font-weight: 700;
        color: #111827;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .vm-view-footer {
        padding: 12px 20px 18px;
        display: flex;
