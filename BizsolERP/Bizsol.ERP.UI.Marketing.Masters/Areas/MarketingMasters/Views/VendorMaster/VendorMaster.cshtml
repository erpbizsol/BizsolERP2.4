<div id="vmDeleteConfirmBackdrop" class="vm-backdrop">
    <div class="vm-delete-modal">
        <div class="vm-delete-icon-wrap">
            <i class="fas fa-trash-can"></i>
        </div>
        <div class="vm-delete-title">Delete this Vendor?</div>
        <div class="vm-delete-text">
            This action cannot be undone.<br>The vendor record will be permanently removed.
        </div>

        <div class="vm-delete-reason">
            <label class="vm-delete-reason-label">
                <i class="fas fa-comment-dots"></i> Reason for Delete <span class="vm-required">*</span>
            </label>
            <input type="text" id="vmReasonForDeleteInput" class="vm-delete-reason-input"
                   placeholder="Enter reason for deletion…" autocomplete="off" />
        </div>

        <div class="vm-delete-actions">
            <button type="button" class="vm-btn-cancel" id="vmBtnCancelDelete">
                <i class="fas fa-times"></i> Cancel
            </button>
            <button type="button" class="vm-btn-confirm-delete" onclick="DoVendorDelete()">
                <i class="fas fa-trash-can"></i> Yes, Delete
            </button>
        </div>
    </div>
</div>

