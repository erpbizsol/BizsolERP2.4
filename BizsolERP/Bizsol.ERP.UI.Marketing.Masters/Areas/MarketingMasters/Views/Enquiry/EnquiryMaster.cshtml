            <input list="ddlStatusList" id="ddlStatus" name="ddlStatus" class="form-control form-control-sm box_border" onclick="$(this).val('');" placeholder="" autocomplete="off" value="All">
            <datalist id="ddlStatusList"></datalist>
        </div>
        <div class="col-md-6" style="margin-top:24px;text-align:right;">
            <button class="btn btn-success btn-height" onclick="CreateNew()"><i class="fa fa-plus" aria-hidden="true"></i></button>
        </div>
    </div>
    <div id="tblLeadList" class="mt-1">
        <div class="table-wrapper fixed-height-table">
            <table id="table" class="table table-sm table-bordered">
                <thead id="table-header">
                </thead>
                <tbody id="table-body">
