<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
    /* Jilva-like theme (scoped to this page) */
    #dvEnquiry, #dvLoad, #dvFollowup {
        font-family: 'Poppins', Arial, sans-serif;
        color: #1f2d3d;
    }
    .card {
        border: 1px solid #e6e9f0;
        border-radius: 10px;
        box-shadow: 0 6px 16px rgba(31,45,61,0.06);
    }
    .card > .card-header, .card > .ps-2.p-1 {
        border-radius: 10px 10px 0 0;
    }
    /* Section headers */
    .card.ps-2.p-1 {
        background: linear-gradient(90deg,#275481 0%, #2f6aa6 100%) !important;
        color:#fff !important;
        font-weight:600 !important;
        letter-spacing:.2px;
    }
    /* Tabs header strip */
    .card-header-tabs {
        display:flex;
        gap:8px;
        padding:6px 8px;
        background:#f8fafc;
        border:1px solid #e6e9f0;
        border-radius:10px;
        margin-bottom:10px;
        align-items:center;
    }
    .card-header-tabs .tab {
        border:none;
        background:#ffffff;
        color:#275481;
        padding:8px 14px;
        font-weight:600;
        border-radius:8px;
        box-shadow: 0 2px 6px rgba(31,45,61,0.06);
        transition: all .2s ease;
        white-space:nowrap;
    }
    .card-header-tabs .tab:hover { background:#eef3f9; }
    .card-header-tabs .tab.active {
        background:#275481;
        color:#ffffff;
    }
    /* Inputs */
    .box_border.form-control, .box_border.form-select {
        border-radius:8px;
        border-color:#d7deea;
    }
    .box_border.form-control:focus, .box_border.form-select:focus {
        border-color:#275481;
        box-shadow:0 0 0 .2rem rgba(39,84,129,.15);
    }
    
    .btn-success { background:#2fb380; border-color:#28a571; }
    .btn-danger { background:#ef476f; border-color:#e23a61; }
    .btn-primary { background:#275481; border-color:#275481; }
    .btn-success:hover, .btn-danger:hover, .btn-primary:hover { filter: brightness(0.95); }
    /* Tables */
    .fixed-width-table.table thead { background:#f3f6fb; }
    /* .fixed-width-table.table th { color:#4a5a6a; font-weight:600; } */

    /* Make tables and wrappers responsive */
    .table-wrapper {
        width:100%;
        overflow-x:auto;
    }
    .fixed-width-table.table {
        width:100%;
        min-width:700px; /* keep layout on larger screens */
    }
    
</style>

