@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<script type="module" src="~/_content/Bizsol.WebERP.UI.Marketing.Masters/js/EnquiryMaster.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<script src="~/assets/js/jquery-3.6.0.min.js"></script>
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.Marketing.Masters/css/EnquiryMaster.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/gh/ankitayodhya2002/CDN@main/Filter.js"></script>

<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
    /* Enquiry — Rolling Plan Sheet palette (#558bc0) */
    #dvEnquiry {
        --enq-accent: #558bc0;
        --enq-accent-hover: #4378b0;
        --enq-accent-soft: #e8f4fd;
        --enq-surface: #f8fafc;
        --enq-border: #e2e8f0;
        --enq-text: #0f172a;
        --enq-muted: #64748b;
    }
    #dvEnquiry, #dvLoad, #dvFollowup {
        color: var(--enq-text, #0f172a);
    }
    .req { color: #dc2626; }

    #dvLoad {
        background:
            radial-gradient(1200px 420px at 8% -10%, rgba(85, 139, 192, 0.16), transparent 55%),
            radial-gradient(900px 360px at 100% 0%, rgba(51, 65, 85, 0.08), transparent 50%),
            linear-gradient(180deg, #eef3f8 0%, #f7f9fc 40%, #f1f5f9 100%);
        border-radius: 16px;
        padding: 14px 14px 18px;
        margin: 0 0 8px;
        min-height: calc(100vh - 140px);
    }
    .enq-list-shell {
        max-width: 1480px;
        margin: 0 auto;
    }
    .enq-list-card {
        background: #fff;
        border: 1px solid rgba(226, 232, 240, 0.95);
        border-radius: 16px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        margin-bottom: 14px;
    }

    .enq-list-header {
        background: linear-gradient(125deg, #1e293b 0%, #334155 48%, #558bc0 140%);
        border-radius: 0;
        padding: 20px 22px 18px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        position: relative;
        overflow: hidden;
    }
    .enq-list-header::after {
        content: "";
        position: absolute;
        right: -40px;
        top: -50px;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        pointer-events: none;
    }
    .enq-list-header h5 {
        margin: 0;
        color: #fff;
        font-weight: 700;
        font-size: 1.2rem;
        letter-spacing: -0.025em;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: nowrap;
    }
    .enq-list-header h5 .enq-title-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.18);
        font-size: 0.95rem;
        flex-shrink: 0;
    }
    .enq-list-header .enq-header-sub {
        color: rgba(255, 255, 255, 0.78);
        font-size: 0.8125rem;
        display: block;
        line-height: 1.45;
        margin: 0;
        flex: 1 1 100%;
        padding-left: 46px;
    }
    .enq-header-top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px 12px;
        position: relative;
        z-index: 1;
    }
    .enq-header-title-block {
        min-width: 0;
        flex: 1 1 auto;
    }
    .enq-header-actions {
        flex-shrink: 0;
    }
    @@media (max-width: 768px) {
        .enq-list-header {
            padding: 12px 14px;
        }
        .enq-header-top {
            align-items: center;
            gap: 8px 10px;
        }
        .enq-header-title-block {
            flex: 1 1 auto;
            min-width: 0;
        }
        .enq-list-header h5 {
            font-size: 1.05rem;
            line-height: 1.2;
        }
        .enq-list-header h5 .enq-title-icon {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            font-size: 0.85rem;
        }
        .enq-list-header .enq-header-sub {
            flex: 1 1 100%;
            order: 3;
            padding-left: 0;
            margin-top: 2px;
            font-size: 0.7rem;
            line-height: 1.35;
            color: rgba(255, 255, 255, 0.72);
        }
        .enq-header-actions {
            margin-left: auto;
        }
        .btn-enq-new {
            padding: 6px 10px;
            font-size: 0.75rem;
            gap: 5px;
            border-radius: 8px;
        }
        .btn-enq-new span {
            white-space: nowrap;
        }
        .btn-enq-settings {
            width: 32px;
            height: 32px;
            padding: 0;
            font-size: 0.8rem;
        }
    }
    /* Primary actions: New enquiry, Save, Back */
    .btn-enq-new {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        background: linear-gradient(180deg, #6a9ccd 0%, #558bc0 100%);
        color: #fff !important;
        border-radius: 10px;
        padding: 7px 16px;
        font-weight: 600;
        font-size: 0.8125rem;
        border: none;
        box-shadow: 0 2px 8px rgba(85, 139, 192, 0.4);
        cursor: pointer;
        flex-shrink: 0;
        transition: box-shadow 0.2s, transform 0.15s, filter 0.15s;
        line-height: 1.25;
    }
    .btn-enq-new:hover {
        filter: brightness(1.05);
        box-shadow: 0 4px 14px rgba(85, 139, 192, 0.5);
        transform: translateY(-1px);
        color: #fff !important;
    }
    .btn-enq-settings {
        display: inline-flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #64748b, #475569);
        color: #fff !important;
        border-radius: 10px;
        padding: 7px 12px;
        font-size: 0.875rem;
        border: none;
        box-shadow: 0 3px 10px rgba(71, 85, 105, 0.35);
        cursor: pointer;
        flex-shrink: 0;
        transition: all 0.2s;
        line-height: 1;
        width: 36px; height: 36px;
    }
    .btn-enq-settings:hover {
        color: #fff !important;
        transform: translateY(-1px);
        box-shadow: 0 5px 14px rgba(71, 85, 105, 0.45);
    }
    /* Enquiry Configuration Modal */
    #EnquiryConfigurationModal .modal-dialog { max-width: 520px; }
    #EnquiryConfigurationModal .modal-content {
        border: none; border-radius: 18px; overflow: hidden;
        box-shadow: 0 20px 56px rgba(8, 12, 36, 0.24);
    }
    #EnquiryConfigurationModal .enq-config-modal-header {
        background: linear-gradient(130deg, #558bc0, #334155);
        border: none; padding: 12px 16px;
        position: relative; overflow: hidden;
    }
    #EnquiryConfigurationModal .enq-config-modal-header::before {
        content: '';
        position: absolute; top: -18px; right: -18px;
        width: 80px; height: 80px; border-radius: 50%;
        background: rgba(255,255,255,0.08); pointer-events: none;
    }
    #EnquiryConfigurationModal .enq-config-modal-title {
        color: #fff; font-size: 15px; font-weight: 700;
        display: flex; align-items: center; gap: 9px;
        position: relative; z-index: 1; margin: 0;
    }
    #EnquiryConfigurationModal .enq-config-modal-close {
        width: 30px; height: 30px; border-radius: 50%;
        border: none; background: rgba(255,255,255,0.18);
        color: #fff; font-size: 14px; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: background 0.13s; position: relative; z-index: 1; flex-shrink: 0;
    }
    #EnquiryConfigurationModal .enq-config-modal-close:hover { background: rgba(255,255,255,0.32); }
    #EnquiryConfigurationModal .enq-config-modal-body {
        padding: 20px 22px 14px; max-height: 420px; overflow-y: auto;
    }
    #EnquiryConfigurationModal .enq-config-modal-body::-webkit-scrollbar { width: 8px; }
    #EnquiryConfigurationModal .enq-config-modal-body::-webkit-scrollbar-thumb { background: #c4c8d4; border-radius: 4px; }
    #EnquiryConfigurationModal .enq-config-checks > [class*="col-"] {
        display: flex; align-items: flex-start; gap: 8px;
        font-size: 13px; color: #374151; padding: 6px 4px;
    }
    #EnquiryConfigurationModal .enq-config-checks input[type="checkbox"] {
        margin-top: 0.2rem; flex-shrink: 0; width: 1rem; height: 1rem; cursor: pointer;
    }
    #EnquiryConfigurationModal .enq-config-checks label { font-weight: 500; line-height: 1.35; cursor: pointer; margin: 0; }
    #EnquiryConfigurationModal .enq-config-modal-footer {
        padding: 12px 22px 18px; border-top: 1px solid #eef2ff; justify-content: flex-end;
    }
    #EnquiryConfigurationModal .enq-config-btn-close {
        padding: 9px 20px; border-radius: 999px; border: 1.5px solid #d4d7e8;
        background: #fff; color: #374151; font-size: 13px; font-weight: 600; cursor: pointer;
        transition: all 0.13s; display: inline-flex; align-items: center; gap: 7px;
    }
    #EnquiryConfigurationModal .enq-config-btn-close:hover { background: #f5f5fb; border-color: #9ca3af; }
    #EnquiryConfigurationModal .enq-config-section-title {
        font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
        color: #558bc0; border-bottom: 2px solid #e2e8f0; padding-bottom: 6px; margin-bottom: 4px;
        display: flex; align-items: center; gap: 6px;
    }
    #EnquiryConfigurationModal .enq-config-section + .enq-config-section { margin-top: 16px; }
    #EnquiryConfigurationModal .enq-config-checks input[type="radio"] {
        margin-top: 0.2rem; flex-shrink: 0; width: 1rem; height: 1rem; cursor: pointer;
    }
    #EnquiryConfigurationModal .enq-config-btn-save {
        padding: 9px 22px; border-radius: 999px; border: none;
        background: linear-gradient(135deg, #558bc0, #334155);
        color: #fff; font-size: 13px; font-weight: 600; cursor: pointer;
        transition: all 0.18s; display: inline-flex; align-items: center; gap: 7px;
        box-shadow: 0 3px 10px rgba(85,139,192,0.35);
    }
    #EnquiryConfigurationModal .enq-config-btn-save:hover { filter: brightness(1.08); transform: translateY(-1px); }
    #EnquiryConfigurationModal .enq-config-btn-save:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }
    #EnquiryConfigurationModal .enq-config-mandatory-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px;
    }
    #EnquiryConfigurationModal .enq-config-mandatory-item {
        display: flex; align-items: center; gap: 8px;
        font-size: 13px; color: #374151; padding: 5px 4px;
    }
    #EnquiryConfigurationModal .enq-config-mandatory-item input[type="checkbox"] {
        flex-shrink: 0; width: 1rem; height: 1rem; cursor: pointer; margin: 0;
    }
    #EnquiryConfigurationModal .enq-config-mandatory-item label { font-weight: 500; cursor: pointer; margin: 0; line-height: 1.3; }

    .enq-filter-bar {
        background: linear-gradient(180deg, #fbfdff 0%, #f8fafc 100%);
        border: none;
        border-top: 1px solid #e8eef5;
        border-radius: 0;
        padding: 16px 20px 18px;
        margin-bottom: 0;
        position: relative;
        z-index: 2;
    }
    .enq-filter-bar .enq-filter-label {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .enq-filter-bar .enq-filter-label i {
        color: #558bc0;
        font-size: 0.78rem;
    }
    .enq-filter-bar .form-control,
    .enq-filter-bar .form-select {
        border-radius: 8px !important;
        border-color: #d7e0ea !important;
        background: #fff;
        min-height: 30px;
        height: 30px;
        padding-top: 2px;
        padding-bottom: 2px;
        font-size: 0.8rem;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
    }
    .enq-filter-bar .form-control:focus,
    .enq-filter-bar .form-select:focus {
        border-color: #558bc0 !important;
        box-shadow: 0 0 0 3px rgba(85, 139, 192, 0.18) !important;
    }
    /* Select2 next to native Status: keep widget in flow (avoids jumping to viewport top after grid refresh) */
    .enq-filter-bar .row > [class*="col-"] {
        min-width: 0;
    }
    .enq-filter-bar .select2-container {
        display: block !important;
        width: 100% !important;
        max-width: 100%;
        position: relative !important;
        vertical-align: top;
    }
    .enq-filter-bar .select2-container .select2-selection--single {
        height: 30px !important;
        min-height: 30px !important;
        border-radius: 8px !important;
        border: 1.5px solid #d7e0ea !important;
        background: #fff !important;
    }
    .enq-filter-bar .select2-container .select2-selection--single .select2-selection__rendered {
        line-height: 27px !important;
        padding-left: 10px;
        color: #0f172a;
        font-size: 0.8rem;
    }
    .enq-filter-bar .select2-container .select2-selection--single .select2-selection__arrow {
        height: 28px !important;
        top: 1px !important;
    }
    .enq-filter-bar .select2-container--focus .select2-selection--single,
    .enq-filter-bar .select2-container--open .select2-selection--single,
    .enq-filter-bar .select2-container--focus .select2-selection--multiple,
    .enq-filter-bar .select2-container--open .select2-selection--multiple {
        border-color: #558bc0 !important;
        box-shadow: 0 0 0 3px rgba(85, 139, 192, 0.16) !important;
    }
    .enq-filter-bar .select2-container .select2-selection--multiple {
        min-height: 30px !important;
        max-height: 58px;
        overflow-y: auto;
        border-radius: 8px !important;
        border: 1.5px solid #d7e0ea !important;
        background: #fff !important;
        padding: 2px 24px 2px 4px;
    }
    .enq-filter-bar .select2-container .select2-selection--multiple .select2-selection__rendered {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        padding: 0 !important;
        margin: 0 !important;
    }
    /* Select2 4.1 choice chip: remove btn is position:absolute left — keep that layout */
    .enq-filter-bar .select2-container--default .select2-selection--multiple .select2-selection__choice,
    .enq-filter-bar .select2-container .select2-selection--multiple .select2-selection__choice {
        position: relative !important;
        font-size: 0.72rem !important;
        font-weight: 600 !important;
        margin: 0 !important;
        background: linear-gradient(180deg, #eef6fc 0%, #e2f0fa 100%) !important;
        border: 1px solid #b7d4ef !important;
        color: #1e4a75 !important;
        border-radius: 999px !important;
        /* left padding reserves space for × button (no divider line) */
        padding: 2px 8px 2px 22px !important;
        line-height: 1.25 !important;
        max-width: 100%;
        overflow: hidden;
        display: inline-block !important;
        vertical-align: middle;
    }
    .enq-filter-bar .select2-container--default .select2-selection--multiple .select2-selection__choice__display,
    .enq-filter-bar .select2-container .select2-selection--multiple .select2-selection__choice__display {
        padding-left: 6px !important;
        padding-right: 2px !important;
        color: #1e4a75 !important;
        cursor: default;
    }
    .enq-filter-bar .select2-container--default .select2-selection--multiple .select2-selection__choice__remove,
    .enq-filter-bar .select2-container .select2-selection--multiple .select2-selection__choice__remove {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        bottom: 0 !important;
        width: auto !important;
        height: auto !important;
        margin: 0 !important;
        padding: 0 4px 0 8px !important;
        border: none !important;
        border-right: none !important;
        border-radius: 999px 0 0 999px !important;
        background: transparent !important;
        color: #558bc0 !important;
        font-weight: 700 !important;
        font-size: 0.95rem !important;
        line-height: 1 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer;
        box-shadow: none !important;
    }
    .enq-filter-bar .select2-container--default .select2-selection--multiple .select2-selection__choice__remove span,
    .enq-filter-bar .select2-container .select2-selection--multiple .select2-selection__choice__remove span {
        padding-right: 2px !important;
        padding-left: 0 !important;
        display: inline-block !important;
        line-height: 1 !important;
        border: none !important;
    }
    .enq-filter-bar .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover,
    .enq-filter-bar .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:focus,
    .enq-filter-bar .select2-container .select2-selection--multiple .select2-selection__choice__remove:hover {
        color: #b91c1c !important;
        background: rgba(185, 28, 28, 0.08) !important;
        outline: none !important;
    }
    .enq-filter-bar .select2-container .select2-selection--multiple .select2-selection__clear {
        margin-right: 2px !important;
        margin-top: 2px !important;
        font-size: 14px;
        color: #94a3b8 !important;
    }
    .enq-filter-bar .select2-container .select2-selection--multiple .select2-search--inline .select2-search__field {
        margin-top: 1px;
        font-size: 0.78rem;
        color: #334155;
        min-height: 22px !important;
        height: 22px !important;
        line-height: 22px !important;
    }
    /* Dropdown is on body (not clipped by .enq-list-card overflow:hidden) */
    .select2-dropdown.enq-filter-select2-dropdown {
        border: 1.5px solid #cfe0f0 !important;
        border-radius: 10px !important;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12) !important;
        overflow: hidden;
        z-index: 10050 !important;
    }
    .select2-dropdown.enq-filter-select2-dropdown .select2-results__option {
        font-size: 0.82rem;
        padding: 8px 12px;
    }
    .select2-dropdown.enq-filter-select2-dropdown .select2-results__option--highlighted {
        background: #558bc0 !important;
    }
    .enq-filter-bar .select2-container--open {
        z-index: 10050 !important;
    }
    /* Column sort menu (filter-division wraps dropdown-content; JS toggles filter-division) */
    #dvLoad .filter-table-heading-div {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        max-width: 100%;
    }
    #dvLoad .filter-table-heading {
        color: #fff !important;
    }
    #dvLoad .table-filter-arrow {
        cursor: pointer;
        line-height: 1;
    }
    #dvLoad .table-filter-arrow > i {
        color: rgba(255, 255, 255, 0.95) !important;
        font-size: 0.75rem !important;
    }
    #dvLoad .filter-division {
        position: absolute !important;
        top: calc(100% + 4px) !important;
        left: 0 !important;
        right: auto !important;
        z-index: 10080 !important;
        /* display toggled by Filter.js OpenFilter — do not force display:none here */
    }
    #dvLoad .filter-division .dropdown-content,
    #dvLoad #table.enq-list-table thead th .filter-division .dropdown-content {
        position: static !important;
        top: auto !important;
        right: auto !important;
        min-width: 172px !important;
        width: max-content !important;
        background: #ffffff !important;
        border: 1px solid #d7e0ea !important;
        border-radius: 10px !important;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.16) !important;
        padding: 6px !important;
        display: flex !important;
        flex-direction: column !important;
        color: #0f172a !important;
        overflow: hidden;
    }
    #dvLoad .filter-division .dropdown-content .dropdown-item,
    #dvLoad #table.enq-list-table thead th .filter-division .dropdown-content .dropdown-item {
        color: #1e293b !important;
        background: transparent !important;
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        padding: 9px 12px !important;
        border-radius: 8px !important;
        margin: 0 !important;
        display: flex !important;
        align-items: center !important;
        gap: 10px !important;
        cursor: pointer;
        white-space: nowrap;
        text-transform: none !important;
        letter-spacing: 0 !important;
        line-height: 1.25 !important;
    }
    #dvLoad .filter-division .dropdown-content .dropdown-item:hover {
        background: #eef6fc !important;
        color: #0f172a !important;
    }
    #dvLoad .filter-division .dropdown-content .dropdown-item i,
    #dvLoad .filter-division .dropdown-content .sort-indicator,
    #dvLoad .filter-division .dropdown-content .sort-indicator-color,
    #dvLoad #table.enq-list-table thead th .filter-division .dropdown-content .dropdown-item i {
        color: #558bc0 !important;
        font-size: 0.85rem !important;
        width: 1.1rem;
        text-align: center;
        margin: 0 !important;
    }

    /* Column filter popup after choosing Filter… */
    #dvLoad .filter-dropdown,
    #dvLoad .filter-dropdown-double {
        background: #fff !important;
        border: 1px solid #d7e0ea !important;
        border-radius: 12px !important;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.14) !important;
        padding: 12px !important;
        width: 230px !important;
        top: calc(100% + 4px) !important;
        z-index: 10080 !important;
        color: #0f172a !important;
    }
    #dvLoad .filter-dropdown label,
    #dvLoad .filter-dropdown-double label {
        font-size: 0.72rem !important;
        font-weight: 700 !important;
        color: #64748b !important;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin: 0 0 6px;
    }
    #dvLoad .filter-inputs input,
    #dvLoad .filter-dropdown input[type="text"],
    #dvLoad .filter-dropdown-double input[type="text"] {
        border: 1.5px solid #d7e0ea !important;
        border-radius: 8px !important;
        padding: 8px 10px !important;
        font-size: 0.82rem !important;
        color: #0f172a !important;
        margin-bottom: 8px !important;
        background: #fff !important;
        box-shadow: none !important;
    }
    #dvLoad .filter-inputs input:focus,
    #dvLoad .filter-dropdown input[type="text"]:focus {
        border-color: #558bc0 !important;
        outline: none;
        box-shadow: 0 0 0 3px rgba(85, 139, 192, 0.16) !important;
    }
    #dvLoad .filter-dropdown button,
