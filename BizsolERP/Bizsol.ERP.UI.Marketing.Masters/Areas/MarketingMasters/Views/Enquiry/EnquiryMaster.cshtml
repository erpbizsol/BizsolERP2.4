</div>
<div class="modal fade" id="VerifyModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Verify/Reject</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="col-md-12">
                    <label for="txtVerifyReason" class="form-label">Reason </label>
                    <input type="text" id="txtVerifyReason" class="form-control" placeholder="Please enter reason.." autocomplete="off" />
                    <input type="hidden" id="txtEnquiryCode" class="form-control" placeholder="" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success icon-height" onclick="Verify()">Verify</button>
                <button type="button" class="btn btn-danger icon-height" onclick="Reject()">Reject</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseVerifyModal()">Cancel</button>
            </div>
        </div>
