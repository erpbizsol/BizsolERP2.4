@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<script type="module" src="~/_content/Bizsol.WebERP.UI.Marketing.Masters/js/EnquiryMaster.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<script src="~/assets/js/jquery-3.6.0.min.js"></script>
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.Marketing.Masters/css/EnquiryMaster.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/gh/ankitayodhya2002/CDN@main/Filter.js"></script>

<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
    /* Enquiry — Rolling Plan Sheet palette (#558bc0) */
    #dvEnquiry {
        --enq-accent: #558bc0;
        --enq-accent-hover: #4378b0;
        --enq-accent-soft: #e8f4fd;
        --enq-surface: #f8fafc;
        --enq-border: #e2e8f0;
        --enq-text: #0f172a;
        --enq-muted: #64748b;
    }
    #dvEnquiry, #dvLoad, #dvFollowup {
        color: var(--enq-text, #0f172a);
    }
    .req { color: #dc2626; }

    #dvLoad {
        background: transparent;
    }

    .enq-list-header {
        background: linear-gradient(135deg, #334155 0%, #1e293b 100%);
        border-radius: 12px 12px 0 0;
        padding: 18px 24px 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .enq-list-header h5 { margin: 0; color: #fff; font-weight: 650; font-size: 1.05rem; letter-spacing: -0.02em; }
    .enq-list-header small { color: rgba(255,255,255,0.72); font-size: 0.8125rem; display: block; line-height: 1.4; }
    .enq-header-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    /* Primary actions: New enquiry, Save, Back */
    .btn-enq-new {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        background: linear-gradient(180deg, #6a9ccd 0%, #558bc0 100%);
        color: #fff !important;
        border-radius: 10px;
        padding: 7px 16px;
        font-weight: 600;
        font-size: 0.8125rem;
        border: none;
        box-shadow: 0 2px 8px rgba(85, 139, 192, 0.4);
        cursor: pointer;
        flex-shrink: 0;
        transition: box-shadow 0.2s, transform 0.15s, filter 0.15s;
        line-height: 1.25;
    }
    .btn-enq-new:hover {
        filter: brightness(1.05);
        box-shadow: 0 4px 14px rgba(85, 139, 192, 0.5);
        transform: translateY(-1px);
        color: #fff !important;
    }

    .enq-filter-bar {
        background: #fff;
        border: 1px solid var(--enq-border, #e2e8f0);
        border-top: none;
        border-radius: 0 0 12px 12px;
        padding: 14px 18px 14px;
        margin-bottom: 16px;
        position: relative;
        z-index: 2;
    }
    /* Select2 next to native Status: keep widget in flow (avoids jumping to viewport top after grid refresh) */
    .enq-filter-bar .row > [class*="col-"] {
        min-width: 0;
    }
    .enq-filter-bar .select2-container {
        display: block !important;
        width: 100% !important;
        max-width: 100%;
        position: relative !important;
        vertical-align: top;
    }
    .enq-filter-bar .select2-container .select2-selection--single {
        height: calc(1.5em + 0.5rem + 2px);
    }
    .enq-grid-wrap {
        background: #fff;
        border-radius: 12px;
        border: 1px solid var(--enq-border, #e2e8f0);
        box-shadow: 0 1px 3px rgba(15,23,42,0.06);
        overflow: hidden;
        margin-bottom: 12px;
    }
    .table-wrapper.enq-table-scroll { max-height: 440px; overflow-y: auto; }
    .enq-grid-wrap #table.table { margin-bottom: 0; }

    /* List grid — Rolling Plan Sheet style (#tblTable) */
    .enq-grid-wrap .table-wrapper.enq-table-scroll {
        position: relative;
        overflow: auto;
    }
    #table.enq-list-table {
        width: 100%;
        margin-bottom: 0;
        border-collapse: collapse;
    }
    #table.enq-list-table thead {
        position: sticky;
        top: 0;
        z-index: 06;
        background-color: #fff;
    }
    #table.enq-list-table thead th {
        background-color: #558bc0 !important;
        color: #fff !important;
        position: sticky;
        top: 0;
        border-bottom: 2px solid #dee2e6 !important;
        border-top: none !important;
        border-left: none !important;
        border-right: 1px solid rgba(255,255,255,0.25) !important;
        padding: 6px 10px !important;
        padding-right: 15px !important;
        font-size: 8pt !important;
        font-weight: 600 !important;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #table.enq-list-table thead th:last-child {
        border-right: none !important;
    }
    /* List filters live in #dvLoad — stack above sticky thead; dropdown is on body */
    #dvLoad .select2-container--open {
        z-index: 10050 !important;
    }
    .select2-dropdown {
        z-index: 10050 !important;
    }
    #table.enq-list-table tbody td {
        padding: 4px 8px !important;
        border: 1px solid #ddd !important;
        font-size: 9pt !important;
        vertical-align: middle !important;
        color: #212529;
    }
    #table.enq-list-table.table-hover tbody tr:hover {
        background-color: #e8f4fd !important;
    }
    /* Action column: flex cell + display:contents wrapper = all buttons one row, centered */
    #dvLoad #table.enq-list-table thead th:last-child {
        min-width: 270px;
        text-align: center !important;
        vertical-align: middle !important;
    }
    #dvLoad #table.enq-list-table tbody td:last-child {
        min-width: 270px;
        width: 1%;
        white-space: nowrap;
        text-align: center !important;
        vertical-align: middle !important;
        flex-wrap: nowrap !important;
        justify-content: center !important;
        align-items: center !important;
        gap: 5px;
        padding: 6px 8px !important;
        /* Collapse &nbsp; text nodes between buttons (legacy string concat) */
        font-size: 0;
        line-height: 0;
    }
    #dvLoad #table.enq-list-table tbody td:last-child .btn,
    #dvLoad #table.enq-list-table tbody td:last-child .btn-group {
        font-size: 0.875rem;
        line-height: 1.25;
    }
    /* Unwrap inner div so buttons lay out in the <td> flex row */
    #dvLoad #table.enq-list-table tbody td:last-child .enq-action-wrap {
        display: contents;
    }
    #dvLoad #table.enq-list-table tbody td:last-child .btn,
    #dvLoad #table.enq-list-table tbody td:last-child .btn-group {
        margin: 0 !important;
        flex: 0 0 auto;
        align-self: center !important;
    }
    /* Bootstrap .btn-group > .btn { flex: 1 1 auto } + default align-items:stretch — kills tall rows */
    #dvLoad #table.enq-list-table tbody td:last-child .btn-group {
        display: inline-flex !important;
        flex-direction: row;
        align-items: center !important;
        align-self: center !important;
        height: auto !important;
        min-height: 0 !important;
    }
    #dvLoad #table.enq-list-table tbody td:last-child .btn-group > .btn {
        flex: 0 0 auto !important;
        align-self: center !important;
        height: 28px !important;
        min-height: 28px !important;
        max-height: 28px !important;
    }
    #dvLoad #table.enq-list-table tbody td:last-child .btn.icon-height {
        min-width: 26px;
        width: 28px;
        height: 28px !important;
        min-height: 28px !important;
        max-height: 28px !important;
        padding: 0 !important;
        font-size: 11px !important;
        line-height: 1 !important;
        border-radius: 5px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
    }
    #dvLoad #table.enq-list-table tbody td:last-child .btn-group > .btn.dropdown-toggle {
        margin-top: 0 !important;
        min-width: 28px;
        width: 28px;
        height: 28px !important;
        min-height: 28px !important;
        max-height: 28px !important;
        padding: 0 !important;
    }
    #dvLoad #table.enq-list-table tbody td:last-child .dropdown-menu {
        font-size: 9pt;
    }

    .enq-form-wrap {
        padding-bottom: 28px;
        max-width: 1320px;
        margin-left: auto;
        margin-right: auto;
    }

    /* Tabs left; Back right — no empty “balance” column (avoids large left gap) */
    .enq-section-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px 16px;
        padding: 8px 12px;
        background: #fff;
        border: 1px solid var(--enq-border, #e2e8f0);
        border-radius: 12px;
        margin-bottom: 16px;
        position: sticky;
        top: 62px;
        z-index: 1020;
        box-shadow: 0 1px 2px rgba(15,23,42,0.04);
    }
    .enq-nav-tabs-wrap {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        flex: 1 1 auto;
        min-width: 0;
    }
    .enq-nav-back {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }
    .enq-section-nav .tab {
        border: 1px solid #dee2e6;
        background: #f8f9fa;
        color: #495057;
        padding: 0 0.75rem;
        height: 28px;
        font-weight: 600;
        font-size: 0.75rem;
        border-radius: 5px;
        transition: background 0.2s, color 0.2s, border-color 0.2s, box-shadow 0.2s;
        white-space: nowrap;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }
    .enq-section-nav .tab:hover:not(.active) {
        background: #eceaff;
        color: #2d2a52;
        border-color: #c9c5ff;
    }
    .enq-section-nav .tab.active {
        background: #558bc0;
        color: #fff !important;
        border-color: #578dc3;
        box-shadow: 0 2px 6px rgba(83, 135, 188, 0.45);
    }
    .enq-section-nav .btn-enq-secondary {
        background: #fff;
        color: #475569 !important;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 6px 12px;
        font-weight: 600;
        font-size: 0.75rem;
        box-shadow: none;
        line-height: 1.35 !important;
        height: auto !important;
    }
    .enq-section-nav .btn-enq-secondary:hover {
        background: #f1f5f9;
        border-color: #94a3b8;
        color: #0f172a !important;
    }

    .enq-step-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid var(--enq-border, #e2e8f0);
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
        margin-bottom: 20px;
        overflow: hidden;
    }
    .enq-step-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 16px;
        background: linear-gradient(90deg, var(--enq-accent-soft, #e8f4fd) 0%, #f0f7fc 55%, #fff 100%);
        border-bottom: 1px solid #d6e8f5;
        border-left: 4px solid var(--enq-accent, #558bc0);
    }
    .enq-step-num {
        width: 26px; height: 26px; border-radius: 7px;
        background: var(--enq-accent, #558bc0);
        color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 0.8rem; flex-shrink: 0;
        border: none;
        box-shadow: 0 2px 6px rgba(85, 139, 192, 0.35);
    }
    .enq-step-title {
        font-weight: 700; font-size: 0.8125rem;
        color: #1e4a6e;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        flex: 1;
    }
    .enq-step-icon { color: #558bc0; font-size: 1.05rem; opacity: 0.9; }
    .enq-step-body {
        padding: 18px 18px 22px;
        background: #fafcfd;
    }
    /* Customer type toggle — align with form grid (no centered dead space) */
    .enq-customer-type-row {
        display: flex;
        justify-content: flex-start;
        width: 100%;
        margin-bottom: 1.25rem;
    }

    #dvEnquiry .form-label,
    #dvFollowup .form-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 4px;
        letter-spacing: 0.01em;
    }

    #dvEnquiry .box_border.form-control:not(textarea),
    #dvEnquiry .box_border.form-select,
    #dvEnquiry #txtAttachment {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.8125rem;
        background-color: #fff;
        color: #0f172a;
        min-height: 32px;
        padding-top: 0.3rem;
        padding-bottom: 0.3rem;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    #dvEnquiry .box_border.form-control:focus,
    #dvEnquiry .box_border.form-select:focus {
        border-color: var(--enq-accent, #558bc0);
        background-color: #fff;
        box-shadow: 0 0 0 3px rgba(85, 139, 192, 0.18);
    }
    #dvEnquiry .enq-upload-btn {
        background: #fff !important;
        color: #558bc0 !important;
        border: 1px dashed #7eb0db !important;
        font-weight: 600;
        cursor: pointer;
    }
    #dvEnquiry .enq-upload-btn:hover {
        background: var(--enq-accent-soft, #e8f4fd) !important;
        border-color: #558bc0 !important;
        border-style: solid !important;
    }
    #dvFollowup .box_border.form-control:not(textarea),
    #dvFollowup .box_border.form-select {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background-color: #fff;
        min-height: 32px;
        padding-top: 0.3rem;
        padding-bottom: 0.3rem;
        font-size: 0.8125rem;
    }
    #dvFollowup .box_border.form-control:focus,
    #dvFollowup .box_border.form-select:focus {
        border-color: #558bc0;
        box-shadow: 0 0 0 3px rgba(85, 139, 192, 0.18);
    }
    #dvLoad .form-control:not(textarea),
    #dvLoad .form-select {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.8125rem;
        background-color: #fff;
        min-height: 32px;
        padding-top: 0.3rem;
        padding-bottom: 0.3rem;
    }
    #dvLoad .form-control:focus, #dvLoad .form-select:focus {
        border-color: #558bc0;
        box-shadow: 0 0 0 3px rgba(85, 139, 192, 0.18);
    }

    /* Segmented customer type — pill group */
    #dvEnquiry .customer-type.enq-segment-wrap {
        display: inline-flex;
        padding: 4px;
        background: #fff;
        border-radius: 12px;
        border: 1px solid #cfe2f3;
        gap: 6px;
        box-shadow: 0 1px 3px rgba(85, 139, 192, 0.12);
    }
    #dvEnquiry .customer-type label.customertype:has(input[type="radio"]:checked) {
        background: linear-gradient(180deg, #6a9ccd 0%, #558bc0 100%);
        color: #fff !important;
        box-shadow: 0 2px 6px rgba(85, 139, 192, 0.35);
        border: 1px solid #4a7eb0;
    }
    #dvEnquiry .customer-type label.customertype:has(input[type="radio"]) {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid transparent;
        border-radius: 8px;
        padding: 6px 16px;
        font-weight: 600;
        font-size: 0.78rem;
    }

    /* Contact / Product line grids — header */
    .enq-grid-table { width: 100%; border-collapse: separate; border-spacing: 0; }
    .enq-grid-table thead tr th {
        background: #558bc0;
        color: #fff;
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        text-align: center;
        vertical-align: middle;
        padding: 11px 10px;
        white-space: nowrap;
        border: none;
        border-right: 1px solid rgba(255,255,255,0.15);
    }
    .enq-grid-table thead tr th:last-child { border-right: none; }
    .enq-grid-table thead tr th:first-child { border-radius: 8px 0 0 0; }
    .enq-grid-table thead tr th:last-child { border-radius: 0 8px 0 0; }
    .enq-grid-table tbody tr { transition: background 0.12s; }
    .enq-grid-table tbody tr:hover { background: #e8f4fd; }
    .enq-grid-table tbody tr td {
        padding: 8px 10px;
        vertical-align: middle;
        border: 1px solid #e2e8f0;
        font-size: 0.8125rem;
    }

    .enq-form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 8px;
        padding: 14px 18px;
        background: #f8fafc;
        border: 1px solid var(--enq-border, #e2e8f0);
        border-radius: 12px;
        box-shadow: 0 1px 2px rgba(15,23,42,0.04);
    }
    .enq-form-actions .enq-actions-hint {
        margin-right: auto;
        font-size: 0.8125rem;
        color: #64748b;
    }
    .btn-enq-primary {
        background: linear-gradient(180deg, #6a9ccd 0%, #558bc0 100%);
        border: none;
        color: #fff !important;
        border-radius: 10px;
        padding: 8px 22px;
        font-size: 0.8125rem;
        font-weight: 600;
        box-shadow: 0 2px 10px rgba(85, 139, 192, 0.4);
        transition: filter 0.15s, transform 0.15s, box-shadow 0.15s;
        height: auto !important;
        line-height: 1.4 !important;
    }
    .btn-enq-primary:hover {
        filter: brightness(1.05);
        color: #fff !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(85, 139, 192, 0.5);
    }

    /* Follow-up form: secondary / ghost actions (match main enquiry toolbar) */
    .btn-enq-outline {
        background: #fff !important;
        color: #475569 !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.8125rem;
        box-shadow: none;
        height: auto !important;
        line-height: 1.35 !important;
    }
    .btn-enq-outline:hover {
        background: #f8fafc !important;
        border-color: #94a3b8 !important;
        color: #0f172a !important;
    }
    .btn-enq-outline-danger {
        background: #fff !important;
        color: #b91c1c !important;
        border: 1px solid #fecaca !important;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.8125rem;
        height: auto !important;
        line-height: 1.35 !important;
    }
    .btn-enq-outline-danger:hover {
        background: #fef2f2 !important;
        border-color: #f87171 !important;
        color: #991b1b !important;
    }
    /* + Add contact — same height as inputs, enquiry accent */
    #dvFollowup .btn-enq-icon-add {
        background: linear-gradient(180deg, #6a9ccd 0%, #558bc0 100%);
        border: none !important;
        color: #fff !important;
        min-height: 32px;
        height: 32px;
        max-height: 32px;
        padding: 0 !important;
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(85, 139, 192, 0.35);
    }
    #dvFollowup .btn-enq-icon-add:hover {
        filter: brightness(1.06);
        color: #fff !important;
    }

    /* Follow-up grid block — same card feel as main list */
    #dvFollowup .enq-follow-grid-wrap {
        background: #fff;
        border: 1px solid var(--enq-border, #e2e8f0);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(15,23,42,0.06);
    }
    #dvFollowup .enq-follow-grid-wrap .table-wrapper {
        max-height: 440px;
        overflow: auto;
    }
    /* JS-built grids: beat Bootstrap .table thead defaults */
    #dvFollowup table.enq-grid-table thead th,
    #dvEnquiry table.enq-grid-table thead th {
        background-color: #558bc0 !important;
        color: #fff !important;
        border-color: rgba(255,255,255,0.2) !important;
    }
    #dvFollowup #FollowUp tbody td .btn-primary,
    #dvFollowup #FollowUp tbody td .btn.btn-primary {
        background: linear-gradient(180deg, #6a9ccd 0%, #558bc0 100%) !important;
        border: none !important;
        color: #fff !important;
        border-radius: 6px;
        box-shadow: 0 1px 3px rgba(85, 139, 192, 0.35);
    }
    #dvFollowup #FollowUp tbody td .btn-danger,
    #dvFollowup #FollowUp tbody td .btn.btn-danger {
        background: #fff !important;
        color: #dc2626 !important;
        border: 1px solid #fecaca !important;
        border-radius: 6px;
    }
    #dvFollowup #FollowUp tbody td .btn-danger:hover {
        background: #fef2f2 !important;
    }
    /* Same as main list: Filter.css .fixed-width-table uses white-space:nowrap — text stays on one line; scroll horizontally */
    #dvFollowup #FollowUp.fixed-width-table td,
    #dvFollowup #FollowUp.fixed-width-table th {
        vertical-align: middle;
    }
    #dvFollowup #FollowUp .enq-fu-row-actions {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    /* Paginator — match enquiry accent (Filter.js buttons); compact height */
    #dvFollowup .paginator,
    #dvLoad .paginator,
    #AssignModal .paginator {
        margin-top: 0;
        padding: 6px 10px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        font-size: 0.72rem;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
    }
    #dvFollowup .enq-follow-grid-wrap .paginator,
    #dvLoad .enq-grid-wrap .paginator,
    #AssignModal .paginator {
        border-radius: 0 0 12px 12px;
        border-top: 1px solid #e2e8f0;
    }
    #dvFollowup .paginator button.paginator-btn,
    #dvLoad .paginator button.paginator-btn,
    #AssignModal .paginator button.paginator-btn {
