@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 style="color:red">Hi size Control </h1>
 
<button class="btn btn-primary iconBtn" type="button" onclick="JIOK()">
    <i class='bx bxs-file-plus align-middle'></i>
</button>

<div class="row">
<div class="col-md-2">
        <h5>Number</h5>
        <input class="form-control" type="text" placeholder="Numbric text" onchange="BizSolInputControl.OnChangeNumericTextBox(this)" onkeypress="return BizSolInputControl.OnKeyDownPressNumericTextBox(event,this);">
        <h5>Float</h5>
        <input class="form-control" type="text" placeholder="Float text" onchange="BizSolInputControl.OnChangeFloatTextBox(this)" onkeypress="return BizSolInputControl.OnKeyDownPressFloatTextBox(event,this);">
        <h5>Email</h5>
        <input class="form-control" type="text" placeholder="Email text" onchange="BizSolInputControl.OnChangeEmailTextBox(this)" onkeypress="BizSolhandleEnterKey(event)">
        <h5>String Not Allowed Char</h5>
        <input class="form-control" type="text" placeholder="String Not Allowed Char text" onchange="BizSolInputControl.OnChangeStringTextBox(this,'M,a,n,p',',')" onkeypress="BizSolhandleEnterKey(event)">
        <h5>URL</h5>
        <input class="form-control" type="text" placeholder="URL text" onchange="BizSolInputControl.OnChangeURLTextBox(this)" onkeypress="BizSolhandleEnterKey(event)">
        
    </div>
</div>

<div id="DivSizeControlmodal"></div>

