<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>BizSol ERP2.4</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Premium Multipurpose Admin & Dashboard Template" name="description" />
    <meta content="Themesbrand" name="author" />
    <!--toastr-->
    <link href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />
    <link href="~/assets/css/toastr.min.css" rel="stylesheet" />
    <!-- DataTables -->
    <link href="~/assets/libs/datatables.net-bs4/css/datatables.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" />
    <!-- Responsive datatable examples -->
    <link href="~/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" />
    <!-- Bootstrap Css -->
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Icons Css -->
    <link href="~/assets/css/icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link href="~/assets/libs/select2-4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- App Css-->
    <link href="~/assets/css/app.min.css" rel="stylesheet" />
    <link href="~/assets/css/responsive.css" rel="stylesheet"/>
    <script src="~/assets/js/jquery-3.6.0.min.js"></script>
    <style>
        :root {
            /* BizSol ERP - Royal Blue Corporate Theme */
            --primary-gradient: linear-gradient(135deg, #1251b5 0%, #1565c0 100%);
            --secondary-gradient: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
            --success-gradient: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
            --warning-gradient: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
            --info-gradient: linear-gradient(135deg, #0891b2 0%, #0e7490 100%);
            --accent-gradient: linear-gradient(135deg, #1251b5 0%, #0891b2 100%);

            /* Content Area - Cool Light */
            --light-bg: #eef3fa;
            --white-bg: #ffffff;
            --card-bg: #ffffff;
            --card-hover: #f6f9ff;
            --text-dark: #0c1932;
            --text-primary: #1a2d52;
            --text-muted: #64748b;
            --border-color: #d8e3f0;
            --border-light: #eef3fa;

            /* Brand Accent Colors */
            --accent-primary: #1251b5;
            --accent-primary-dark: #0d3d8a;
            --accent-secondary: #f97316;
            --accent-secondary-dark: #ea580c;
            --accent-gray: #64748b;
            --accent-success: #16a34a;
            --accent-warning: #eab308;
            --accent-info: #0891b2;

            /* Colored Corporate Header */
            --header-bg: linear-gradient(135deg, #0a2760 0%, #0e3585 45%, #1045a8 100%);

            /* Sidebar - CLEAN WHITE (like SAP Fiori, Oracle, Salesforce) */
            --sidebar-bg: #ffffff;
            --sidebar-item-hover: rgba(18, 81, 181, 0.07);
            --sidebar-item-active: rgba(18, 81, 181, 0.12);
            --sidebar-text: #334155;
            --sidebar-icon: #1251b5;

            /* Professional Shadows */
            --shadow-sm: 0 1px 3px rgba(12, 25, 50, 0.06);
            --shadow-md: 0 4px 16px rgba(12, 25, 50, 0.08);
            --shadow-lg: 0 10px 30px rgba(12, 25, 50, 0.10);
            --shadow-xl: 0 20px 50px rgba(12, 25, 50, 0.12);
            --shadow-primary: 0 8px 24px rgba(18, 81, 181, 0.22);
            --shadow-secondary: 0 8px 24px rgba(249, 115, 22, 0.20);
            --shadow-success: 0 8px 24px rgba(22, 163, 74, 0.20);

            /* ── Live Theme-Switch Variables ── */
            --header-border-img: linear-gradient(90deg, #38bdf8 0%, #818cf8 35%, #f97316 70%, #fbbf24 100%) 1;
            --header-icon-bg: rgba(255, 255, 255, 0.10);
            --header-icon-border: rgba(255, 255, 255, 0.15);
            --header-icon-color: rgba(255, 255, 255, 0.85);
            --header-icon-hover-bg: rgba(255, 255, 255, 0.22);
            --logo-gradient: linear-gradient(135deg, #ffffff 0%, #bfdbfe 50%, #fde68a 100%);
            --popup-bg: #ffffff;
            --popup-border: var(--border-color);
            --popup-title-bg: rgba(18, 81, 181, 0.05);
            --popup-hover-bg: rgba(18, 81, 181, 0.07);
            --popup-icon-color: var(--accent-primary);
            --welcome-bg: linear-gradient(135deg, #0a2760, #1251b5, #0891b2, #f97316, #1251b5);
            --footer-border-img: linear-gradient(90deg, #1251b5 0%, #f97316 100%) 1;
            --mobile-border-img: linear-gradient(90deg, #1251b5 0%, #0891b2 50%, #f97316 100%) 1;
            --time-color: rgba(255, 255, 255, 0.90);
            --menu-label-color: rgba(18, 81, 181, 0.45);
            --sidebar-hover-text: var(--accent-primary);
            --sidebar-border-right: 1px solid var(--border-color);
        }

        body {
            background: var(--light-bg);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text-dark);
        }

        .modern-header {
            background: var(--header-bg);
            box-shadow: 0 2px 16px rgba(10, 39, 96, 0.35);
            padding: 0.75rem 1.5rem;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            border-bottom: 3px solid;
            border-image: var(--header-border-img);
        }

        .modern-header::after {
            content: '';
            position: absolute;
            top: 0;
            left: -150%;
            width: 60%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.04), transparent);
            animation: headerShimmer 10s ease-in-out infinite;
            pointer-events: none;
        }

        @@keyframes headerShimmer {
            0%   { left: -150%; }
            100% { left: 180%; }
        }

        .modern-sidebar {
            background: var(--sidebar-bg);
            width: 270px;
            position: fixed;
            left: 0;
            top: 70px;
            bottom: 0;
            box-shadow: 2px 0 12px rgba(12, 25, 50, 0.08);
            overflow-y: auto;
            transition: all 0.3s ease;
            z-index: 999;
            border-right: var(--sidebar-border-right);
        }

        .modern-sidebar.collapsed {
            width: 70px;
        }

        .modern-sidebar.collapsed .sidebar-menu-item span {
            display: none;
        }

        .modern-sidebar.collapsed .sidebar-menu-item::after {
            display: none;
        }

        .modern-sidebar.collapsed .sub-menu {
            display: none !important;
        }

        .modern-sidebar.collapsed .sidebar-menu-item {
            justify-content: center;
            padding: 0.875rem 0.5rem;
            margin: 0.35rem 0.25rem;
        }

        .modern-sidebar.collapsed h6 {
            display: none;
        }

        /* Popup menu for collapsed sidebar */
        .sidebar-popup-menu {
            position: fixed;
            left: 70px;
            background: var(--popup-bg);
            border: 1px solid var(--popup-border);
            border-radius: 14px;
            box-shadow: 0 16px 50px rgba(12, 25, 50, 0.14), 0 4px 12px rgba(18, 81, 181, 0.08);
            min-width: 230px;
            display: none;
            z-index: 1100;
            padding: 0.5rem 0;
            animation: slideInRight 0.25s ease;
        }

        @@keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(-10px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .sidebar-popup-menu .popup-menu-title {
            padding: 0.75rem 1.1rem;
            font-weight: 700;
            color: var(--text-dark);
            border-bottom: 2px solid;
            border-image: linear-gradient(90deg, #1251b5 0%, #f97316 100%) 1;
            margin-bottom: 0.4rem;
            background: var(--popup-title-bg);
            font-size: 0.9rem;
            letter-spacing: 0.3px;
        }

        .sidebar-popup-menu .popup-menu-item {
            padding: 0.75rem 1rem;
            color: var(--sidebar-text);
            text-decoration: none;
            display: flex;
            align-items: center;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }

        .sidebar-popup-menu .popup-menu-item:hover {
            background: var(--popup-hover-bg);
            color: var(--sidebar-hover-text);
            border-left-color: var(--accent-primary);
            padding-left: 1.25rem;
        }

        .sidebar-popup-menu .popup-menu-item i {
            margin-right: 0.75rem;
            min-width: 20px;
            color: var(--popup-icon-color);
            font-size: 0.9rem;
        }

        .sidebar-popup-menu .popup-menu-item.has-arrow {
            position: relative;
        }

        .sidebar-popup-menu .popup-menu-item.has-arrow::after {
            content: '\203A';
            margin-left: auto;
            font-size: 1.3rem;
            color: var(--text-muted);
        }

        .sidebar-popup-menu .popup-submenu {
            display: none;
            padding-left: 1rem;
        }

        .sidebar-popup-menu .popup-submenu .popup-menu-item {
            padding: 0.6rem 1rem;
            font-size: 0.875rem;
        }

        .modern-sidebar.collapsed .sidebar-menu-item {
            position: relative;
        }

        .sidebar-menu-item {
            padding: 0.875rem 1.25rem;
            display: flex;
            align-items: center;
            color: var(--sidebar-text);
            text-decoration: none;
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
            margin: 0.35rem 0.75rem;
            border-radius: 10px;
            background: transparent;
            cursor: pointer;
        }

        .sidebar-menu-item:hover {
            background: var(--sidebar-item-hover);
            border-left-color: var(--accent-primary);
            color: var(--sidebar-hover-text);
            transform: translateX(3px);
        }

        .sidebar-menu-item.active {
            background: var(--sidebar-item-active);
            border-left-color: var(--accent-primary);
            color: var(--sidebar-hover-text);
            font-weight: 600;
        }

        .sidebar-menu-item i {
            font-size: 1.2rem;
            min-width: 36px;
            color: var(--sidebar-icon);
            transition: all 0.3s ease;
        }

        .sidebar-menu-item:hover i {
            color: var(--sidebar-hover-text);
            transform: scale(1.1);
        }

        .sidebar-menu-item.active i {
            color: var(--sidebar-hover-text);
        }

        .sidebar-menu-item span {
            flex: 1;
            font-size: 0.95rem;
        }

        /* Parent menu items with arrows */
        .sidebar-menu-item.has-arrow::after {
            content: '\203A';
            font-size: 1.5rem;
            margin-left: auto;
            transition: transform 0.3s ease;
            color: var(--text-muted);
        }

        .sidebar-menu-item.has-arrow.active::after {
            transform: rotate(90deg);
            color: var(--accent-primary);
        }

        .sub-menu {
            padding-left: 1.5rem;
            margin-top: 0;
            margin-bottom: 0.5rem;
            background: transparent;
        }

        .sub-menu .sidebar-menu-item {
            padding: 0.7rem 1rem;
            margin: 0.25rem 0.5rem;
            font-size: 0.9rem;
            border-radius: 8px;
        }

        .sub-menu .sidebar-menu-item i {
            font-size: 1rem;
            min-width: 30px;
        }

        .sub-menu .sub-menu {
            padding-left: 1.25rem;
        }

        .sub-menu .sub-menu .sidebar-menu-item {
            padding: 0.6rem 0.85rem;
            font-size: 0.85rem;
            border-radius: 6px;
        }

        .sub-menu .sub-menu .sidebar-menu-item i {
            font-size: 0.9rem;
            min-width: 26px;
        }

        .modern-content {
            margin-left: 270px;
            margin-top: 70px;
            padding: 2rem;
            min-height: calc(100vh - 70px);
            transition: margin-left 0.3s ease;
        }

        .modern-sidebar.collapsed ~ .modern-content {
            margin-left: 70px;
        }

        .dashboard-card {
            background: var(--white-bg);
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-md);
            transition: all 0.4s ease;
            border: 1px solid var(--border-color);
            position: relative;
            overflow: hidden;
        }

        .dashboard-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--primary-gradient);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .dashboard-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-primary);
            border-color: var(--accent-primary);
        }

        .dashboard-card:hover::before {
            opacity: 1;
        }

        .stat-card {
            background: var(--white-bg);
            border-radius: 20px;
            padding: 1.5rem;
            position: relative;
            overflow: hidden;
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
            box-shadow: var(--shadow-sm);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--primary-gradient);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-primary);
        }

        .stat-card.success::before {
            background: var(--secondary-gradient);
        }

        .stat-card.warning::before {
            background: var(--warning-gradient);
        }

        .stat-card.info::before {
            background: var(--info-gradient);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            background: var(--primary-gradient);
            color: white;
            box-shadow: var(--shadow-primary);
            transition: all 0.3s ease;
        }

        .stat-icon:hover {
            transform: scale(1.1) rotate(5deg);
        }

        .stat-icon.success {
            background: var(--success-gradient);
            box-shadow: var(--shadow-success);
        }

        .stat-icon.warning {
            background: var(--warning-gradient);
            box-shadow: 0 8px 24px rgba(245, 158, 11, 0.28);
        }

        .stat-icon.info {
            background: var(--info-gradient);
            box-shadow: 0 8px 24px rgba(6, 182, 212, 0.28);
        }

        .notification-badge {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
            border-radius: 20px;
            padding: 0.25rem 0.6rem;
            font-size: 0.75rem;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
            animation: pulse-badge 2s infinite;
        }

        @@keyframes pulse-badge {
            0%, 100% {
                transform: scale(1);
                box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
            }
            50% {
                transform: scale(1.05);
                box-shadow: 0 6px 16px rgba(239, 68, 68, 0.5);
            }
        }

        .alert-card {
            background: linear-gradient(135deg, rgba(18, 81, 181, 0.04) 0%, rgba(249, 115, 22, 0.03) 100%);
            border-left: 4px solid var(--accent-primary);
            border-radius: 16px;
            padding: 1rem 1.5rem;
            margin-bottom: 1rem;
            border: 1px solid rgba(18, 81, 181, 0.10);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }

        .alert-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-primary);
            border-color: var(--accent-primary);
        }

        .modern-button {
            background: var(--primary-gradient);
            border: none;
            border-radius: 12px;
            padding: 0.75rem 1.5rem;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: var(--shadow-primary);
            position: relative;
            overflow: hidden;
        }

        .modern-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.5s;
        }

        .modern-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 32px rgba(18, 81, 181, 0.32);
            color: white;
        }

        .modern-button:hover::before {
            left: 100%;
        }

        .modern-button:active {
            transform: translateY(-1px);
        }

        .profile-avatar {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            border: 2px solid rgba(255, 255, 255, 0.45);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
        }

        .app-logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: var(--logo-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 800;
            font-size: 1.5rem;
            letter-spacing: -0.3px;
        }

        .app-logo img {
            width: 40px;
            height: 40px;
            border-radius: 10px;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .header-icon-btn {
            background: var(--header-icon-bg);
            border: 1px solid var(--header-icon-border);
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--header-icon-color);
            transition: all 0.3s ease;
            position: relative;
        }

        .header-icon-btn:hover {
            background: var(--header-icon-hover-bg);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
            border-color: transparent;
        }

        .loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(248, 249, 250, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            visibility: hidden;
        }

        .loader-img {
            max-width: 200px;
        }

        .content-hidden {
            opacity: 0;
        }

        .modern-footer {
            background: var(--white-bg);
            padding: 0.75rem 1.5rem;
            margin-left: 270px;
            border-top: 2px solid;
            border-image: var(--footer-border-img);
            transition: margin-left 0.3s ease;
            box-shadow: 0 -2px 12px rgba(12, 25, 50, 0.06);
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 1001;
        }

        .modern-sidebar.collapsed ~ .modern-footer {
            margin-left: 70px;
        }

        .modern-content {
            margin-left: 270px;
            margin-top: 70px;
            padding: 1.5rem;
            transition: margin-left 0.3s ease;
            padding-bottom: 80px;
        }

        .modern-sidebar.collapsed ~ .modern-content {
            margin-left: 70px;
        }

        .welcome-card {
            background: var(--welcome-bg);
            background-size: 400% 400%;
            animation: gradientFlow 15s ease infinite;
            border-radius: 20px;
            padding: 2rem;
            color: white;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-primary);
            position: relative;
            overflow: hidden;
        }

        @@keyframes gradientFlow {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }

        .welcome-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.25) 0%, transparent 70%);
            animation: float-rotate 12s ease-in-out infinite;
        }

        .welcome-card::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -10%;
            width: 250px;
            height: 250px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
            animation: float-rotate 15s ease-in-out infinite reverse;
        }

        @@keyframes float-rotate {
            0%, 100% {
                transform: translate(0, 0) rotate(0deg);
            }
            25% {
                transform: translate(20px, -20px) rotate(90deg);
            }
            50% {
                transform: translate(-15px, 15px) rotate(180deg);
            }
            75% {
                transform: translate(15px, 20px) rotate(270deg);
            }
        }

        @@keyframes rotate-gradient {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .workflow-progress {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .workflow-step {
            flex: 1;
            height: 6px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 3px;
            position: relative;
            overflow: hidden;
        }

        .workflow-step.active::after {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            right: 0;
            background: white;
            animation: pulse 2s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        .welcome-card > * {
            position: relative;
            z-index: 1;
        }

        .welcome-card h3,
        .welcome-card h2,
        .welcome-card h4 {
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
            animation: fadeInScale 0.8s ease-out;
        }

        @@keyframes fadeInScale {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .metric-value {
            font-size: 2rem;
            font-weight: 700;
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 0.5rem 0;
        }

        .metric-label {
            font-size: 0.875rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        /* Mobile Bottom Navigation */
        .mobile-bottom-nav {
            display: none;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: var(--white-bg);
            border-top: 2px solid;
            border-image: var(--mobile-border-img);
            box-shadow: 0 -4px 20px rgba(12, 25, 50, 0.06);
            z-index: 1000;
            padding: 0.5rem 0;
        }

        .mobile-nav-items {
            display: flex;
            justify-content: space-around;
            align-items: center;
            max-width: 600px;
            margin: 0 auto;
        }

        .mobile-nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 0.5rem 0.75rem;
            text-decoration: none;
