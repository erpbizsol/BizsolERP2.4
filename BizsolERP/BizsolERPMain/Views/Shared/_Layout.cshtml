    <script>
        (function () {
            var SESSION_KEY = 'authKey';
            var SESSION_URL = 'AppBaseURL';

            // --- Step 1: If this page was opened with a fresh AuthKey from server, store it ---
            var authKey = '@Html.Raw(ViewBag.AuthKey)';
            if (authKey && authKey !== '') {
                sessionStorage.setItem(SESSION_KEY, authKey);
                sessionStorage.setItem(SESSION_URL, '@Html.Raw(ViewBag.AppBaseURL)');
            }

            // --- Step 2: Cross-tab session sharing via localStorage as a temporary messenger ---
            // Any existing tab listens for a session-request and responds with its session data.
            window.addEventListener('storage', function (e) {
                if (e.key === 'bizsol_session_request' && e.newValue) {
                    // Another tab is asking for a session.
                    // Only respond if THIS tab already has a session.
                    var myKey = sessionStorage.getItem(SESSION_KEY);
                    var myURL = sessionStorage.getItem(SESSION_URL);
                    if (myKey) {
                        // Write the response into localStorage temporarily.
                        // Use the requestId so only the requesting tab picks it up.
                        var req = JSON.parse(e.newValue);
                        localStorage.setItem('bizsol_session_response_' + req.id,
                            JSON.stringify({ authKey: myKey, appBaseURL: myURL }));
                        // Clean up the response after a short delay
                        setTimeout(function () {
                            localStorage.removeItem('bizsol_session_response_' + req.id);
                        }, 3000);
                    }
                }
            });

            // --- Step 3: If this tab has no session yet, request one from other open tabs ---
            // Skip if we already reloaded once to avoid infinite reload loop
            var alreadyReloaded = sessionStorage.getItem('bizsol_session_reloaded');
            if (!sessionStorage.getItem(SESSION_KEY) && !alreadyReloaded) {
                var requestId = Date.now() + '_' + Math.random().toString(36).slice(2);
                var responseKey = 'bizsol_session_response_' + requestId;

                // Listen for the response
                window.addEventListener('storage', function onResponse(e) {
                    if (e.key === responseKey && e.newValue) {
                        try {
                            var data = JSON.parse(e.newValue);
                            if (data && data.authKey) {
                                sessionStorage.setItem(SESSION_KEY, data.authKey);
                                sessionStorage.setItem(SESSION_URL, data.appBaseURL || '');
                                // Mark that we reloaded so we don't loop
                                sessionStorage.setItem('bizsol_session_reloaded', '1');
                                localStorage.removeItem(responseKey);
                                window.removeEventListener('storage', onResponse);
                                // Reload so the page initialises with the correct session
                                location.reload();
                            }
                        } catch (_) {}
                    }
                });

                // Broadcast the request — other tabs will see this via the storage event
                localStorage.setItem('bizsol_session_request', JSON.stringify({ id: requestId }));
                // Remove the request key after a short delay
                setTimeout(function () { localStorage.removeItem('bizsol_session_request'); }, 500);
            }
        })();
    </script>

    <script>
        function Showloader() {
            document.getElementById('loader').style.visibility = 'visible';
        }
        function HideLoader() {
            document.getElementById('loader').style.visibility = 'hidden';
            document.getElementById('layout-wrapper').classList.remove('content-hidden');
        }

        window.Showloader = Showloader;
        window.HideLoader = HideLoader;
        HideLoader();

        /* Move modals to <body> so they are not trapped inside #modern-content stacking context */
        function erpMoveModalToBody(modal) {
            if (modal && modal.classList && modal.classList.contains('modal') && modal.parentElement !== document.body) {
                document.body.appendChild(modal);
            }
        }

        document.querySelectorAll('.modal').forEach(erpMoveModalToBody);

        document.addEventListener('show.bs.modal', function (e) {
            erpMoveModalToBody(e.target);
        }, true);

        // Sidebar toggle
        document.getElementById('vertical-menu-btn').addEventListener('click', function() {
            const sidebar = document.getElementById('modern-sidebar');
            const overlay = document.getElementById('sidebar-overlay');

            if (window.innerWidth <= 768) {
                // Mobile behavior - toggle show class and overlay
                sidebar.classList.toggle('show');
                overlay.classList.toggle('show');
            } else {
                // Desktop behavior - toggle collapsed class
                sidebar.classList.toggle('collapsed');
            }
        });

        // Close sidebar when clicking overlay on mobile
        document.getElementById('sidebar-overlay').addEventListener('click', function() {
            const sidebar = document.getElementById('modern-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            sidebar.classList.remove('show');
            overlay.classList.remove('show');
        });

        // Close popup menu when clicking outside
        $(document).on('click', function(e) {
            if (!$(e.target).closest('.sidebar-popup-menu, .sidebar-menu-item').length) {
                $('.sidebar-popup-menu').remove();
            }
        });

        // Mobile sidebar toggle
        if (window.innerWidth <= 768) {
            // Close sidebar when clicking a menu item without submenu (only on mobile)
            $(document).on('click', '#sidebar-menu a:not(.has-arrow)', function() {
                // Only close if it's a valid link (not javascript:void(0))
                var href = $(this).attr('href');
                if (href && href !== 'javascript:void(0);' && href.indexOf('#') !== 0) {
                    setTimeout(function() {
                        $('#modern-sidebar').removeClass('show');
                        $('#sidebar-overlay').removeClass('show');
                    }, 300);
                }
            });
        }

        // ── Select2 Global Defaults ───────────────────────────────────────────
        $(function () {
            if (typeof $.fn.select2 !== 'undefined') {
                $.fn.select2.defaults.set('width', '100%');
            }
        });

        // ── Keyboard-aware repositioning (mobile only) ────────────────────────
        // _s2InitialVvpHeight: captures vvp.height BEFORE the keyboard animates in.
        // This is needed because on iOS 15+ window.innerHeight ALSO shrinks with
        // the keyboard, making the Method-1 calculation return 0.
        var _s2ViewportHandler  = null;
        var _s2InitialVvpHeight = null;
        var _s2BodyOverflowPrev = null;
        var _s2HtmlOverflowPrev = null;
        var _s2ScrollLocked = false;

        // ── Modal-scroll guard ────────────────────────────────────────────────
        // Select2 focuses its search field BEFORE firing select2:open, which
        // causes the nearest scrollable ancestor (.modal) to auto-scroll down
        // to the newly-appended dropdown container. We save the scroll position
        // in select2:opening (before any DOM change) and restore it in
        // select2:open via requestAnimationFrame (before the browser paints).
        var _s2ModalEl  = null;
        var _s2ModalTop = 0;

        function _lockSelect2PageScroll() {
            if (_s2ScrollLocked) return;
            _s2BodyOverflowPrev = document.body.style.overflow;
            _s2HtmlOverflowPrev = document.documentElement.style.overflow;
            document.body.style.overflow = 'hidden';
            document.documentElement.style.overflow = 'hidden';
            _s2ScrollLocked = true;
        }

        function _unlockSelect2PageScroll() {
            if (!_s2ScrollLocked) return;
            document.body.style.overflow = _s2BodyOverflowPrev || '';
            document.documentElement.style.overflow = _s2HtmlOverflowPrev || '';
            _s2BodyOverflowPrev = null;
            _s2HtmlOverflowPrev = null;
            _s2ScrollLocked = false;
        }

        function _cleanupSelect2MobileState() {
            $('.select2-backdrop').remove();
            _unlockSelect2PageScroll();

            if (_s2ViewportHandler && window.visualViewport) {
                window.visualViewport.removeEventListener('resize', _s2ViewportHandler);
                window.visualViewport.removeEventListener('scroll', _s2ViewportHandler);
                _s2ViewportHandler = null;
            }
            _s2InitialVvpHeight = null;
        }

        $(document).on('select2:opening', function (e) {
            var $modal = $(e.target).closest('.modal');
            if ($modal.length) {
                _s2ModalEl  = $modal[0];
                _s2ModalTop = $modal[0].scrollTop;
            } else {
                _s2ModalEl = null;
            }
        });

        function _adjustSelect2AboveKeyboard() {
            if (!window.visualViewport) return;
            var vvp = window.visualViewport;

            // Method 1 – Android & older iOS:
            //   keyboard height = layout viewport − (offset + visual viewport)
            var kbH1 = Math.max(0, window.innerHeight - vvp.offsetTop - vvp.height);

            // Method 2 – iOS 15+ (window.innerHeight also shrinks):
            //   compare current vvp.height against the height captured before keyboard
            var kbH2 = (_s2InitialVvpHeight !== null)
                ? Math.max(0, _s2InitialVvpHeight - vvp.height)
                : 0;

            var keyboardHeight = Math.max(kbH1, kbH2);

            var dropdown = document.querySelector('.select2-dropdown');
            if (!dropdown) return;

            // Push the dropdown above the keyboard
            dropdown.style.bottom = keyboardHeight + 'px';

            // Give the dropdown as much visible space as possible.
            // vvp.height = visible area above keyboard.
            // Cap at 50 % of the original (pre-keyboard) height so the sheet
            // doesn’t fill the entire screen when no keyboard is open.
            var baseHeight = _s2InitialVvpHeight || window.innerHeight;
            var maxH = Math.min(
                Math.max(150, vvp.height - 48),   // visible area minus 48 px top gap
                Math.round(baseHeight * 0.50)      // never taller than 50 % of full screen
            );
            dropdown.style.maxHeight = maxH + 'px';

            // Results list = dropdown minus drag handle (18 px) + search bar (54 px)
            var results = dropdown.querySelector('.select2-results__options');
            if (results) {
                results.style.maxHeight = Math.max(80, maxH - 72) + 'px';
            }

            // Keep the backdrop ending exactly where the dropdown begins
            var backdrop = document.querySelector('.select2-backdrop');
            if (backdrop) {
                backdrop.style.bottom = (keyboardHeight + maxH) + 'px';
            }
        }

        // Auto-focus the search field when any Select2 opens
        $(document).on('select2:open', function (e) {
            // Restore the modal scroll position that Select2 disrupted by focusing
            // its search input (which triggered a browser scroll-into-view on the
            // dropdown element appended at the end of the modal DOM).
            if (_s2ModalEl) {
                var el  = _s2ModalEl;
                var top = _s2ModalTop;
                requestAnimationFrame(function () { el.scrollTop = top; });
            }

            setTimeout(function () {
                // For multiple-select, the search field is INLINE — every instance
                // keeps its own .select2-search__field in the DOM at all times.
                // querySelectorAll returns ALL of them, so [last] always lands on
                // the bottom-most row (Management). Instead, look up only the field
                // that belongs to the Select2 that just opened.
                var searchField = null;
                try {
                    var s2 = $(e.target).data('select2');
                    if (s2 && s2.$container && s2.$container.length) {
                        searchField = s2.$container[0].querySelector('.select2-search__field');
                    }
                } catch (err) {}

                // Fallback for single-selects: their search lives in the dropdown
                if (!searchField) {
                    var fields = document.querySelectorAll('.select2-dropdown .select2-search__field');
                    if (fields.length > 0) { searchField = fields[fields.length - 1]; }
                }

                if (searchField) { searchField.focus({ preventScroll: true }); }
            }, 10);

            // Mobile: add backdrop + prevent background scroll
            if (window.innerWidth <= 991) {
                if (!$('.select2-backdrop').length) {
                    $('<div class="select2-backdrop"></div>').appendTo('body');
                }
                _lockSelect2PageScroll();

                // Capture viewport height BEFORE the keyboard animation starts
                _s2InitialVvpHeight = window.visualViewport
                    ? window.visualViewport.height
                    : window.innerHeight;

                if (window.visualViewport && !_s2ViewportHandler) {
                    _s2ViewportHandler = _adjustSelect2AboveKeyboard;
                    // 'resize' fires on Android; iOS Safari sometimes fires 'scroll'
                    window.visualViewport.addEventListener('resize', _s2ViewportHandler);
                    window.visualViewport.addEventListener('scroll', _s2ViewportHandler);
                    // 300 ms delay lets the iOS keyboard finish its open animation
                    setTimeout(_adjustSelect2AboveKeyboard, 300);
                }
            }
        });

        // Cleanup on close
        $(document).on('select2:close select2:closing', function () {
            _s2ModalEl = null;
            _cleanupSelect2MobileState();
        });

        // Tap backdrop (top area above dropdown) to dismiss the open Select2.
        // Use select2-hidden-accessible because Select2 hides the original <select>.
        $(document).on('click', '.select2-backdrop', function () {
            $('select.select2-hidden-accessible').select2('close');
        });
    </script>

    <script type="module" src="~/assets/script/menutest.js"></script>
    <script type="module" src="~/assets/script/webnotification.js"></script>
    <script src="~/assets/script/Logout.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
