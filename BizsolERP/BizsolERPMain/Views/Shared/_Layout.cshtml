        /* ── Select2 Global Fixes ──────────────────────────────────────────── */
        .select2-container {
            width: 100% !important;
        }

        .select2-container--open .select2-dropdown {
            z-index: 99999 !important;
            max-width: 100vw !important;
            box-sizing: border-box;
        }

        /* Mobile: bottom-sheet style — dropdown slides up above the keyboard */
        @@media (max-width: 991px) {
            /* Prevent iOS auto-zoom (font-size must be >= 16px on inputs) */
            .select2-search__field,
            .select2-results__option {
                font-size: 16px !important;
            }

            /* Drag-handle pip at the top of the bottom sheet */
            .select2-container--open .select2-dropdown--below::before,
            .select2-container--open .select2-dropdown--above::before {
                content: '';
                display: block;
                width: 36px;
                height: 4px;
                background: rgba(0, 0, 0, 0.18);
                border-radius: 2px;
                margin: 10px auto 4px;
                flex-shrink: 0;
            }

            .select2-container--open .select2-dropdown--below,
            .select2-container--open .select2-dropdown--above {
                position: fixed !important;
                bottom: 0 !important;
                top: auto !important;
                left: 0 !important;
                width: 100% !important;
                max-height: 50vh;
                border-radius: 16px 16px 0 0;
                border-top: 3px solid var(--accent-primary);
                box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.25);
                z-index: 99999 !important;
                overflow: hidden;
                /* Smooth slide when keyboard opens / closes */
                transition: bottom 0.15s ease, max-height 0.15s ease;
            }

            .select2-container--open .select2-results__options {
                overflow-y: auto;
            }

            /* Backdrop only covers the area ABOVE the bottom sheet.
               The dropdown itself (bottom 50vh) is never overlapped,
               so options remain fully tappable. */
            .select2-backdrop {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 50vh; /* stops where the dropdown begins */
                background: rgba(0, 0, 0, 0.3);
                z-index: 99998;
                animation: backdropFadeIn 0.2s ease;
            }
        }

        @@keyframes backdropFadeIn {
            from { opacity: 0; }
            to   { opacity: 1; }
        }

        /* ── Embedded / iframe mode ─────────────────────────────────────────
           When the page is loaded with ?embedded=1 (e.g. inside a modal iframe)
           the header, sidebar, footer and mobile nav are hidden and the content
           area fills the full viewport with no extra margins.
        ─────────────────────────────────────────────────────────────────── */
        body.erp-embedded .modern-header,
        body.erp-embedded .modern-sidebar,
        body.erp-embedded footer.modern-footer,
        body.erp-embedded .mobile-bottom-nav,
        body.erp-embedded #sidebar-overlay {
            display: none !important;
        }

        body.erp-embedded .modern-content {
            position: static !important;
            left: auto !important;
            right: auto !important;
            bottom: auto !important;
            top: auto !important;
            margin: 0 !important;
            padding: 1rem !important;
            min-height: 100vh;
            overflow: visible !important;
        }

        body.erp-embedded {
            overflow: auto !important;
            height: auto !important;
        }

        /* ERP Heading */
        .erp-heading-wrapper {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 0 0.75rem;
            min-width: 0;
        }

        .erpHedTextSize {
            background: linear-gradient(135deg, #667eea 0%, #0dcaf0 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: 0.3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
            margin: 0;
            padding-bottom: 2px;
            border-bottom: 2px solid transparent;
            border-image: linear-gradient(90deg, #667eea 0%, #0dcaf0 100%) 1;
        }

        .Highlighted {
            background-color: #FFD700 !important;
            color: black !important;
        }

        /* Additional Light Theme Enhancements */
        .table {
            color: var(--text-dark);
        }

            .table thead {
                color: var(--text-primary);
                background: var(--light-bg);
            }

        .badge {
            font-weight: 600;
            padding: 0.5rem 0.75rem;
        }

        .dropdown-menu {
            background: var(--white-bg);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-lg);
        }

        .dropdown-item {
            color: var(--text-dark);
        }

            .dropdown-item:hover {
                background: var(--light-bg);
                color: var(--accent-primary);
            }

        /* ── Notification bell + dropdown panel (well list) ── */
        .modern-header .dropdown-menu.notification-dropdown,
        .modern-header .dropdown-menu.profile-dropdown {
            z-index: 1025;
        }

        .notification-dropdown {
            min-width: 310px;
            max-width: 400px;
            padding: 0 !important;
            margin-top: 0.15rem !important;
            border-radius: 10px;
            border: 1px solid #e8ecf1;
            background: #ffffff;
            box-shadow: 0 16px 48px rgba(15, 23, 42, 0.1), 0 4px 14px rgba(15, 23, 42, 0.06);
            overflow: hidden;
        }

        #bell-icon .notification-badge.notification-bell-badge {
            top: -4px !important;
            right: -10px !important;
            left: auto !important;
            transform: none !important;
        }

        .notification-bell-badge {
            background: #2563eb !important;
            color: #fff !important;
            border-radius: 999px !important;
            min-width: 1.125rem;
            min-height: 1.125rem;
            padding: 1px 0.32rem !important;
            font-size: 0.65rem !important;
            font-weight: 700;
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            animation: none !important;
            box-shadow: 0 1px 3px rgba(37, 99, 235, 0.4);
            line-height: 1;
        }

        #bell-icon.header-icon-btn {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            color: #64748b;
        }

            #bell-icon.header-icon-btn:hover {
                background: rgba(102, 126, 234, 0.08) !important;
                color: #334155;
            }

        #bell-icon .fa-bell,
        #bell-icon .fa-regular {
            font-size: 1.15rem;
        }

        .notification-well-header {
            text-align: center;
            font-weight: 700;
            font-size: 0.875rem;
            letter-spacing: 0.02em;
            color: #0f172a;
            padding: 0.55rem 1rem 0.45rem;
            border-bottom: 1px solid #eeeeee;
            background: #ffffff;
        }

        .notification-well-list {
            max-height: 300px;
            overflow-y: auto;
            overflow-x: hidden;
            background: #ffffff;
            scrollbar-width: thin;
            scrollbar-color: #3b82f6 #f1f5f9;
        }

            .notification-well-list::-webkit-scrollbar {
                width: 8px;
            }

            .notification-well-list::-webkit-scrollbar-track {
                background: #f1f5f9;
                border-radius: 100px;
            }

            .notification-well-list::-webkit-scrollbar-thumb {
                background: #3b82f6;
                border-radius: 100px;
            }

        .notification-well-item {
            display: flex;
            gap: 0.6rem;
            padding: 0.45rem 0.85rem;
            text-decoration: none;
            color: inherit;
            border-bottom: 1px solid #eeeeee;
            align-items: center;
            transition: background 0.15s ease;
        }

            .notification-well-item:last-child {
                border-bottom: none;
            }

            .notification-well-item:hover {
                background: #f8fafc;
            }

        .notification-well-icon {
            flex-shrink: 0;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.82rem;
        }

            .notification-well-icon--danger {
                background: #fce7f3;
                color: #e11d48;
            }

            .notification-well-icon--warning {
                background: #fef9c3;
                color: #ca8a04;
            }

            .notification-well-icon--info {
                background: #e0f2fe;
                color: #2563eb;
            }

            .notification-well-icon--success {
                background: #d1fae5;
                color: #059669;
            }

