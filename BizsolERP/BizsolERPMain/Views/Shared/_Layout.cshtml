            color: #0f172a;
            padding: 0.7rem 1.15rem;
            font-size: 0.9rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

            .profile-dropdown .dropdown-item i {
                font-size: 1.05rem;
                width: 1.25rem;
                text-align: center;
                color: #64748b;
            }

            .profile-dropdown .dropdown-item:hover,
            .profile-dropdown .dropdown-item:focus {
                background: #f8fafc;
                color: #0f172a;
            }

                .profile-dropdown .dropdown-item:hover i {
                    color: #334155;
                }

        .profile-dropdown .profile-dropdown-logout {
            color: #b91c1c;
        }

            .profile-dropdown .profile-dropdown-logout i {
                color: #dc2626;
            }

            .profile-dropdown .profile-dropdown-logout:hover,
            .profile-dropdown .profile-dropdown-logout:focus {
                background: #fef2f2;
                color: #991b1b;
            }

        .profile-dropdown .dropdown-divider {
            border-color: #eeeeee;
            margin: 0;
        }

        /* Scrollbar Styling for Light Theme */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--light-bg);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--accent-primary);
            border-radius: 10px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: var(--accent-secondary);
            }

        /* ERP Home — full-bleed hero image (no side gaps, no crop) */
        body.erp-home-page {
            --erp-home-top: 55px;
            --erp-home-bottom: 3.25rem;
            --erp-home-left-offset: var(--sidebar-width);
            overflow: hidden;
            height: 100%;
        }

        body.erp-home-page:has(.modern-sidebar.collapsed) {
            --erp-home-left-offset: 70px;
        }

        body.erp-home-page #layout-wrapper {
            overflow: hidden;
            height: 100dvh;
        }

        body.erp-home-page .modern-content {
            top: var(--erp-home-top) !important;
            left: var(--erp-home-left-offset) !important;
            right: 0 !important;
            bottom: var(--erp-home-bottom) !important;
            padding: 0 !important;
            margin: 0 !important;
            overflow: hidden !important;
            min-height: 0 !important;
        }

        body.erp-home-page .modern-content main {
            padding: 0 !important;
            margin: 0 !important;
            height: 100%;
            overflow: hidden;
            max-width: none !important;
        }

        .erp-home-hero {
            position: fixed;
            top: var(--erp-home-top);
            left: var(--erp-home-left-offset);
            right: 0;
            bottom: var(--erp-home-bottom);
            overflow: hidden;
            background-color: #eef2f7;
            z-index: 0;
            box-sizing: border-box;
            transition: left 0.3s ease;
        }

        .erp-home-picture {
            display: none;
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        .erp-home-hero .erp-home-img {
            display: block !important;
            border: 0;
            margin: 0;
            padding: 0;
            width: 100% !important;
            height: 100% !important;
            max-width: none !important;
            object-fit: cover !important;
            object-position: center center;
        }

        @@media (min-width: 769px) {
            .erp-home-hero {
                bottom: auto;
                height: auto;
                max-height: calc(100dvh - var(--erp-home-top) - var(--erp-home-bottom));
                overflow: hidden;
                background-image: none;
            }

            .erp-home-picture {
                display: block;
                width: 100%;
                height: auto;
            }

            .erp-home-hero .erp-home-img {
                width: 100% !important;
                height: auto !important;
                max-width: 100% !important;
                object-fit: fill !important;
                display: block !important;
            }
        }

        @@media (max-width: 768px) {
            body.erp-home-page {
                --erp-home-left-offset: 0;
                --erp-home-bottom: 5.5rem;
            }

            body.erp-home-page:has(.modern-sidebar.collapsed) {
                --erp-home-left-offset: 0;
            }

            .erp-home-hero {
                background-image: none;
            }

            .erp-home-picture {
                display: flex;
                align-items: stretch;
                justify-content: stretch;
            }
        }
    </style>
</head>
<body class="@(Context.Request.Query["embedded"] == "1" ? "erp-embedded" : "") @(ViewBag.BodyClass)">
