     function getddlPrinters() {
         SelectPrinterToPrintService.GetPrinterList().then(function (respone) {
               

              if(respone.length > 0){
                      BindSelectList($('#ddlPrinters')[0], respone.map((item) => ({ Code: item.PrinterIP, Desp: item.DisplayName,PortNo:item.PORTNo })));

                       if(respone.length==1){
                              $('#ddlPrinters').val(respone[0].PrinterIP);
                       }

                     $('#ddlPrinters').select2({
                        dropdownParent: $('#SelectPrinterToPrintControlModal'),
                         width: '-webkit-fill-available'
                    });

                  $(document).ready(function () {
                          $("#SelectPrinterToPrintControlModal").modal({
                              backdrop: 'static',
                          });
                          $("#SelectPrinterToPrintControlModal").modal('show');
                  });
              }else{
                   toastr.error('No Printer Found');
                   return;
              }
           

           
       })

    }

   function BindSelectList(element,list) {
         let option = '<option value="0" PortNo="0"></option>';
        $.each(list, function (key, val) {
            option += '<option value="' + val.Code + '" PortNo="'+val.PortNo+'">' + val.Desp + '</option>';
        });
        element.innerHTML = option;
    }
    
