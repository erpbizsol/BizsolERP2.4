                <div class="row">
                    
                    <div class="col-md-12 ">
                        <label for="ddlPrinters" class="col-form-label-sm fw-bold">Printer:</label>
                        <select id="ddlPrinters" class="form-control form-control-sm box_border"></select>
                    </div>
                </div>

