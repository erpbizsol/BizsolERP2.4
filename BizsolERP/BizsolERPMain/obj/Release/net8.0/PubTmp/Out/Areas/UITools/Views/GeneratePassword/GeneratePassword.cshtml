@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Tools/script/GeneratePassword.js"></script>
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/BizSolInputControl.js"></script>
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/bizsolpbcontrols.js"></script>
<script src="https://cdn.rawgit.com/rainabba/jquery-table2excel/1.1.0/dist/jquery.table2excel.min.js"></script>


<div class="tab-section" id="DivGeneratePassword">
    <ul class="nav nav-tabs" id="GeneratePasswordTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#UnUsedGeneratePassword" role="tab" aria-controls="home" aria-selected="true" >
                UNUSED OTP
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#UsedGeneratePassword" role="tab" aria-controls="profile" aria-selected="false" >
                USED OTP
            </button>
        </li>
    </ul>
    <div class="tab-content" id="GeneratePasswordContent">
        <div class="tab-pane fade show active" id="UnUsedGeneratePassword" role="tabpanel" aria-labelledby="home-tab">
            <div class="row">
                <div class="col-sm-3">
                    <label for="txtNoOfGenerateOTP" class="col-form-label-sm fw-bold">No Of Generate OTP:<span class="text-danger">*</span></label>
                    <input id="txtNoOfGenerateOTP" name="txtNoOfGenerateOTP" placeholder="0" oninput="validateIntegerInput(this)" class="box_border form-control form-control-sm" autocomplete="off" maxlength="2" required />
                </div>
                <div class="col-sm-3" style="margin-top:2.2rem;">
                    <button type="button" onclick="Generate_GeneratePassword()" title="Generate" class="btn btn-primary btn-height">Generate</button>
                    <button type="button" id="btnDownload" title="Export" class="btn btn-primary btn-height">Export</button>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div id="tblUnUsedGeneratePassword">
                        <div class="table-wrapper fixed-height-table">
                            <table id="UnUsedGeneratePassword" class="fixed-width-table table">
                                <thead id="table-header-UnUsedGeneratePassword">
                                </thead>
                                <tbody id="table-body-UnUsedGeneratePassword">
                                </tbody>
                            </table>
                        </div>
                        <div class="paginator" id="paginator-UnUsedGeneratePassword">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="tab-pane fade" id="UsedGeneratePassword" role="tabpanel" aria-labelledby="profile-tab">
            <div class="row">
                <div class="col-sm-2">
                    <label for="txtFromDate" class="col-form-label-sm fw-bold">From Date:<span class="text-danger">*</span></label>
                    <input id="txtFromDate" type="date" name="txtFromDate" class="box_border form-control form-control-sm" autocomplete="off" maxlength="2" required />
                </div>
                <div class="col-sm-2">
                    <label for="txtToDate" class="col-form-label-sm fw-bold">To Date:<span class="text-danger">*</span></label>
                    <input id="txtToDate" type="date" name="txtToDate" class="box_border form-control form-control-sm" autocomplete="off" maxlength="2" required />
                </div>
                <div class="col-sm-2">
                    <label for="txtUsedFor" class="col-form-label-sm fw-bold">Used For:<span class="text-danger">*</span></label>
                    <select id="txtUsedForType" class="form-control form-control-sm box_border"></select>
                </div>
                <div class="col-sm-3" style="margin-top:2.2rem;">
                    <button type="button" onclick="ShowUsed_GeneratePassword()" title="Show" class="btn btn-primary btn-height">Show</button>
                    <button type="button" id="btnDownloadUsedPassword" title="Export" class="btn btn-primary btn-height">Export</button>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div id="tblUsedGeneratePassword">
                        <div class="table-wrapper fixed-height-table">
                            <table id="UsedGeneratePassword" class="fixed-width-table table">
                                <thead id="table-header-UsedGeneratePassword">
                                </thead>
                                <tbody id="table-body-UsedGeneratePassword">
                                </tbody>
                            </table>
                        </div>
                        <div class="paginator" id="paginator-UsedGeneratePassword">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
</div>

<div class="table-wrapper fixed-height-table" hidden="hidden">
    <table id="tblReport" hidden="hidden">
        <thead id="table-headerPrint">
            <tr></tr>
        </thead>
        <tbody id="table-bodyPrint">
        </tbody>
    </table>
</div>
<div class="table-wrapper fixed-height-table" hidden="hidden">
    <table id="tblReportUsed" hidden="hidden">
        <thead id="table-headerPrint">
            <tr></tr>
        </thead>
        <tbody id="table-bodyPrint">
        </tbody>
    </table>
</div>
