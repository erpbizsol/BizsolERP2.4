    /* Transporter Dropdown with Checkbox Styles */
    .dropdown-container {
        position: relative;
        display: inline-block;
        font-family: Arial, sans-serif;
    }
    .dropdown-button,
    .select-checkbox-multi {
        padding: 8px;
        border: 2px solid #000;
        cursor: pointer;
        background-color: #fff;
        width: 350px;
        margin-top: 10px;
        text-align: left;
    }
    .dropdown-list {
        display: none;
        background-color: #fff;
        border: 1px solid #ccc;
        z-index: 1000 !important;
        padding: 5px;
        max-height: 162px;
        margin-top: -8px;
        overflow-y: auto;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
    .dropdown-list .checkbox-row {
        padding: 4px 6px;
    }
    .dropdown-list .checkbox-row:hover {
        background-color: #f3f6fb;
    }
    .dropdown-list label {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        margin: 0;
    }
    .dropdown-list input[type="checkbox"] {
        margin: 0;
    }

    /* Transporter modal: make body scrollable and table header sticky */
    #Transporter .modal-body {
        max-height: 70vh;
        padding: 8px 12px;
        overflow: hidden;
    }
    #transporterGridWrapper {
        max-height: 60vh;
        overflow-y: auto;
        overflow-x: hidden;
        border: 1px solid #e5e7eb;
        border-radius: 4px;
        background: #fff;
    }
    #transporterGridTable {
        margin-bottom: 0;
    }
    #transporterGridTable thead th {
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* Card: height comes from JS (tableWrapper) so it stops above fixed footer — avoid vh calc fighting script */
    #dvTableDispatch {
        flex: 1;
        min-height: 0;
        flex-direction: column;
        overflow: hidden;
        display: flex;
    }
    
    /* Ensure flex layout when element is shown (override inline display:none) */
    #dvTableDispatch[style*="display: flex"],
    #dvTableDispatch[style*="display:block"],
    #dvTableDispatch:not([style*="display: none"]) {
        display: flex !important;
    }

    /* Update Qty modal width */
    #dvUpdateQty .modal-dialog {
        max-width: 1100px;
        width: 70vw;
        margin: 0 auto;
    }
    #dvUpdateQty .modal-content {
        width: 100%;
    }

    /* Update Qty modal: mobile friendly */
    #dvUpdateQty #QtyUpdateGridWrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    /* Validation highlight for Update Qty inputs */
    #dvUpdateQty .is-invalid {
        border-color: #dc3545 !important;
        background-color: #fff5f5 !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath d='m5.8 3.6 .4.4.4-.4m0 4.8h-.8'/%3e%3c/svg%3e") !important;
        background-repeat: no-repeat !important;
        background-position: left 0.5rem center !important;
        background-size: 1rem 1rem !important;
        padding-left: 2rem !important;
    }
    #dvUpdateQty .is-invalid:focus {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath d='m5.8 3.6 .4.4.4-.4m0 4.8h-.8'/%3e%3c/svg%3e") !important;
        background-position: left 0.5rem center !important;
    }

    /* Update Qty grid numeric columns – right aligned and tidy */
    #dvUpdateQty #tblUpdateGridWrapper thead th:nth-child(4),
    #dvUpdateQty #tblUpdateGridWrapper thead th:nth-child(5),
    #dvUpdateQty #tblUpdateGridWrapper thead th:nth-child(6),
    #dvUpdateQty #tblUpdateGridWrapper thead th:nth-child(7),
    #dvUpdateQty #tblUpdateGridWrapper thead th:nth-child(8),
    #dvUpdateQty #tblUpdateGridWrapper thead th:nth-child(9),
    #dvUpdateQty #tblUpdateGridWrapper tbody td:nth-child(4),
    #dvUpdateQty #tblUpdateGridWrapper tbody td:nth-child(5),
    #dvUpdateQty #tblUpdateGridWrapper tbody td:nth-child(6),
    #dvUpdateQty #tblUpdateGridWrapper tbody td:nth-child(7),
    #dvUpdateQty #tblUpdateGridWrapper tbody td:nth-child(8),
    #dvUpdateQty #tblUpdateGridWrapper tbody td:nth-child(9) {
        text-align: right;
        white-space: nowrap;
    }

    

    #dvUpdateQty #tblUpdateGridWrapper tbody td input.form-control-sm {
        width: 100%;
        padding-right: 8px;
        padding-left: 8px;
        text-align: right;
        box-sizing: border-box;
    }

    @@media (max-width: 576px) {
        #dvUpdateQty .modal-dialog {
            width: 100%;
            max-width: 100%;
            margin: 0;
        }

        #dvUpdateQty .modal-body {
            max-height: calc(100vh - 160px);
            overflow-y: auto;
        }
    }
</style>
<div class="row">
    <div class="col-sm-12">
        <div class="filter-card">
            @* <div class="filter-title">
                <i class="fas fa-filter"></i> Dispatch Plan Filter
            </div> *@
            <div class="row align-items-end">
                <div class="col-md-3">
                    <label for="ddlStatus" class="form-label filter-label">Status</label><span class="text-danger">*</span>
                    <select id="ddlStatus" class="form-control form-control-sm box_border">
                        <option value="M">Pending For Approval (Marketing Man)</option>
                        <option value="P">Pending For Approval (PPC)</option>
                        <option value="D">Pending For Approval (Dispatch)</option>
                        <option value="C">Approved Dispatch Plan</option>
                        <option value="T">Approved Quotation</option>
                        <option value="R">Dispatch Activity Report</option>
                    </select>
                </div>
                <div class="col-auto despatch-activity-filter d-none">
                    <label for="txtFromDate" class="col-form-label-sm fw-bold">From Date:<span class="text-danger">*</span></label>
                    <input type="date" id="txtFromDate" name="txtFromDate" class="box_border form-control form-control-sm" />
                </div>
                <div class="col-auto despatch-activity-filter d-none">
                    <label for="txtToDate" class="col-form-label-sm fw-bold">To Date:<span class="text-danger">*</span></label>
                    <input type="date" id="txtToDate" name="txtToDate" class="box_border form-control form-control-sm" />
                </div>
                <div class="col-auto despatch-activity-filter d-none mb-2">
                    <button type="button" onclick="ShowFilteredList()" title="Show" class="btn btn-primary btn-height btn-sm">Show</button>
                </div>
                <div class="col text-md-end mb-2">
                    <button type="button" id="btnExportExcel" class="btn btn-primary btn-height" onclick="ExportExcel();">
                        <i class="fas fa-download"></i> Download
                    </button>
                </div>
            </div>
        </div>
        <div class="card p-1" id="dvTableDispatch" style="display:none;">
            
            <div class="table-wrapper" id="tableWrapper">
                <table id="tblDispatchPlan" class="fixed-width-table table table-bordered">
                    <thead id="table-head">
                    </thead>
                    <tbody id="table-body">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
