@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />




<div class="row col-md-6">
    <div class="row">
        <div class="col-4">
            Reporting Date time <span class="text-danger fw-semibold">*</span>
        </div>
        <div class="col-8">
            <input id="frmGateToken_txtReportingDatetime" class="BizSolFormControl form-control form-control-sm" type="datetime-local" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
        </div>
    </div>
    <div class="row">
        <div class="col-4">
            Vehicle No. <span class="text-danger fw-semibold">*</span>
        </div>
        <div class="col-8">
            <input id="frmGateToken_txtVehicleNo" class="BizSolFormControl form-control form-control-sm alphanum-uppercase" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" maxlength="10" autocomplete="off">
            <ul id="frmGateToken_txtVehicleNo_List" class="AutoSuggestion-list"></ul>
        </div>
    </div>

    <div class="row" id="DivGateTokenChassisNo">
        <div class="col-4">
            Chassis No.
        </div>
        <div class="col-8">
            <input id="frmGateToken_txtChassisNo" class="BizSolFormControl form-control form-control-sm alphanum-uppercase" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" maxlength="30" autocomplete="off">
        </div>
    </div>

    <div class="row" id="DivGateTokenRCNo">
        <div class="col-4">
            RC No.
        </div>
        <div class="col-8">
            <input id="frmGateToken_txtRCNo" class="BizSolFormControl form-control form-control-sm alphanum-uppercase" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" maxlength="30" autocomplete="off">
        </div>
    </div>

    <div class="row" id="DivGateTokenRCExpiredDate">
        <div class="col-4">
            RC Expired Date
        </div>
        <div class="col-8">
            <input id="frmGateToken_txtRCExpiredDate" class="BizSolFormControl form-control form-control-sm" type="date" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
        </div>
    </div>

    <div class="row">
        <div class="col-4">
            Driver Name
        </div>
        <div class="col-8">
            <input id="frmGateToken_txtDriverName" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" autocomplete="off">
        </div>
    </div>

    <div class="row" id="DivGateTokenDriverLicenseNo">
        <div class="col-4">
            Driver License No.
        </div>
        <div class="col-8">
            <input id="frmGateToken_txtDriverLicenseNo" class="BizSolFormControl form-control form-control-sm alphanum-uppercase" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" maxlength="30" autocomplete="off">
        </div>
    </div>

    <div class="row" id="DivGateTokenDriverLicenseExpiredDate">
        <div class="col-4">
            Driver License Expiry
        </div>
        <div class="col-8">
            <input id="frmGateToken_txtDriverLicenseExpiredDate" class="BizSolFormControl form-control form-control-sm" type="date" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
        </div>
    </div>

    <div class="row">
        <div class="col-4">
            Driver No.
        </div>
        <div class="col-8">
            <input id="frmGateToken_txtDriverNo" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="return BizSolInputControl.OnKeyDownPressNumericTextBox(event,this);" maxlength="12" autocomplete="off">
        </div>
    </div>
    <div class="row" id="DivGateTokenDriverAadharNo">
        <div class="col-4">
            Driver Aadhar No
        </div>
        <div class="col-8">
            <input id="frmGateToken_txtDriverAadharNo" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="return BizSolInputControl.OnKeyDownPressNumericTextBox(event,this);" autocomplete="off" maxlength="12">
        </div>
    </div>
    <div class="row">
        <div class="col-4">
            Transporter Name.
        </div>
        <div class="col-8">
           
            <input id="frmGateToken_ddlTransporterName" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
            <ul id="frmGateToken_ddlTransporterName_List" class="AutoSuggestion-list"></ul>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 text-end">
            <button type="button" id="frmGateToken_btnSave" class="btn btn-primary icon-height" onclick="GateToken_SaveData()">Save</button>
            @* <button type="button" id="frmLoadedOut_btnCancel" class="btn btn-danger icon-height" onclick="GateEntyMode_GateEntry('grid','')">Cancel</button> *@
        </div>
    </div>

    <div>
        Note: <span id="spNote"></span>
    </div>
</div>

