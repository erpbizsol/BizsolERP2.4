@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/BizSolInputControl.js"></script>
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Marketing.Transactions/Script/CollectionCommitment.js"></script>

<style>
    .without-label-field {
        margin-top: 2.1rem;
    }
</style>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label class="col-form-label-sm fw-bold required"><b>Order By:</b><span class="text-danger">*</span></label>
                    <select id="ddlOrderBy" class="form-control form-control-sm box_border"></select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtCommitmentdate" class="col-form-label-sm fw-bold"><b>Commitment Date:<span class="text-danger">*</span></b></label>
                    <input type="date" id="txtCommitmentdate" name="txtCommitmentdate" class="box_border form-control form-control-sm" autocomplete="off" required />
                </div>
            </div>
            <div class="col-md-2 without-label-field">
                <input type="button" id="btnShow" class="btn btn-primary btn-height" value="Show">
                <input type="button" id="btnSave" class="btn btn-success btn-height" value="Save" onclick="UpdateCommitmentAmount()">
                <input type="button" id="btnReport" class="btn btn-success btn-height" value="Report">
            </div>
        </div>
    </div>
</div>

<div class="table-wrapper fixed-height-table">
    <table id="tbCollectionCommitment" class="fixed-width-table table">
        <thead id="table-header-CollectionCommitment">
        </thead>
        <tbody id="tablebody-CollectionCommitment">
        </tbody>
    </table>
</div>
<div class="paginator" id="paginator-tbCollectionCommitment">
</div>
<div class="table-wrapper fixed-height-table" hidden="hidden">
    <table id="tblReport" hidden="hidden">
        <thead id="table-headerPrint">
            <tr></tr>
        </thead>
        <tbody id="table-bodyPrint">
        </tbody>
    </table>
</div>