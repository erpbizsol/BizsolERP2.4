@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Purchase.Transactions/Script/POApproval.js"></script>
<style>
    .modal-dialog {
        max-width: 1100px;
    }
</style>

<div class="table-wrapper fixed-height-table">
    <table id="POApproval" class="fixed-width-table table">
        <thead id="table-header-POApproval">
        </thead>
        <tbody id="table-body-POApproval">
        </tbody>
    </table>
</div>
<div class="paginator" id="paginator-POApproval">
</div>

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <input type="hidden" id="hfCodeForBack" value="0"/>
                <h5 class="modal-title">View Details</h5>
                <button type="button" class="close modal-close" aria-label="Close" onclick="CloseModal()">
                    <span aria-hidden="true" class="modal-close-icon">&times;</span>
                </button>
                    
            </div>
            <div class="modal-body">
                <div class="table-wrapper fixed-height-table">
                    <table id="PoapprovalModal" class="fixed-width-table table">
                        <thead id="table-header-PoapprovalModal">
                        </thead>
                        <tbody id="table-body-PoapprovalModal">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-PoapprovalModal">
                </div>
                <div class="table-wrapper ">
                    <table id="PoapprovalDeliveryTerms" class="fixed-width-table table">
                        <thead id="table-header-PoapprovalDeliveryTerms">
                        </thead>
                        <tbody id="table-body-PoapprovalDeliveryTerms">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-PoapprovalDeliveryTerms">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger btn-height" onclick="CloseModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="myHistoryModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title"></h5>
                <button type="button" class="close modal-close" aria-label="Close" onclick="CloseHistoryModal()">
                    <span aria-hidden="true" class="modal-close-icon">&times;</span>
                   @* <span aria-hidden="true">x</span> *@
                </button>
            </div>
            <div class="modal-body">
                <div class="table-wrapper fixed-height-table">
                    <table id="PoaprrovalHistory" class="fixed-width-table table">
                        <thead id="table-header-PoaprrovalHistory">
                        </thead>
                        <tbody id="table-body-PoaprrovalHistory">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-PoaprrovalHistory">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-height" onclick="BackButton()">Back</button>
                <button type="button" class="btn btn-danger btn-height" onclick="CloseHistoryModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div id="POApproval_AttachmentControlmodal"></div>