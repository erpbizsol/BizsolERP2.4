            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label for="txtItemWise" class="form-label">Item Wise Summary</label>
                <div class="row">
                    <div id="tblItemWiseSummary">
                        <div class="table-wrapper fixed-height-table">
                            <table id="ItemWiseSummary" class="fixed-width-table table">
                                <thead id="ItemWiseSummary-header">
                                </thead>
                                <tbody id="ItemWiseSummary-body">
                                </tbody>
                            </table>
                        </div>
                        <div class="paginator" id="paginator-ItemWiseSummary">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
