@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Transactions/js/PendingOrder.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<script src="https://cdn.rawgit.com/rainabba/jquery-table2excel/1.1.0/dist/jquery.table2excel.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
    .highlighted-date {
        background-color: #3926B6;
        color: white;
        border-radius: 30px;
    }

    .datepicker td, .datepicker th {
        border-radius: 20px !important;
    }

    .datepicker table tr td, .datepicker table tr td {
        padding: 8px 9px !important;
        height: 16px !important;
    }

    .datepicker table tfoot {
        display: none;
    }

    #hidetexbox {
        display: none;
    }

    .btn:not(:disabled):not(.disabled) {
        cursor: pointer !important;
    }
</style>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-2 col-sm-6 col-6">
                <label for="fromDate" class="form-label">From Date <span class="text-danger">*</span></label>
                <input type="text" id="txtFromDate" name="FromDate" class="form-control form-control-sm box_border" autocomplete="off" required />
            </div>
            <div class="col-md-2 col-sm-6 col-6">
                <label for="toDate" class="form-label">To Date <span class="text-danger">*</span></label>
                <input type="text" id="txtToDate" name="ToDate" class="form-control form-control-sm box_border" autocomplete="off" required />
            </div>
            <div class="col-md-3">
                <label for="userName" class="form-label">Sales Person <span class="text-danger">*</span></label>
               
                <select id="ddlSalesPersonList" name="ddlSalesPersonList" class="form-control form-control-sm box_border" autocomplete="off">
                  </select>

            </div>
            <div class="col-md-2">
                <label for="listTemplate" class="form-label">Template<span class="text-danger">*</span></label>
                <select id="listTemplate" name="listTemplate" class="form-control form-control-sm box_border" autocomplete="off">
                    <option value="CONSOLIDATED_VIEW" selected>Consolidated View</option>
                    <option value="DETAIL_VIEW">Detailed View</option>
                </select>
            </div>
            <div class="col-md-3 without-label-field">
                <button type="button" id="btnShow" class="btn btn-primary btn-height btn-width">Show</button>
                <button type="button" id="btnDownload" class="btn btn-primary btn-height" title="Download List"><i class="fa fa-download" aria-hidden="true"></i></button>

            </div>

        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <label for="txtEduBack" class="form-label">Pending Order Details</label>
                <div class="row">
                    <div id="tblPendingOrderList">
                        <div class="table-wrapper  fixed-height-table">
                            <table id="PendingOrderList" class="table fixed-width-table">
                                <thead id="PendingOrderList-header">
                                </thead>
                                <tbody id="PendingOrderList-body">
                                </tbody>
                            </table>
                        </div>
                        <div class="paginator" id="paginator-PendingOrderList">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label for="txtEduBack" class="form-label">Salesman Wise Summary</label>
                <div class="row">
                    <div id="tblSalesManSummary">
                        <div class="table-wrapper fixed-height-table">
                            <table id="SalesManSummary" class="fixed-width-table table">
                                <thead id="SalesManSummary-header">
                                </thead>
                                <tbody id="SalesManSummary-body">
                                </tbody>
                            </table>
                        </div>
                        <div class="paginator" id="paginator-SalesManSummary">
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label for="txtEduBack" class="form-label">Zone Wise Summary</label>
                <div class="row">
                    <div id="tblZoneWiseSummary">
                        <div class="table-wrapper fixed-height-table">
                            <table id="ZoneWiseSummary" class="fixed-width-table table">
                                <thead id="ZoneWiseSummary-header">
                                </thead>
                                <tbody id="ZoneWiseSummary-body">
                                </tbody>
                            </table>
                        </div>
                        <div class="paginator" id="paginator-ZoneWiseSummary">
