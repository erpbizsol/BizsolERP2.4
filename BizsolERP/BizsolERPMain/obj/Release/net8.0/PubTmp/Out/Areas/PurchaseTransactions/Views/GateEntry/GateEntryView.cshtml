@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />

<div class="tab-section" id="DivGateEntryForm">
    <ul class="nav nav-tabs" id="GateEntryTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#EmptyInTab" role="tab" aria-controls="home" aria-selected="true" onclick="GateEntyMode_GateEntry('form','EmptyInNew')">
                Empty In
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#LoadedInTab" role="tab" aria-controls="profile" aria-selected="false" onclick="GateEntyMode_GateEntry('form','LoadedInNew')">
                Loaded In
            </button>
        </li>
    </ul>
    <div class="tab-content" id="GateEntryTabContent">
        <div class="tab-pane fade show active" id="EmptyInTab" role="tabpanel" aria-labelledby="home-tab">
            <div class="row">
                @*  Empty-in *@
                <span class="mt-1" style="color:#28a745;font-weight: 600"><b>Empty In</b></span>
                <div class="col-sm-6" id="DivfrmEmptyIn">
                    @*  <div class="row">
                        <div class="col-sm-6">
                            Empty-in
                        </div>
                        <div class="col-sm-6">
                            Empty-in
                        </div>
                    </div> *@
                    <div class="row">
                        <div class="col-4">
                            Date In <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtDateIn" class="BizSolFormControl form-control form-control-sm" type="date" onkeypress="BizSolhandleEnterKey(event)" readonly autocomplete="off">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Vehicle No. <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtVehicleNo" class="BizSolFormControl form-control form-control-sm alphanum-uppercase" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" maxlength="10" autocomplete="off">
                            <ul id="frmEmptyIn_txtVehicleNo_List" class="AutoSuggestion-list"></ul>
                        </div>
                    </div>
                    <div class="row" id="RowfrmEmptyInTokenNo">
                        <div class="col-4">
                            Token No. 
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtTokenNo" class="BizSolFormControl form-control form-control-sm alphanum-uppercase" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" maxlength="20" autocomplete="off">
                            <ul id="frmEmptyIn_txtTokenNo_List" class="AutoSuggestion-list"></ul>
                        </div>
                    </div>
                    <div class="row" id="RowfrmEmptyInReportingDatetime">
                        <div class="col-4">
                            Reporting Date time <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtReportingDatetime" class="BizSolFormControl form-control form-control-sm" type="datetime-local" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>
                    <div class="row" id="DivEmptyInChassisNo">
                        <div class="col-4">
                            Chassis No. <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtChassisNo" class="BizSolFormControl form-control form-control-sm alphanum-uppercase" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" maxlength="30" autocomplete="off">
                        </div>
                    </div>

                    <div class="row" id="DivEmptyInRCNo">
                        <div class="col-4">
                            RC No. <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtRCNo" class="BizSolFormControl form-control form-control-sm alphanum-uppercase" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" maxlength="30" autocomplete="off">
                        </div>
                    </div>

                    <div class="row" id="DivEmptyInRCExpiredDate">
                        <div class="col-4">
                            RC Expired Date <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtRCExpiredDate" class="BizSolFormControl form-control form-control-sm" type="date" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            Driver Name <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtDriverName" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" autocomplete="off">
                        </div>
                    </div>

                    <div class="row" id="DivEmptyInDriverLicenseNo">
                        <div class="col-4">
                            Driver License No. <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtDriverLicenseNo" class="BizSolFormControl form-control form-control-sm alphanum-uppercase" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" maxlength="30" autocomplete="off">
                        </div>
                    </div>

                    <div class="row" id="DivEmptyInDriverLicenseExpiredDate">
                        <div class="col-4">
                            Driver License Expiry <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtDriverLicenseExpiredDate" class="BizSolFormControl form-control form-control-sm" type="date" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            Driver No. <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtDriverNo" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="return BizSolInputControl.OnKeyDownPressNumericTextBox(event,this);" maxlength="12" autocomplete="off">
                        </div>
                    </div>
                    <div class="row" id="DivEmptyInDriverAadharNo">
                        <div class="col-4">
                            Driver Aadhar No. 
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtDriverAadharNo" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="return BizSolInputControl.OnKeyDownPressNumericTextBox(event,this);" autocomplete="off" maxlength="12">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Transporter Name. <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            @* <select id="frmEmptyIn_ddlTransporterName" class="BizSolFormControl form-control-sm" onkeypress="BizSolhandleEnterKey(event)">
                            </select> *@
                            <input id="frmEmptyIn_ddlTransporterName" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                            <ul id="frmEmptyIn_ddlTransporterName_List" class="AutoSuggestion-list"></ul>
                        </div>
                    </div>
                    <div class="row" id="RowfrmEmptyInVehicleEmptyWeight">
                        <div class="col-4">
                            Vehicle Empty Weight(KG) <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtVehicleEmptyWeight" class="BizSolFormControl form-control form-control-sm" type="text" onchange="BizSolInputControl.OnChangeFloatTextBox(this,2)" onkeypress="return BizSolInputControl.OnKeyDownPressFloatTextBox(event,this);" autocomplete="off">
                            <a class="btn btn-dark btn-height" title="Scale Weight" id="btnScaleWeigh_frmEmptyIn_txtVehicleEmptyWeight" onclick="GateEntry_InitSelectMachineToGetWeightControl('frmEmptyIn_txtVehicleEmptyWeight')">
                                <i class="fa-solid fa-scale-unbalanced"></i>
                            </a>
                        </div>
                    </div>
                    <div class="row" id="RowfrmEmptyInWeightmentSlipNoEmpty">
                        <div class="col-4">
                            Weightment Slip No.(Empty) <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtWeightmentSlipNoEmpty" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Vehicle In Time. <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtVehicleInTime" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" readonly autocomplete="off">
                        </div>
                    </div>
                    <div class="row" id="DivfrmEmptyIn_fileVehiclePhoto">
                        <div class="col-4">
                            Vehicle Photo <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <div class="input-group" >
                                <span class=" input-group-text" onclick="document.getElementById('frmEmptyIn_fileVehiclePhoto').click()" style="cursor: pointer;height: 28px;">
                                    <i class="fa fa-camera"></i>
                                </span>
                                <input id="frmEmptyIn_fileVehiclePhoto" asp-for="Attachment" type="file" accept="image/x-png,image/gif,image/jpeg" capture="camera" class="form-control form-control-sm" onkeypress="BizSolhandleEnterKey(event)" />
                            </div>

                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-4">
                            Remarks
                        </div>
                        <div class="col-8">
                            <input id="frmEmptyIn_txtRemarks" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12 text-end">
                            <button id="frmEmptyIn_btnSave" type="button" class="btn btn-primary icon-height" onclick="GateEntry_SaveData('EmptyInSave')">Save</button> &nbsp;
                            <button id="frmEmptyIn_btnCancel" type="button" class="btn btn-danger icon-height" onclick="GateEntyMode_GateEntry('grid','')">Cancel</button>
                        </div>
                    </div>
                </div>

                @*  Loaded-Out *@

                <div class="col-sm-6" id="DivfrmLoadedOut">
                    <div class="row">
                        <div class="col-4">
                            Date Out
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtDateOut" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" readonly>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                           Out Type
                        </div>
                        <div class="col-8">
                            <select class="form-control form-control-sm" id="frmLoadedOut_ddlOutType">
                                <option value="LOUT">Loaded Out</option>
                                <option value="EOUT">Empty Out</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            Out Reason
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtOutReason" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                            <ul id="frmLoadedOut_txtOutReason_List" class="AutoSuggestion-list"></ul>
                        </div>
                    </div>

                    <div class="row" id="RowfrmLoadedOutVehicleLoadedWeight">
                        <div class="col-4">
                            Vehicle Loaded Weight (KG) <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtVehicleLoadedWeight" class="BizSolFormControl form-control form-control-sm" type="text" onchange="GateEntry_GetNetWeight();BizSolInputControl.OnChangeFloatTextBox(this,2)" onkeypress="return BizSolInputControl.OnKeyDownPressFloatTextBox(event,this);" autocomplete="off">
                            <a class="btn btn-dark btn-height" title="Scale Weight" id="btnScaleWeigh_frmLoadedOut_txtVehicleLoadedWeight" onclick="GateEntry_InitSelectMachineToGetWeightControl('frmLoadedOut_txtVehicleLoadedWeight')">
                                <i class="fa-solid fa-scale-unbalanced"></i>
                            </a>
                        </div>
                    </div>
                    <div class="row" id="RowfrmLoadedOutWeightmentSlipNoLoadedOut">
                        <div class="col-4">
                            Weightment Slip No. Loaded <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtWeightmentSlipNoLoadedOut" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>
                    <div class="row" id="RowfrmLoadedOutNetWeightLoadedOut">
                        <div class="col-4">
                            Net Weight
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtNetWeightLoadedOut" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off" readonly>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Vehicle Out Time <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtVehicleOutTime" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" readonly>
                        </div>
                    </div>
                    <div class="row" id="RowLoadedOut_fileVehiclePhoto">
                        <div class="col-4">
                            Vehicle Photo <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <div class="input-group">
                                <span class="input-group-text" onclick="document.getElementById('frmLoadedOut_fileVehiclePhoto').click()" style="cursor: pointer;height: 28px;">
                                    <i class="fa fa-camera"></i>
                                </span>
                                <input id="frmLoadedOut_fileVehiclePhoto" asp-for="Attachment" type="file" accept="image/x-png,image/gif,image/jpeg" capture="camera" class="form-control form-control-sm" onkeypress="BizSolhandleEnterKey(event)" />
                            </div>

                        </div>
                    </div>
                    <div class="row" id="RowLoadedOut_fileGoodsPhoto">
                        <div class="col-4">
                            Goods Photo <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <div class="input-group">
                                <span class=" input-group-text" onclick="document.getElementById('frmLoadedOut_fileGoodsPhoto').click()" style="cursor: pointer;height: 28px;">
                                    <i class="fa fa-camera"></i>
                                </span>
                                <input id="frmLoadedOut_fileGoodsPhoto" asp-for="Attachment" type="file" accept="image/x-png,image/gif,image/jpeg" capture="camera" class="form-control form-control-sm" onkeypress="BizSolhandleEnterKey(event)" />
                            </div>

                        </div>
                    </div>
                    <div class="row" id="RowLoadedOut_fileInvoicePhoto">
                        <div class="col-4">
                            Document Photo <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <div class="input-group">
                                <span class=" input-group-text" onclick="document.getElementById('frmLoadedOut_fileInvoicePhoto').click()" style="cursor: pointer;height: 28px;">
                                    <i class="fa fa-camera"></i>
                                </span>
                                <input id="frmLoadedOut_fileInvoicePhoto" asp-for="Attachment" type="file" accept="image/x-png,image/gif,image/jpeg" capture="camera" class="form-control form-control-sm" onkeypress="BizSolhandleEnterKey(event)" />
                            </div>

                        </div>
                    </div>
                    <div class="row" id="RowLoadedOut_fileOtherPhoto">
                        <div class="col-4">
                            Other Photo
                        </div>
                        <div class="col-8">
                            <div class="input-group">
                                <span class=" input-group-text" onclick="document.getElementById('frmLoadedOut_fileOtherPhoto').click()" style="cursor: pointer;height: 28px;">
                                    <i class="fa fa-camera"></i>
                                </span>
                                <input id="frmLoadedOut_fileOtherPhoto" asp-for="Attachment" type="file" multiple accept=".jpg, .png, .jpeg" class="form-control form-control-sm" onkeypress="BizSolhandleEnterKey(event)" />
                            </div>

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Document Type <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <select id="frmLoadedOut_ddlDocumentType" class="BizSolFormControl form-control form-control-sm" onkeypress="BizSolhandleEnterKey(event)" onchange="GateEntry_changeDocumentType()"></select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4" id="DivfrmLoadedOut_CustomerName">
                            Customer Name <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtCustomerName" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                            <ul id="frmLoadedOut_txtCustomerName_List" class="AutoSuggestion-list"></ul>

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Goods Description <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtGoodsDescription" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                            <ul id="frmLoadedOut_txtGoodsDescription_List" class="AutoSuggestion-list"></ul>
                            
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            QTY <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-3">
                            <input id="frmLoadedOut_txtQty" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="return BizSolInputControl.OnKeyDownPressFloatTextBox(event,this);" onchange="BizSolInputControl.OnChangeFloatTextBox(this,3);"  maxlength="8" autocomplete="off">
                        </div>
                        <div class="col-2">
                            UOM <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-3">
                            <select id="frmLoadedOut_ddlUOM" class="BizSolFormControl form-control form-control-sm" onkeypress="BizSolhandleEnterKey(event)" > </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Document No. <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtDocumentNo" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                            <ul id="frmLoadedOut_txtDocumentNo_List" class="AutoSuggestion-list"></ul>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Document date. <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtDocumentDate" class="BizSolFormControl form-control form-control-sm" type="date" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>
                    <div class="row" id="RowLoadedOut_txtManualDocNo">
                        <div class="col-4">
                            Ext.Manual Invoice No.
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtManualDocNo" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off" max="100">
                        </div>
                    </div>
                    <div class="row" id="RowLoadedOut_txtGRNo">
                        <div class="col-4">
                            GR No.
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtGRNo" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off" max="100">
                        </div>
                    </div>
                    <div class="row" >
                        <div class="col-4">
                            E-Way Bill No.
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtEWayBillNo" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            E-Way Bill Date.
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtEWayBillDate" class="BizSolFormControl form-control form-control-sm" type="date" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Remarks
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedOut_txtRemarks" class="BizSolFormControl form-control form-control-sm" type="text" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12 text-end">
                            <button type="button" id="frmLoadedOut_btnSave" class="btn btn-primary icon-height" onclick="GateEntry_SaveData('UpdateEmptyInSave')">Save</button> &nbsp;
                            <button type="button" id="frmLoadedOut_btnCancel" class="btn btn-danger icon-height" onclick="GateEntyMode_GateEntry('grid','')">Cancel</button>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <div class="tab-pane fade" id="LoadedInTab" role="tabpanel" aria-labelledby="profile-tab">
            <div class="row">
                @*  Loaded-in *@
                <span class="mt-1" style="color:#28a745;font-weight: 600"><b>Loaded In</b></span>
                <div class="col-sm-6" id="DivfrmLoadedIn">
                    <div class="row">
                        <div class="col-4">
                            Date In <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedIn_txtDateIn" class="BizSolFormControl form-control form-control-sm" type="date" onkeypress="BizSolhandleEnterKey(event)" readonly autocomplete="off">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Vehicle No. <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedIn_txtVehicleNo" class="BizSolFormControl form-control form-control-sm alphanum-uppercase" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" maxlength="10" autocomplete="off">
                            <ul id="frmLoadedIn_txtVehicleNo_List" class="AutoSuggestion-list"></ul>
                        </div>
                    </div>
                    <div class="row" id="RowfrmLoadedInTokenNo">
                        <div class="col-4">
                            Token No.
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedIn_txtTokenNo" class="BizSolFormControl form-control form-control-sm alphanum-uppercase" type="text" onkeypress="BizSolInputControl.OnChangeOnlyAlphaNumericTextBox(this)" maxlength="20" autocomplete="off">
                            <ul id="frmLoadedIn_txtTokenNo_List" class="AutoSuggestion-list"></ul>
                        </div>
                    </div>
                    <div class="row" id="RowfrmLoadedInReportingDatetime">
                        <div class="col-4">
                            Reporting Date time <span class="text-danger fw-semibold">*</span>
                        </div>
                        <div class="col-8">
                            <input id="frmLoadedIn_txtReportingDatetime" class="BizSolFormControl form-control form-control-sm" type="datetime-local" onkeypress="BizSolhandleEnterKey(event)" autocomplete="off">
