@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />

<div class="row mb-2" id="DivPackingListFGForm">
    <div class="col-md-12">
        <fieldset class="rounded-1 p-3">
            <legend class="float-none w-auto px-2">Packing List Entry</legend>

            <div class="row">
                <div class="col-md-3 form-group">
                    <label for="txtUserName" class="col-form-label-sm fw-bold">User Name</label>
                    <input type="text" id="txtUserName" class="box_border form-control form-control-sm" autocomplete="off" value="">
                </div>
                <div class="col-md-3 col-sm-6 col-6">
                    <label for="txtdate" class="col-form-label-sm fw-bold">Date</label>
                    <input ID="txtdate" name="txtdate" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Date" value="" readonly="readonly" required />
                </div>
                <div class="col-md-3 col-sm-6 col-6">
                    <label for="txtCheckInTime" class="col-form-label-sm fw-bold">Check In Time</label>
                    <input type="text" id="txtCheckInTime" name="txtCheckInTime" class="box_border form-control form-control-sm" value="" readonly="readonly" />
                </div>
                <div class="col-md-3">
                    <label for="txtLocation" class="col-form-label-sm fw-bold">Location</label>
                    <input type="text" id="txtAddLocation" name="txtAddLocation" class="box_border form-control form-control-sm" hidden required />
                    <input type="text" id="txtCurrentLocation" name="txtCurrentLocation" class="box_border form-control form-control-sm" value="" required />
                    <input type="text" id="txtCheckOutLocation" name="txtCheckOutLocation" class="box_border form-control form-control-sm" hidden required />
                    <input type="hidden" id="hflatlong" name="hflatlong" value="" />
                </div>
            </div>
           
        </fieldset>
    </div>
</div>


<div id="DivPackingListFGViewGrid">
    <div class="row">
        <div class="col-sm-3">
            <label for="from-date">From Date</label>
            <input type="date" class="form-control form-control-sm" id="txtFromDate" onchange="PackingListFGViewGirdByDates()">
        </div>
        <div class="col-sm-3">
            <label for="to-date">To Date</label>
            <input type="date" class="form-control form-control-sm" id="txtToDate" onchange="PackingListFGViewGirdByDates()">
        </div>
        
        <div class="col-sm-3 without-label-field text-end">
            <label></label>
            <button type="button" class="btn btn-primary icon-height" onclick="GateEntyMode_PackingListFGView('form','EmptyInNew')">CREATE NEW</button>
            
        </div>
    </div>
    <div class="table-wrapper mt-2">
        <table id="tbGateEntyView" class="table fixed-width-table">
            <thead id="tbGateEntyViewHeader">
            </thead>
            <tbody id="tbGateEntyViewBody">
            </tbody>
        </table>
    </div>
    <div class="paginator" id="paginator-tbGateEntyView">
    </div>
</div>





<script src="~/_content/Bizsol.WebERP.UI.Shared/js/BizSolInputControl.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Production.Transactions/Script/PackingListFG.js"></script>

