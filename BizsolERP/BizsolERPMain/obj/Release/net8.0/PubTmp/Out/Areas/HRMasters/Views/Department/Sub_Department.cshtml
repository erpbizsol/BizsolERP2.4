@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.HR.Masters/js/Sub_Department.js"></script>
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/BizSolInputControl.js"></script>
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/bizsolpbcontrols.js"></script>
<script src="https://cdn.rawgit.com/rainabba/jquery-table2excel/1.1.0/dist/jquery.table2excel.min.js"></script>
<style>
    .modal-dialog {
        max-width: 350px;
    }

    .fixed-height-table {
        height: 460px;
    }
</style>

<div id="locateSubDepartment">
    <div class="card col-md-9">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label for="txtStatus" class="col-form-label-sm fw-bold">Department Status:<span class="text-danger">*</span></label>
                    <select id="txtStatus" name="txtStatus" class="box_border form-control form-control-sm" required>
                        <option value="Y" selected>Active</option>
                        <option value="N">Inactive</option>
                        <option value="A">All</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="txtFilterDepartmentName" class="col-form-label-sm fw-bold">Department Name:<span class="text-danger">*</span></label>
                    <select id="txtFilterDepartmentName" class="form-control form-control-sm box_border"></select>
                </div>
                <div class="col-md-3" style="margin-top:2.1rem">
                    <button type="button" onclick="ListStatus_Sub_Department()" title="Create New" class="btn btn-primary btn-height">Show</button>
                    <button type="button" onclick="CreateNew_Sub_Department()" title="Create New" class="btn btn-primary btn-height">Create New</button>
                    <button type="button" id="btnDownload" class="btn btn-primary btn-height" title="Download List"><i class="fa fa-download" aria-hidden="true"></i></button>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-9">
            <div id="tblSubDepartment">
                <div class="table-wrapper fixed-height-table">
                    <table id="SubDepartment" class="fixed-width-table table">
                        <thead id="table-header-SubDepartment">
                        </thead>
                        <tbody id="table-body-SubDepartment">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-SubDepartment">
                </div>
            </div>
        </div>
    </div>
</div>

<div id="newCreateForm" class="card" style="display:none">
    <form class="card-body">
        <div class="row">
            <input type="hidden" name="Code" id="Code" class="form-control" value="0">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtDepartmentName" class="col-form-label-sm fw-bold">Department Name:<span class="text-danger">*</span></label>
                    <select id="txtDepartmentName" class="form-control form-control-sm box_border"></select>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtSubDepartmentName" class="col-form-label-sm fw-bold">Sub Department Name:<span class="text-danger">*</span></label>
                    <input id="txtSubDepartmentName" name="txtSubDepartmentName" class="box_border form-control form-control-sm" autocomplete="off" maxlength="50" required />
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtSubDepartmentCode" class="col-form-label-sm fw-bold">Sub Department Code:<span class="text-danger">*</span></label>
                    <input id="txtSubDepartmentCode" name="txtSubDepartmentCode" class="box_border form-control form-control-sm" autocomplete="off" maxlength="40" required />
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtPrefix" class="col-form-label-sm fw-bold">Prefix:<span class="text-danger">*</span></label>
                    <input id="txtPrefix" name="txtPrefix" class="box_border form-control form-control-sm" autocomplete="off" maxlength="50" required />
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtShowInDailyAtt" class="col-form-label-sm fw-bold">Show In Daily Attendance:<span class="text-danger">*</span></label>
                    <select id="txtShowInDailyAtt" name="txtShowInDailyAtt" class="box_border form-control form-control-sm" required>
                        <option value="Y" selected>Yes</option>
                        <option value="N">No</option>
                    </select>
                </div>
            </div>

            <div class="col-md-3">
                <label for="txtDeptStatus" class="col-form-label-sm fw-bold">Active/InActive:<span class="text-danger">*</span></label>
                <select id="txtDeptStatus" name="txtDeptStatus" class="box_border form-control form-control-sm" required>
                    <option value="Y" selected>Active</option>
                    <option value="N">InActive</option>
                </select>
            </div>
            <div class="col-md-3 text-start" style="margin-top:2rem">
                <button type="button" onclick="submit_Sub_Department()" id="saveDepartmentButton" title="Save" class="btn btn-primary btn-height">Save</button>
                <button type="button" class="btn btn-primary btn-height" title="Back" onclick="Department_Back()">Back</button>
            </div>
        </div>
    </form>
    @* <div id="PBControls" class="mb-2"></div> *@
</div>

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Reason</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <input type="text" id="reasonForDeleteInput" class="form-control" placeholder="Enter reason" autocomplete="off" />
                <input type="hidden" id="txtcode" class="form-control" placeholder="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success icon-height" onclick="SaveModal_Sub_DepartmentDelete()">Ok</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseModal_Sub_DepartmentDelete()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="table-wrapper fixed-height-table" hidden="hidden">
    <table id="tblReport" hidden="hidden">
        <thead id="table-headerPrint">
            <tr></tr>
        </thead>
        <tbody id="table-bodyPrint">
        </tbody>
    </table>
</div>