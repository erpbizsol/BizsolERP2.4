@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.HR.Masters/js/Department.js"></script>
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/BizSolInputControl.js"></script>
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/bizsolpbcontrols.js"></script>
<script src="https://cdn.rawgit.com/rainabba/jquery-table2excel/1.1.0/dist/jquery.table2excel.min.js"></script>
<style>
    .modal-dialog {
        max-width: 350px;
    }

    .fixed-height-table{
        height: 460px;
    }
</style>

<div id="locateDepartment">
    <div class="card col-md-9">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label for="txtStatus" class="col-form-label-sm fw-bold">Department Status:<span class="text-danger">*</span></label>
                    <select id="txtStatus" name="txtStatus" class="box_border form-control form-control-sm" required>
                        <option value="Y" selected>Active</option>
                        <option value="N">Inactive</option>
                        <option value="A">All</option>
                    </select>
                </div>
                <div class="col-md-3" style="margin-top:2.1rem">
                    <button type="button" onclick="ListStatus_Department()" title="Create New" class="btn btn-primary btn-height">Show</button>
                    <button type="button" onclick="CreateNew_Department()" title="Create New" class="btn btn-primary btn-height">Create New</button>
                    <button type="button" id="btnDownload" class="btn btn-primary btn-height" title="Download List"><i class="fa fa-download" aria-hidden="true"></i></button>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-9">
            <div id="tblDepartment">
                <div class="table-wrapper fixed-height-table">
                    <table id="Department" class="fixed-width-table table">
                        <thead id="table-header-Department">
                        </thead>
                        <tbody id="table-body-Department">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-Department">
                </div>
            </div>
        </div>
    </div>
</div>

<div id="newCreateForm" class="card" style="display:none">
    <form class="card-body">
        <div class="row">
            <input type="hidden" name="Code" id="Code" class="form-control" value="0">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtDepartmentName" class="col-form-label-sm fw-bold">Department Name:<span class="text-danger">*</span></label>
                    <input id="txtDepartmentName" name="txtDepartmentName" class="box_border form-control form-control-sm" autocomplete="off" maxlength="50" required />
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtDepartmentCode" class="col-form-label-sm fw-bold">Department Code:<span class="text-danger">*</span></label>
                    <input id="txtDepartmentCode" name="txtDepartmentCode" class="box_border form-control form-control-sm" autocomplete="off" maxlength="40" required />
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtDepartmentType" class="col-form-label-sm fw-bold">Department Type:<span class="text-danger">*</span></label>
                    <select id="txtDepartmentType" class="form-control form-control-sm box_border"></select>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtDepartmentAddress" class="col-form-label-sm fw-bold">Department Address:<span class="text-danger">*</span></label>
                    <input id="txtDepartmentAddress" name="txtDepartmentAddress" class="box_border form-control form-control-sm" autocomplete="off" maxlength="50" required />
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtWeeklyOff" class="col-form-label-sm fw-bold">Weekly Off:<span class="text-danger">*</span></label>
                    <input id="txtWeeklyOff" name="txtWeeklyOff" class="box_border form-control form-control-sm" autocomplete="off" maxlength="10" required />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtDivisionName" class="col-form-label-sm fw-bold">Division Name:<span class="text-danger">*</span></label>
                    <select id="txtDivisionName" class="form-control form-control-sm box_border"></select>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtSecondWeeklyOff" class="col-form-label-sm fw-bold">Second Weekly Off:<span class="text-danger">*</span></label>
                    <input id="txtSecondWeeklyOff" name="txtSecondWeeklyOff" class="box_border form-control form-control-sm" autocomplete="off" maxlength="50" required />
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtFirstSecondWeeklyoffON" class="col-form-label-sm fw-bold">First Second Weekly Off ON:<span class="text-danger">*</span></label>
                    <input id="txtFirstSecondWeeklyoffON" name="txtFirstSecondWeeklyoffON" class="box_border form-control form-control-sm" autocomplete="off" oninput="validateIntegerInput(this)" maxlength="4" required />
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtSecondSecondWeeklyoffON" class="col-form-label-sm fw-bold">Second Second Weekly Off ON:<span class="text-danger">*</span></label>
                    <input id="txtSecondSecondWeeklyoffON" name="txtSecondSecondWeeklyoffON" class="box_border form-control form-control-sm" autocomplete="off" oninput="validateIntegerInput(this)" maxlength="4" required />
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtLunchTimeDeduction" class="col-form-label-sm fw-bold">Lunch Time Deduction:<span class="text-danger">*</span></label>
                    <select id="txtLunchTimeDeduction" name="txtLunchTimeDeduction" class="box_border form-control form-control-sm" required>
                        <option value="Y" selected>Yes</option>
                        <option value="N">No</option>
                    </select>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtProfessionalTaxApplicable" class="col-form-label-sm fw-bold">Professional Tax Applicable:<span class="text-danger">*</span></label>
                    <select id="txtProfessionalTaxApplicable" name="txtProfessionalTaxApplicable" class="box_border form-control form-control-sm" required>
                        <option value="Y" selected>Yes</option>
                        <option value="N">No</option>
                    </select>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtMachineApplicable" class="col-form-label-sm fw-bold">Machine Applicable:<span class="text-danger">*</span></label>
                    <select id="txtMachineApplicable" name="txtMachineApplicable" class="box_border form-control form-control-sm" required>
                        <option value="Y" selected>Yes</option>
                        <option value="N">No</option>
                    </select>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtLunchTimeDeductionInWeeklyOff" class="col-form-label-sm fw-bold">Lunch Time Deduction In Weekly Off:<span class="text-danger">*</span></label>
                    <select id="txtLunchTimeDeductionInWeeklyOff" name="txtLunchTimeDeductionInWeeklyOff" class="box_border form-control form-control-sm" required>
                        <option value="Y" selected>Yes</option>
                        <option value="N">No</option>
                    </select>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtDepartmentEmailID" class="col-form-label-sm fw-bold">Email ID:<span class="text-danger">*</span></label>
                    <input id="txtDepartmentEmailID" name="txtDepartmentEmailID" type="email" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Email ID" maxlength="50" required />
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtPrefix" class="col-form-label-sm fw-bold">Prefix:<span class="text-danger">*</span></label>
                    <input id="txtPrefix" name="txtPrefix" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Prefix" maxlength="50" required />
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtShiftMaster_CodeForDeductLunchTimeForOT" class="col-form-label-sm fw-bold">Shift For Deduct LunchTime ForOT:<span class="text-danger">*</span></label>
                    <input id="txtShiftMaster_CodeForDeductLunchTimeForOT" name="txtShiftMaster_CodeForDeductLunchTimeForOT" class="box_border form-control form-control-sm" autocomplete="off" maxlength="500" required />
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtShiftMaster_CodeForDeductInWeekOfForOT" class="col-form-label-sm fw-bold">Shift For Deduct InWeekOf ForOT:<span class="text-danger">*</span></label>
                    <input id="txtShiftMaster_CodeForDeductInWeekOfForOT" name="txtShiftMaster_CodeForDeductInWeekOfForOT" class="box_border form-control form-control-sm" autocomplete="off" maxlength="500" required />
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtIsActive" class="col-form-label-sm fw-bold">IsActive:<span class="text-danger">*</span></label>
                    @* <input type="checkbox" id="Chk_${Res[key]}${rowNO}" switch="success" onchange="CoilProductionPlan_OnChangeChkProcess(this)" /><label data-on-label="Yes" data-off-label="No" for="Chk${Res[key]}_${rowNO}"></label> *@
                    <select id="txtIsActive" name="txtIsActive" class="box_border form-control form-control-sm" required>
                        <option value="Y" selected>Active</option>
                        <option value="N">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6 text-end" style="margin-top:2rem">
                <button type="button" onclick="submit_Department()" id="saveDepartmentButton" title="Save" class="btn btn-primary btn-height">Save</button>
                <button type="button" class="btn btn-primary btn-height" title="Back" onclick="Department_Back()">Back</button>
            </div>
        </div>
    </form>
    @* <div id="PBControls" class="mb-2"></div> *@
</div>

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Reason</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <input type="text" id="reasonForDeleteInput" class="form-control" placeholder="Enter reason" autocomplete="off" />
                <input type="hidden" id="txtcode" class="form-control" placeholder="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success icon-height" onclick="SaveModal_DepartmentDelete()">Ok</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseModal_DepartmentDelete()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="table-wrapper fixed-height-table" hidden="hidden">
    <table id="tblReport" hidden="hidden">
        <thead id="table-headerPrint">
            <tr></tr>
        </thead>
        <tbody id="table-bodyPrint">
        </tbody>
    </table>
</div>