<script src="https://code.jquery.com/jquery-3.7.1.js" ntegrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4="crossorigin="anonymous"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Production.Transactions/Script/TestView.js"></script>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | My App</title>
    <style>
        body {
            font-family: "Segoe UI", sans-serif;
            background: linear-gradient(135deg, #3a7bd5, #00d2ff);
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }

        .login-container {
            background: #fff;
            padding: 40px 35px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            width: 350px;
            text-align: center;
        }

            .login-container h2 {
                margin-bottom: 25px;
                color: #333;
            }

        .input-group {
            margin-bottom: 20px;
            text-align: left;
        }

            .input-group label {
                display: block;
                color: #555;
                margin-bottom: 5px;
                font-size: 14px;
            }

            .input-group input {
                width: 100%;
                padding: 10px;
                border: 1px solid #ccc;
                border-radius: 8px;
                font-size: 15px;
                transition: border-color 0.3s ease;
            }

                .input-group input:focus {
                    border-color: #3a7bd5;
                    outline: none;
                }

        .btn-login {
            background: #3a7bd5;
            color: white;
            border: none;
            padding: 10px 0;
            border-radius: 8px;
            width: 100%;
            font-size: 16px;
            cursor: pointer;
            transition: background 0.3s ease;
        }

            .btn-login:hover {
                background: #2f67c5;
            }

        .forgot {
            margin-top: 15px;
            display: block;
            color: #3a7bd5;
            text-decoration: none;
            font-size: 14px;
        }

            .forgot:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div class="login-container">
        <h2>Sign Up</h2>
        <form>
            <div class="input-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required />
            </div>
            <div class="input-group">
                <label for="MobileNo">Mobile No</label>
                <input type="text" id="MobileNo" name="MobileNo" required />
            </div>
            <div class="input-group">
                <label for="Email">Email</label>
                <input type="text" id="Email" name="Email" required />
            </div>
            <div class="input-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required />
            </div>
            <button type="button" class="btn-login" onclick="Save_SignUp()">Sign Up</button>
        </form>
    </div>
</body>
</html>
