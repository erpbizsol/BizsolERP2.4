@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Marketing.Transactions/Script/BOM.js?v=3"></script>
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/BizSolInputControl.js"></script>

<style>
    .bom-page {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        padding: 4px 0 32px;
    }

    .bom-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 20px;
    }

    .bom-hero-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .bom-hero-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: var(--primary-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
        box-shadow: var(--shadow-primary);
        flex-shrink: 0;
    }

    .bom-hero-title {
        font-size: 21px;
        font-weight: 800;
        color: var(--text-dark);
        letter-spacing: -.025em;
        line-height: 1.2;
    }

    .bom-hero-sub {
        font-size: 13px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .bom-card {
        background: var(--white-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
        position: relative;
    }

    .bom-card::before {
        content: '';
        position: absolute;
        inset: 0 0 auto 0;
        height: 3px;
        background: var(--primary-gradient);
        border-radius: 20px 20px 0 0;
    }

    .bom-card-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 14px 18px;
        align-items: flex-end;
        padding: 18px 22px 14px;
        border-bottom: 1px solid var(--border-light);
    }

    .bom-fg {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 220px;
    }

    .bom-fg label {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .bom-fg select {
        padding: 9px 13px;
        border-radius: 10px;
        border: 1.5px solid var(--border-color);
        font-size: 13.5px;
        outline: none;
        background: var(--white-bg);
        color: var(--text-dark);
        transition: border-color .2s, box-shadow .2s;
        min-width: 220px;
    }

    .bom-fg select:focus {
        border-color: var(--accent-primary);
        box-shadow: 0 0 0 3px rgba(102,126,234,.15);
    }

    .bom-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-height: calc(100vh - 320px);
        overflow-y: auto;
    }

    .bom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
        min-width: 920px;
    }

    .bom-table thead {
        position: sticky;
        top: 0;
        z-index: 3;
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
    }

    .bom-table thead th {
        color: #fff !important;
        background: transparent !important;
        font-weight: 700;
        padding: 11px 10px;
        text-align: left;
        white-space: nowrap;
        border: none !important;
        font-size: 12px;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .bom-table thead th.center {
        text-align: center;
    }

    .bom-table thead th.right {
        text-align: right;
    }

    .bom-table tbody tr {
        transition: background .12s;
    }

    .bom-table tbody tr:nth-child(even) {
        background: var(--light-bg) !important;
    }

    .bom-table tbody tr:nth-child(odd) {
        background: #fff !important;
    }

    .bom-table tbody tr:hover {
        background: rgba(102,126,234,.07) !important;
    }

    .bom-table td {
        padding: 8px 8px;
        border-bottom: 1px solid var(--border-light) !important;
        color: var(--text-dark) !important;
        background: transparent !important;
        vertical-align: middle;
    }

    .bom-table td.center {
        text-align: center;
    }

    .bom-table td.right {
        text-align: right;
    }

    .bom-input,
    .bom-select {
        width: 100%;
        box-sizing: border-box;
        padding: 6px 8px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        font-size: 13px;
        outline: none;
        background: #fff;
    }

    .bom-input:focus,
    .bom-select:focus {
        border-color: var(--accent-primary);
        box-shadow: 0 0 0 2px rgba(102,126,234,.18);
    }

    .bom-input[readonly],
    .bom-input[disabled] {
        background: #f5f5f5;
        cursor: not-allowed;
    }

    .bom-input.right {
        text-align: right;
    }

    /* ── BOM Summary panel ── */
    #dvBOMSummary {
        margin-top: 18px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border-color);
        box-shadow: 0 2px 10px rgba(102,126,234,.08);
    }
    .bom-summary-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        background: #17a2b8;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .3px;
    }
    .bom-summary-header i { font-size: 14px; }
    .bom-summary-table-wrap {
        overflow-x: hidden !important;
        overflow-y: visible !important;
        max-height: none !important;
    }
    #tblBOMSummary {
        margin: 0;
        border-radius: 0;
        min-width: 0 !important;
        width: 100%;
        table-layout: fixed;
    }
    #tblBOMSummary thead th {
        background: #5a5af0 !important;
        color: #fff !important;
        font-size: 12px;
        font-weight: 700;
        padding: 8px 10px;
        text-transform: uppercase;
        letter-spacing: .4px;
        border-bottom: 2px solid rgba(255,255,255,.2) !important;
    }
    #tblBOMSummary tbody td {
        padding: 8px 10px;
        font-size: 13px;
        border-bottom: 1px solid var(--border-light) !important;
    }
    #tblBOMSummary tbody tr:last-child td { border-bottom: none !important; }
    #tblBOMSummary tbody tr:hover { background: rgba(90,90,240,.06) !important; }
    #tblBOMSummary tfoot td {
        padding: 8px 10px;
        font-size: 13px;
        font-weight: 700;
        background: #f8f9fa !important;
        border-top: 2px solid var(--border-color) !important;
    }
    #tblBOMSummary .uom-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 20px;
        background: #17a2b8;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .3px;
    }
    @@media (max-width: 768px) {
        #dvBOMSummary { margin-top: 12px; }
        .bom-summary-header { padding: 8px 12px; font-size: 12px; }
        #tblBOMSummary thead th,
        #tblBOMSummary tbody td,
        #tblBOMSummary tfoot td {
            padding: 6px 8px;
            font-size: 12px;
        }
        #tblBOMSummary thead th:nth-child(1) { width: 28%; }
        #tblBOMSummary thead th:nth-child(2) { width: 22%; }
        #tblBOMSummary thead th:nth-child(3) { width: 25%; }
        #tblBOMSummary thead th:nth-child(4) { width: 25%; }
    }

    .bom-actions {
        display: flex;
        gap: 6px;
        justify-content: center;
    }

    .bom-btn {
        border: none;
        outline: none;
        border-radius: 8px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }

    .bom-btn.add {
        background: linear-gradient(135deg, #0ea5e9, #38bdf8);
        color: #fff;
        box-shadow: 0 8px 20px rgba(14,165,233,.35);
    }

    .bom-btn.back {
        background: linear-gradient(135deg, #f97316, #fb923c);
        color: #fff;
        box-shadow: 0 8px 20px rgba(249,115,22,.35);
    }

    .bom-btn.secondary {
        background: #f3f4f6;
        color: var(--text-dark);
        border: 1px solid var(--border-color);
        box-shadow: none;
    }

    .bom-btn.save {
        background: var(--primary-gradient);
        color: #fff;
        box-shadow: var(--shadow-primary);
    }

    .bom-btn.verify {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        color: #fff;
    }

    /* List action buttons – match ProjectMaster look */
    .bom-btn.icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        transition: transform .14s, box-shadow .14s;
    }

    .bom-btn.icon:hover {
        transform: translateY(-2px);
    }

    .bom-btn.icon.view {
        background: rgba(6,182,212,.12);
        color: var(--accent-info);
        border: 1px solid rgba(6,182,212,.25);
    }

    .bom-btn.icon.view:hover {
        background: rgba(6,182,212,.22);
        box-shadow: 0 4px 12px rgba(6,182,212,.25);
    }

    .bom-btn.icon.edit {
        background: rgba(102,126,234,.12);
        color: var(--accent-primary);
        border: 1px solid rgba(102,126,234,.25);
    }

    .bom-btn.icon.edit:hover {
        background: rgba(102,126,234,.22);
        box-shadow: var(--shadow-primary);
    }

    .bom-btn.icon.del {
        background: rgba(239,68,68,.1);
        color: #ef4444;
        border: 1px solid rgba(239,68,68,.2);
    }

    .bom-btn.icon.del:hover {
        background: rgba(239,68,68,.18);
        box-shadow: 0 4px 12px rgba(239,68,68,.3);
    }

    .bom-btn:disabled {
        opacity: .6;
        cursor: default;
        box-shadow: none;
    }

    .bom-pill {
        font-size: 11px;
        padding: 3px 9px;
        border-radius: 999px;
        background: rgba(15,118,110,.1);
        color: #0f766e;
        border: 1px solid rgba(15,118,110,.2);
        display: inline-block;
    }

    /* ── Shared ProjectMaster-style components for grid ─────── */
    .pm-card {
        background: var(--white-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
        position: relative;
    }

    .pm-card::before {
        content: '';
        position: absolute;
        inset: 0 0 auto 0;
        height: 3px;
        background: var(--primary-gradient);
        border-radius: 20px 20px 0 0;
    }

    .pm-card-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 18px 22px 16px;
        border-bottom: 1px solid var(--border-light);
    }

    .pm-search-wrap {
        position: relative;
        flex: 1;
        min-width: 200px;
        max-width: 340px;
    }

    .pm-search-wrap i {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 13px;
        pointer-events: none;
    }

    #bomSearch {
        width: 100%;
        padding: 9px 14px 9px 38px;
        border-radius: 10px;
        border: 1.5px solid var(--border-color);
        font-size: 13.5px;
        outline: none;
        background: var(--light-bg);
        color: var(--text-dark);
        transition: border-color .2s, box-shadow .2s, background .2s;
    }

    #bomSearch:focus {
        border-color: var(--accent-primary);
        background: #fff;
        box-shadow: 0 0 0 3px rgba(102,126,234,.15);
    }

    .pm-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-height: calc(100vh - 360px);
        overflow-y: auto;
    }

    .pm-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
        min-width: 680px;
    }

    .pm-table thead {
        position: sticky;
        top: 0;
        z-index: 4;
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
    }

    .pm-table thead th {
        color: #fff !important;
        background: transparent !important;
        font-weight: 700;
        padding: 13px 16px;
        text-align: left;
        white-space: nowrap;
        border: none !important;
        font-size: 12px;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .pm-table thead th.center { text-align: center; }
    .pm-table thead th.right  { text-align: right; }

    .pm-table tbody tr { transition: background .12s; }
    .pm-table tbody tr:nth-child(even) { background: var(--light-bg) !important; }
    .pm-table tbody tr:nth-child(odd)  { background: #fff !important; }
    .pm-table tbody tr:hover           { background: rgba(102,126,234,.07) !important; }

    .pm-table tfoot td {
        padding: 10px 16px;
        font-weight: 700;
        font-size: 13px;
        background: rgba(102,126,234,.07) !important;
        border-top: 2px solid var(--border-color) !important;
        color: var(--text-dark) !important;
    }

    .pm-table td {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border-light) !important;
        color: var(--text-dark) !important;
        background: transparent !important;
        vertical-align: middle;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pm-table td.center { text-align: center; }
    .pm-table td.right  { text-align: right; }
    .pm-table tbody tr:last-child td { border-bottom: none !important; }

    .pm-sno {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: var(--primary-gradient);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .pm-code-badge {
        display: inline-block;
        padding: 3px 11px;
        border-radius: 20px;
        background: rgba(102,126,234,.1);
        color: var(--accent-primary);
        font-size: 12px;
        font-weight: 700;
        border: 1px solid rgba(102,126,234,.2);
        letter-spacing: .03em;
    }

    .pm-budget {
        font-weight: 700;
        color: var(--accent-primary-dark);
    }

    .pm-days-chip {
        display: inline-block;
        padding: 3px 11px;
        border-radius: 20px;
        background: rgba(6,182,212,.1);
        color: var(--accent-info);
        font-size: 12px;
        font-weight: 700;
        border: 1px solid rgba(6,182,212,.2);
    }

    .pm-empty {
        text-align: center;
        padding: 56px 20px;
    }

    .pm-empty-icon {
        width: 68px;
        height: 68px;
        border-radius: 20px;
        background: var(--primary-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-size: 28px;
        color: #fff;
        box-shadow: var(--shadow-primary);
        opacity: .7;
    }

    .pm-empty-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 6px;
    }

    .pm-empty-sub {
        font-size: 13px;
        color: var(--text-muted);
    }

    /* Reuse ProjectMaster button styles for modals */
    .pm-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 8px 20px;
        border: none;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        outline: none;
    }

    .pm-btn.secondary {
        background: var(--light-bg);
        color: var(--text-muted);
        border: 1.5px solid var(--border-color);
    }

    .pm-btn.danger {
        background: linear-gradient(135deg, #ef4444, #f87171);
        color: #fff;
        box-shadow: 0 4px 14px rgba(239,68,68,.32);
    }

    .pm-btn-new {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        outline: none;
        padding: 10px 22px;
        border-radius: 12px;
        background: var(--primary-gradient);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: var(--shadow-primary);
        transition: transform .15s, box-shadow .15s;
        white-space: nowrap;
    }

    .pm-btn-new:hover  { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(102,126,234,.45); }
    .pm-btn-new:active { transform: translateY(0); }

    .pm-btn-new .pm-plus {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: rgba(255,255,255,.22);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 700;
        line-height: 1;
    }

    @@media (max-width: 768px) {
        .bom-card-toolbar {
            padding: 14px 14px 10px;
        }

        .bom-fg {
            width: 100%;
        }
    }
</style>

<div class="bom-page" id="dvBOMGrid">
    <div class="bom-hero">
        <div class="bom-hero-left">
            <div class="bom-hero-icon">
                <i class="fas fa-clipboard-list"></i>
            </div>
            <div>
                <div class="bom-hero-title">Bill of Material</div>
            </div>
        </div>
        <button class="pm-btn-new" id="btnCreateBOM" type="button">
            <span class="pm-plus">+</span>
            <span>New BOM</span>
        </button>
    </div>

    <div class="pm-card">
        <div class="pm-card-toolbar">
            <div class="pm-search-wrap">
                <i class="fas fa-search"></i>
                <input type="text" id="bomSearch" placeholder="Search by project…" autocomplete="off" />
            </div>
        </div>

        <div class="pm-table-wrap">
            <table class="pm-table" id="tblBOMList">
                <thead>
                    <tr>
                        <th class="center" style="width:60px;">#</th>
                        <th style="min-width:220px;">Project Name</th>
                        <th style="min-width:220px;">Sub Project Name</th>
                        <th class="center" style="min-width:100px;">Total Items</th>
                        <th class="right" style="min-width:130px;">Total Amount</th>
                        <th class="center" style="width:130px;">Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" style="text-align:right; font-weight:700; padding:8px 10px;">Grand Total</td>
                        <td id="bomListGrandTotal" style="text-align:right; font-weight:700; padding:8px 10px;">—</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="bom-card" id="dvBOMEntry" style="display:none;">
    <div class="bom-card-toolbar">
        <div class="bom-fg">
            <label for="ddlProject">Project Name</label>
            <select id="ddlProject">
                <option value="">Loading…</option>
            </select>
        </div>
        <div class="bom-fg">
            <label for="ddlSubProject">Sub Project Name</label>
            <select id="ddlSubProject">
                <option value="">Select project first</option>
            </select>
        </div>

        <div style="margin-left:auto; display:flex; align-items:flex-end; gap:10px; flex-wrap:wrap;">
            <button type="button" class="bom-btn add" id="btnAddBomRow">
                <i class="fas fa-plus-circle"></i> Add New Row
            </button>
            <button type="button" class="bom-btn save" id="btnSaveAllBomRows">
                <i class="fas fa-save"></i> Save All
            </button>
            @* <button type="button" class="bom-btn verify" id="btnVerifyAllBomRows" style="display:none;">
                <i class="fas fa-check-circle"></i> Verify All
            </button> *@
            <button type="button" class="bom-btn back" id="btnBackToBomList">
                <i class="fas fa-arrow-left"></i> Back
            </button>
        </div>
    </div>

    <input type="hidden" id="hfBOMCode" value="0" />

    <div class="bom-table-wrap">
        <table class="bom-table" id="tblBOM">
            <thead>
                <tr>
                    <th class="center" style="width:50px;">#</th>
                    <th style="min-width:100px;">Prj Category</th>
                    <th style="min-width:110px;">Work Type</th>
                    <th style="min-width:150px;">Item Name</th>
                    <th style="min-width:80px;">UOM</th>
                    <th style="min-width:80px;">Item Specification</th>
                    <th style="min-width:90px;" class="right">Tolerance</th>
                    <th style="min-width:110px;" class="right">Qty Required</th>
                    <th style="min-width:110px;" class="right">Rate Tol (%)</th>
                    <th style="min-width:110px;" class="right">EST. Rate</th>
                    <th style="min-width:120px;" class="right">Amount</th>
                    <th style="width:40px;"></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

    <!-- BOM Summary by project category (inside entry card so it hides/shows with the form) -->
    <div id="dvBOMSummary" style="display:none;margin-top:16px;" class="bom-card">
        <div class="bom-summary-header">
            <i class="fas fa-chart-bar"></i> BOM Summary by Prj Category
        </div>
        <div class="bom-table-wrap bom-summary-table-wrap" style="margin-top:0; border-radius:0; box-shadow:none; border:none;">
            <table class="bom-table" id="tblBOMSummary">
                <thead>
                    <tr>
                        <th>Prj Category</th>
                        <th class="right">Qty Required</th>
                        <th class="right">EST. Rate (wt. avg)</th>
                        <th class="right">Amount</th>
                    </tr>
                </thead>
                <tbody></tbody>
                <tfoot>
                    <tr>
                        <td><strong>Grand Total</strong></td>
                        <td class="right" id="sumQtyRequired">—</td>
                        <td class="right" id="sumEstRate">—</td>
                        <td class="right" id="sumAmount">—</td>
                    </tr>
                </tfoot>
            </table>
        </div>
