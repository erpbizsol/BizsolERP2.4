        <div style="text-align:right;">
            <button type="button" class="btn btn-danger icon-height" onclick="BackFollowUp()">Back To Followup List</button>
        </div>
    </div>
</div>
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Reason</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <input type="text" id="deleteReason" class="form-control" placeholder="Enter reason" autocomplete="off" />
                <input type="hidden" id="txtcode" class="form-control" placeholder="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success icon-height" onclick="DeleteModal()">Ok</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="ContactModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Reason</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <input type="text" id="deleteContactReason" class="form-control" placeholder="Enter reason" autocomplete="off" />
                <input type="hidden" id="txtContactPersonCode" class="form-control" placeholder="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success icon-height" onclick="DeleteContactPersonModal()">Ok</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseModalContactPerson()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="ProductModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Reason</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <input type="text" id="deleteProductReason" class="form-control" placeholder="Enter reason" autocomplete="off" />
                <input type="hidden" id="txtProductCode" class="form-control" placeholder="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success icon-height" onclick="DeleteProductModal()">Ok</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseModalProduct()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="VerifyModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Verify/Reject</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="col-md-12">
                    <label for="txtVerifyReason" class="form-label">Reason </label>
                    <input type="text" id="txtVerifyReason" class="form-control" placeholder="Please enter reason.." autocomplete="off" />
                    <input type="hidden" id="txtEnquiryCode" class="form-control" placeholder="" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success icon-height" onclick="Verify()">Verify</button>
                <button type="button" class="btn btn-danger icon-height" onclick="Reject()">Reject</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseVerifyModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="AssignModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Re-Assign</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="col-md-12">
                    <label for="ddlAssignTo" class="form-label">Assign To </label>
                    <select id="ddlAssignTo" class="form-control form-control-sm box_border">
                    </select>
                    <input type="hidden" id="txtEnquiryAssignCode" class="form-control" placeholder="" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary icon-height" onclick="Assign()">Assign</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseAssignModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="FollowUpModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Reason</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="col-md-12">
                    <label for="txtFollowUpReason" class="form-label">Reason </label>
                    <input type="text" id="txtFollowUpReason" class="form-control" placeholder="Please enter reason.." autocomplete="off" />
                    <input type="hidden" id="txtFollowUpMasterCode" class="form-control" placeholder="" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary icon-height" onclick="DeleteFollowModal()">Delete</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseFollowUpModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="ContactPersonModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-lg">
            <div class="modal-header">
                <h5 class="modal-title">New Contact Person</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="row">
                        <div class="col-md-6">
                            <label for="txtModalName" class="form-label">Name <span class="text-danger">*</span></label>
                            <input type="text" id="txtModalName" name="txtModalName" class="form-control form-control-sm box_border" placeholder="" autocomplete="off" maxlength="50">
                        </div>
                        <div class="col-md-6">
                            <label for="ddlModalDepartment" class="form-label">Department <span class="text-danger">*</span></label>
                            <select id="ddlModalDepartment" class="form-control form-control-sm box_border">
                                <option>Select</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="ddlModalDesignation" class="form-label">Designation <span class="text-danger">*</span></label>
                            <select id="ddlModalDesignation" class="form-control form-control-sm box_border">
                                <option>Select</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="txtModalEmailId" class="form-label">Email Id <span class="text-danger">*</span></label>
                            <input type="text" id="txtModalEmailId" name="txtModalEmailId" class="form-control form-control-sm box_border" autocomplete="off" maxlength="100">
                        </div>
                        <div class="col-md-6">
                            <label for="txtModalPersonContactNo" class="form-label">Contact No <span class="text-danger">*</span></label>
                            <input type="text" id="txtModalPersonContactNo" name="txtModalPersonContactNo" class="form-control form-control-sm box_border Phone" autocomplete="off" maxlength="10">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary icon-height" onclick="SaveModalContactPersonDetails()">Save</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseContactPersonModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>