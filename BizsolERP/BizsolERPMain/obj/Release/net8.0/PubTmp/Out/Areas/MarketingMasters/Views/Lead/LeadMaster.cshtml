                    <label for="ddlFollowUpModeFollowUp" class="form-label">Follow Up Mode <span class="text-danger">*</span></label>
                    <select id="ddlFollowUpModeFollowUp" class="form-control form-control-sm box_border">
                    </select>
                </div>
                <div class="col-md-4" style="margin-top:28px;">
                    <input type="checkbox" checked id="chkFollowUpRequired" name="chkFollowUpRequired" autocomplete="off">
                    <label for="chkFollowUpRequired" class="form-label">Next Follow-up Required</label>
                </div>
                <div class="col-md-4" id="dvNextFollowUpDateFollowUp" style="display:block">
                    <label for="txtNextFollowUpDateFollowUp" class="form-label">Next Follow Up Date <span class="text-danger">*</span></label>
                    <input type="date" id="txtNextFollowUpDateFollowUp" name="txtNextFollowUpDateFollowUp" class="form-control form-control-sm box_border Phone" autocomplete="off" maxlength="100">
                </div>
                <div class="col-md-4" id="dvNextFollowUpModeFollowUp" style="display:block">
                    <label for="ddlNextFollowUpModeFollowUp" class="form-label">Next Follow Up Mode <span class="text-danger">*</span></label>
                    <select id="ddlNextFollowUpModeFollowUp" class="form-control form-control-sm box_border">
                    </select>
                </div>
                <div class="col-md-4" style="margin-top: 26px;">
                    <button type="button" id="btnFollowUpSave" class="btn btn-success icon-height" onclick="SaveEnquiryFollowUp()">Save</button>
                </div>
            </div>
