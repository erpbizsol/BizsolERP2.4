                    <label for="txtCustomerRemarks" class="form-label">Customer Remarks<span class="text-danger">*</span></label>
                    <textarea id="txtCustomerRemarks" name="txtCustomerRemarks" class="form-control form-control-sm box_border" placeholder="" autocomplete="off" maxlength="500"></textarea>
                </div>
