@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Finance.Reports/css/DepreciationChart.css?v=dep-chart-v22" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>

<div class="dc-page" id="depreciationChartPage">
    <div class="dc-list-top-panel">
        <div class="po-list-header">
            <div class="po-header-top">
                <div>
                    <h5><i class="fa fa-chart-line me-2" aria-hidden="true"></i>Depreciation chart</h5>
                    <small>View asset groups, types and gross block in expandable grid</small>
                </div>
            </div>
        </div>

        <div class="po-filter-bar dc-filter-bar">
            <div class="dc-filter-row">
                <div class="dc-field">
                    <label class="dc-filter-lbl" for="txtDcFromDate">From date</label>
                    <input type="date" id="txtDcFromDate" class="dc-date-input" />
                </div>
                <div class="dc-field">
                    <label class="dc-filter-lbl" for="txtDcToDate">To date</label>
                    <input type="date" id="txtDcToDate" class="dc-date-input" />
                </div>
                <div class="dc-field dc-field--btn">
                    <button type="button" id="btnDcShow" class="dc-btn dc-btn--primary"><i class="fas fa-search" aria-hidden="true"></i> Show</button>
                </div>
                <div class="dc-field dc-field--search">
                    <label class="dc-filter-lbl" for="txtDcSearch">Search</label>
                    <div class="dc-search">
                        <span class="dc-search-icon" aria-hidden="true"><i class="fas fa-search"></i></span>
                        <input type="text" id="txtDcSearch" class="dc-search-input" placeholder="Group, type, ref no, tag no..." autocomplete="off" />
                        <button type="button" id="btnDcSearchClear" class="dc-search-clear" title="Clear search" aria-label="Clear search" hidden>
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <div class="dc-filter-actions">
                    <button type="button" id="btnDcExpandAll" class="dc-btn dc-btn--outline"><i class="fas fa-square-plus" aria-hidden="true"></i> Expand all</button>
                    <button type="button" id="btnDcCollapseAll" class="dc-btn dc-btn--outline"><i class="fas fa-square-minus" aria-hidden="true"></i> Collapse all</button>
                </div>
            </div>
        </div>
    </div>

    <div class="dc-grid-wrap">
        <div class="dc-table-wrap">
            <table class="dc-table" id="tblDepreciationChart">
                <thead></thead>
                <tbody id="tblDepreciationChartBody">
                    <tr class="dc-state-row"><td><i class="fas fa-spinner fa-spin"></i> Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script type="module" src="~/_content/Bizsol.WebERP.UI.Finance.Reports/Script/DepreciationChart.js?v=dep-chart-v19"></script>
