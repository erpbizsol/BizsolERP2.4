@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.Shared/components/DateRangeControl/DateRangeControl.css" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.Shared/components/FilterSidePanelControl/FilterSidePanelControl.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

<style>
    body {
        -webkit-tap-highlight-color: transparent;
    }

    .loader-wrapper, #loader {
        z-index: 9998 !important;
    }

    body.zooming #loader {
        visibility: hidden !important;
        display: none !important;
    }

    .modal-backdrop {
        z-index: 9997 !important;
    }

    /* ── Ledger page shell ── */
    .ledger-page {
        padding-bottom: 1rem;
    }

    /* Date / status banner */
    .ledger-status-banner {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 10px;
        padding: 0.6rem 4.85rem 0.6rem 0.85rem;
        color: #fff;
        box-shadow: 0 4px 14px rgba(102, 126, 234, 0.25);
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        position: relative;
    }

    .ledger-banner__main {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        min-width: 0;
    }

    .ledger-banner__controls {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .ledger-banner__display {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        flex-wrap: wrap;
        padding-left: 0.55rem;
        border-left: 1px solid rgba(255, 255, 255, 0.35);
    }

    .ledger-status-banner__icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.95rem;
    }

    .ledger-status-banner__text {
        flex: 0 1 auto;
        min-width: 0;
    }

    .ledger-status-banner__party {
        font-size: 0.92rem;
        font-weight: 700;
        margin: 0;
        line-height: 1.25;
    }

    .ledger-status-banner__party.is-hidden {
        display: none;
    }

    .ledger-status-banner__range {
        font-size: 0.78rem;
        font-weight: 500;
        margin: 0.1rem 0 0;
        line-height: 1.25;
        opacity: 0.92;
    }

    .ledger-status-banner.is-loaded {
        background: linear-gradient(135deg, #0f766e 0%, #059669 100%);
        box-shadow: 0 4px 14px rgba(5, 150, 105, 0.22);
    }

    /* Main card */
    .ledger-card {
        background: #fff;
        border: 1px solid #e8ecf1;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .ledger-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
        padding: 0;
        background: transparent;
        border: none;
    }

    .ledger-banner__controls .ledger-btn--preview,
    .ledger-banner__controls .ledger-btn--excel {
        white-space: nowrap;
        flex-shrink: 0;
        background: #fff;
        color: #5b46c9;
        border: none;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.14);
        padding: 0.42rem 0.9rem;
        font-size: 0.78rem;
        min-width: 92px;
        justify-content: center;
    }

    .ledger-banner__controls .ledger-btn--preview:hover,
    .ledger-banner__controls .ledger-btn--excel:hover {
        background: #f8fafc;
        color: #4338ca;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.18);
    }

    .ledger-status-banner.is-loaded .ledger-banner__controls .ledger-btn--preview,
    .ledger-status-banner.is-loaded .ledger-banner__controls .ledger-btn--excel {
        color: #0f766e;
    }

    .ledger-banner__display .ledger-toolbar__label {
        color: rgba(255, 255, 255, 0.88);
        margin-right: 0.1rem;
    }

    .ledger-banner__display .ledger-toggle-chip {
        background: rgba(255, 255, 255, 0.14);
        border-color: rgba(255, 255, 255, 0.32);
        color: #fff;
        padding: 0.2rem 0.48rem;
        font-size: 0.72rem;
        gap: 0.3rem;
    }

    .ledger-banner__display .ledger-toggle-chip:hover {
        border-color: rgba(255, 255, 255, 0.5);
        background: rgba(255, 255, 255, 0.22);
    }

    .ledger-banner__display .ledger-toggle-chip:has(input:checked) {
        border-color: #fff;
        background: rgba(255, 255, 255, 0.28);
        color: #fff;
        box-shadow: none;
    }

    .ledger-toolbar__section {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
    }

    .ledger-toolbar__label {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        margin-right: 0.15rem;
    }

    .ledger-toggle-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.35rem 0.65rem;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 500;
        color: #334155;
        cursor: pointer;
        transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
        user-select: none;
        margin: 0;
    }

    .ledger-toggle-chip:hover {
        border-color: #cbd5e1;
        background: #f1f5f9;
    }

    .ledger-toggle-chip:has(input:checked) {
        border-color: #667eea;
        background: #eef2ff;
        color: #4338ca;
        box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.12);
    }

    .ledger-toggle-chip input {
        cursor: pointer;
        margin: 0;
    }

    .ledger-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
    }

    .ledger-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.32rem 0.7rem;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        border-radius: 7px;
        border: 1px solid transparent;
        transition: transform 0.12s, box-shadow 0.12s;
    }

    .ledger-btn:active {
        transform: translateY(1px);
    }

    .ledger-btn--preview {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        box-shadow: 0 2px 8px rgba(102, 126, 234, 0.35);
    }

    .ledger-btn--preview:hover {
        color: #fff;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.45);
    }

    /* Table area */
    .ledger-table-wrap {
        position: relative;
        min-height: 320px;
    }

    .ledger-table-wrap .table-wrapper {
        margin: 0;
    }

    .ledger-table-wrap .table-wrapper .table {
        margin-bottom: 0;
    }

    /* Empty state */
    .ledger-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 3rem 1.5rem;
        min-height: 280px;
        color: #64748b;
    }

    .ledger-empty-state__icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: linear-gradient(135deg, #eef2ff 0%, #f3e8ff 100%);
        color: #667eea;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        margin-bottom: 1rem;
    }

    .ledger-empty-state__title {
        font-size: 1.05rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 0.35rem;
    }

    .ledger-empty-state__desc {
        font-size: 0.88rem;
        max-width: 360px;
        line-height: 1.5;
        margin-bottom: 1rem;
    }

    .ledger-empty-state__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: #667eea;
        background: #eef2ff;
        border: 1px dashed #a5b4fc;
        border-radius: 8px;
        padding: 0.5rem 1rem;
    }

    .ledger-empty-state.is-hidden {
        display: none;
    }

    .ledger-grid-area.is-hidden {
        display: none;
    }

    /* Grid action links */
    .ledger-action-link {
        color: #4f46e5;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.82rem;
        white-space: nowrap;
    }

    .ledger-action-link:hover {
        color: #3730a3;
        text-decoration: underline;
    }

    .ledger-action-link--attached {
        display: inline-block;
        background: #dcfce7;
        color: #166534;
        padding: 2px 8px;
        border-radius: 4px;
        border: 1px solid #86efac;
    }

    .ledger-preview-modal {
        position: fixed;
        inset: 0;
        z-index: 200000 !important;
        display: flex;
        align-items: stretch;
        justify-content: center;
        padding: 0;
        margin: 0;
    }

    .ledger-preview-modal.is-hidden {
        display: none !important;
    }

    .ledger-preview-modal__backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.65);
        z-index: 0;
    }

    .ledger-preview-modal__panel {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
        background: #e5e7eb;
        border-radius: 0;
        box-shadow: none;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .ledger-preview-modal__toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid #e2e8f0;
        background: #fff;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
        flex-shrink: 0;
        position: relative;
        z-index: 2;
    }

    .ledger-preview-modal__title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
    }

    .ledger-preview-modal__actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .ledger-preview-modal__toolbar .ledger-btn {
        background: #fff;
        border: 1px solid #cbd5e1;
        color: #334155;
        min-width: 96px;
        justify-content: center;
    }

    .ledger-preview-modal__toolbar .ledger-btn--primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: transparent;
        color: #fff;
    }

    #ledgerPreviewFrame {
        flex: 1;
        width: 100%;
        min-height: 0;
        border: 0;
        background: #e5e7eb;
        overflow: auto;
        -webkit-overflow-scrolling: touch;
    }

    body.ledger-preview-open {
        overflow: hidden !important;
    }

    @@media (max-width: 768px) {
        .ledger-preview-modal__toolbar {
            flex-wrap: wrap;
            padding: 0.5rem 0.65rem;
            gap: 0.5rem;
        }

        .ledger-preview-modal__title {
            font-size: 0.88rem;
            flex: 1 1 auto;
            min-width: 0;
        }

        .ledger-preview-modal__actions {
            flex: 1 1 100%;
            justify-content: flex-end;
        }

        .ledger-preview-modal__toolbar .ledger-btn {
            min-width: 0;
            padding: 0.35rem 0.55rem;
            font-size: 0.78rem;
        }

        .ledger-status-banner {
            grid-template-columns: 1fr;
            padding-right: 4.85rem;
        }

        .ledger-banner__controls {
            justify-content: flex-start;
            width: 100%;
        }

        .ledger-banner__display {
            border-left: none;
            padding-left: 0;
            padding-top: 0.35rem;
            border-top: 1px solid rgba(255, 255, 255, 0.28);
            width: 100%;
        }

        .tab-content {
            padding-bottom: 80px !important;
        }
    }

    @@media (max-width: 576px) {
        .tab-content {
            padding-bottom: 70px !important;
        }

        .ledger-status-banner {
            text-align: left;
        }

        .ledger-banner__main {
            justify-content: flex-start;
        }

        .ledger-toggle-chip {
            font-size: 0.78rem;
        }
    }
</style>

<filter-side-panel-control id="filterPanel"></filter-side-panel-control>

<div class="ledger-page">
    <!-- Status banner + display toolbar -->
    <div class="ledger-status-banner" id="ledgerStatusBanner">
        <div class="ledger-banner__main">
            <div class="ledger-status-banner__icon">
                <i class="fas fa-book-open"></i>
            </div>
            <div class="ledger-status-banner__text">
                <p class="ledger-status-banner__party is-hidden" id="ledger-party-name"></p>
                <p class="ledger-status-banner__range" id="report-date-range">Please select an account to view ledger</p>
            </div>
        </div>
        <div class="ledger-banner__controls">
            <button type="button" class="ledger-btn ledger-btn--preview" id="btnLedgerPreview" title="Preview Ledger Report">
                <i class="fa fa-eye"></i> Preview
            </button>
            <button type="button" class="ledger-btn ledger-btn--excel" id="btnLedgerExportExcel" title="Download grid to Excel">
                <i class="fa fa-file-excel"></i> Excel
            </button>
            <div class="ledger-banner__display">
                <span class="ledger-toolbar__label">Display</span>
                <label class="ledger-toggle-chip" for="showNarration">
                    <input class="form-check-input ledger-col-toggle" type="checkbox" id="showNarration" />
                    Narration
                </label>
                <label class="ledger-toggle-chip" for="showEntryNo">
                    <input class="form-check-input ledger-col-toggle" type="checkbox" id="showEntryNo" />
                    Entry No
                </label>
                <label class="ledger-toggle-chip" for="showVoucherNo">
                    <input class="form-check-input ledger-col-toggle" type="checkbox" id="showVoucherNo" />
                    VoucherNo
                </label>
                <label class="ledger-toggle-chip" for="showBillNo">
                    <input class="form-check-input ledger-col-toggle" type="checkbox" id="showBillNo" />
                    Bill No
                </label>
            </div>
        </div>
    </div>

    <!-- Main card -->
    <div class="ledger-card">
        <!-- Table / empty state -->
        <div class="ledger-table-wrap">
            <div class="ledger-empty-state" id="ledgerEmptyState">
                <div class="ledger-empty-state__icon">
                    <i class="fas fa-table"></i>
                </div>
                <div class="ledger-empty-state__title">No ledger data yet</div>
                <p class="ledger-empty-state__desc">
                    Select an account and a date range from the filter panel, then click
                    <strong>Apply Filters &amp; Show</strong> to load transactions here.
                </p>
                <span class="ledger-empty-state__cta">
                    <i class="fas fa-sliders"></i> Open filters to get started
                </span>
            </div>

            <div class="ledger-grid-area is-hidden" id="ledgerGridArea">
                <div class="table-wrapper">
                    <table id="tblLedgerData" class="table fixed-width-table">
                        <thead id="tblLedgerDataHeader"></thead>
                        <tbody id="tblLedgerDataBody"></tbody>
                        <tfoot></tfoot>
                    </table>
                    <div class="paginator" id="paginator-tblLedgerData"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="DivLedgerAttachmentControlmodal"></div>

<div id="ledgerPreviewModal" class="ledger-preview-modal is-hidden" aria-hidden="true">
    <div class="ledger-preview-modal__backdrop" id="ledgerPreviewBackdrop"></div>
    <div class="ledger-preview-modal__panel">
        <div class="ledger-preview-modal__toolbar">
            <p class="ledger-preview-modal__title">Ledger Preview</p>
            <div class="ledger-preview-modal__actions">
                <button type="button" class="ledger-btn ledger-btn--primary" id="btnLedgerPreviewDownload">
                    <i class="fa fa-download"></i> Download
                </button>
                <button type="button" class="ledger-btn" id="btnLedgerPreviewPrint">
                    <i class="fa fa-print"></i> Print
                </button>
                <button type="button" class="ledger-btn" id="btnLedgerPreviewClose">
                    <i class="fa fa-times"></i> Close
                </button>
            </div>
        </div>
        <iframe id="ledgerPreviewFrame" title="Ledger Preview"></iframe>
    </div>
</div>

<script type="module" src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Shared/components/DateRangeControl/DateRangeControl.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Finance.Reports/Script/LedgerNew.js"></script>
