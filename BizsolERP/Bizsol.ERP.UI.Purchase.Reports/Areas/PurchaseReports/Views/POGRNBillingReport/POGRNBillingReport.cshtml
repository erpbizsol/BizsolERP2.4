@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.CRM.Transactions/css/ExpenseEntry.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Purchase.Reports/Script/POGRNBillingReport.js"></script>
<style>
    .pmr-page .pmr-filter-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr)) auto;
        gap: 0.75rem 2rem;
        align-items: end;
    }
    .pmr-page .pmr-filter-field {
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }
    .pmr-page .pmr-filter-field .form-label {
        font-size: 0.77rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 0.35rem;
    }
    .pmr-page .pmr-filter-field select.form-control.form-control-sm {
        height: 38px !important;
        min-height: 38px !important;
        border: 1.5px solid #cbd5e1 !important;
        border-radius: 10px !important;
        font-size: 13px !important;
    }
    .pmr-page .pmr-filter-field .select2-container--default .select2-selection--single {
        height: 38px !important;
        min-height: 38px !important;
        border: 1.5px solid #cbd5e1 !important;
        border-radius: 10px !important;
    }
    .pmr-page .pmr-filter-field .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 34px !important;
        font-size: 13px;
    }
    .pmr-page .pmr-filter-actions .pmr-btn-show {
        height: 38px;
        border: none !important;
        color: #fff !important;
        background: linear-gradient(135deg, #667eea, #764ba2) !important;
        border-radius: 999px;
        font-weight: 700;
        padding: 0 1.2rem;
    }
    #tblPOGRNBilling {
        table-layout: auto;
        width: 100%;
        min-width: 1680px;
    }
    #tblPOGRNBilling thead th {
        white-space: nowrap;
        word-break: keep-all;
        overflow-wrap: normal;
        line-height: 1.2;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.4rem 0.45rem;
        vertical-align: middle;
        text-align: center;
    }
    #tblPOGRNBilling td.num, #tblPOGRNBilling th.num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }
    #tblPOGRNBilling td.num {
        white-space: nowrap;
        font-size: 0.74rem;
        padding: 0.3rem 0.25rem;
    }
    #tblPOGRNBilling td.label-cell,
    #tblPOGRNBilling th.pmr-th-dim {
        text-align: left;
        min-width: 10rem;
        font-weight: 600;
    }
    #tblPOGRNBilling tr.pogr-row-total td {
        font-weight: 700;
        background: rgba(102, 126, 234, 0.12) !important;
        color: #4338ca !important;
    }
    #tblPOGRNBilling tr.pmr-tree-parent {
        cursor: pointer;
        background: #f8fafc;
        font-weight: 600;
    }
    #tblPOGRNBilling tr.pmr-tree-parent:hover {
        background: #eef2ff;
    }
    .pmr-tree-toggle {
        width: 14px;
        color: #4338ca;
    }
    .pmr-page .expense-entry-table-wrapper #tblPOGRNBilling > thead {
        position: sticky;
        top: 0;
        z-index: 5;
    }
    .pmr-page .expense-entry-table-wrapper #tblPOGRNBilling > thead th {
        color: #fff !important;
    }
    .pmr-page .expense-entry-table-wrapper #tblPOGRNBilling > thead th.pmr-th-dim {
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
    }
    .pmr-page .expense-entry-table-wrapper #tblPOGRNBilling > thead th.col-po-group,
    .pmr-page .expense-entry-table-wrapper #tblPOGRNBilling > thead th.col-po,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table thead th.col-po-group,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table thead th.col-po {
        background: #2563eb !important;
        background-color: #2563eb !important;
    }
    .pmr-page .expense-entry-table-wrapper #tblPOGRNBilling > thead th.col-grn-group,
    .pmr-page .expense-entry-table-wrapper #tblPOGRNBilling > thead th.col-grn,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table thead th.col-grn-group,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table thead th.col-grn {
        background: #0d9488 !important;
        background-color: #0d9488 !important;
    }
    #tblPOGRNBilling td.col-po,
    .pmr-nested-table td.col-po {
        background: #eff6ff;
    }
    #tblPOGRNBilling td.col-grn,
    .pmr-nested-table td.col-grn {
        background: #f0fdfa;
    }
    #tblPOGRNBilling tr.pogr-row-total td.col-po,
    .pmr-nested-table tr.pogr-row-total td.col-po {
        background: #dbeafe !important;
        color: #1e40af !important;
    }
    #tblPOGRNBilling tr.pogr-row-total td.col-grn,
    .pmr-nested-table tr.pogr-row-total td.col-grn {
        background: #ccfbf1 !important;
        color: #115e59 !important;
    }
    .pmr-nested-table {
        width: 100%;
        min-width: 1600px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        margin: 0;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table thead th {
        color: #fff !important;
        font-size: 0.66rem !important;
        font-weight: 700 !important;
        padding: 0.35rem 0.25rem !important;
        text-align: center;
        border: none !important;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table thead th.pmr-th-dim {
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
    }
    .pogr-nested-wrap {
        margin: 0.25rem 0 0.35rem 1rem;
        border-left: 3px solid rgba(102, 126, 234, 0.35);
        padding-left: 0.5rem;
        overflow-x: auto;
    }
    #tblPOGRNBilling .col-qty.hidden-col,
    #tblPOGRNBilling .col-val.hidden-col {
        display: none;
    }
    .pmr-page .ee-list-header .pmr-header-toolbar {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }
    .pmr-page .ee-list-header .pmr-header-icon-btn {
        width: 46px;
        height: auto !important;
        min-width: 46px;
        min-height: 46px !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        border: 2px solid rgba(255, 255, 255, 0.92);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
        cursor: pointer;
        font-size: 1rem !important;
    }
    .pmr-page .ee-list-header .pmr-header-icon-btn--excel i { color: #0f7c3a !important; }
    .pmr-page .ee-list-header .pmr-header-icon-btn--close i { color: #c2410c !important; }

    .pogr-drill-crumb {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        padding: 0.7rem 0.9rem;
        margin: 0 0 0.55rem;
        background: linear-gradient(135deg, #eef2ff, #e0e7ff);
        border: 1px solid #c7d2fe;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(67, 56, 202, 0.08);
    }
    .pogr-drill-crumb-top {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.65rem 0.85rem;
    }
    .pogr-drill-crumb #btnDrillBack {
        height: 36px !important;
        min-height: 36px !important;
        min-width: 92px;
        padding: 0 14px !important;
        border: none !important;
        border-radius: 999px !important;
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
        color: #fff !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        line-height: 1 !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        gap: 6px;
        box-shadow: 0 3px 10px rgba(79, 70, 229, 0.28);
        cursor: pointer;
    }
    .pogr-drill-crumb #btnDrillBack:hover {
        background: linear-gradient(135deg, #4338ca, #5b4fd4) !important;
        color: #fff !important;
    }
    .pogr-drill-current-title {
        font-size: 0.95rem;
        font-weight: 800;
        color: #312e81;
    }
    .pogr-selected-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }
    .pogr-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.28rem 0.7rem;
        border-radius: 999px;
        background: #fff;
        border: 1px solid #c7d2fe;
        font-size: 0.78rem;
        color: #1e293b;
        max-width: 100%;
    }
    .pogr-chip .lbl {
        color: #64748b;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.65rem;
        letter-spacing: 0.03em;
    }
    .pogr-chip .val {
        font-weight: 800;
        color: #312e81;
        word-break: break-word;
    }
    .pogr-drill-path {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.35rem 0.4rem;
        font-size: 0.82rem;
    }
    .pogr-drill-crumb .pogr-crumb-link {
        border: 1px solid #c7d2fe;
        background: #fff;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        color: #4338ca;
        font-weight: 700;
        cursor: pointer;
        height: auto !important;
        min-height: 28px !important;
        font-size: 12px !important;
    }
    .pogr-drill-crumb .pogr-crumb-link:hover {
        background: #e0e7ff;
        color: #312e81;
    }
    .pogr-drill-crumb .pogr-crumb-current {
        background: #4f46e5;
        color: #fff;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        font-weight: 800;
        font-size: 12px;
    }
    .pogr-drill-crumb .pogr-crumb-sep {
        color: #6366f1;
        font-weight: 800;
        padding: 0 0.1rem;
    }
    #tblPOGRNBilling a.pogr-drill-link {
        color: #4338ca;
        font-weight: 600;
        text-decoration: underline;
        cursor: pointer;
    }
    #tblPOGRNBilling a.pogr-drill-link:hover { color: #312e81; }

    @@media (max-width: 991px) {
        .pmr-page .pmr-filter-row { grid-template-columns: 1fr; }
        .pmr-page .pmr-filter-actions .pmr-btn-show { width: 100%; }
    }
</style>

<div class="ee-page pmr-page">
    <div class="ee-list-header section-entry-animation">
        <div class="ee-list-header-top">
            <div class="ee-list-header-title-block">
                <h2 class="ee-list-header-title"><i class="fa fa-chart-bar me-2" aria-hidden="true"></i><span id="pogrPageTitleText">PO GRN Billing Report</span></h2>
                <small class="ee-list-header-sub">Click a project to open SubProjectWise. Click a sub project to open PO / GRN detail. Use the breadcrumb to go back.</small>
            </div>
            <div class="ee-list-header-actions no-print pmr-header-toolbar">
                <button type="button" id="btnDownload" class="pmr-header-icon-btn pmr-header-icon-btn--excel" title="Export to Excel" aria-label="Export to Excel">
                    <i class="fas fa-file-excel" aria-hidden="true"></i>
                </button>
                <button type="button" id="btnClose" class="pmr-header-icon-btn pmr-header-icon-btn--close" title="Clear report" aria-label="Clear report">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="ee-list-filter-bar no-print">
        <div class="pmr-filter-row">
            <div class="pmr-filter-field">
                <label for="ddlStatus" class="form-label">Status <span class="text-danger">*</span></label>
                <select id="ddlStatus" class="form-control form-control-sm box_border w-100">
                    <option value="Pending">Pending</option>
                    <option value="Closed">Closed</option>
                </select>
            </div>
            <div class="pmr-filter-field" id="pogrQtyValueField" style="display:none">
                <label for="ddlQtyValue" class="form-label">QTY / Value</label>
                <select id="ddlQtyValue" class="form-control form-control-sm box_border w-100">
                    <option value="both" selected>Both</option>
                    <option value="qty">Qty only</option>
                    <option value="value">Value only</option>
                </select>
            </div>
            <div class="pmr-filter-actions">
                <button type="button" id="btnShow" class="btn btn-sm pmr-btn-show">
                    <i class="fas fa-search me-1" aria-hidden="true"></i>Show
                </button>
            </div>
        </div>
    </div>

    <div id="pogrDrillBreadcrumb" class="pogr-drill-crumb no-print" style="display:none" aria-live="polite">
        <div class="pogr-drill-crumb-top">
            <button type="button" id="btnDrillBack" title="Back to previous report">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> Back
            </button>
            <span class="pogr-drill-current-title" id="pogrDrillTitle"></span>
        </div>
        <div class="pogr-selected-chips" id="pogrSelectedChips"></div>
        <div class="pogr-drill-path" id="pogrDrillPath"></div>
    </div>

    <div class="expense-entry-card expense-entry-card-table ee-list-grid-wrap">
        <div class="expense-entry-table-wrapper pmr-table-wrap">
            <table id="tblPOGRNBilling" class="table table-sm mb-0">
                <thead id="pogrTableHead"></thead>
                <tbody id="pogrTableBody"></tbody>
            </table>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
