@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Finance.Masters/js/PayTypeMaster.js"></script>

<style>
    #modern-content.modern-content:has(#PayTypeMasterPage) { overflow: hidden !important; }
    .modern-content > main:has(#PayTypeMasterPage) {
        height: 100%; min-height: 0; display: flex; flex-direction: column; overflow: hidden; box-sizing: border-box;
    }
    #PayTypeMasterPage.pt-page {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        flex: 1; display: flex; flex-direction: column; min-height: 0; width: 100%; padding: 2px 8px 8px; box-sizing: border-box;
    }
    #PayTypeMasterPage #dvPtList { flex: 1; display: flex; flex-direction: column; min-height: 0; }
    #PayTypeMasterPage #dvPtList.pt-list-hidden { display: none; }
    #PayTypeMasterPage #dvPtEntry { display: none; flex: 1; flex-direction: column; min-height: 0; }
    #PayTypeMasterPage #dvPtEntry.pt-entry-visible { display: flex; }
    #PayTypeMasterPage .pt-list-grid-wrap .table-wrapper,
    #PayTypeMasterPage .pt-list-grid-wrap .pm-table-wrap.table-wrapper { margin: 0; box-shadow: none; min-height: 0 !important; }
    #PayTypeMasterPage .pt-list-grid-wrap .table-wrapper.filtered { min-height: 0 !important; }
    #PayTypeMasterPage .pt-list-header {
        background: var(--primary-gradient, linear-gradient(135deg, #667eea 0%, #764ba2 100%));
        border-radius: 10px 10px 0 0; padding: 8px 14px; flex-shrink: 0;
    }
    #PayTypeMasterPage .pt-list-header-inner {
        display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    }
    #PayTypeMasterPage .pt-list-title-wrap { display: flex; align-items: center; gap: 12px; min-width: 0; }
    #PayTypeMasterPage .pt-list-icon {
        width: 36px; height: 36px; border-radius: 10px; background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.35); color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    #PayTypeMasterPage .pt-list-title { margin: 0; font-size: 0.95rem; font-weight: 800; color: #fff; line-height: 1.15; }
    #PayTypeMasterPage .pt-list-sub { font-size: 0.72rem; color: rgba(255, 255, 255, 0.78); margin-top: 2px; }
    #PayTypeMasterPage .pt-btn-new {
        display: inline-flex; align-items: center; gap: 5px; min-height: 30px; padding: 5px 12px; border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.6); background: #fff; color: var(--accent-primary, #667eea);
        font-size: 0.8rem; font-weight: 800; cursor: pointer; white-space: nowrap;
    }
    #PayTypeMasterPage .pt-list-grid-wrap,
    #PayTypeMasterPage .pt-entry-card {
        flex: 1; display: flex; flex-direction: column; min-height: 0; background: #fff; border: 1px solid #e2e8f0;
        border-radius: 0 0 14px 14px; box-shadow: 0 2px 12px rgba(102, 126, 234, 0.07); overflow: hidden;
    }
    #PayTypeMasterPage .pt-entry-card { border-radius: 14px; border-top: 1px solid #e2e8f0; }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-card-toolbar {
        flex-shrink: 0;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 8px 14px;
        border-bottom: 1px solid var(--border-light);
    }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-search-wrap {
        position: relative;
        flex: 1;
        min-width: 200px;
        max-width: 340px;
    }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-search-wrap i {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 13px;
        pointer-events: none;
    }
    #PayTypeMasterPage #ptSearch {
        width: 100%;
        padding: 6px 12px 6px 36px;
        border-radius: 8px;
        border: 1.5px solid var(--border-color);
        font-size: 13.5px;
        outline: none;
        background: var(--light-bg);
        color: var(--text-dark);
        box-sizing: border-box;
    }
    #PayTypeMasterPage .pt-entry-card .pt-toolbar {
        flex-shrink: 0; padding: 6px 12px; border-bottom: 1px solid #eef0f8; background: #fafbff;
    }
    #PayTypeMasterPage .pt-field label { margin: 0 0 4px; font-size: 12.5px; font-weight: 700; color: #2c3852; }
    #PayTypeMasterPage .pt-field input[type="text"],
    #PayTypeMasterPage .pt-field select {
        width: 100%; height: 30px; padding: 0 8px; border: 1px solid #d4d9e3; border-radius: 6px; font-size: 12.5px; box-sizing: border-box;
        background: #fff; color: #1e293b;
    }
    #PayTypeMasterPage .pt-field input[type="text"]:focus,
    #PayTypeMasterPage .pt-field select:focus {
        border-color: #667eea; outline: none; box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.15);
    }
    #PayTypeMasterPage .pt-check-row { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; min-height: 30px; }
    #PayTypeMasterPage .pt-check {
        display: inline-flex; align-items: center; gap: 6px; margin: 0; font-size: 12.5px; font-weight: 600; color: #2c3852; cursor: pointer;
    }
    #PayTypeMasterPage .pt-check input[type="checkbox"] {
        width: 15px; height: 15px; margin: 0; cursor: pointer; accent-color: #667eea; flex-shrink: 0;
    }
    #PayTypeMasterPage .pt-check input[type="checkbox"]:disabled { cursor: not-allowed; opacity: 0.55; }
    #PayTypeMasterPage .pt-form-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
    #PayTypeMasterPage .pt-btn {
        height: 30px; padding: 0 12px; border-radius: 6px; border: none; font-size: 12.5px; font-weight: 700; cursor: pointer;
        display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
    }
    #PayTypeMasterPage .pt-btn-save { background: linear-gradient(135deg, #059669, #10b981); color: #fff; }
    #PayTypeMasterPage .pt-btn-save:focus { outline: none; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.45); }
    #PayTypeMasterPage .pt-btn-clear { background: #fff; color: #475569; border: 1px solid #cbd5e1; }
    #PayTypeMasterPage .pt-btn-back,
    #PayTypeMasterPage .pt-btn-add { background: var(--primary-gradient, linear-gradient(135deg, #667eea, #764ba2)); color: #fff; }
    #PayTypeMasterPage .pt-scroll { flex: 1; min-height: 0; overflow: auto; }
    #PayTypeMasterPage .pt-map-bar {
        display: flex; align-items: center; justify-content: space-between; padding: 6px 12px; flex-shrink: 0;
        font-size: 12.5px; font-weight: 700; color: #2c3852;
    }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-table-wrap {
        flex: 1; min-height: 0; overflow-x: auto; overflow-y: auto;
    }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-table {
        width: 100%; border-collapse: collapse; font-size: 12.5px; min-width: 720px;
    }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-table thead {
        position: sticky; top: 0; z-index: 4;
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
    }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-table thead th {
        color: #fff !important; background: transparent !important; font-weight: 700;
        padding: 4px 8px; font-size: 10.5px; letter-spacing: 0.04em; text-transform: uppercase;
        border: none !important; white-space: nowrap; text-align: center !important;
    }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-table thead th > div { justify-content: center !important; }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-table tbody tr:nth-child(even) { background: #f8fafc !important; }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-table tbody tr:hover { background: rgba(102, 126, 234, 0.07) !important; }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-table tbody td {
        padding: 1px 8px; border-bottom: 1px solid #eef0f8; vertical-align: middle; line-height: 1.25;
    }
    #PayTypeMasterPage .pt-list-grid-wrap .paginator {
        flex-shrink: 0; padding: 5px 12px; border-top: 1px solid #eef2ff; background: #fafbff;
    }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-actions { display: flex; gap: 4px; justify-content: center; }
    #PayTypeMasterPage .pt-list-grid-wrap .pm-icon-btn {
        width: 22px; height: 22px; padding: 0; border-radius: 6px; border: 1px solid transparent; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center; font-size: 10px;
    }
    #PayTypeMasterPage .pm-icon-btn.view { background: rgba(6, 182, 212, 0.12); color: #0891b2; border-color: rgba(6, 182, 212, 0.25); }
    #PayTypeMasterPage .pm-icon-btn.edit { background: rgba(102, 126, 234, 0.12); color: #667eea; border-color: rgba(102, 126, 234, 0.25); }
    #PayTypeMasterPage .pm-icon-btn.del { background: rgba(239, 68, 68, 0.1); color: #dc2626; border-color: rgba(239, 68, 68, 0.25); }
    #PayTypeMasterPage .pm-icon-btn.copy { background: rgba(16, 185, 129, 0.1); color: #059669; border-color: rgba(16, 185, 129, 0.25); }
    #PayTypeMasterPage #tblPtVerification { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 12.5px; margin: 0; }
    #PayTypeMasterPage #tblPtVerification col.pt-col-level { width: 4%; }
    #PayTypeMasterPage #tblPtVerification col.pt-col-hierarchy { width: 20%; }
    #PayTypeMasterPage #tblPtVerification thead th.pt-th-level {
        text-align: center; padding-left: 4px; padding-right: 4px; white-space: nowrap;
    }
    #PayTypeMasterPage #tblPtVerification tbody td.pt-td-level {
        text-align: center; font-weight: 700; color: #475569; padding-left: 4px; padding-right: 4px;
    }
    #PayTypeMasterPage #tblPtVerification col.pt-col-users { width: 37%; }
    #PayTypeMasterPage #tblPtVerification col.pt-col-usergroups { width: 37%; }
    #PayTypeMasterPage #tblPtVerification col.pt-col-action { width: 6%; }
    #PayTypeMasterPage #tblPtVerification .pt-hierarchy {
        width: 100%; height: 28px; padding: 0 8px; border: 1px solid #d4d9e3; border-radius: 6px; font-size: 12px; box-sizing: border-box;
    }
    #PayTypeMasterPage #tblPtVerification thead th {
        position: sticky; top: 0; z-index: 2; padding: 8px 10px; text-align: left; font-size: 0.73rem; font-weight: 600;
        color: #fff; background: #4f46e5; border: 1px solid rgba(255, 255, 255, 0.22);
    }
    #PayTypeMasterPage #tblPtVerification tbody td { padding: 2px 6px; vertical-align: middle; border-bottom: 1px solid #eef0f8; background: #fff; }
    #PayTypeMasterPage #tblPtVerification tbody tr { min-height: 32px; }
    #PayTypeMasterPage #tblPtVerification .select2-container { width: 100% !important; vertical-align: middle; }
    #PayTypeMasterPage #tblPtVerification .select2-container .select2-selection--multiple {
        display: flex !important; flex-wrap: wrap; align-items: center; position: relative;
        min-height: 28px !important; max-height: 52px; overflow-x: hidden; overflow-y: auto; scrollbar-width: thin;
        padding: 1px 22px 1px 4px !important; box-sizing: border-box;
        border: 1px solid #d4d9e3; border-radius: 6px; background: #fff;
    }
    #PayTypeMasterPage #tblPtVerification .select2-container.pt-multi-empty .select2-selection--multiple {
        height: 28px !important; max-height: 28px; overflow: hidden !important; cursor: pointer;
    }
    #PayTypeMasterPage #tblPtVerification .select2-selection--multiple .select2-selection__rendered {
        display: contents !important;
    }
    #PayTypeMasterPage #tblPtVerification .select2-selection__clear { display: none !important; }
    #PayTypeMasterPage #tblPtVerification .select2-selection--multiple .select2-selection__choice {
        display: inline-flex !important; align-items: center; box-sizing: border-box;
        margin: 1px 3px 1px 0 !important; padding: 0 5px 0 3px !important; height: 20px;
        font-size: 11px; line-height: 18px; max-width: calc(100% - 4px); overflow: hidden; white-space: nowrap;
        background: #eef2ff; border: 1px solid #c7d2fe; border-radius: 4px; color: #3730a3;
    }
    #PayTypeMasterPage #tblPtVerification .select2-selection--multiple .select2-selection__choice__display {
        padding: 0 !important; line-height: 16px; overflow: hidden; text-overflow: ellipsis;
    }
    #PayTypeMasterPage #tblPtVerification .select2-selection--multiple .select2-selection__choice__remove {
        position: static !important; top: auto !important; left: auto !important; order: -1;
        display: inline-flex; align-items: center; flex-shrink: 0;
        width: auto !important; min-width: 0; height: auto !important;
        margin: 0 3px 0 0 !important; padding: 0 1px !important;
        border: none !important; border-radius: 0 !important;
        color: #6366f1; font-weight: 700; line-height: 1; cursor: pointer;
    }
    #PayTypeMasterPage #tblPtVerification .select2-selection--multiple .select2-selection__choice__remove:hover {
        color: #4338ca;
    }
    #PayTypeMasterPage #tblPtVerification .select2-selection--multiple .select2-search--inline {
        display: flex; align-items: center; flex: 1 1 40px; min-width: 40px; height: 24px; margin: 0; float: none;
    }
    #PayTypeMasterPage #tblPtVerification .select2-container:not(.pt-multi-empty):not(.select2-container--open):not(.select2-container--focus) .select2-search--inline {
        flex: 0 0 0; min-width: 0; width: 0; overflow: hidden;
    }
    #PayTypeMasterPage #tblPtVerification .select2-selection--multiple .select2-search--inline .select2-search__field {
        width: 100% !important; height: 22px !important; line-height: 22px; margin: 0 !important; padding: 0 !important;
        font-size: 12px; font-family: inherit; color: #1e293b; caret-color: #1e293b; white-space: nowrap; resize: none; overflow: hidden !important;
        background: transparent !important; border: none !important; box-shadow: none !important; outline: none;
    }
    #PayTypeMasterPage #tblPtVerification .select2-selection--multiple .select2-search__field::placeholder { color: #94a3b8; }
    #PayTypeMasterPage #tblPtVerification .select2-selection--multiple::after {
        content: ''; position: absolute; top: 12px; right: 8px;
        border: 4px solid transparent; border-top-color: #64748b; pointer-events: none;
    }
    #PayTypeMasterPage #tblPtVerification .select2-container--focus .select2-selection--multiple,
    #PayTypeMasterPage #tblPtVerification .select2-container--open .select2-selection--multiple {
        border-color: #667eea; box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.12);
    }
    #PayTypeMasterPage #tblPtVerification thead th.pt-th-action { text-align: center; }
    #PayTypeMasterPage #tblPtVerification tbody td.pt-td-action { text-align: center; }
    #PayTypeMasterPage .pt-remove-level {
        width: 26px; height: 26px; border-radius: 9px; border: 1px solid rgba(239, 68, 68, 0.25);
        background: rgba(239, 68, 68, 0.1); color: #dc2626; cursor: pointer;
    }
    body > .select2-container.select2-container--open { z-index: 20060 !important; }
    #PayTypeMasterPage.pt-readonly #btnSavePt,
    #PayTypeMasterPage.pt-readonly #btnClearPt,
    #PayTypeMasterPage.pt-readonly #btnPtAddLevel,
    #PayTypeMasterPage.pt-readonly .pt-remove-level { display: none; }
    #PayTypeMasterPage.pt-readonly #tblPtVerification .select2-selection__choice__remove,
    #PayTypeMasterPage.pt-readonly #tblPtVerification .select2-selection__clear,
    #PayTypeMasterPage.pt-readonly #tblPtVerification .select2-search--inline { display: none !important; }
    #PayTypeMasterPage.pt-readonly #tblPtVerification .select2-container--disabled .select2-selection {
        background: #f8fafc; border-color: #e2e8f0;
    }
    #PayTypeMasterPage .pt-field .select2-container { width: 100% !important; }
    #PayTypeMasterPage .pt-field .select2-container--default .select2-selection--single {
        height: 30px; border: 1px solid #d4d9e3; border-radius: 6px; font-size: 12.5px;
    }
    @@media (min-width: 576px) { #PayTypeMasterPage .pt-check-row { flex-wrap: nowrap; } }
    @@media (min-width: 992px) { #PayTypeMasterPage .pt-form-actions { flex-wrap: nowrap; } }
</style>

<div id="PayTypeMasterPage" class="pt-page">
    <div id="dvPtList">
        <header class="pt-list-header">
            <div class="pt-list-header-inner">
                <div class="pt-list-title-wrap">
                    <div class="pt-list-icon" aria-hidden="true"><i class="fas fa-money-check-alt"></i></div>
                    <div>
                        <h1 class="pt-list-title">Pay Type Master</h1>
                        <div class="pt-list-sub">Saved pay types</div>
                    </div>
                </div>
                <button type="button" id="btnCreatePaymentType" class="pt-btn-new">
                    <span class="pm-plus">+</span> New Pay Type
                </button>
            </div>
        </header>
        <div class="pt-list-grid-wrap">
            <div class="pm-card-toolbar">
                <div class="pm-search-wrap">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="text" id="ptSearch" placeholder="Search pay types..."
                           autocomplete="off" spellcheck="false" aria-label="Search pay types" />
                </div>
            </div>
            <div class="pm-table-wrap table-wrapper">
                <table class="pm-table" id="PayTypeMaster">
                    <thead id="table-header-PayTypeMaster"></thead>
                    <tbody id="table-body-PayTypeMaster"></tbody>
                </table>
            </div>
            <div class="paginator" id="paginator-PayTypeMaster"></div>
        </div>
    </div>

    <div id="dvPtEntry">
        <div class="pt-entry-card">
            <div class="pt-toolbar">
                <input type="hidden" id="hfPtCode" value="0" />
                <input type="hidden" id="hfPtIsActive" value="Y" />
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-lg-4">
                        <div class="pt-field">
                            <label for="txtPtDesp">Description</label>
                            <input type="text" id="txtPtDesp" maxlength="150" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="pt-field">
                            <label for="ddlPtAccountGroup">Account group</label>
                            <select id="ddlPtAccountGroup" required aria-required="true">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-lg-2">
                        <div class="pt-field">
                            <label>Options</label>
                            <div class="pt-check-row">
                                <label class="pt-check" for="chkPtAllowManual"><input type="checkbox" id="chkPtAllowManual" /> Manual</label>
                                <label class="pt-check" for="chkPtIsSalary"><input type="checkbox" id="chkPtIsSalary" /> Salary</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="pt-form-actions">
                            <button type="button" id="btnSavePt" class="pt-btn pt-btn-save"><i class="fas fa-save"></i> Save</button>
                            <button type="button" id="btnClearPt" class="pt-btn pt-btn-clear">Clear</button>
                            <button type="button" id="btnBackToList" class="pt-btn pt-btn-back"><i class="fas fa-arrow-left"></i> Back</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="pt-map-bar">
                <span>Approval configuration</span>
                <button type="button" id="btnPtAddLevel" class="pt-btn pt-btn-add">Add Level</button>
            </div>
            <div class="pt-scroll">
                <table id="tblPtVerification">
                    <colgroup>
                        <col class="pt-col-level" />
                        <col class="pt-col-hierarchy" />
                        <col class="pt-col-users" />
                        <col class="pt-col-usergroups" />
                        <col class="pt-col-action" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="pt-th-level">Level</th>
                            <th>Approval hierarchy</th>
                            <th>User</th>
                            <th>User group</th>
                            <th class="pt-th-action"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="dvPtDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0">Confirm</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="mb-0">Do you want to mark the pay type as inactive?</p>
                <input type="hidden" id="hfPtDeleteCode" value="0" />
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" id="btnPtConfirmDelete"><i class="fas fa-ban"></i> Mark inactive</button>
            </div>
        </div>
    </div>
</div>
