<style>
    /* Hide the spinner arrows in most modern browsers */
    input[type="number"]:not([name="txtYearPassing"])::-webkit-outer-spin-button,
    input[type="number"]:not([name="txtYearPassing"])::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Hide the spinner arrows in Firefox */
    input[type="number"]:not([name="txtYearPassing"]) {
        -moz-appearance: textfield;
    }

    .datepicker td, .datepicker th {
        border-radius: 20px !important;
    }

    .datepicker table tr td, .datepicker table tr td {
        padding: 8px 9px !important;
        height: 16px !important;
    }

    .datepicker table tfoot {
        display: none;
    }
</style>

