@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Marketing.Reports/js/TemplateReports.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Marketing.Reports/js/TemplateReportsManageTemplate.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Marketing.Reports/js/TemplateReportsTemplateUsers.js"></script>

<style>
    .btn:not(:disabled):not(.disabled) { cursor: pointer !important; }
    .form-control-sm {
        margin-bottom: 1px !important;
        padding: .25rem .4rem !important;
        font-size: 12px !important;
    }
    body:has(#OrderLoadReportPage) #modern-content.modern-content > main {
        height: 100%;
        min-height: 0;
        min-width: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

/* Keep this page inside the content pane on browser zoom — scroll inside grid, do not clip. */
body:has(#OrderLoadReportPage) #modern-content.modern-content {
    overflow-x: hidden !important;
    overflow-y: auto !important;
    min-width: 0 !important;
}


body:has(#OrderLoadReportPage) #modern-content.modern-content > main {
    height: 100%;
    max-height: 100%;
    min-height: 0;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

/* Order Load Report — Pallet Packing / ExpenseEntry list layout */

.ol-page {
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    padding: 4px 0 8px;
    height: 100%;
    max-height: 100%;
    min-height: 0;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
}

/* ── List header ─────────────────────────────────────────────────────── */
.ol-list-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 14px;
    padding: 12px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 4px 24px rgba(102, 126, 234, 0.22);
    flex-shrink: 0;
    margin-bottom: 14px;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
}

.ol-list-header-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    width: 100%;
}

.ol-list-header-title-block {
    flex: 1 1 180px;
    min-width: 0;
    align-self: center;
}

.ol-list-header-actions {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 10px;
    flex: 1 1 auto;
    margin-left: auto;
    flex-wrap: wrap;
    overflow: visible;
}

/* Template + action buttons inside purple header */
.ol-header-template {
    min-width: 200px;
    flex: 1 1 220px;
    max-width: 280px;
}

.ol-header-template .form-label {
    font-size: 0.72rem;
    line-height: 1.2;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 0.25rem;
}

.ol-header-template .form-control,
.ol-header-template select {
    min-width: 0;
    width: 100%;
    height: 34px !important;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: 8px;
    background: #fff;
    font-size: 0.82rem;
}

.ol-header-template.ol-filter-applied .form-control,
.ol-header-template.ol-filter-applied select {
    border-color: #fff;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.35);
}

.ol-header-date-fields {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 4px;
    flex: 0 0 158px;
    width: 158px;
    min-width: 148px;
    max-width: 170px;
}

.ol-header-date-caption,
.ol-header-date-caption span {
    margin-bottom: 0;
    color: #fff !important;
    font-size: 0.72rem;
    line-height: 1.2;
    font-weight: 600;
}

/* All header buttons live in ONE block beside the fields. The block starts on the input row (not on the label row),
   and when the buttons do not fit on one line they wrap INSIDE the block: the second line (Print / Reset ...) sits
   next to the second date input. Before, every wrapped button got its own label offset plus a full row gap and
   started below the whole date column, which made the header about 60px taller. */
.ol-header-buttons {
    display: flex;
    flex: 1 1 300px;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 6px 10px;
    min-width: 0;
    max-width: max-content;
    margin-top: calc(0.72rem * 1.2 + 0.25rem);
}

.ol-show-all-templates {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: auto;
    margin: 2px 0 0;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
}

.ol-show-all-templates input {
    width: 15px;
    height: 15px;
    margin: 0;
    accent-color: #fff;
    cursor: pointer;
}

#olHeaderDateBar .ol-header-date-field.ol-header-template {
    min-width: 0;
    flex: 0 0 auto;
    max-width: none;
    width: 100%;
}

#olHeaderDateBar .ol-header-date-field-label {
    display: none !important;
}

.ol-header-date-field {
    min-width: 0;
    flex: 0 0 auto;
    max-width: none;
    width: 100%;
}

.ol-header-date-field input[type="date"] {
    min-width: 0;
    width: 100%;
}

/* Report Template — master (Y) = green, user copy (N) = black */
#ddlTemplate.ol-tpl-selected-y {
    color: #15803d;
    font-weight: 700;
}

#ddlTemplate.ol-tpl-selected-n {
    color: #111827;
    font-weight: 700;
}

#ddlTemplate option.ol-tpl-master-y {
    color: #15803d;
    font-weight: 600;
    background: #fff;
}

#ddlTemplate option.ol-tpl-master-n {
    color: #111827;
    font-weight: 600;
    background: #f3f4f6;
}

/* Manage Template dropdown — master = green, user copy = black */
#ddlMtMaster.ol-tpl-selected-y {
    color: #15803d;
    font-weight: 700;
}

#ddlMtMaster.ol-tpl-selected-n {
    color: #111827;
    font-weight: 700;
}

#ddlMtMaster option.ol-tpl-master-y {
    color: #15803d;
    font-weight: 600;
    background: #fff;
}

#ddlMtMaster option.ol-tpl-master-n {
    color: #111827;
    font-weight: 600;
    background: #f3f4f6;
}

.ol-header-filter-actions {
    margin-left: 0;
    padding-bottom: 0;
}

.ol-list-header .ol-btn-filter,
.ol-list-header .ol-btn-reset,
.ol-list-header .ol-btn-show,
.ol-list-header .ol-btn-manage,
.ol-list-header .ol-btn-download,
.ol-list-header .ol-btn-print,
.ol-list-header .ol-btn-preview,
.ol-list-header .ol-btn-size-param {
    height: 34px;
}

.ol-list-header-title {
    margin: 0;
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
}

.ol-list-header-title i {
    opacity: 0.95;
}

.ol-list-header-sub {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.78rem;
    display: block;
    margin-top: 4px;
}

.ol-list-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #fff;
    border: 2px solid rgba(255, 255, 255, 0.6);
    color: #667eea;
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: 800;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.2);
    white-space: nowrap;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s;
    line-height: 1;
    font-size: 0.85rem;
    height: auto !important;
    min-height: 40px;
    -webkit-appearance: none;
    appearance: none;
    font-family: inherit;
}

.ol-list-action-btn:hover:not(:disabled) {
    background: #f0f4ff;
    border-color: #667eea;
    color: #667eea;
}

.ol-list-action-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}

/* ── Filter bar ──────────────────────────────────────────────────────── */
.ol-list-filter-bar {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-top: none;
    border-radius: 0 0 14px 14px;
    padding: 14px 18px 12px;
    margin-bottom: 14px;
    box-shadow: 0 2px 12px rgba(102, 126, 234, 0.06);
    flex-shrink: 0;
}

.ol-filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 16px 24px;
    width: 100%;
}

.ol-filter-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 160px;
    flex: 0 1 auto;
}

.ol-hidden {
    display: none !important;
}

.ol-filter-field.ol-hidden {
    display: none !important;
}

.ol-list-filter-bar .form-label,
.ol-list-filter-bar label {
    font-size: 0.77rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 0.35rem;
}

.ol-list-filter-bar .form-control,
.ol-list-filter-bar .form-select,
.ol-list-filter-bar select {
    min-width: 160px;
    max-width: 220px;
    height: 34px !important;
    border: 1.5px solid #ddd6fe;
    border-radius: 8px;
    font-size: 0.82rem;
    background-color: #f5f3ff;
    color: #1e1b4b;
    padding: 0 10px;
}

.ol-list-filter-bar .form-control:focus,
.ol-list-filter-bar .form-select:focus,
.ol-list-filter-bar select:focus {
    border-color: #667eea;
    background-color: #fff;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
    outline: none;
}

.ol-filter-field.ol-filter-multiselect {
    width: 210px;
    min-width: 210px;
    flex: 0 0 210px;
    position: relative;
}

/* ── Checkbox multi-select dropdown (same pattern as CommonSizeFilterControl.js) ── */
.ol-cd-wrap {
    position: relative;
    width: 100%;
}

.ol-cd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    box-sizing: border-box;
    height: 34px !important;
    padding: .25rem .4rem !important;
    border: 1.5px solid #ddd6fe;
    border-radius: 8px;
    background-color: #f5f3ff;
    cursor: pointer;
    user-select: none;
    transition: border-color 0.15s, box-shadow 0.15s, background-color 0.15s;
}

.ol-cd-header:hover {
    border-color: #a5b4fc;
}

.ol-cd-wrap.ol-cd-open .ol-cd-header {
    border-color: #667eea;
    background-color: #fff;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
}

.ol-cd-header-text {
    font-size: 12px;
    color: #1e1b4b;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ol-cd-arrow {
    font-size: 10px;
    color: #667eea;
    flex-shrink: 0;
    transition: transform 0.15s ease;
}

.ol-cd-wrap.ol-cd-open .ol-cd-arrow {
    transform: rotate(180deg);
}

/* Positioned dynamically via JS (position: fixed, top/left/width) so it always
   escapes any ancestor's overflow/scroll clipping — same idea as Select2's dropdownParent. */
.ol-cd-menu {
    max-width: calc(100vw - 24px);
    background: #fff;
    border: 1px solid #eef0fa;
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(102, 126, 234, 0.2);
    z-index: 2000;
    overflow: hidden;
}

/* Keep checkbox menus above Bootstrap modal content */
body > .ol-cd-menu,
#olFilterModal > .ol-cd-menu {
    z-index: 10060 !important;
}

#olFilterModal.show {
    overflow: visible;
}

#olFilterModal.show .modal-dialog,
#olFilterModal.show .modal-content,
#olFilterModal.show .modal-body {
    overflow: visible;
}

.ol-cd-search-wrap {
    padding: 10px;
    border-bottom: 1px solid #eef0fa;
}

.ol-cd-search-input {
    width: 100%;
    box-sizing: border-box;
    border: 1.5px solid #e7e5f7;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 0.82rem;
    outline: none;
    background: #f8f8fd;
}

.ol-cd-search-input:focus {
    border-color: #667eea;
    background: #fff;
}

.ol-cd-options {
    max-height: 220px;
    overflow-y: auto;
    padding: 4px 0;
}

.ol-cd-options.ol-cd-options-large {
    max-height: 320px;
}

.ol-cd-no-results {
    padding: 10px 12px;
    text-align: center;
    color: #64748b;
    font-size: 0.82rem;
    border-top: 1px solid #eef0fa;
}

.ol-cd-no-results.is-hidden {
    display: none !important;
}

.ol-cd-option {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 12px;
    cursor: pointer;
    user-select: none;
    margin: 0;
}

.ol-cd-option:hover {
    background-color: #f2f1fd;
}

.ol-cd-checkbox {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    accent-color: #667eea;
    cursor: pointer;
}

.ol-cd-option-text {
    font-size: 0.83rem;
    color: #1e1b4b;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ol-cd-option .ol-cd-checkbox:checked ~ .ol-cd-option-text {
    font-weight: 700;
    color: #4f46e5;
}

.ol-cd-option.ol-cd-option-hidden {
    display: none !important;
}

.ol-cd-selection-hint {
    margin-right: auto;
    font-size: 0.78rem;
    font-weight: 600;
    color: #4f46e5;
}

.ol-cd-selection-hint.is-hidden {
    display: none !important;
}

.ol-cd-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 10px;
    border-top: 1px solid #eef0fa;
    background: #fafaff;
}

.ol-cd-btn-select-visible,
.ol-cd-btn-clear-visible {
    border: none;
    background: transparent;
    color: #4f46e5;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 6px 8px;
    cursor: pointer;
}

.ol-cd-btn-select-visible:hover,
.ol-cd-btn-clear-visible:hover {
    color: #3730a3;
    text-decoration: underline;
}

.ol-cd-footer .ol-cd-btn-ok {
    margin-left: auto;
}

.ol-cd-btn-ok {
    height: 30px;
    min-width: 64px;
    border: none;
    border-radius: 7px;
    padding: 0 14px;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    box-shadow: 0 2px 8px rgba(102, 126, 234, 0.3);
}

.ol-cd-btn-ok:hover {
    filter: brightness(1.05);
}

.ol-cd-wrap.ol-cd-has-selection .ol-cd-header {
    border-color: #667eea;
    background: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 100%);
    box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.18);
}

.ol-cd-wrap.ol-cd-has-selection .ol-cd-header-text {
    color: #4338ca;
    font-weight: 700;
}

.ol-filter-field.ol-filter-applied > .form-control,
.ol-filter-field.ol-filter-applied > .form-select,
.ol-filter-field.ol-filter-applied > select {
    border-color: #667eea;
    background: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 100%);
    color: #4338ca;
    font-weight: 600;
}

.ol-cd-options::-webkit-scrollbar {
    width: 7px;
}

.ol-cd-options::-webkit-scrollbar-thumb {
    background: #c7d2fe;
    border-radius: 4px;
}

.ol-filter-summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1 1 auto;
    color: #475569;
    font-size: 0.84rem;
    font-weight: 600;
}

.ol-filter-summary i {
    color: #667eea;
    flex-shrink: 0;
}

.ol-filter-summary span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ol-filter-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding-bottom: 2px;
    /* sit next to Report Template (not pushed to far right) */
    margin-left: 0;
    flex-shrink: 0;
}

.ol-main-filter-row {
    align-items: flex-end;
}

.ol-main-filter-row .ol-template-field {
    min-width: 220px;
    flex: 1 1 240px;
    max-width: 320px;
}

.ol-main-filter-row .ol-template-field .form-control,
.ol-main-filter-row .ol-template-field select {
    max-width: none;
    width: 100%;
    min-width: 0;
}

.ol-filter-modal-empty {
    text-align: center;
    color: #94a3b8;
    font-size: 0.86rem;
    padding: 18px 8px 6px;
}

.ol-btn {
    height: 34px;
    border-radius: 9px;
    padding: 0 16px;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    border: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: transform 0.15s, box-shadow 0.15s;
}

.ol-btn-reset {
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    color: #fff;
    border: none;
    justify-content: center;
    box-shadow: 0 3px 10px rgba(249, 115, 22, 0.35);
}

.ol-btn-reset:hover:not(:disabled) {
    filter: brightness(1.05);
    background: linear-gradient(135deg, #fb923c 0%, #f97316 100%);
    color: #fff;
}

.ol-list-header .ol-btn-filter {
    background: rgba(255, 255, 255, 0.95);
    color: #4338ca;
    border: 1.5px solid #fff;
}

.ol-list-header .ol-btn-manage {
    background: #fff;
    color: #4338ca;
    border: 1.5px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
}

.ol-list-header .ol-btn-manage:hover:not(:disabled) {
    background: #f0f4ff;
    color: #3730a3;
    border-color: #fff;
}

.ol-list-header .ol-btn-show {
    background: #fff;
    color: #4338ca;
    border: none;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
}

.ol-list-header .ol-btn-show:hover:not(:disabled) {
    background: #f0f4ff;
    color: #3730a3;
}

.ol-list-header .ol-btn-size-param {
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    color: #fff;
    border: none;
    box-shadow: 0 3px 10px rgba(249, 115, 22, 0.35);
    white-space: nowrap;
}

.ol-list-header .ol-btn-size-param:hover:not(:disabled) {
    background: linear-gradient(135deg, #fb923c 0%, #f97316 100%);
    color: #fff;
    filter: brightness(1.05);
}

.ol-list-header .ol-btn-size-param.ol-filter-applied {
    background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);
    box-shadow: 0 3px 12px rgba(234, 88, 12, 0.5);
}

.ol-list-header .ol-btn-size-param .ol-size-filter-badge {
    margin-left: 4px;
    padding: 1px 7px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.22);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.4;
}

.ol-size-param-wrap {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
}

.ol-btn-size-param-clear {
    min-width: 34px;
    width: 34px;
    height: 34px;
    padding: 0;
    justify-content: center;
    background: #fff;
    color: #ea580c;
    border: 1.5px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
}

.ol-btn-size-param-clear:hover:not(:disabled) {
    background: #fff7ed;
    color: #c2410c;
}

.ol-empty-size-filter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    max-width: 420px;
    margin: 0 auto;
}

.ol-empty-size-filter .ol-btn-size-param {
    margin-top: 4px;
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    color: #fff;
    border: none;
    box-shadow: 0 3px 10px rgba(249, 115, 22, 0.35);
}

.ol-list-header .ol-download-wrap {
    position: relative;
    flex-shrink: 0;
}

.ol-list-header .ol-btn-download {
    background: rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.88);
    border: 1.5px dashed rgba(255, 255, 255, 0.55);
    box-shadow: none;
}

.ol-list-header .ol-download-wrap:not(.ol-download-ready) {
    pointer-events: none;
}

.ol-list-header .ol-download-wrap:not(.ol-download-ready) .ol-btn-download {
    background: rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.88);
    border: 1.5px dashed rgba(255, 255, 255, 0.55);
    box-shadow: none;
    opacity: 1;
}

