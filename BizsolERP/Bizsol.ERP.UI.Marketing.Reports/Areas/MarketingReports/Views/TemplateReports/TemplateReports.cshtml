/* ── Responsive ──────────────────────────────────────────────────────── */

/* Medium laptop / tablet landscape */
@@media (max-width: 1280px) {
    .ol-list-header-actions {
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .ol-header-template {
        max-width: 100%;
    }
}

@@media (max-height: 820px) {
    #OrderLoadReportPage.ol-page {
        height: 100%;
        max-height: 100%;
        min-height: 0;
    }
}

/* Tablet / small laptop: keep the compact single-row layout but let fields wrap in pairs */
@@media (max-width: 1024px) {
    .ol-filter-field.ol-filter-multiselect {
        width: 190px;
        min-width: 190px;
        flex: 0 0 190px;
    }
}

/* Narrow (769-800px, e.g. a half-width window) WITH the date bar showing: the button block no longer fits beside
   the fields, so it dissolves. Filter + Load stay next to the From input; the other buttons flow below and need
   no label offset there. (Without the date bar the block still fits beside the template field, so it stays as is.)
   768.02px (not 769px) so a fractional viewport width can never fall between this range and the phone block. */
@@media (min-width: 768.02px) and (max-width: 800px) {
    .ol-header-date-fields:not(.ol-hidden) ~ .ol-header-buttons {
        display: contents;
    }

    .ol-header-date-fields:not(.ol-hidden) ~ .ol-header-buttons > .ol-header-filter-actions {
        margin-top: calc(0.72rem * 1.2 + 0.25rem);
    }

    /* with the Size button showing, the Filter group is too wide for the field line: it wraps down, so no offset */
    .ol-header-date-fields:not(.ol-hidden) ~ .ol-header-buttons > .ol-header-filter-actions:has(.ol-size-param-wrap:not(.is-hidden)) {
        margin-top: 0;
    }
}

@@media (max-width: 768px) {
    .ol-page {
        height: 100%;
        max-height: 100%;
        min-height: 0;
        overflow: hidden;
        padding: 4px 0 8px;
    }

    .ol-list-grid-wrap {
        flex: 1 1 0%;
        min-height: 0;
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
    }

    .ol-grid-panel {
        min-height: 0;
        min-width: 0;
        overflow: hidden;
    }

    .ol-table-wrapper {
        flex: 1 1 0%;
        min-height: 0 !important;
        max-height: none !important;
        min-width: 0;
        max-width: 100%;
        overflow: auto !important;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
    }

    .ol-list-header {
        padding: 10px 12px;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 8px;
    }

    .ol-list-header-top {
