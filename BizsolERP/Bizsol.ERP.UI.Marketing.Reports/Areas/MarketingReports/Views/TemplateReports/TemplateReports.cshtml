        margin-left: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        align-items: stretch;
    }

    /* the button block dissolves: every button is a plain cell of the 2-column grid above */
    .ol-header-buttons {
        display: contents;
    }

    .ol-header-template {
        grid-column: 1 / -1;
        max-width: 100%;
        min-width: 0;
        flex: none;
    }

    .ol-header-filter-actions {
        grid-column: 1 / -1;
