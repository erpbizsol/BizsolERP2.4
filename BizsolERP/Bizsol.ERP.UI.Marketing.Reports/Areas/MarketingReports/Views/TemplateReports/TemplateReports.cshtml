        pointer-events: auto;
    }

    .ol-header-buttons > .ol-download-wrap:not(.ol-download-ready) {
        pointer-events: none;
    }

    .ol-list-header .ol-list-action-btn {
        flex: 1 1 calc(50% - 5px);
        min-width: 100px;
    }

    .ol-filter-row {
        align-items: stretch;
        gap: 12px;
    }

    .ol-filter-field {
        min-width: 0;
        flex: 1 1 calc(50% - 6px);
        max-width: 100%;
    }

    .ol-filter-field.ol-filter-multiselect {
        width: auto;
        min-width: 0;
        flex: 1 1 calc(50% - 6px);
        max-width: 100%;
    }

    /* Grid toolbar: record count + search */
    .ol-grid-toolbar {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
    }

    #olSearchSlot {
        width: 100%;
        flex: 1 1 100%;
        margin-left: 0;
    }

    #OrderLoadReportPage #global-search-wrap-OrderLoadReport {
        max-width: 100%;
