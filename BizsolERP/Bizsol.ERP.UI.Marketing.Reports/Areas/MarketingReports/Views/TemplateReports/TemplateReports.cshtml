        height: 40px;
    }

    #OrderLoadReportPage .bizsol-global-search-input {
        height: 36px !important;
        font-size: 16px !important;
    }

    .ol-grid-footer {
        position: relative;
        bottom: auto;
        box-shadow: none;
        padding: 8px 10px;
        padding-bottom: calc(8px + env(safe-area-inset-bottom, 0px));
        justify-content: center;
        flex-shrink: 0;
    }

    #OrderLoadReportPage #paginator-OrderLoadReport {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
    }

    #OrderLoadReportPage #paginator-OrderLoadReport > .page-size-select {
        flex: 1 1 100%;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin: 0;
        padding-bottom: 6px;
        border-bottom: 1px solid #e2e8f0;
    }

    #OrderLoadReportPage #paginator-OrderLoadReport > .page-size-select select {
        flex: 0 0 auto;
        min-width: 72px;
        max-width: 110px;
        font-size: 16px;
    }

    #OrderLoadReportPage #paginator-OrderLoadReport > .page-info {
        margin: 0;
        flex: 1 1 auto;
        text-align: center;
        font-size: 11px;
        white-space: nowrap;
        min-width: 0;
    }

    #OrderLoadReportPage #paginator-OrderLoadReport .paginator-btn {
        width: auto;
        min-width: 40px;
        min-height: 40px;
        margin: 0;
        flex: 0 0 auto;
    }

    /* Filter modal: full width on phones */
    #olFilterModal .modal-dialog {
        max-width: calc(100vw - 12px);
        margin: 8px auto;
    }

    #olFilterModal .modal-body {
