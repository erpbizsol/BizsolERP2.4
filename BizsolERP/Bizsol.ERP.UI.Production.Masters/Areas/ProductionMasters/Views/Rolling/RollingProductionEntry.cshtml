@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
   
</style>
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />

<div class="tab-section">
    <ul class="nav nav-tabs" id="RollingProductionTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#IssueTab" role="tab" aria-controls="Issue" aria-selected="true" onclick="">
                Issue
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#ReceiveTab" role="tab" aria-controls="Receive" aria-selected="false" onclick="">
                Receive
            </button>
        </li>
    </ul>


    <div class="tab-content" id="RollingProductionTabContent">

        @* Issue Tabs *@

        <div class="tab-pane fade show active" id="IssueTab" role="tabpanel" aria-labelledby="Issue">
            <div class="row">
                <div class="col-sm-2 col-6">
                    <label for="txtIssuePlanDate" class="col-form-label-sm fw-bold">Plan Date</label>
                    <input type="date" class="form-control form-control-sm" id="txtIssuePlanDate" onchange="RollingProductionEnty_GatPlanDetail()">
                </div>
                <div class="col-sm-2 col-6">
                    <label for="txtIssueProductionDate" class="col-form-label-sm fw-bold">Production Date</label>
                    <input type="date" class="form-control form-control-sm" id="txtIssueProductionDate" onchange="RollingProductionEnty_GatPlanDetail()">
                </div>
                <div class="col-sm-2 col-6">
                    <label for="ddlGodown" class="col-form-label-sm fw-bold">Warehouse</label>
                    <select id="ddlGodown" class="form-control form-control-sm box_border" onchange="RollingProductionEnty_GatPlanDetail()">
                    </select>
                </div>
                <div class="col-sm-2 col-6">
                    <label for="ddlMachineNo" class="col-form-label-sm fw-bold">Mill</label>
                    <select id="ddlMachineNo" class="form-control form-control-sm box_border" onchange="RollingProductionEnty_GatPlanDetail()">
                    </select>

                </div>
                <div class="col-sm-2 col-6">
                    <label class="col-form-label-sm fw-bold">Shift</label>
                    <select id="ddlIssueShift" class="form-control form-control-sm box_border" onchange="RollingProductionEnty_GatPlanDetail()">
                    </select>

                </div>
                <div class="col-sm-2 col-6">
                    <label class="col-form-label-sm fw-bold">Identification No</label>
                    <input type="text" id="txtScanIdNo" class="form-control form-control-sm box_border" onchange="RollingProductionEnty_SaveIssueID('ScanIdNo')" autocomplete="off">
                    

                </div>
                <div class="col-md-12 col-12 mt-2">

                    <a class="btn btn-primary btn-height" id="btnBrkDownStart">
                        BREAK DOWN START
                    </a> &nbsp;&nbsp;
                    <a class="btn btn-secondary btn-height" id="btnScanQR" onclick="RollingProductionEnty_btnScanQR()">
                        Scan QR
                    </a>
                    &nbsp;&nbsp;
                    <button type="button" class="btn btn-primary btn-height" onclick="RollingProductionEnty_Back()">Back</button>
                </div>
                @*  <div class="col-sm-2 col-3 without-label-field">
                    <button type="button" class="btn btn-primary btn-height" onclick="RollingProductionEnty_Back()">Back</button>
                </div>  *@

            </div>
            
            <div class="row">
                <div class="col-md-12">
                    <div class="table-wrapper mt-2 ">
                        <table id="tbIssueSlitID" class="table fixed-width-table">
                            <thead id="tbIssueSlitIDHeader">
                            </thead>
                            <tbody id="tbIssueSlitIDBody">
                            </tbody>
                            <tfoot>
                            </tfoot>
                        </table>
                    </div>
                    <div class="paginator" id="paginator-tbIssueSlitID">
                    </div>

                    <div class="table-wrapper mt-2 ">
                        <table id="tbIssuedIDDetails" class="table fixed-width-table">
                            <thead id="tbIssuedIDDetailsHeader">
                            </thead>
                            <tbody id="tbIssuedIDDetailsBody">
                            </tbody>
                            <tfoot>
                            </tfoot>
                        </table>
                    </div>
                    <div class="paginator" id="paginator-tbIssuedIDDetails">
                    </div>
                </div>
                @* <fieldset class="rounded-1 p-3">
                    <legend class="float-none w-auto px-2">ISSUE SLIT ID</legend>
                </fieldset> *@
            </div>
        </div>

        @* Receive Tabls *@
        <div class="tab-pane fade" id="ReceiveTab" role="tabpanel" aria-labelledby="Receive">
            <div class="row">
                <div class="col-sm-2 col-6">
                    <label for="txtReceivePlanDate" class="col-form-label-sm fw-bold">Plan Date</label>
                    <input type="date" class="form-control form-control-sm" id="txtReceivePlanDate" onchange="RollingProductionEnty_GatReceivedPlanDetail()">
                </div>
                <div class="col-sm-2 col-6">
                    <label for="txtReceiveProductionDate" class="col-form-label-sm fw-bold">Production Date</label>
                    <input type="date" class="form-control form-control-sm" id="txtReceiveProductionDate" onchange="RollingProductionEnty_GatReceivedPlanDetail()">
                </div>
                <div class="col-sm-2 col-6">
                    <label for="ddlGodownReceive" class="col-form-label-sm fw-bold">Warehouse</label>
                    <select id="ddlGodownReceive" class="form-control form-control-sm box_border" onchange="RollingProductionEnty_GatReceivedPlanDetail()">
                    </select>
                </div>
                <div class="col-sm-2 col-6">
                    <label for="ddlMachineNoReceive" class="col-form-label-sm fw-bold">Mill</label>
                    <select id="ddlMachineNoReceive" class="form-control form-control-sm box_border" onchange="RollingProductionEnty_GatReceivedPlanDetail()">
                    </select>

                </div>
                <div class="col-sm-2 col-6">
                    <label class="col-form-label-sm fw-bold">Shift</label>
                    <select id="ddlReceiveShift" class="form-control form-control-sm box_border" onchange="RollingProductionEnty_GatReceivedPlanDetail()">
                    </select>

                </div>
                
                <div class="col-md-12 col-12">
                    <a class="btn btn-primary btn-height" id="btnReceiveBrkDownStart">
                        BREAK DOWN START
                    </a> &nbsp;&nbsp;
                    <button type="button" class="btn btn-primary btn-height" onclick="RollingProductionEnty_Back()">Back</button>
                </div>
                @* <div class="col-sm-2 col-3 without-label-field">
                    <button type="button" class="btn btn-primary btn-height" onclick="RollingProductionEnty_Back()">Back</button>
                </div> *@
            </div>

            <div class="row">
                <div class="col-md-12 mt-2">
                    <h4 class="table-heading">RECEIVE ALL SIZE</h4>
                </div>
                <div class="col-md-12">
                    <div class="table-wrapper mt-2 ">
                        <table id="tbItemToBeReceive" class="table fixed-width-table">
                            <thead id="tbItemToBeReceiveHeader">
                            </thead>
                            <tbody id="tbItemToBeReceiveBody">
                            </tbody>
                            <tfoot>
                            </tfoot>
                        </table>
                    </div>
                    <div class="paginator" id="paginator-tbItemToBeReceive">
                    </div>
                </div>
                @* <fieldset class="rounded-1 p-3">
                    <legend class="float-none w-auto px-2">RECEIVE ALL SIZE</legend>
                </fieldset> *@
            </div>


            <div class="row">
               @*  <fieldset class="rounded-1 p-3">
                    <legend class="float-none w-auto px-2">RECEIVE</legend>
                </fieldset> *@
                <div class="col-md-12 mt-2">
                    <h4 class="table-heading">RECEIVE</h4>
                </div>
                <div class="col-md-12">
                    <div class="table-wrapper mt-2 ">
                        <table id="tbReceiveView" class="table fixed-width-table" style="--bs-table-bg: unset;">
                            <thead id="tbReceiveViewHeader">
                            </thead>
                            <tbody id="tbReceiveViewBody">
                            </tbody>
                            <tfoot>
                            </tfoot>
                        </table>
                    </div>
                    <div class="paginator" id="paginator-tbReceiveView">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade bs-example-modal-center" id="modalGetScrapAndRejectedItem" tabindex="-1" role="dialog" aria-hidden="false" aria-modal="false">
    <div class="modal-dialog modal-dialog-scrollable" style="max-width:600px">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalTitle">Scrap And Rejected</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-wrapper fixed-height-table">
                    <table id="tbScrapAndRejectedItem" class="fixed-width-table table">
                        <thead id="tbScrapAndRejectedItemHeader">
                        </thead>
                        <tbody id="tbScrapAndRejectedItembody">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-tbScrapAndRejectedItem">
                </div>

                <div class="text-end mt-1">
                    <a class="btn btn-success icon-height" id="btnOk" onclick="RollingProductionEnty_CheckValidRejected()">
                        Ok
                    </a>
                    &nbsp;
                    &nbsp;
                    <a class="btn btn-danger icon-height" data-bs-dismiss="modal">
                        Close
                    </a>
                </div>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div>
<div id="DivBrakDownStartControlModal"></div>
<div id="DivSelectPrinterToPrintControlModal"></div>
<div id="DivScanQRCodeByCameraControlModal"></div>
<script>
    let IsRunningPlan='@ViewBag.IsRunningPlan'
    let NavPVCProductionMaster_Code='@ViewBag.PVCProductionMaster_Code'
    let NavPlanDate='@ViewBag.PlanDate'
    let NavMachineNo='@ViewBag.MachineNo'
    
   
</script>
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/BizSolInputControl.js"></script>

<script type="module" src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Production.Masters/Script/RollingProductionEntry.js"></script>

