<div class="row">
    <div class="col-sm-12">
        <div class="filter-card">
            <div class="filter-title">
                <i class="fas fa-filter"></i> Dispatch Plan Filter
            </div>
            <div class="row">
                <div class="col-md-3">
                    <label for="ddlStatus" class="form-label filter-label">Status</label><span class="text-danger">*</span>
                    <select id="ddlStatus" class="form-control form-control-sm box_border">
                        <option value="M">Pending For Approval (Marketing Man)</option>
                        <option value="P">Pending For Approval (PPC)</option>
                        <option value="D">Pending For Approval (Dispatch)</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="card p-1" id="dvTableDispatch" style="display:none;">
            <div id="btnDownload" class="row mb-1">
                <div class="col-md-12" style="text-align:right">
                    <button type="button" id="btnExportExcel" class="btn btn-primary btn-height" onclick="ExportExcel();">
                        <i class="fas fa-download"></i> Download
                    </button>
                </div>
            </div>
            <div class="table-wrapper" id="tableWrapper" style="min-height:400px;">
                <table id="tblDispatchPlan" class="fixed-width-table table table-bordered">
                    <thead id="table-head">
                    </thead>
                    <tbody id="table-body">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
