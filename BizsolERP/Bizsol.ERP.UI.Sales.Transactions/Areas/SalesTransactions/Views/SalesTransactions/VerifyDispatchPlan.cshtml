<div class="row">
    <div class="col-sm-12">
        <div class="filter-card">
            <div class="filter-title">
                <i class="fas fa-filter"></i> Dispatch Plan Filter
            </div>
            <div class="row">
                <div class="col-md-3">
                    <label for="ddlStatus" class="form-label filter-label">Status</label><span class="text-danger">*</span>
                    <select id="ddlStatus" class="form-control form-control-sm box_border">
                        <option value="M">Pending For Approval (Marketing Man)</option>
                        <option value="P">Pending For Approval (PPC)</option>
                        <option value="D">Pending For Approval (Dispatch)</option>
                        <option value="C">Approved Dispatch Plan</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="card p-1" id="dvTableDispatch" style="display:none;">
            <div id="btnDownload" class="row mb-1">
                <div class="col-md-12" style="text-align:right">
                    <button type="button" id="btnExportExcel" class="btn btn-primary btn-height" onclick="ExportExcel();">
                        <i class="fas fa-download"></i> Download
                    </button>
                </div>
            </div>
            <div class="table-wrapper" id="tableWrapper" style="min-height:400px;">
                <table id="tblDispatchPlan" class="fixed-width-table table table-bordered">
                    <thead id="table-head">
                    </thead>
                    <tbody id="table-body">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal fade rps-detail-modal" id="AllModal" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-scroll="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-width-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-modal-title">All Transporter Rate</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="table-wrapper" style="min-height:150px;">
                    <table id="AllTable" class="fixed-width-table table">
                        <thead id="AllTable-head">
                        </thead>
                        <tbody id="AllTable-body">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-AllTable">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger icon-height" onclick="CloseModal()">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade rps-detail-modal" id="Transporter" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-scroll="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-width-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-modal-title">Transporter</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div id="transporterGridWrapper">
                    <table id="transporterGridTable" class="table table-bordered table-striped table-sm">
                        <thead>
                            <tr>
                                <th style="width:40px;text-align:center;">
                                    <input type="checkbox" id="selectAll">
                                </th>
                                <th>Account Desp</th>
                                <th style="width:90px;text-align:center;">Update</th>
                            </tr>
                        </thead>
                        <tbody id="transporterGridBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary icon-height" onclick="SendMailToTransporter()">Send Mail</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseTransporter()">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade rps-detail-modal" id="dvApproved" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-scroll="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-modal-title">Approved Transporter</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                Do you want to approve this transporter quotation ?.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success icon-height" onclick="ApprovedTransporter()">Approved</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseApprovedModal()">Close</button>
            </div>
        </div>
    </div>
</div>

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
