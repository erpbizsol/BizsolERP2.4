    /* Transporter Dropdown with Checkbox Styles */
    .dropdown-container {
        position: relative;
        display: inline-block;
        font-family: Arial, sans-serif;
    }
    .dropdown-button,
    .select-checkbox-multi {
        padding: 8px;
        border: 2px solid #000;
        cursor: pointer;
        background-color: #fff;
        width: 350px;
        margin-top: 10px;
        text-align: left;
    }
    .dropdown-list {
        display: none;
        background-color: #fff;
        border: 1px solid #ccc;
        z-index: 1000 !important;
        padding: 5px;
        max-height: 162px;
        margin-top: -8px;
        overflow-y: auto;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
    .dropdown-list .checkbox-row {
        padding: 4px 6px;
    }
    .dropdown-list .checkbox-row:hover {
        background-color: #f3f6fb;
    }
    .dropdown-list label {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        margin: 0;
    }
    .dropdown-list input[type="checkbox"] {
        margin: 0;
    }

    /* Transporter modal: make body scrollable and table header sticky */
    #Transporter .modal-body {
        max-height: 70vh;
        padding: 8px 12px;
        overflow: hidden;
    }
    #transporterGridWrapper {
        max-height: 60vh;
        overflow-y: auto;
        overflow-x: hidden;
        border: 1px solid #e5e7eb;
        border-radius: 4px;
        background: #fff;
    }
    #transporterGridTable {
        margin-bottom: 0;
    }
    #transporterGridTable thead th {
        position: sticky;
        top: 0;
        z-index: 2;
    }
