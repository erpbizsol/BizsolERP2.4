@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Sales.Transactions/Script/FreightInvoice.js"></script>

<style>
    /* Fill fixed #modern-content pane; scroll inside grid only (not page) */
    #modern-content.modern-content:has(#FreightInvoicePage) {
        overflow: hidden !important;
    }

    .modern-content > main:has(#FreightInvoicePage) {
        height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        overflow: hidden;
    }

    #FreightInvoicePage.fi-page {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        max-width: 100%;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        padding: 4px 12px 16px;
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    #FreightInvoicePage #dvFiEntry.fi-entry-visible {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    @@media (max-width: 991.98px) {
        #FreightInvoicePage.fi-page {
            padding-bottom: 4px;
        }
    }

    #FreightInvoicePage .fi-card {
        background: var(--white-bg, #fff);
        border: 1px solid var(--border-color, #e2e8f0);
        border-radius: 14px;
        box-shadow: var(--shadow-md, 0 2px 12px rgba(102, 126, 234, 0.08));
        overflow: hidden;
        position: relative;
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    #FreightInvoicePage .fi-card::before {
        content: '';
        position: absolute;
        inset: 0 0 auto 0;
        height: 3px;
        background: var(--primary-gradient, linear-gradient(135deg, #667eea, #764ba2));
        border-radius: 14px 14px 0 0;
    }

    #FreightInvoicePage .fi-card-toolbar {
        flex-shrink: 0;
        padding: 12px 14px 10px;
        border-bottom: 1px solid var(--border-light, #eef0f8);
    }

    #FreightInvoicePage .fi-fg {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    #FreightInvoicePage .fi-fg label {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--text-primary, #2c3852);
        margin: 0;
    }

    #FreightInvoicePage .fi-fg input,
    #FreightInvoicePage .fi-fg select {
        height: 36px;
        width: 100%;
        border: 1px solid var(--border-color, #d4d9e3);
        border-radius: 8px;
        padding: 0 10px;
        font-size: 13px;
        color: var(--text-dark, #1e293b);
        background: var(--white-bg, #fff);
        outline: none;
        box-sizing: border-box;
    }

    #FreightInvoicePage .fi-fg input:focus,
    #FreightInvoicePage .fi-fg select:focus {
        border-color: var(--accent-primary, #667eea);
        box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.15);
    }

    #FreightInvoicePage .fi-date-range {
        display: flex;
        gap: 8px;
    }

    #FreightInvoicePage .fi-date-range .fi-fg {
        flex: 1;
        min-width: 0;
    }

    #FreightInvoicePage .fi-action-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    #FreightInvoicePage .fi-action-row .fi-btn {
        flex: 1;
        min-width: 0;
    }

    #FreightInvoicePage .fi-btn {
        height: 36px;
        border: none;
        border-radius: 8px;
        padding: 0 16px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        white-space: nowrap;
    }

    #FreightInvoicePage .fi-btn-show {
        background: var(--primary-gradient, linear-gradient(135deg, #667eea, #764ba2));
        color: #fff;
    }

    #FreightInvoicePage .fi-btn-save {
        background: linear-gradient(135deg, #059669, #10b981);
        color: #fff;
    }

    #FreightInvoicePage .fi-btn-save:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    #FreightInvoicePage #dvFiGridSection {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        border-top: 1px solid #eef0f8;
    }

    #FreightInvoicePage .fi-table-wrap {
        flex: 1;
        min-height: 0;
        overflow: auto;
        -webkit-overflow-scrolling: touch;
    }

    /* app.min.css .table-wrapper { display:block } breaks thead/body alignment — do not use that class here */
    #FreightInvoicePage .fi-table-wrap > #tblFreightInvoice {
        display: table;
        border-collapse: collapse;
    }

    #FreightInvoicePage #tblFreightInvoice {
        width: max-content;
        min-width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        font-size: 12.5px;
        margin-bottom: 0;
    }

    /* Override app.min.css: table > thead, th { position:sticky } — stick whole thead only */
    #FreightInvoicePage #tblFreightInvoice thead {
        position: sticky;
        top: 0;
        z-index: 5;
        background: #4f46e5;
    }

    #FreightInvoicePage #tblFreightInvoice thead th,
    #FreightInvoicePage #tblFreightInvoice tbody td,
    #FreightInvoicePage #tblFreightInvoice tbody tr {
        height: auto !important;
        position: static !important;
        top: auto !important;
    }

    /* Column width by data type — CSS only, fi-col-* classes */
    #FreightInvoicePage #tblFreightInvoice col.fi-col-check,
    #FreightInvoicePage #tblFreightInvoice th.fi-col-check,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-check {
        width: 40px;
    }

    #FreightInvoicePage #tblFreightInvoice col.fi-col-sno,
    #FreightInvoicePage #tblFreightInvoice th.fi-col-sno,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-sno {
        width: 58px;
    }

    #FreightInvoicePage #tblFreightInvoice col.fi-col-date,
    #FreightInvoicePage #tblFreightInvoice th.fi-col-date,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-date {
        width: 95px;
    }

    #FreightInvoicePage #tblFreightInvoice col.fi-col-grn,
    #FreightInvoicePage #tblFreightInvoice th.fi-col-grn,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-grn {
        width: 110px;
    }

    #FreightInvoicePage #tblFreightInvoice col.fi-col-city,
    #FreightInvoicePage #tblFreightInvoice th.fi-col-city,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-city {
        width: 120px;
    }

    #FreightInvoicePage #tblFreightInvoice col.fi-col-area,
    #FreightInvoicePage #tblFreightInvoice th.fi-col-area,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-area {
        width: 105px;
    }

    #FreightInvoicePage #tblFreightInvoice col.fi-col-transporter,
    #FreightInvoicePage #tblFreightInvoice th.fi-col-transporter,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-transporter {
        width: 150px;
    }

    #FreightInvoicePage #tblFreightInvoice col.fi-col-combo,
    #FreightInvoicePage #tblFreightInvoice th.fi-col-combo,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-combo {
        width: 115px;
    }

    #FreightInvoicePage #tblFreightInvoice col.fi-col-vehicle,
    #FreightInvoicePage #tblFreightInvoice th.fi-col-vehicle,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-vehicle {
        width: 130px;
    }

    #FreightInvoicePage #tblFreightInvoice col.fi-col-num,
    #FreightInvoicePage #tblFreightInvoice th.fi-col-num,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-num {
        width: 88px;
    }

    #FreightInvoicePage #tblFreightInvoice col.fi-col-tolerance,
    #FreightInvoicePage #tblFreightInvoice th.fi-col-tolerance,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-tolerance {
        width: 105px;
    }

    /* Gate Entry grid header — flat indigo; override filter.css th + app.min.css .table th gradient */
    #FreightInvoicePage #tblFreightInvoice.table thead tr th {
        background: #4f46e5 !important;
        background-color: #4f46e5 !important;
        background-image: none !important;
        color: #fff !important;
        font-size: 0.73rem !important;
        font-weight: 600 !important;
        text-align: center !important;
        vertical-align: middle !important;
        padding: 8px 6px !important;
        height: auto !important;
        white-space: nowrap;
        border: 1px solid rgba(255, 255, 255, 0.22) !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        letter-spacing: 0.03em;
        text-transform: none;
        position: static;
        overflow: visible;
        text-overflow: clip;
        --bs-table-bg: #4f46e5;
        --bs-table-color: #fff;
    }

    #FreightInvoicePage #tblFreightInvoice thead th.fi-th-normal {
        font-size: 0.73rem !important;
    }

    #FreightInvoicePage #tblFreightInvoice thead th.fi-sortable {
        cursor: pointer;
        user-select: none;
    }

    #FreightInvoicePage #tblFreightInvoice thead th.fi-sortable .fi-th-label,
    #FreightInvoicePage #tblFreightInvoice thead th.fi-sortable .fi-head-check-box {
        vertical-align: middle;
    }

    #FreightInvoicePage #tblFreightInvoice thead th.fi-sortable .fi-sort-icon {
        margin-left: 4px;
        font-size: 0.62rem;
        opacity: 0.85;
        vertical-align: middle;
    }

    #FreightInvoicePage #tblFreightInvoice thead th.center,
    #FreightInvoicePage #tblFreightInvoice tbody td.center {
        text-align: center;
    }

    #FreightInvoicePage #tblFreightInvoice th.fi-col-num,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-num,
    #FreightInvoicePage .fi-col-num .fi-input,
    #FreightInvoicePage .fi-col-num .fi-cell {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    #FreightInvoicePage #tblFreightInvoice th.fi-col-tolerance,
    #FreightInvoicePage #tblFreightInvoice td.fi-col-tolerance,
    #FreightInvoicePage .fi-col-tolerance .fi-cell {
        text-align: center;
    }

    #FreightInvoicePage #tblFreightInvoice tbody tr:nth-child(even) {
        background: #fff !important;
    }

    #FreightInvoicePage #tblFreightInvoice tbody tr:nth-child(odd) {
        background: #fff !important;
    }

    #FreightInvoicePage #tblFreightInvoice.table tbody td {
        padding: 6px 4px !important;
        height: auto !important;
        vertical-align: middle;
        border: 1px solid #eef0f8 !important;
        overflow: visible;
    }

    #FreightInvoicePage #tblFreightInvoice .fi-input {
        width: 100%;
        min-width: 0;
        height: 30px;
        box-sizing: border-box;
        display: block;
        font-size: 12.5px;
        outline: none;
        padding: 0 6px;
        border: 1px solid var(--border-color, #d4d9e3);
        border-radius: 8px;
        background: #fff;
        color: #334155;
    }

    #FreightInvoicePage #tblFreightInvoice .fi-cell {
        display: block;
        width: 100%;
        min-width: 0;
        height: 30px;
        line-height: 28px;
        box-sizing: border-box;
        font-size: 12.5px;
        padding: 0 6px;
        border: 1px solid var(--border-color, #e2e8f0);
        border-radius: 8px;
        background: #fafafa;
        color: #64748b;
        overflow: visible;
        white-space: nowrap;
    }

    #FreightInvoicePage #tblFreightInvoice .fi-cell.fi-skeleton.fi-empty {
        color: #94a3b8;
    }

    #FreightInvoicePage #tblFreightInvoice .fi-input.fi-editable {
        width: auto;
        min-width: 100%;
        max-width: none;
        display: block;
        box-sizing: border-box;
    }

    #FreightInvoicePage #tblFreightInvoice td.fi-col-num .fi-input.fi-editable {
        text-align: right;
        margin-left: auto;
        margin-right: 0;
    }

    #FreightInvoicePage #tblFreightInvoice .fi-input.fi-editable,
    #FreightInvoicePage #tblFreightInvoice select.fi-input {
        background: #fffbeb;
        border-color: #fcd34d;
    }

    #FreightInvoicePage #tblFreightInvoice .fi-input.fi-editable:focus {
        background: #fff;
        border-color: var(--accent-primary, #667eea);
        box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.18);
    }

    #FreightInvoicePage #tblFreightInvoice select.fi-input:not(.select2-hidden-accessible) {
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        opacity: 0 !important;
        pointer-events: none !important;
    }

    #FreightInvoicePage #tblFreightInvoice td .select2-container {
        width: 100% !important;
        max-width: 100%;
    }

    #FreightInvoicePage #tblFreightInvoice .select2-container .select2-selection--single {
        height: 30px;
        min-height: 30px;
        border: 1px solid #fcd34d;
        border-radius: 8px;
        background: #fffbeb;
        font-size: 12.5px;
    }

    #FreightInvoicePage #tblFreightInvoice .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 28px;
        padding-left: 6px;
        padding-right: 22px;
        color: #334155;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    #FreightInvoicePage #tblFreightInvoice .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 28px;
    }

    #FreightInvoicePage #tblFreightInvoice .select2-container--default.select2-container--focus .select2-selection--single,
    #FreightInvoicePage #tblFreightInvoice .select2-container--default.select2-container--open .select2-selection--single {
        border-color: var(--accent-primary, #667eea);
        background: #fff;
    }

    #FreightInvoicePage #tblFreightInvoice .fi-input.fi-locked,
    #FreightInvoicePage #tblFreightInvoice .fi-input.fi-calc,
    #FreightInvoicePage #tblFreightInvoice .fi-cell.fi-calc,
    #FreightInvoicePage #tblFreightInvoice .fi-cell.fi-locked,
    #FreightInvoicePage #tblFreightInvoice .fi-input.fi-skeleton,
    #FreightInvoicePage #tblFreightInvoice .select2-container--default.select2-container--disabled .select2-selection--single {
        background: #fafafa;
        border-color: #e8ecf0;
        color: #64748b;
    }

    #FreightInvoicePage #tblFreightInvoice tbody td.fi-col-sno {
        text-align: center;
        font-size: 13px;
        color: #1e293b;
    }

    #FreightInvoicePage #tblFreightInvoice tbody td.fi-col-check,
    #FreightInvoicePage #tblFreightInvoice thead th.fi-col-check {
        text-align: center;
    }

    #FreightInvoicePage #tblFreightInvoice .fi-row-select,
    #FreightInvoicePage #tblFreightInvoice .fi-select-all {
        width: 15px;
        height: 15px;
        margin: 0;
        cursor: pointer;
        vertical-align: middle;
        accent-color: var(--accent-primary, #667eea);
    }

    #FreightInvoicePage #tblFreightInvoice thead th.fi-col-check .fi-head-check-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 0;
    }

    /* ── Saved list — Marketing Executive Master layout ── */
    #FreightInvoicePage .fi-po-list-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 14px 14px 0 0;
        padding: 16px 22px 14px;
        margin-bottom: 0;
    }

    #FreightInvoicePage .fi-po-header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    #FreightInvoicePage .fi-po-list-header .fi-hero-left {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    #FreightInvoicePage .fi-po-list-header .fi-hero-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.2);
        border: 2px solid rgba(255, 255, 255, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
        flex-shrink: 0;
    }

    #FreightInvoicePage .fi-po-list-header .fi-hero-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.02em;
        line-height: 1.2;
        margin: 0;
    }

    #FreightInvoicePage .fi-po-list-header .fi-hero-sub {
        font-size: 0.78rem;
        color: rgba(255, 255, 255, 0.78);
        margin-top: 4px;
        font-weight: 500;
    }

    #FreightInvoicePage .fi-po-create-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: #fff;
        border: 2px solid rgba(255, 255, 255, 0.6);
        color: #667eea;
        border-radius: 10px;
        padding: 8px 16px;
        font-weight: 800;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.2);
        white-space: nowrap;
        cursor: pointer;
        flex-shrink: 0;
        font-size: 0.85rem;
        line-height: 1;
    }

    #FreightInvoicePage .fi-po-create-btn:hover {
        background: #f0f4ff;
        border-color: #667eea;
    }

    #FreightInvoicePage .fi-po-create-btn .pm-plus {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: rgba(102, 126, 234, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 700;
        line-height: 1;
    }

    #FreightInvoicePage .fi-list-grid-wrap {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-top: none;
        border-radius: 0 0 14px 14px;
        box-shadow: 0 2px 12px rgba(102, 126, 234, 0.07);
        overflow: hidden;
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    #FreightInvoicePage .fi-list-toolbar {
        flex-shrink: 0;
        padding: 14px 16px 12px;
        border-bottom: 1px solid var(--border-light, #eef0f8);
        background: #fafbff;
    }

    #FreightInvoicePage .fi-list-toolbar .fi-fg {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    #FreightInvoicePage .fi-list-toolbar .fi-fg label {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--text-primary, #2c3852);
        margin: 0;
    }

    #FreightInvoicePage .fi-list-toolbar .pm-search-wrap {
        position: relative;
        width: 100%;
        max-width: none;
        min-width: 0;
    }

    #FreightInvoicePage .fi-list-toolbar .pm-search-wrap i {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted, #64748b);
        font-size: 13px;
        pointer-events: none;
    }

    #FreightInvoicePage .fi-list-toolbar #txtFiListSearch,
    #FreightInvoicePage .fi-list-toolbar input[type="date"] {
        width: 100%;
        height: 36px;
        box-sizing: border-box;
        border: 1px solid var(--border-color, #d4d9e3);
        border-radius: 8px;
        padding: 0 10px;
        font-size: 13px;
        background: #fff;
        color: var(--text-dark, #1e293b);
        outline: none;
    }

    #FreightInvoicePage .fi-list-toolbar #txtFiListSearch {
        padding-left: 34px;
    }

    #FreightInvoicePage .fi-list-toolbar #txtFiListSearch:focus,
    #FreightInvoicePage .fi-list-toolbar input[type="date"]:focus {
        border-color: var(--accent-primary, #667eea);
        box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.15);
    }

    #FreightInvoicePage .fi-list-toolbar .fi-list-refresh-btn {
        width: auto;
        min-width: 0;
        padding: 0 12px;
        height: 36px;
        border: none;
        border-radius: 8px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        flex-shrink: 0;
    }

    #FreightInvoicePage .fi-list-toolbar .fi-list-action-col {
        display: flex;
        align-items: flex-end;
    }

    #FreightInvoicePage .fi-list-toolbar .fi-list-action-col .fi-fg {
        width: auto;
        min-width: 0;
    }

    #FreightInvoicePage .fi-list-grid-wrap .pm-table-wrap {
        flex: 1;
        min-height: 0;
        overflow-x: auto;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    #FreightInvoicePage .fi-list-grid-wrap .table-wrapper.filtered {
        min-height: 0 !important;
    }

    #FreightInvoicePage .fi-list-grid-wrap .paginator {
        flex-shrink: 0;
        padding: 10px 16px 14px;
        border-top: 1px solid #eef2ff;
        background: #fafbff;
        margin-top: 0;
        font-size: 12px;
    }

    #FreightInvoicePage .fi-list-grid-wrap #tblFiSavedList {
        width: 100%;
        border-collapse: collapse;
        font-size: 12.5px;
        min-width: 860px;
    }

    #FreightInvoicePage .fi-list-grid-wrap #tblFiSavedList thead {
        position: sticky;
        top: 0;
        z-index: 4;
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
    }

    #FreightInvoicePage .fi-list-grid-wrap #tblFiSavedList thead th {
        color: #fff !important;
        background: transparent !important;
        font-weight: 700;
        padding: 10px 12px !important;
        font-size: 11px !important;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border: none !important;
        white-space: nowrap;
    }

    #FreightInvoicePage .fi-list-grid-wrap #tblFiSavedList tbody td {
        padding: 8px 12px !important;
        font-size: 12.5px !important;
        border-bottom: 1px solid #eef0f8 !important;
        vertical-align: middle;
    }

    #FreightInvoicePage .fi-compact-list {
        cursor: help;
        border-bottom: 1px dotted currentColor;
    }

    #FreightInvoicePage .fi-view-value .fi-compact-list {
        cursor: help;
    }

    #FreightInvoicePage .fi-list-grid-wrap #tblFiSavedList tbody tr:nth-child(even) {
