@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Transactions/js/NotificationsDashboard.js?v=20261021a"></script>
<style>
    #NotificationsDashboardPage {
        --nd-ink: #0f172a;
        --nd-body: #334155;
        --nd-muted: #64748b;
        --nd-line: #e2e8f0;
        --nd-primary: #6366f1;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        padding: 14px 14px 28px;
        color: var(--nd-body);
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        background: linear-gradient(160deg, #eef2ff 0%, #f8fafc 42%, #f1f5f9 100%);
        min-height: calc(100vh - var(--erp-header-height, 55px) - var(--erp-footer-height, 34px));
    }

    #NotificationsDashboardPage *,
    #NotificationsDashboardPage *::before,
    #NotificationsDashboardPage *::after { box-sizing: border-box; }

    .nd-header {
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 45%, #7c3aed 100%);
        border-radius: 18px;
        padding: 20px 24px;
        margin-bottom: 16px;
        box-shadow: 0 10px 28px rgba(79, 70, 229, .28);
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }
    .nd-header::before {
        content: '';
        position: absolute;
        top: -48px; right: -20px;
        width: 180px; height: 180px;
        background: rgba(255,255,255,.08);
        border-radius: 50%;
    }
    .nd-header::after {
        content: '';
        position: absolute;
        bottom: -60px; left: 28%;
        width: 220px; height: 220px;
        background: rgba(255,255,255,.05);
        border-radius: 50%;
    }

    .nd-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
        position: relative;
        z-index: 1;
    }
    .nd-header-icon {
        width: 48px; height: 48px; border-radius: 14px;
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.28);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 1.2rem; flex-shrink: 0;
    }
    .nd-header-title { margin: 0; font-size: 1.28rem; font-weight: 800; color: #fff; letter-spacing: -.02em; }
    .nd-header-sub { margin: 3px 0 0; font-size: 13px; color: rgba(255,255,255,.82); font-weight: 500; }

    .nd-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
    }
    .nd-stat-chip {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
        min-width: 92px;
        padding: 8px 14px;
        border-radius: 12px;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.28);
        color: #fff;
        backdrop-filter: blur(8px);
    }
    .nd-stat-chip strong { font-size: 18px; font-weight: 800; line-height: 1.1; }
    .nd-stat-chip span { font-size: 11px; opacity: .85; font-weight: 600; }
    .nd-refresh-btn {
        width: 42px; height: 42px; border-radius: 12px;
        border: 1px solid rgba(255,255,255,.32);
        background: rgba(255,255,255,.16);
        color: #fff;
        display: inline-flex; align-items: center; justify-content: center;
        cursor: pointer;
        transition: background .2s, transform .2s;
    }
    .nd-refresh-btn:hover { background: rgba(255,255,255,.28); transform: rotate(-20deg); }

    .nd-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }

    .nd-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 14px 14px 12px;
        text-decoration: none;
        color: #fff;
        background: var(--nd-fill, linear-gradient(135deg, #6366f1, #4f46e5));
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 20px var(--nd-shadow, rgba(79, 70, 229, .28));
        overflow: hidden;
        transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
        cursor: pointer;
    }
    .nd-card::before {
        content: '';
        position: absolute;
        top: -36px; right: -28px;
        width: 96px; height: 96px;
        border-radius: 50%;
        background: rgba(255,255,255,.16);
        pointer-events: none;
    }
    .nd-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 26px var(--nd-shadow, rgba(79, 70, 229, .38));
        filter: brightness(1.05);
        text-decoration: none;
        color: #fff;
    }
    .nd-card.is-disabled { opacity: .65; cursor: not-allowed; transform: none; filter: none; }

    .nd-accent-0 {
        --nd-fill: linear-gradient(135deg, #fb7185 0%, #e11d48 100%);
        --nd-shadow: rgba(225, 29, 72, .35);
    }
    .nd-accent-1 {
        --nd-fill: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
        --nd-shadow: rgba(217, 119, 6, .35);
    }
    .nd-accent-2 {
        --nd-fill: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%);
        --nd-shadow: rgba(37, 99, 235, .35);
    }
    .nd-accent-3 {
        --nd-fill: linear-gradient(135deg, #34d399 0%, #059669 100%);
        --nd-shadow: rgba(5, 150, 105, .35);
    }
    .nd-accent-4 {
        --nd-fill: linear-gradient(135deg, #c084fc 0%, #7c3aed 100%);
        --nd-shadow: rgba(124, 58, 237, .35);
    }
    .nd-accent-5 {
        --nd-fill: linear-gradient(135deg, #2dd4bf 0%, #0f766e 100%);
        --nd-shadow: rgba(15, 118, 110, .35);
    }

    .nd-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        position: relative;
        z-index: 1;
    }
    .nd-card-icon {
        width: 32px; height: 32px; border-radius: 10px; flex-shrink: 0;
        display: inline-flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,.22);
        border: 1px solid rgba(255,255,255,.3);
        color: #fff;
        font-size: 13px;
    }
    .nd-card-time {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        border-radius: 999px;
        background: rgba(255,255,255,.2);
        border: 1px solid rgba(255,255,255,.28);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .nd-card-main {
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
        z-index: 1;
        min-width: 0;
    }
    .nd-card-count {
        flex-shrink: 0;
        font-size: 32px;
        font-weight: 800;
        color: #fff;
        line-height: .9;
        letter-spacing: -.04em;
        text-shadow: 0 2px 8px rgba(0,0,0,.12);
        min-width: 40px;
    }
    .nd-card-info { flex: 1; min-width: 0; }
    .nd-card-title {
        margin: 0;
        font-size: 13px;
        font-weight: 800;
        color: #fff;
        line-height: 1.25;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .nd-card-count-label {
        margin-top: 2px;
        font-size: 10px;
        font-weight: 700;
        color: rgba(255,255,255,.82);
        text-transform: uppercase;
        letter-spacing: .05em;
    }
    .nd-card-go {
        width: 26px; height: 26px; border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,.2);
        border: 1px solid rgba(255,255,255,.3);
        color: #fff;
        font-size: 10px;
        flex-shrink: 0;
    }

    .nd-loading, .nd-empty {
        display: none;
        text-align: center;
        padding: 56px 16px;
        color: var(--nd-muted);
        font-weight: 600;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
    }
    .nd-loading i, .nd-empty i { display: block; font-size: 30px; margin-bottom: 12px; color: var(--nd-primary); }

    @@media (max-width: 1100px) {
        .nd-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
        .nd-card-title { font-size: 12px; }
        .nd-card-count { font-size: 28px; min-width: 34px; }
    }
    @@media (max-width: 900px) {
        .nd-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media (max-width: 640px) {
        #NotificationsDashboardPage { padding: 10px 10px 20px; }
        .nd-header { padding: 16px; border-radius: 14px; }
        .nd-grid { grid-template-columns: 1fr; }
        .nd-stat-chip { min-width: 0; }
    }
</style>

<div id="NotificationsDashboardPage">
    <div class="nd-header">
        <div class="nd-header-left">
            <div class="nd-header-icon"><i class="fas fa-bell"></i></div>
            <div>
                <h1 class="nd-header-title" id="ERPHeading">Notifications Dashboard</h1>
                <p class="nd-header-sub" id="nd-dashboard-name">Pending work items assigned to you</p>
            </div>
        </div>
        <div class="nd-header-actions">
            <button type="button" id="btnBackToUserDashboardMenu" class="btn btn-light btn-sm" title="Back to User Dashboard Menu" style="display:none;">
                <i class="fas fa-arrow-left"></i> Back
            </button>
            <div class="nd-stat-chip">
                <strong id="nd-total-pending">0</strong>
                <span>Pending</span>
            </div>
            <div class="nd-stat-chip">
                <strong id="nd-count-badge">0</strong>
                <span>Notifications</span>
            </div>
            <button type="button" id="btnNdRefresh" class="nd-refresh-btn" title="Refresh" aria-label="Refresh">
                <i class="fas fa-rotate"></i>
            </button>
        </div>
    </div>

    <div id="nd-loading" class="nd-loading">
        <i class="fas fa-spinner fa-spin"></i>
        Loading notifications…
    </div>
    <div id="nd-empty" class="nd-empty">
        <i class="fas fa-inbox"></i>
        <div id="nd-empty-text">You have no new notifications.</div>
    </div>
    <div id="nd-grid" class="nd-grid" style="display:none;"></div>
</div>
