@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
<link href="~/_content/Bizsol.WebERP.UI.Shared/components/DateRangeControl/DateRangeControl.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Shared/components/DateRangeControl/DateRangeControl.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.Shared/components/FilterSidePanelControl/FilterSidePanelControl.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Transactions/js/ProjectDetailDashboard.js"></script>


<style>
    /* ── GLOBAL ─────────────────────────────────────────────────── */
    .pdd-wrap {
        background: linear-gradient(135deg, #f0f4ff 0%, #faf5ff 50%, #f0fdf4 100%);
        min-height: 100vh;
        padding: 4px;
    }

    /* ── PAGE HEADER BANNER ─────────────────────────────────────── */
    .pdd-page-header {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #6366f1 100%);
        border-radius: 18px;
        padding: 20px 28px 18px;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(99,102,241,0.3);
    }
    .pdd-page-header::before {
        content: '';
        position: absolute;
        top: -40px; right: -40px;
        width: 200px; height: 200px;
        background: rgba(255,255,255,0.07);
        border-radius: 50%;
    }
    .pdd-page-header::after {
        content: '';
        position: absolute;
        bottom: -60px; left: 30%;
        width: 280px; height: 280px;
        background: rgba(255,255,255,0.04);
        border-radius: 50%;
    }
    .pdd-header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        z-index: 1;
    }
    .pdd-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .pdd-header-icon {
        width: 48px; height: 48px;
        background: rgba(255,255,255,0.2);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; color: #fff;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.25);
    }
    .pdd-header-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.02em;
    }
    .pdd-header-subtitle {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.7);
        margin-top: 2px;
        font-weight: 500;
    }
    .pdd-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }
    .pdd-header-reset {
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.35);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 5px 14px;
        border-radius: 20px;
        backdrop-filter: blur(10px);
        cursor: pointer;
        transition: background 0.2s;
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .pdd-header-reset:hover {
        background: rgba(255,255,255,0.25);
    }
    .pdd-header-badge {
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 5px 14px;
        border-radius: 20px;
        backdrop-filter: blur(10px);
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    /* Filter button — integrated in header (works on desktop & mobile) */
    .pdd-filter-btn {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.45);
        background: linear-gradient(135deg, #818cf8 0%, #a78bfa 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        flex-shrink: 0;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .pdd-filter-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.28);
    }
    .pdd-filter-btn i {
        font-size: 1rem;
    }
    .pdd-filter-btn-text {
        display: none;
    }

    /* ── MOBILE RESPONSIVE ───────────────────────────────────────── */
    @@media (max-width: 768px) {
        .pdd-wrap {
            padding: 2px;
            min-height: auto;
            overflow-x: hidden;
            padding-bottom: 20px;
        }
        .pdd-page-header {
            padding: 14px 14px 12px;
            margin-bottom: 14px;
            border-radius: 14px;
            overflow: visible;
        }
        .pdd-header-content {
            flex-direction: row;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
        }
        .pdd-header-left {
            flex: 1;
            min-width: 0;
        }
        .pdd-header-left > div:last-child {
            min-width: 0;
            flex: 1;
        }
        .pdd-header-icon {
            width: 40px;
            height: 40px;
            font-size: 1.1rem;
            border-radius: 12px;
            flex-shrink: 0;
        }
        .pdd-header-title {
            font-size: 1.05rem;
            line-height: 1.25;
        }
        .pdd-header-subtitle {
            font-size: 0.68rem;
            line-height: 1.35;
        }
        .pdd-header-actions {
            justify-content: flex-end;
            flex-wrap: nowrap;
            gap: 8px;
            margin-left: auto;
        }
        .pdd-header-reset {
            padding: 7px 12px;
            font-size: 0.68rem;
        }
        .pdd-header-badge {
            padding: 7px 12px;
            font-size: 0.68rem;
        }
        .pdd-filter-btn {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
        }
        .pdd-filter-btn i {
            font-size: 0.95rem;
        }
        .pdd-chart-area {
            position: relative;
            width: 100%;
            max-width: 100%;
            overflow: hidden;
        }
        .pdd-chart-area-donut {
            height: 160px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .pdd-chart-area-bar {
            height: 210px;
        }
        .pdd-chart-area-pie {
            height: 150px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .pdd-chart-area-line {
            height: 110px;
        }
        .pdd-chart-area-exp {
            height: 135px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .pdd-bva-stats-row {
            grid-template-columns: 1fr;
            gap: 0;
            padding: 10px 12px;
        }
        .pdd-bva-divider {
            display: none;
        }
        .pdd-bva-stat {
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-align: left;
            padding: 8px 4px;
            border-bottom: 1px solid #e0e7ff;
        }
        .pdd-bva-stat:last-child {
            border-bottom: none;
        }
        .bva-val {
            font-size: 1rem;
        }
        .pdd-chart-header {
            flex-wrap: wrap;
            gap: 6px;
        }
        .pdd-chart-title {
            font-size: 0.82rem;
        }
        .pdd-legend-row {
            font-size: 0.78rem;
        }
        .pdd-exp-total-box {
            flex-wrap: wrap;
            gap: 4px;
        }
        .pdd-exp-total-val {
            font-size: 0.95rem;
        }
        .pdd-kpi-grid {
            gap: 12px;
            margin-bottom: 14px;
        }
        .pdd-kpi-card {
            padding: 16px 16px 14px;
            border-radius: 14px;
        }
        .pdd-kpi-icon {
            width: 44px;
            height: 44px;
            font-size: 1.15rem;
            border-radius: 12px;
        }
        .pdd-kpi-value {
            font-size: 1.45rem;
        }
        .pdd-kpi-label {
            font-size: 0.7rem;
        }
        .pdd-chart-card {
            padding: 14px 14px 12px;
            border-radius: 14px;
        }
        .pdd-chart-row,
        .pdd-chart-row-3 {
            gap: 12px;
            margin-bottom: 12px;
        }
    }

    @@media (max-width: 480px) {
        .pdd-header-reset span.pdd-reset-text {
            display: none;
        }
        .pdd-header-badge span.pdd-live-text {
            display: none;
        }
        .pdd-header-reset {
            padding: 8px 10px;
        }
        .pdd-header-badge {
            padding: 8px 10px;
        }
        .pdd-kpi-value {
            font-size: 1.3rem;
        }
        .pdd-kpi-badge {
            font-size: 0.62rem;
        }
    }

    /* ── FILTER BAR ─────────────────────────────────────────────── */
    .pdd-filter-bar {
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.9);
        border-radius: 18px;
        padding: 18px 24px 16px;
        margin-bottom: 20px;
        box-shadow: 0 4px 24px rgba(99,102,241,0.08), 0 1px 4px rgba(0,0,0,0.04);
        position: relative;
        overflow: hidden;
    }
    .pdd-filter-bar::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, #6366f1, #8b5cf6, #a78bfa);
        border-radius: 18px 18px 0 0;
    }
    .pdd-filter-bar .form-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: #6366f1;
        margin-bottom: 5px;
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .pdd-filter-bar .form-control,
    .pdd-filter-bar .form-select {
        border: 1.5px solid #e0e7ff;
        border-radius: 10px;
        font-size: 0.82rem;
        background: #fafaff;
        color: #1e1b4b;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        padding: 7px 12px;
    }
    .pdd-filter-bar .form-control:focus,
    .pdd-filter-bar .form-select:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
        background: #fff;
        outline: none;
    }
    .pdd-btn-show {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0 16px;
        font-size: 0.83rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        width: 100%;
        box-shadow: 0 4px 14px rgba(99,102,241,0.35);
        letter-spacing: 0.02em;
        height: 33px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }
    .pdd-btn-show:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(99,102,241,0.45);
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    }
    .pdd-btn-show:active { transform: translateY(0); }
    .pdd-btn-reset {
        background: #fff;
        color: #6366f1;
        border: 1.5px solid #e0e7ff;
        border-radius: 10px;
        padding: 0 16px;
        font-size: 0.83rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        width: 100%;
        height: 33px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }
    .pdd-btn-reset:hover {
        background: #f5f3ff;
        border-color: #a78bfa;
        color: #7c3aed;
    }

    /* ── KPI CARDS ──────────────────────────────────────────────── */
    .pdd-kpi-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }
    @@media (max-width: 1400px) { .pdd-kpi-grid { grid-template-columns: repeat(3,1fr); } }
    @@media (max-width: 900px)  { .pdd-kpi-grid { grid-template-columns: repeat(2,1fr); } }
    @@media (max-width: 600px)  { .pdd-kpi-grid { grid-template-columns: 1fr; } }

    .pdd-kpi-card {
        border-radius: 18px;
        padding: 20px 20px 16px;
        display: flex;
        align-items: flex-start;
        gap: 15px;
        transition: transform 0.2s, box-shadow 0.2s;
        position: relative;
        overflow: hidden;
        cursor: default;
    }
    .pdd-kpi-card.pdd-kpi-click {
        cursor: pointer;
    }
    .pdd-kpi-card.pdd-kpi-click:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.18);
    }
    .pdd-kpi-card::after {
        content: '';
        position: absolute;
        bottom: -30px; right: -20px;
        width: 100px; height: 100px;
        border-radius: 50%;
        background: rgba(255,255,255,0.12);
    }
    .pdd-kpi-card:hover { transform: translateY(-4px); }

    .pdd-kpi-card.kpi-red {
        background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
        box-shadow: 0 8px 24px rgba(238,90,36,0.3);
    }
    .pdd-kpi-card.kpi-amber {
        background: linear-gradient(135deg, #fdcb6e 0%, #e17055 100%);
        box-shadow: 0 8px 24px rgba(225,112,85,0.3);
    }
    .pdd-kpi-card.kpi-purple {
        background: linear-gradient(135deg, #a29bfe 0%, #6c5ce7 100%);
        box-shadow: 0 8px 24px rgba(108,92,231,0.35);
    }
    .pdd-kpi-card.kpi-green {
        background: linear-gradient(135deg, #55efc4 0%, #00b894 100%);
        box-shadow: 0 8px 24px rgba(0,184,148,0.3);
    }
    .pdd-kpi-card.kpi-blue {
        background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);
        box-shadow: 0 8px 24px rgba(9,132,227,0.3);
    }

    .pdd-kpi-icon {
        width: 50px; height: 50px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; flex-shrink: 0;
        background: rgba(255,255,255,0.22);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.3);
        backdrop-filter: blur(8px);
    }
    .pdd-kpi-body { flex: 1; position: relative; z-index: 1; }
    .pdd-kpi-value {
        font-size: 1.75rem;
        font-weight: 900;
        color: #fff;
        line-height: 1.1;
        letter-spacing: -0.03em;
        text-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .pdd-kpi-label {
        font-size: 0.73rem;
        color: rgba(255,255,255,0.85);
        font-weight: 600;
        margin-top: 3px;
        line-height: 1.3;
    }
    .pdd-kpi-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 8px;
        font-size: 0.66rem;
        font-weight: 700;
        border-radius: 20px;
        padding: 3px 10px;
        letter-spacing: 0.05em;
        background: rgba(255,255,255,0.25);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.35);
    }

    /* ── CHART CARDS ────────────────────────────────────────────── */
    .pdd-chart-row {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 16px;
        margin-bottom: 18px;
    }
    .pdd-chart-row-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 16px;
        margin-bottom: 18px;
    }
    @@media (max-width: 900px) {
        .pdd-chart-row, .pdd-chart-row-3 { grid-template-columns: 1fr; }
    }

    .pdd-chart-card {
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(20px);
        border-radius: 18px;
        padding: 20px 22px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06), 0 1px 4px rgba(0,0,0,0.03);
        border: 1px solid rgba(255,255,255,0.9);
        position: relative;
        overflow: hidden;
        transition: box-shadow 0.2s;
    }
    .pdd-chart-card:hover {
        box-shadow: 0 8px 32px rgba(99,102,241,0.12), 0 2px 8px rgba(0,0,0,0.06);
    }
    .pdd-chart-card.accent-indigo::before  { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,#6366f1,#8b5cf6); border-radius:18px 18px 0 0; }
    .pdd-chart-card.accent-emerald::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,#10b981,#34d399); border-radius:18px 18px 0 0; }
    .pdd-chart-card.accent-amber::before   { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,#f59e0b,#fbbf24); border-radius:18px 18px 0 0; }
    .pdd-chart-card.accent-violet::before  { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,#8b5cf6,#c084fc); border-radius:18px 18px 0 0; }
    .pdd-chart-card.accent-rose::before    { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,#ef4444,#f97316); border-radius:18px 18px 0 0; }

    .pdd-chart-header {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 14px;
    }
    .pdd-chart-title-wrap { display: flex; align-items: center; gap: 8px; }
    .pdd-chart-title-icon {
        width: 32px; height: 32px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.85rem;
    }
    .pdd-chart-title-icon.ti-indigo  { background: #eef2ff; color: #6366f1; }
    .pdd-chart-title-icon.ti-emerald { background: #ecfdf5; color: #10b981; }
    .pdd-chart-title-icon.ti-amber   { background: #fffbeb; color: #f59e0b; }
    .pdd-chart-title-icon.ti-violet  { background: #f5f3ff; color: #8b5cf6; }
    .pdd-chart-title-icon.ti-rose    { background: #fff1f2; color: #ef4444; }

    .pdd-chart-title {
        font-size: 0.87rem; font-weight: 800; color: #1e293b; line-height: 1.2;
    }
    .pdd-chart-title span { font-size: 0.7rem; font-weight: 500; color: #94a3b8; display:block; }
    .pdd-chart-action {
        font-size: 0.68rem; font-weight: 700; border-radius: 8px;
        padding: 4px 12px;
        background: linear-gradient(135deg, #eef2ff, #f5f3ff);
        color: #6366f1;
        border: 1px solid #e0e7ff;
        cursor: pointer;
        transition: all 0.15s;
        text-decoration: none;
    }
    .pdd-chart-action:hover { background: linear-gradient(135deg,#6366f1,#8b5cf6); color:#fff; border-color:transparent; }

    /* ── DONUT LEGEND ───────────────────────────────────────────── */
    .pdd-legend { margin-top: 14px; }
    .pdd-legend-row {
        display: flex; align-items: center; justify-content: space-between;
        font-size: 0.78rem; color: #475569; padding: 5px 0;
        border-bottom: 1px dashed #f1f5f9;
    }
    .pdd-legend-row:last-child { border-bottom: none; }
    .pdd-legend-dot-wrap { display: flex; align-items: center; gap: 7px; }
    .pdd-legend-row .dot {
        width: 10px; height: 10px; border-radius: 3px; display: inline-block;
    }
    .pdd-legend-row .lbl { flex: 1; font-weight: 500; }
    .pdd-legend-row .val { font-weight: 800; color: #1e293b; }
    .pdd-legend-divider { border-top: 2px solid #f1f5f9; margin: 8px 0; }
    .pdd-legend-total {
        font-size: 0.82rem; font-weight: 800; color: #1e293b;
        background: #f8faff; border-radius: 8px; padding: 6px 8px;
        border: none !important;
    }

    /* ── BUDGET VS ACTUAL ───────────────────────────────────────── */
    .pdd-bva-stats-row {
        display: grid; grid-template-columns: 1fr 1px 1fr 1px 1fr;
        gap: 0; background: linear-gradient(135deg,#f8faff,#f5f3ff);
        border-radius: 14px; padding: 14px 10px; margin-bottom: 14px;
        border: 1px solid #e0e7ff;
    }
    .pdd-bva-stat { text-align: center; padding: 0 12px; }
    .bva-lbl { font-size: 0.68rem; color: #6366f1; font-weight: 700; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.06em; }
    .bva-val { font-size: 1.15rem; font-weight: 900; color: #1e293b; }
    .pdd-bva-divider { background: #e0e7ff; align-self: stretch; width: 1px; }

    .pdd-utilization-wrap { margin-bottom: 14px; }
    .pdd-utilization-label {
        font-size: 0.7rem; color: #64748b; font-weight: 700;
        margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.06em;
        display: flex; align-items: center; justify-content: space-between;
    }
    .pdd-progress-outer {
        background: #f1f5f9; border-radius: 20px; height: 16px;
        overflow: hidden; position: relative;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.06);
    }
    .pdd-progress-inner {
        height: 100%; border-radius: 20px;
        background: linear-gradient(90deg, #6366f1, #8b5cf6, #a78bfa);
        transition: width 1.2s cubic-bezier(.4,0,.2,1);
        min-width: 4px;
        position: relative;
        overflow: hidden;
    }
    .pdd-progress-inner::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        animation: pdd-shimmer 2s infinite;
    }
    @@keyframes pdd-shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
