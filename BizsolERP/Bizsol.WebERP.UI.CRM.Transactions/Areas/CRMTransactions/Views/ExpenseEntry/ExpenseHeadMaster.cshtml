@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<script src="~/assets/js/jquery-3.6.0.min.js"></script>
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.CRM.Transactions/css/ExpenseEntry.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Transactions/js/ExpenseHeadMaster.js"></script>

<div id="locateExpenseHeadMaster" class="row g-3 mx-0">
    <div class="expense-entry-card col-12 col-lg-10 col-xl-8">
        <div class="d-flex flex-wrap gap-2 justify-content-end">
            <button type="button" onclick="CreateNew_ExpenseHeadMaster()" title="Create New" class="btn btn-success btn-height">Create New</button>
            <button type="button" id="btnExpenseEntryListDetails" title="Back" class="btn btn-secondary btn-height">Back</button>
        </div>
    </div>
    <div class="expense-entry-card expense-entry-card-table col-12 col-lg-10 col-xl-8" id="cardExpenseHeadMaster">
        <div id="tblExpenseHeadMaster">
            <div class="expense-entry-table-wrapper">
                <table id="ExpenseHeadMaster" class="fixed-width-table table">
                    <thead id="table-header-ExpenseHeadMaster"></thead>
                    <tbody id="table-body-ExpenseHeadMaster"></tbody>
                </table>
            </div>
            <div class="paginator" id="paginator-ExpenseHeadMaster"></div>
        </div>
    </div>
</div>

<div id="newCreateForm" class="row g-3" style="display:none">
    <div class="expense-entry-card col-12 col-lg-10 col-xl-8">
    <form>
        <input type="hidden" name="Code" id="Code" value="0">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-md-3">
                <label for="txtExpenseDescription" class="form-label fw-bold">Expense Description <span class="text-danger">*</span></label>
                <input id="txtExpenseDescription" type="text" name="txtExpenseDescription" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Expense Description" maxlength="50" required />
            </div>
            <div class="col-12 col-sm-6 col-md-3 mb-2">
                <label for="ddlExpenseGroup" class="form-label fw-bold">Expense Group <span class="text-danger">*</span></label>
                <select id="ddlExpenseGroup" class="form-control form-control-sm box_border"></select>
            </div>
            <div class="col-12 col-sm-auto d-flex align-items-end" style="margin-bottom:0.9rem">
                <div class="form-check form-switch ms-1">
                    <input class="form-check-input" type="checkbox" id="chkIsKMApplicable" onchange="ToggleKMApplicableLabel()" />
                    <label class="form-check-label fw-bold" for="chkIsKMApplicable">Is KM Applicable</label>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-auto without-label-field" style="margin-bottom:0.8rem">
                <button type="button" id="btnExpenseEntryListBack" class="btn btn-secondary btn-height" title="Back" onclick="ExpenseHeadMaster_Back()">Back</button>
            </div>
        </div>
    </form>
    </div>
</div>

<div id="newCreateFormExpenseHeadLimit" class="row g-3" style="display:none">
    <div class="expense-entry-card col-12 col-lg-10 col-xl-8">
    <form>
        <div class="row g-3 align-items-end">
                <div class="col-12 col-sm-6 col-md-4" style="margin-bottom:auto">
                <label for="txtDesignation" class="form-label fw-bold">Designation Category <span class="text-danger">*</span></label>
                <select id="txtDesignation" class="form-control form-control-sm box_border"></select>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
                <label for="txtEffectiveDate" class="form-label fw-bold">Effective Date <span class="text-danger">*</span></label>
                <input type="date" id="txtEffectiveDate" name="txtEffectiveDate" class="box_border form-control form-control-sm" required />
            </div>
            <div class="col-12 col-sm-6 col-md-4">
                <label for="txtPerDayLimit" class="form-label fw-bold" id="lblPerDayLimit">Per Day Limit</label>
                <input id="txtPerDayLimit" type="text" name="txtPerDayLimit" class="box_border form-control form-control-sm text-end" autocomplete="off" maxlength="8" oninput="validateDecimalInput(this)" />
            </div>
            <div class="col-12 col-sm-6 col-md-4 without-label-field">
                <button type="button" onclick="submit_ExpenseHeadMaster()" id="saveExpenseHeadMasterButton" title="Save" class="btn btn-success btn-height">Save</button>
            </div>
        </div>
    </form>
    </div>
</div>

<div class="row g-3" id="rowExpenseHeadLimitDetails" style="display:none">
    <div class="expense-entry-card expense-entry-card-table col-12 col-lg-10 col-xl-8" id="cardExpenseHeadLimitDetails">
        <div id="tblExpenseHeadLimitDetails">
        <div class="expense-entry-table-wrapper expense-entry-table-limit">
            <table id="ExpenseHeadLimitDetails" class="fixed-width-table table">
                <thead id="table-header-ExpenseHeadLimitDetails"></thead>
                <tbody id="table-body-ExpenseHeadLimitDetails"></tbody>
            </table>
        </div>
        <div class="paginator" id="paginator-ExpenseHeadLimitDetails"></div>
        </div>
    </div>
</div>

<!-- Delete confirmation modal -->
<div id="ehmDeleteBackdrop" class="ee-backdrop">
    <div class="ee-delete-modal">
        <div class="ee-delete-icon-wrap"><i class="fas fa-trash-can"></i></div>
        <div class="ee-delete-title">Delete this Expense Head?</div>
        <div class="ee-delete-text">This action cannot be undone. The expense head will be permanently removed.</div>
        <div class="ee-delete-reason">
            <label class="ee-delete-reason-label">
                <i class="fas fa-comment-dots"></i> Reason for Delete <span class="text-danger">*</span>
            </label>
            <input type="text" id="ehmReasonForDeleteInput" class="ee-delete-reason-input" placeholder="Enter reason for deletion…" autocomplete="off" />
        </div>
        <div class="ee-delete-actions">
            <button type="button" class="ee-btn-cancel" onclick="CloseDeleteEHMModal()"><i class="fas fa-times"></i> Cancel</button>
            <button type="button" class="ee-btn-confirm-delete" onclick="ConfirmDeleteExpenseHead()"><i class="fas fa-trash-can"></i> Yes, Delete</button>
        </div>
    </div>
</div>

<!-- Success modal -->
<div id="eeSuccessBackdrop" class="ee-backdrop">
    <div class="ee-success-modal">
        <div class="ee-success-icon-wrap"><i id="eeSuccessModalIcon" class="fas fa-circle-check"></i></div>
        <div class="ee-success-title" id="eeSuccessModalTitle">Done!</div>
        <div class="ee-success-text" id="eeSuccessModalText">Operation completed successfully.</div>
        <button type="button" class="ee-btn-success-ok" onclick="CloseExpenseHeadMasterSuccessModal()"><i class="fas fa-check"></i> OK</button>
    </div>
</div>
