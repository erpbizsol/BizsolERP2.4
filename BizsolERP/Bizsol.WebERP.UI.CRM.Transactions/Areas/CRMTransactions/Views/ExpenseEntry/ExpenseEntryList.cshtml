@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<script src="~/assets/js/jquery-3.6.0.min.js"></script>
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.CRM.Transactions/css/ExpenseEntry.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Transactions/js/ExpenseEntryList.js"></script>
<style>
    .btn:not(:disabled):not(.disabled) { cursor: pointer !important; }
</style>

<div class="ee-page">
    <!-- PO Store–style: purple header + stats strip + attached filter (see PurchaseOrderStore.cshtml) -->
    <div class="ee-list-header section-entry-animation">
        <div class="ee-list-header-top">
            <div class="ee-list-header-title-block">
                <h2 class="ee-list-header-title"><i class="fa fa-file-invoice me-2" aria-hidden="true"></i>Expense Entry</h2>
                <small class="ee-list-header-sub">Manage and track all expense entries.</small>
            </div>
            <div class="ee-list-header-actions">
                <button type="button" id="btnExpenseEntryConfig" class="ee-list-header-icon-btn ee-list-header-icon-btn--settings" title="Expense head configuration"><i class="fas fa-gear" aria-hidden="true"></i></button>
                <button type="button" id="btnAddExpenseEntryHero" class="ee-list-create-btn">
                    <i class="fa fa-plus-circle" aria-hidden="true"></i>
                    <span class="ee-list-create-btn-label ms-1">Create New Expense</span>
                </button>
            </div>
        </div>
        <div class="ee-list-stats-strip" role="group" aria-label="Summary">
            <button type="button" class="ee-list-stat-chip" id="eeStatCardTotal" title="Scroll to list">
                <span class="val" id="eeStatTotal">—</span>
                <span class="lbl">Total</span>
            </button>
            <button type="button" class="ee-list-stat-chip ee-list-stat-chip--pending" id="eeStatCardPending" title="Filter: Pending &amp; Rejected">
                <span class="val" id="eeStatPending">—</span>
                <span class="lbl">Pending</span>
            </button>
            <button type="button" class="ee-list-stat-chip ee-list-stat-chip--onme ee-list-stat-chip--link" id="eeStatCardPendingOnMe" title="Open approvals pending on you">
                <span class="val" id="eeStatPendingOnMe">—</span>
                <span class="lbl">Pending on me</span>
            </button>
            <button type="button" class="ee-list-stat-chip ee-list-stat-chip--approved" id="eeStatCardApproved" title="Filter: Approved (Verified)">
                <span class="val" id="eeStatApproved">—</span>
                <span class="lbl">Approved</span>
            </button>
        </div>
    </div>

    <!-- Filters (flush under header, PO filter-bar style) -->
    <div class="ee-list-filter-bar">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-sm-6 col-md-4 col-lg-2">
            <div class="ee-fg">
                <label for="txtFromDate">From Date <span class="text-danger">*</span></label>
                <input type="date" id="txtFromDate" name="FromDate" autocomplete="off" required />
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-2">
            <div class="ee-fg">
                <label for="txtToDate">To Date <span class="text-danger">*</span></label>
                <input type="date" id="txtToDate" name="ToDate" autocomplete="off" required />
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <label for="ddlMarketingMan" class="form-label">Sales Person <span class="text-danger">*</span></label>
            <input list="ddlSalesPersonList" id="ddlMarketingMan" name="ddlMarketingMan" class="form-control form-control-sm box_border" placeholder="Sales Person" autocomplete="off" required>
            <datalist id="ddlSalesPersonList"></datalist>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-2">
            <label for="ddlListStatus" class="form-label">Status</label>
            <select id="ddlListStatus" class="form-control form-control-sm box_border">
                <option value="ALL">-- All Status --</option>
                <option value="PENDING_ALL">Pending &amp; Rejected</option>
                <option value="Unverified">Unverified</option>
                <option value="Pending">Pending Approval</option>
                <option value="Verified">Verified</option>
                <option value="Rejected">Rejected</option>
            </select>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-1 without-label-field" style="margin-bottom:0.5rem">
            <div class="expense-entry-actions ee-list-toolbar">
                <button type="button" id="btnShow" class="btn btn-primary btn-height"><i class="fas fa-search me-1"></i>Show</button>
            </div>
        </div>
    </div>
    </div>

<div class="expense-entry-card expense-entry-card-table ee-list-grid-wrap" id="cardExpenseEntryList">
    <div id="tblExpenseEntryList">
        <div class="expense-entry-table-wrapper">
            <table id="ExpenseEntryList" class="fixed-width-table table">
                <thead id="ExpenseEntryList-header"></thead>
                <tbody id="ExpenseEntryList-body"></tbody>
            </table>
        </div>
        <div class="paginator" id="paginator-ExpenseEntryList"></div>
    </div>
</div>
</div>

<!-- Delete confirmation modal (VendorMaster pattern) -->
<div id="eeDeleteConfirmBackdrop" class="ee-backdrop">
    <div class="ee-delete-modal">
        <div class="ee-delete-icon-wrap"><i class="fas fa-trash-can"></i></div>
        <div class="ee-delete-title">Delete this Expense Entry?</div>
        <div class="ee-delete-text">This action cannot be undone. The expense entry will be permanently removed.</div>
        <div class="ee-delete-reason">
            <label class="ee-delete-reason-label">
                <i class="fas fa-comment-dots"></i> Reason for Delete <span class="text-danger">*</span>
            </label>
            <input type="text" id="eeReasonForDeleteInput" class="ee-delete-reason-input" placeholder="Enter reason for deletion…" autocomplete="off" />
        </div>
        <div class="ee-delete-actions">
            <button type="button" class="ee-btn-cancel" id="eeBtnCancelDelete"><i class="fas fa-times"></i> Cancel</button>
            <button type="button" class="ee-btn-confirm-delete" onclick="DoExpenseEntryDelete()"><i class="fas fa-trash-can"></i> Yes, Delete</button>
        </div>
    </div>
</div>

<!-- Approved Entries Modal -->
<div id="eeApprovedModal" class="ee-backdrop">
    <div class="ee-approved-modal">
        <div class="ee-approved-modal-header">
            <div class="ee-approved-modal-title">
                <i class="fas fa-circle-check me-2"></i>Approved Expense Entries
            </div>
            <button type="button" class="ee-approved-modal-close" onclick="closeApprovedEntriesModal()" title="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="ee-approved-modal-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Person Name</th>
                            <th>Entry No</th>
                            <th>Entry Date</th>
                            <th class="text-end">Expended Amount</th>
                            <th class="text-end">Allowed Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="eeApprovedModalBody">
                        <tr><td colspan="7" class="text-center py-3"><i class="fas fa-spinner fa-spin me-2"></i>Loading…</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="ee-approved-modal-footer">
            <button type="button" class="ee-btn-cancel" onclick="closeApprovedEntriesModal()">
                <i class="fas fa-times me-1"></i>Close
            </button>
        </div>
    </div>
</div>

<!-- Expense Entry Approval Flow modal (PO Store view pattern) -->
<div class="modal fade" id="eeApprovalFlowModal" tabindex="-1" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content ee-approval-flow-modal">
            <div class="modal-header ee-approval-flow-modal-header">
                <h5 class="modal-title" id="eeApprovalFlowModalTitle">
                    <i class="fa fa-file-invoice-dollar me-2"></i>Expense Entry Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body ee-approval-flow-modal-body" id="eeApprovalFlowModalBody"></div>
            <div class="modal-footer ee-approval-flow-modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" onclick="closeExpenseEntryApprovalFlowModal()">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Line approval history modal (same as Expense Entry Levels Approval) -->
<div class="modal fade" id="modalEeListLineHistory" tabindex="-1" role="dialog" aria-hidden="true" style="z-index:1070;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;overflow:hidden;">
            <div class="modal-header eea-history-modal-header">
                <h5 class="modal-title mb-0">
                    <i class="fa fa-history me-2"></i><span id="eeListHistoryModalTitle">Approval history</span>
                </h5>
                <button type="button" class="btn-close" onclick="CloseEeListLineHistoryModal()" aria-label="Close"></button>
            </div>
            <div class="modal-body eea-history-modal-body">
                <p id="eeListHistoryModalSub" class="eea-history-modal-sub mb-0"></p>
                <div class="table-responsive">
                    <table class="eea-history-table">
                        <thead>
                            <tr>
                                <th style="width:40px;">#</th>
                                <th>Level</th>
                                <th style="width:120px;">Old approved</th>
                                <th style="width:120px;">New approved</th>
                            </tr>
                        </thead>
                        <tbody id="eeListHistoryModalBody">
                            <tr>
                                <td colspan="4" class="text-center py-3" style="color:#0e7499;font-size:0.82rem;">
                                    <i class="fa fa-spinner fa-spin me-1"></i>Loading…
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer eea-history-modal-footer">
                <button type="button" class="btn-eea-history-close" onclick="CloseEeListLineHistoryModal()">
                    <i class="fa fa-times-circle"></i>Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Success modal -->
<div id="eeSuccessBackdrop" class="ee-backdrop">
    <div class="ee-success-modal">
        <div class="ee-success-icon-wrap"><i id="eeSuccessModalIcon" class="fas fa-circle-check"></i></div>
        <div class="ee-success-title" id="eeSuccessModalTitle">Done!</div>
        <div class="ee-success-text" id="eeSuccessModalText">Operation completed successfully.</div>
        <button type="button" class="ee-btn-success-ok" onclick="CloseExpenseEntrySuccessModal()"><i class="fas fa-check"></i> OK</button>
    </div>
</div>
