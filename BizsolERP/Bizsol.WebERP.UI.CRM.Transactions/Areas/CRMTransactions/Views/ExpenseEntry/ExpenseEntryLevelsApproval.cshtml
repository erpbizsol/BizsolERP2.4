<div class="gpa-header section-entry-animation">
    <div>
        <h5><i class="fa fa-clipboard-check me-2"></i>Expense Entry Approval</h5>
        <small>Review and approve expense entries by approval level</small>
    </div>
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
        <div class="gpa-stat-chip">
            <div class="val" id="eeaStatPending">—</div>
            <div class="lbl">Pending</div>
        </div>
        <div class="gpa-stat-chip">
            <div class="val" id="eeaStatApproved">—</div>
            <div class="lbl">Approved</div>
        </div>
        <button type="button" class="btn-ee-back-nav" onclick="NavigateToExpenseEntryList()" title="Back to Expense Entry list">
            <i class="fa fa-arrow-left"></i>
            <span>Back</span>
        </button>
    </div>
</div>

<div class="gpa-filter-bar section-entry-animation">
    <div class="row align-items-end g-2">
        <div class="col-6 col-md-2">
            <label class="form-label">From Date</label>
            <input type="date" id="eeaFromDate" class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">To Date</label>
            <input type="date" id="eeaToDate" class="form-control form-control-sm" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">Search entry / person</label>
            <input type="text" id="eeaLstSearch" class="form-control form-control-sm"
                   placeholder="Entry no. or person name…" autocomplete="off" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">Status</label>
            <select id="eeaDdlStatus" class="form-control form-control-sm form-select">
                <option value="A">-- All Status --</option>
                <option value="P" selected="selected">Pending</option>
                <option value="Y">Approved</option>
                <option value="R">Rejected</option>
            </select>
        </div>
        <div class="col-6 col-md-2 d-flex align-items-end mb-2">
            <a onclick="LoadEntryList()" class="btn-gpa-search w-100 text-center" role="button">
                <i class="fa fa-search"></i>Search
            </a>
        </div>
    </div>
</div>

<div id="eeaPendingList" class="section-entry-animation"></div>

<div id="eeaPendingEmpty" style="display:none;" class="gpa-empty-state section-entry-animation">
