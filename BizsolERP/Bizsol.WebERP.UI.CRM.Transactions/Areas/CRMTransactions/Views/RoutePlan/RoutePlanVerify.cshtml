@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<script src="~/assets/js/jquery-3.6.0.min.js"></script>
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Transactions/js/RoutePlanVerify.js"></script>
<style>
    .highlighted-date {
        background-color: #3926B6;
        color: white;
        border-radius: 30px;
    }

    .datepicker td, .datepicker th {
        border-radius: 20px !important;
    }

    .datepicker table tr td, .datepicker table tr td {
        padding: 8px 9px !important;
        height: 16px !important;
    }

    .datepicker table tfoot {
        display: none;
    }

    #hidetexbox {
        display: none;
    }

    .form-label {
        font-weight: bold;
    }
</style>
@* <div style="text-align:right">
    <input type="button" onclick="CreateNew()" class="btn btn-primary" value="Create New" />
</div> *@

        <div class="row">
            <div class="col-md-2">
                <label for="txtFromDate" class="form-label">From Date  <span class="text-danger">*</span></label>
                <input type="text" id="txtFromDate" name="FromDate" class="form-control form-control-sm box_border" autocomplete="off" />
            </div>
            <div class="col-md-2">
                <label for="txtToDate" class="form-label">To Date  <span class="text-danger">*</span></label>
                <input type="text" id="txtToDate" name="ToDate" class="form-control form-control-sm box_border" autocomplete="off" />
            </div>
            <div class="col-md-2">
                <label for="txtToDate" class="form-label">Status<span class="text-danger">*</span></label>
                <select id="ddlStatus" class="form-control form-control-sm box_border" autocomplete="off">
                    <option value="All">All</option>
                    <option value="P" selected>Pending</option>
                    <option value="Y">Verified</option>
                    <option value="N">Rejected</option>
                </select>
            </div>
            <div class="col-md-2 d-flex mt-4">
                <button type="button" id="btnShow" class="btn btn-primary btn-height btn-width">Show</button>
            </div>
        </div>
<div class="row mb-2">
    @* <div class="col-md-3">
        <input type="text" id="searchBox" class="box_border form-control form-control-sm" placeholder="Search" />
    </div> *@
    <div class="col-md-12 d-flex justify-content-end">
        <input type="button" onclick="VerifyAll()" class="btn btn-primary btn-height me-1" title="Verify All" value="Verify All" />
        <input type="button" onclick="RejectAll()" class="btn btn-danger btn-height" title="Reject All" value="Reject All" />
    </div>
   
</div>
<div class="row" id="tblTable">
<div class="table-wrapper fixed-height-table">
    <table id="table" class="fixed-width-table table">
        <thead id="table-header">
        </thead>
        <tbody id="table-body">
        </tbody>
    </table>
</div>
<div class="paginator" id="paginator-table">
</div>
</div>
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Reason</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <input type="text" id="rejectReason" class="form-control form-control-sm" placeholder="Enter reason" autocomplete="off" />
                <input type="hidden" id="txtcode" class="form-control form-control-sm" placeholder="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success icon-height" onclick="SaveModal()" >Ok</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="myAllDeleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Reason</h5>
                <button type="button" class="close modal-close" aria-label="Close" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <input type="text" id="rejectAllReason" class="form-control" placeholder="Enter reason" autocomplete="off"/>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success icon-height" onclick="SaveAllModal()">Ok</button>
                <button type="button" class="btn btn-danger icon-height" onclick="CloseAllModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>
