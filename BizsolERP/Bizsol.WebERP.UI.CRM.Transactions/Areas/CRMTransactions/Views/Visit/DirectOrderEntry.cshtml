                                    <!-- end table row-->
                                </thead>
                                <tbody id="SizeWiseSalesdata" class="filter-class"></tbody>
                            </table>
                            <!-- end table -->
                        </div>
                        <div class="paginator" id="paginator-tblSizeWiseSales">
                        </div>
                        <!-- end table -->
                    </div>
                </div>

                @* 4 *@
                <div class="tab-pane fade" id="paymentHis" role="tabpanel" aria-labelledby="profile-tab">
