@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Transactions/js/Visit.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<style>
    
    .highlighted-date {
        background-color: #3926B6; 
        color: white; 
        border-radius: 30px;
    }

    .datepicker td, .datepicker th {
        border-radius: 20px !important;
    }

    .datepicker table tr td, .datepicker table tr td {
        padding: 8px 9px !important;
        height: 16px !important;
    }

    .datepicker table tfoot {
        display:none;
    }
    #hidetexbox {
        display: none;

    }

    .form-label
    {
        font-weight:bold;
    }

</style>
<div class="card">
    <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                <label for="txtFromDate" class="form-label">From Date  <span class="text-danger">*</span></label>
                    <input type="text" id="txtFromDate" name="FromDate" class="form-control form-control-sm box_border" autocomplete="off" />
                    <input type="hidden" id="txtLocation" name="txtLocation" class="form-control form-control-sm box_border" />
                    <input type="hidden" id="txtAddress" name="txtAddress" class="form-control form-control-sm box_border"  />
                </div>
                <div class="col-md-3">
                <label for="txtToDate" class="form-label">To Date  <span class="text-danger">*</span></label>
                    <input type="text" id="txtToDate" name="ToDate" class="form-control form-control-sm box_border" autocomplete="off" />
                </div>
                <div class="col-md-3">
                <label for="ddlSalesPerson" class="form-label">Sales Person  <span class="text-danger">*</span></label>
                    @* <input list="ddlSalesPersonList" id="ddlSalesPerson" name="ddlSalesPerson" class="form-control form-control-sm box_border" placeholder="Sales Person" autocomplete="off" value="All" hidden>
                    <datalist id="ddlSalesPersonList"></datalist> *@
                <select id="ddlSalesPersonlist" class="form-control form-control-sm box_border">
                </select>
                </div>
                <div class="col-md-2">
                    <button type="button" id="btnShow" class="btn btn-primary btn-height btn-width mt-4">Show</button>
                </div>
            </div>
    </div>
</div>
<div id="txtTable" style="display:none">
<div class="table-wrapper fixed-height-table">
    <table id="Visit" class="fixed-width-table table">
        <thead id="table-header">
        </thead>
        <tbody id="table-body" class="filter-class">
        </tbody>
    </table>
</div>
<div class="paginator" id="paginator-Visit">
</div>
</div>

