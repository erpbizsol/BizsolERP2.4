@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Transactions/js/Visit.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<style>
    
    .highlighted-date {
        background-color: #3926B6; 
        color: white; 
        border-radius: 30px;
    }

    .datepicker td, .datepicker th {
        border-radius: 20px !important;
    }

    .datepicker table tr td, .datepicker table tr td {
        padding: 8px 9px !important;
        height: 16px !important;
    }

    .datepicker table tfoot {
        display:none;
    }
    #hidetexbox {
        display: none;

    }

    .form-label
    {
        font-weight:bold;
    }



</style>
<div class="card">
    <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label for="txtFromDate" class="form-label">From Date</label>
                    <input type="text" id="txtFromDate" name="FromDate" class="form-control form-control-sm box_border" autocomplete="off" />
                    <input type="hidden" id="txtLocation" name="txtLocation" class="form-control form-control-sm box_border" />
                    <input type="hidden" id="txtAddress" name="txtAddress" class="form-control form-control-sm box_border"  />
                </div>
                <div class="col-md-3">
                    <label for="txtToDate" class="form-label">To Date</label>
                    <input type="text" id="txtToDate" name="ToDate" class="form-control form-control-sm box_border" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label for="ddlSalesPerson" class="form-label">Sales Person</label>
                    <input list="ddlSalesPersonList" id="ddlSalesPerson" name="ddlSalesPerson" class="form-control form-control-sm box_border" placeholder="Sales Person" autocomplete="off" value="All">
                    <datalist id="ddlSalesPersonList"></datalist>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" id="btnShow" class="btn btn-primary btn-height btn-width">Show</button>
                </div>
            </div>
    </div>
</div>
<div id="txtTable" style="display:none">
<div class="table-wrapper fixed-height-table">
    <table id="Visit" class="fixed-width-table table">
        <thead id="table-header">
        </thead>
        <tbody id="table-body" class="filter-class">
        </tbody>
    </table>
</div>
<div class="paginator" id="paginator-Visit">
</div>
</div>

<div class="modal fade" id="ReasonModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reason</h5>
                <button type="button" class="btn-close" onclick="Close()"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="txtReason" class="form-control" placeholder="Enter reason" autocomplete="off" />
                <input type="hidden" id="txtCode" class="form-control" value="0"/>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="SaveNotVisited()" >OK</button>
                <button type="button" class="btn btn-danger btn-sm" onclick="Close()" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
