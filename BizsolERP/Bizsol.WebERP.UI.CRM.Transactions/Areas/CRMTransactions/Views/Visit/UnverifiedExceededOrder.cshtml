@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .align-items-end {
        margin-top: 24px;
    }

    .form-label {
        font-weight: bold;
    }



    .modal-dialog {
        width: 100%;
    }

    .modal-header {
        background-color: #3f51b5;
        height: 40px;
    }

    .modal-title {
        text-align: center;
        color: #eef6f2;
    }

    .modal {
        overflow: visible !important;
        position: absolute;
        top:  9%;
    }
</style>
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Transactions/js/UnverifiedExceededOrder.js"></script>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <label for="ddlSalesPerson" class="form-label">Sales Person <span class="text-danger">*</span></label>
                <input list="ddlSalesPersonList" id="ddlSalesPerson" name="ddlSalesPerson" class="form-control form-control-sm box_border" placeholder="Sales Person" autocomplete="off" value="All">
                <datalist id="ddlSalesPersonList"></datalist>
            </div>
            <div class="col-md-3">
                <label for="ddlDealerName" class="form-label">Dealer Name <span class="text-danger">*</span></label>
                <input list="ddlDealerNameList" id="ddlDealerName" name="ddlDealerName" class="form-control form-control-sm box_border" placeholder="Dealer Name" autocomplete="off" value="All">
                <datalist id="ddlDealerNameList"></datalist>
            </div>
            <div class="col-md-3">
                <label for="ddlOrderType" class="form-label">Order Type <span class="text-danger">*</span></label>
                <select id="ddlOrderType" name="ddlOrderType" class="form-control form-control-sm box_border" autocomplete="off">
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <input type="checkbox" id="chkShowOnlyOrders" name="chkShowOnlyOrders" autocomplete="off">
                    <label for="chkShowOnlyOrders" style="margin-top:25px" class="form-label">Show Only Orders</label><br />
                </div>
            </div>
            <div class="col-md-1 align-items-end">
                <button type="button" id="btnShow" class="btn btn-primary btn-height">Show</button>
            </div>
        </div>
    </div>
</div>
<div id="txtTable" style="display:none">
    <div class="table-wrapper fixed-height-table">
        <table id="Visit" class="fixed-width-table table">
            <thead id="table-header">
            </thead>
            <tbody id="table-body">
            </tbody>
        </table>
    </div>
    <div class="paginator" id="paginator-Visit">
    </div>
</div>

<div class="row">
    <div id="ShowOrderDetailModal" class="modal fade" tabindex="-1" role="dialog">
        <div class=" modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" id="ShowDetailModal">ORDER DETAILS</h6>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="table-wrapper fixed-height-table">
                        <table id="OrderDetails" class="fixed-width-table table">
                            <thead id="OrderTable-header">
                            </thead>
                            <tbody id="OrderTable-body">
                            </tbody>

                        </table>

                    </div>
                    <div class="paginator" id="paginator-OrderDetails">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger btn-height" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="ReasonModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-content-width-sm">
            <div class="modal-header">
                <h5 class="modal-title">Reason</h5>
                <button type="button" class="btn-close" onclick="Close()"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="txtReason" class="form-control" placeholder="Enter reason" autocomplete="off" />
                <input type="hidden" id="txtCode" class="form-control" value="0" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-height" onclick="SaveRejectVisit()">OK</button>
                <button type="button" class="btn btn-danger btn-height" onclick="Close()" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>