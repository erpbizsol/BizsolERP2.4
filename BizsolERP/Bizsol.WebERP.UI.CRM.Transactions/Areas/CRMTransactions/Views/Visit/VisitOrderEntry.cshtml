                    <div class="accordion-item">
                        <h2 class="accordion-header" id="flush-headingOne">
                            <button class="accordion-button fw-medium " type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOrder" aria-expanded="false" aria-controls="flush-collapseOrder">
                                Order Booking
                            </button>
                        </h2>
                        <div id="flush-collapseOrder" class="accordion-collapse collapse show" aria-labelledby="flush-collapseOrder" data-bs-parent="#accordionFlushOrder" style="">
                            <div class="accordion-body text-muted">
                                
                                    <div class="row colPhn">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                            <input type="button" name="btnShow" id="btnShow" class="btn btn-primary btn-sm waves-effect waves-light" value="Show Stock" onclick="return GetAllOrderBookingData();" />

                                            <button type="button" class="btn btn-primary  btn-sm waves-effect waves-light">
                                                <i class="bx bx-loader bx-spin font-size-16 align-middle me-2"></i> Loading
                                            </button>
                                                <label id="lblStockDate"></label>

                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           id="toggleSwitch"
                                                           data-on-label="Yes"
                                                           data-off-label="No">
                                                <label class="form-check-label align-text-bottom col-form-label-sm fw-bold" for="toggleSwitch">Show Size Button</label>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                            <div class="table-wrapper table-responsive text-sm-center  overflow-auto">
                            <table id="datatable" class="table table-bordered dt-responsive nowrap dataTable " aria-describedby="datatable_info" style="width: 1123px;">
                                    <thead role="rowgroup" class="text-sm-center">
                                            <tr role="row">
                                                <th class="lead-Date width_cust  w-25" role="columnheader">Consignee</th>
                                                <th class="lead-Date width_cust" role="columnheader">Delivery Address</th>
                                                <th class="lead-text width_cust" role="columnheader">Item Name</th>
                                                <th class="lead-text width_cust" role="columnheader">Size</th>
                                                <th class="lead-text width_cust" role="columnheader">Thickness</th>
                                                <th class="lead-Date width_cust" role="columnheader">SizeDesp</th>
                                                <th class="lead-Date width_cust" role="columnheader">UOM</th>
                                                <th class="lead-text width_cust" role="columnheader">Stock</th>
