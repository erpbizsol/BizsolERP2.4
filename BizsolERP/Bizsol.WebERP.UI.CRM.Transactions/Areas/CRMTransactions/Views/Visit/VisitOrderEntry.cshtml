<div>
    <div class="row">
        <div class="col-md-3 form-group">
            <label for="txtUserName" class="col-form-label-sm fw-bold">User Name</label>
            <input type="text" id="txtUserName" class="box_border form-control form-control-sm" autocomplete="off" value="">
        </div>
        <div class="col-md-3">
            <label for="txtdate" class="col-form-label-sm fw-bold">Date</label>
            <input ID="txtdate" name="txtdate" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Date" value="" readonly="readonly" required />
        </div>
        <div class="col-md-3">
            <label for="txtCheckInTime" class="col-form-label-sm fw-bold">Check In Time</label>
            <input type="text" id="txtCheckInTime" name="txtCheckInTime" class="box_border form-control form-control-sm" value="" readonly="readonly" />
        </div>
        <div class="col-md-3">
            <label for="txtLocation" class="col-form-label-sm fw-bold">Location</label>
            <input type="text" id="txtAddLocation" name="txtAddLocation" class="box_border form-control form-control-sm" readonly="readonly" hidden required />
            <input type="text" id="txtLocation" name="txtLocation" class="box_border form-control form-control-sm" value=""  required />
        </div>
    </div>
    <div class="row">

        
        <div class="col-md-3 form-group">
            <label for="txtDealer" class="col-form-label-sm fw-bold">Dealer</label>
            <input type="text" class="box_border form-control form-control-sm" id="txtDealer" name="txtDealer" value="" placeholder="Dealer Name" autocomplete="off" readonly="readonly" required />
        </div>
        <div class="col-md-3">
            <label for="txtGSTNo" class="col-form-label-sm fw-bold">GST No</label>
            <input ID="txtGSTNo" name="txtGSTNo" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Date" value="" readonly="readonly" required />
        </div>
        <div class="col-md-3">
            <label for="txtAddress" class="col-form-label-sm fw-bold">Address</label>
            <input type="text" id="txtAddress" name="txtAddress" class="box_border form-control form-control-sm" value="" readonly="readonly" />
        </div>
        <div class="col-md-3">
            <label for="txtAttachment" class="col-form-label-sm fw-bold">Attachment</label>
            <div class="form-group">
                <input type="file" id="myFile" name="filename" class="box_border form-control form-control-sm" accept="image/*" capture="camera" />
            </div>
        </div>
    </div>

</div><br/>
