<style>

    /* Table Styles */

    /*  .table-wrapper {
            margin: 5px 5px 5px;
            box-shadow: 0px 35px 50px rgba( 0, 0, 0, 0.2 );
        }
     */
    .fl-table {
        border-radius: 5px;
        font-size: 11px;
        font-weight: normal;
        border: none;
        border-collapse: collapse;
        width: 100%;
        max-width: 100%;
        white-space: nowrap;
        background-color: white;
    }

        .fl-table td, .fl-table th {
            text-align: center;
            padding: 8px;
        }

        .fl-table td {
            border-right: 1px solid #f8f8f8;
            font-size: 10px;
        }

        .fl-table thead th {
            color: #ffffff;
            background: #6699cc;
        }


            .fl-table thead th:nth-child(odd) {
                color: #ffffff;
                background: #6699cc;
            }

        .fl-table tr:nth-child(even) {
            background: #F8F8F8;
        }

    /*  .modal-dialog {
            width: 100%;
        }

        .modal-header {
            background-color: #3f51b5;
            height: 40px;
        }

        .modal-title {
            text-align: center;
            color: #eef6f2;
        }*/

    .modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        max-width: 90%; /* Optional: Adjust to fit the screen size */
        width: auto;
        overflow-x: hidden;
        overflow-y: hidden;
    }

    /* Hide the spinner arrows in most modern browsers */
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Hide the spinner arrows in Firefox */
    input[type="number"] {
        -moz-appearance: textfield;
    }

</style>

<div class="row mb-2">
    <div class="col-md-12">
        <fieldset class="rounded-1 p-3">
            <legend class="float-none w-auto px-2">Entry Details</legend>

            <div class="row">
                <div class="col-md-3 form-group">
                    <label for="txtUserName" class="col-form-label-sm fw-bold">User Name</label>
                    <input type="text" id="txtUserName" class="box_border form-control form-control-sm" autocomplete="off" value="">
                </div>
                <div class="col-md-3">
                    <label for="txtdate" class="col-form-label-sm fw-bold">Date</label>
                    <input ID="txtdate" name="txtdate" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Date" value="" readonly="readonly" required />
                </div>
                <div class="col-md-3">
                    <label for="txtCheckInTime" class="col-form-label-sm fw-bold">Check In Time</label>
                    <input type="text" id="txtCheckInTime" name="txtCheckInTime" class="box_border form-control form-control-sm" value="" readonly="readonly" />
                </div>
                <div class="col-md-3">
                    <label for="txtLocation" class="col-form-label-sm fw-bold">Location</label>
                    <input type="text" id="txtAddLocation" name="txtAddLocation" class="box_border form-control form-control-sm" hidden required />
                    <input type="text" id="txtCurrentLocation" name="txtCurrentLocation" class="box_border form-control form-control-sm" value="" required />
                    <input type="text" id="txtCheckOutLocation" name="txtCheckOutLocation" class="box_border form-control form-control-sm" hidden required />
                    <input type="hidden" id="hflatlong" name="hflatlong" value="" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 form-group">
                    <label for="txtDealer" class="col-form-label-sm fw-bold">Dealer</label>
                    <input type="text" class="box_border form-control form-control-sm" id="txtDealer" list="listdealer" name="txtDealer" value="" onclick="$(this).val('');" placeholder="" autocomplete="off" required onfocusout="GetAccountMasterDetails();" />
                </div>
                <div class="col-md-3">
                    <label for="txtGSTNo" class="col-form-label-sm fw-bold">GST No</label>
                    <input ID="txtGSTNo" name="txtGSTNo" class="box_border form-control form-control-sm" autocomplete="off" placeholder="" value="" readonly="readonly" required />
                </div>
                <div class="col-md-3">
                    <label for="txtAddress" class="col-form-label-sm fw-bold">Address</label>
                    <textarea type="text" id="txtAddress" name="txtAddress" class="box_border form-control form-control-sm" value="" readonly="readonly" rows="2"></textarea>
                </div>
                <div class="col-md-2">
                    <label for="txtAttachment" class="col-form-label-sm fw-bold">Attachment</label>
                    <div class="form-group">
                        <input type="file" id="txtFileInput" name="txtFileInput" class="box_border form-control form-control-sm" accept="image/*" capture="camera" />

                        <input type="hidden" id="hfFileInput" name="hfFileInput" value="" />
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-group">

                        <img id="imgSelfie" class="rounded-circle avatar-lg" src="" />

                    </div>
                </div>
            </div>
        </fieldset>
    </div>
</div>


