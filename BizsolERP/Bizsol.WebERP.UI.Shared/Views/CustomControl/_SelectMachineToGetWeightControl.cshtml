<div class="modal fade" id="SelectMachineToGetWeightControlModal" tabindex="-1" role="dialog" aria-labelledby="wmModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered wm-dialog">
        <div class="modal-content wm-modal">
            <div class="modal-header wm-header">
                <h5 class="modal-title" id="wmModalTitle">
                    <span class="wm-header-icon" aria-hidden="true"><i class="fa fa-scale-balanced"></i></span>
                    <span class="wm-header-copy">
                        Weighment
                        <small>Choose a machine and read the scale</small>
                    </span>
                </h5>
                <button type="button" class="wm-close" data-bs-dismiss="modal" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body wm-body">
                <div class="wm-field">
                    <label for="ddlMachines">Machine</label>
                    <select id="ddlMachines" class="form-control form-control-sm"></select>
                </div>
                <label class="wm-option" for="chkClientSideWeight">
                    <input type="checkbox" id="chkClientSideWeight" checked />
                    <span class="wm-option-text">
                        <span class="wm-option-title">Get weight on this device</span>
                        <span class="wm-option-hint">Reads the scale through the machine's local API</span>
                    </span>
                </label>
                <div id="DivWeightScaleAPIResponse" class="wm-result d-none">
                    <div id="alertWeightScaleResult"></div>
                    <div id="DivWeightScaleVehicleImages" class="wm-images"></div>
                </div>
            </div>
            <div class="modal-footer wm-footer">
                <button type="button" class="wm-btn wm-btn-ghost" data-bs-dismiss="modal">Close</button>
                <button type="button" class="wm-btn wm-btn-primary" onclick="SelectMachineToGetWeightControl_onGetWeight();">
                    <i class="fa fa-scale-balanced" aria-hidden="true"></i> Get Weight
                </button>
                <input type="hidden" value="@ViewBag.OutputTextElementID" id="hfOutputTextElementID" />
            </div>
        </div>
    </div>
</div>

<script type="module">

    import { WeighmentService } from '../../_content/Bizsol.WebERP.UI.Shared/js/JSServices/WeighmentService.js';

    function getddlMachines() {
        WeighmentService.GetMachinesList().then(function (respone) {
            if (respone.length > 0) {
                BindSelectList($('#ddlMachines')[0], respone.map((item) => ({
                    Code: item.MachineNo,
                    Desp: item.MachineNo,
                    WeightScaleIP: item.WeightScaleIP || ''
                })));

                if (respone.length == 1) {
                    $('#ddlMachines').val(respone[0].MachineNo);
                }

                $('#ddlMachines').select2({
                    dropdownParent: $('#SelectMachineToGetWeightControlModal'),
                    width: '100%'
                });

                $(document).ready(function () {
                    $("#SelectMachineToGetWeightControlModal").modal({
                        backdrop: 'static',
                    });
                    $("#SelectMachineToGetWeightControlModal").modal('show');
                });
            } else {
                toastr.error('No Machine Found');
                return;
            }
        });
    }

    function BindSelectList(element, list) {
        let option = '<option value="0"></option>';
        $.each(list, function (key, val) {
            option += '<option value="' + val.Code + '" data-weightscaleip="' + (val.WeightScaleIP || '') + '">' + val.Desp + '</option>';
        });
        element.innerHTML = option;
    }

    function SelectMachineToGetWeightControl_onGetWeight() {
        let MachineName = $('#ddlMachines').val();

        if (MachineName === '0' || MachineName === '') {
            toastr.error('Please select a machine');
            return;
        }

        let isClientSide = $('#chkClientSideWeight').is(':checked');
        let outputTextElementID = $('#hfOutputTextElementID').val();

        $('#DivWeightScaleAPIResponse').addClass('d-none');
        $('#alertWeightScaleResult').html('');
        $('#DivWeightScaleVehicleImages').html('');

        if (isClientSide) {
            let weightScaleIP = $('#ddlMachines option:selected').data('weightscaleip') || '';

            if (!weightScaleIP) {
                toastr.error('Weight Scale IP / URL is not configured for this machine. Please uncheck Client Side mode.');
                return;
            }

            Showloader();

            fetch(weightScaleIP, { method: 'GET' })
                .then(function (resp) {
                    if (!resp.ok) throw new Error('HTTP ' + resp.status);
                    return resp.json();
                })
                .then(function (data) {
                    HideLoader();

                    if (data.API_STATUS === 'Ok') {
                        let weight = data.Weight || '0';
                        toastr.success('GET Weight (Client Side): ' + weight);

                        if (outputTextElementID) {
                            $('#' + outputTextElementID).val(weight);
                        }

                        let vehicleNo = '';
                        let frontImage = '';
                        let backImage = '';

                        if (data.CAMERA && Array.isArray(data.CAMERA)) {
                            let frontCam = data.CAMERA.find(function (c) { return c.CAMERA_TYPE === 'FRONT'; });
                            let backCam = data.CAMERA.find(function (c) { return c.CAMERA_TYPE === 'BACK'; });

                            if (frontCam) {
                                if (frontCam.ANPRNO && frontCam.ANPRNO.toLowerCase() !== 'unknown') {
                                    vehicleNo = frontCam.ANPRNO;
                                }
                                frontImage = frontCam.IMAGE || '';
                            }
                            if (backCam) {
                                backImage = backCam.IMAGE || '';
                                if (!vehicleNo && backCam.ANPRNO && backCam.ANPRNO.toLowerCase() !== 'unknown') {
                                    vehicleNo = backCam.ANPRNO;
                                }
                            }
                        }

                        let resultHtml = '<strong>Weight:</strong> ' + weight;
                        if (vehicleNo) resultHtml += '&nbsp;&nbsp;<strong>Vehicle No:</strong> ' + vehicleNo;
                        $('#alertWeightScaleResult').html(resultHtml);
                        $('#DivWeightScaleAPIResponse').removeClass('d-none');

                        let imagesHtml = '';
                        if (frontImage) {
                            imagesHtml += '<div><p class="mb-0 small fw-bold">Front</p><img src="data:image/jpeg;base64,' + frontImage + '" style="max-height:120px;border:1px solid #ccc;" /></div>';
                        }
                        if (backImage) {
                            imagesHtml += '<div><p class="mb-0 small fw-bold">Back</p><img src="data:image/jpeg;base64,' + backImage + '" style="max-height:120px;border:1px solid #ccc;" /></div>';
                        }
                        $('#DivWeightScaleVehicleImages').html(imagesHtml);

                        document.dispatchEvent(new CustomEvent('weightScaleDataReceived', {
                            detail: {
                                outputTextElementID: outputTextElementID,
                                weight: weight,
                                vehicleNo: vehicleNo,
                                frontImage: frontImage,
                                backImage: backImage,
                                fullResponse: data,
                                mode: 'client'
                            }
                        }));

                        $("#SelectMachineToGetWeightControlModal").modal('hide');
                    } else {
                        toastr.error('Weight scale returned error: ' + (data.API_STATUS || 'Unknown'));
                    }
                })
                .catch(function (err) {
                    HideLoader();
                    toastr.error('Failed to connect to weight scale: ' + err.message);
                });
        } else {
            Showloader();

            WeighmentService.GetMachineWeight(MachineName).then(function (respone) {
                HideLoader();

                if (respone.Status == 'Y') {
                    toastr.success('GET Weight: ' + respone.Msg);

                    if (outputTextElementID) {
                        $('#' + outputTextElementID).val(respone.Msg);
                    }

                    document.dispatchEvent(new CustomEvent('weightScaleDataReceived', {
                        detail: {
                            outputTextElementID: outputTextElementID,
                            weight: respone.Msg,
                            vehicleNo: '',
                            frontImage: '',
                            backImage: '',
                            fullResponse: respone,
                            mode: 'server'
                        }
                    }));
                } else {
                    toastr.error(respone.Msg);
                }

                $("#SelectMachineToGetWeightControlModal").modal('hide');
            });
        }
    }

    window.SelectMachineToGetWeightControl_onGetWeight = SelectMachineToGetWeightControl_onGetWeight;

    getddlMachines();

</script>

