        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    #AttachmentControlmodal .ac-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    #AttachmentControlmodal .ac-header-icon {
        width: 40px;
        height: 40px;
        background: rgba(255,255,255,0.18);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #fff;
        flex-shrink: 0;
    }
    #AttachmentControlmodal .ac-header-title {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.2px;
    }
    #AttachmentControlmodal .ac-header-subtitle {
        font-size: 11.5px;
        color: rgba(255,255,255,0.72);
        margin-top: 1px;
    }
    #AttachmentControlmodal .ac-close-btn {
        background: rgba(255,255,255,0.15);
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #fff;
        font-size: 16px;
        transition: background 0.2s;
        flex-shrink: 0;
        padding: 0;
    }
    #AttachmentControlmodal .ac-close-btn:hover { background: rgba(255,255,255,0.28); }

    /* ── Body ── */
    #AttachmentControlmodal .modal-body {
        background: #f4f6fb;
        padding: 22px 22px 18px;
    }

    /* ── Drop Zone ── */
    #AttachmentControlmodal .ac-dropzone {
        background: #fff;
        border: 2.5px dashed #c7d2fe;
        border-radius: 14px;
        padding: 30px 20px 24px;
