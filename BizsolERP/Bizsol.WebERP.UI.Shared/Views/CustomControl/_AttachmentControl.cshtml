

<div class="modal fade bs-example-modal-center" id="AttachmentControlmodal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable" style="max-width:800px">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bizsol ERP Document Control</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form action="#" class="dropzone" id="fileUploadForm">
                    <div class="upload-container">
                       <div class="row">
                        <div class="col-md-2">
                                <i class="display-2 text-muted bx bx-cloud-upload"></i>
                            </div>
                           <div class="col-md-8 mt-3">
                                <input type="text" id="file-names" placeholder="Drag & Drop image here or choose a file" readonly />
                            </div>
                            <div class="col-md-2 mt-4">
                                <label id="file-button" onclick="document.getElementById('file-input').click()">Browse</label>
                            <input type="file" id="file-input" multiple>
                            </div>

                            <div class="col-md-12">
                            <div class="file-list" id="fileList">
                                <!-- Dynamically added files will appear here -->
                            </div>
                        </div>
                            
                       
                        </div>
                    </div>
                </form>


                <div class="table-wrapper mt-1">
                    <table id="tbAttachmentControl" class="fixed-width-table">
                        <thead id="table-header-tbAttachmentControl">
                        </thead>
                        <tbody id="table-body-tbAttachmentControl">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-tbAttachmentControl">
                </div>

                
                <div class="text-end mt-1">
                    <a class="btn btn-primary" onclick="DownloadAll_AttachmentControl()">
                       Download all
                    </a>
                    &nbsp;
                    
                    <input type="hidden" value="@ViewBag.MasterTableName" id="hfMasterTableName" />
                    <input type="hidden" value="@ViewBag.MasterTableCode" id="hfMasterTableCode" />
                </div>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div>
<style>
    #file-button {
        background-color: #5156be;
        color: white;
        padding: 8px 20px;
        border-radius: 5px;
        cursor: pointer;
    }

    #file-names {
        width: 100%;
        margin-bottom: 10px;
        padding: 10px;
        border: 1px solid #ccc;
        font-size: 16px;
    }

        #file-names.hover {
            border-color: #007BFF;
            background-color: #f0f8ff;
        }

 .save-btn {
        background-color: #28a745;
        color: white;
        padding: 8px 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .delete-btn, .download-btn {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 6px 10px;
        cursor: pointer;
        border-radius: 5px;
    }

    .file-input {
        display: none;
    }

    .upload-container input[type="file"] {
        display: none;
    }

   
   
</style>

