@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/components/DateRangeControl/DateRangeControl.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<style>
    .smd-page {
        --smd-brand: #1d4ed8;
        --smd-brand-dark: #1e3a8a;
        --smd-accent: #0f766e;
        --smd-ok: #047857;
        --smd-surface: #ffffff;
        --smd-warn: #b45309;
        --smd-danger: #b91c1c;
        --smd-bg: #f1f5f9;
        --smd-border: #e2e8f0;
        --smd-text: #0f172a;
        --smd-muted: #64748b;
        --smd-radius: 14px;
        --smd-shadow: 0 1px 3px rgba(15, 23, 42, 0.06), 0 8px 24px rgba(15, 23, 42, 0.04);
        --smd-shell-max: 1440px;
        --smd-header: #1e293b;
        --smd-header-deep: #0f172a;
    }
    .smd-page, .smd-page * { box-sizing: border-box; }

    .smd-page {
        /* padding: 16px 18px 48px; */
        /* color: var(--smd-text); */
        background: var(--smd-bg);
        border-radius: var(--smd-radius);
        min-height: 100%;
        font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    }
    .smd-shell {
        max-width: var(--smd-shell-max);
        margin: 0 auto;
    }
    .smd-hero {
        margin-bottom: 24px;
        border-radius: var(--smd-radius);
        background: linear-gradient(180deg, var(--smd-header) 0%, var(--smd-header-deep) 100%);
        border: 1px solid #334155;
        box-shadow: 0 4px 6px rgba(15, 23, 42, 0.08), 0 16px 32px rgba(15, 23, 42, 0.12);
        position: relative;
        overflow: hidden;
    }
   
    .smd-hero-body {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        padding: 18px 24px;
        padding-right: 72px;
        position: relative;
        z-index: 1;
    }
    .smd-hero-title {
        margin: 0;
        flex: 1;
        min-width: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 16px;
        font-size: clamp(1.15rem, 2vw, 1.5rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.3;
        color: #f8fafc;
    }
    .smd-hero-title .smd-date-from,
    .smd-hero-title .smd-date-to {
        padding: 8px 16px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        color: #fff;
    }
    .smd-hero-title .smd-date-arrow {
        color: #94a3b8;
        font-size: 1rem;
        font-weight: 600;
    }
    .smd-hero-actions {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 8px;
        flex-shrink: 0;
    }
    .smd-hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #334155;
        font-weight: 600;
        font-size: 12px;
        padding: 8px 14px 8px 8px;
        border-radius: 8px;
        cursor: pointer;
        white-space: nowrap;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
        transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .smd-hero-btn i {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        flex-shrink: 0;
        color: #fff;
    }
    .smd-hero-btn--excel i { background: #047857; }
    .smd-hero-btn--print i { background: #1d4ed8; }
    .smd-hero-btn:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
    }
    .smd-section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 0 0 16px;
        padding: 0 0 10px;
        border-bottom: 1px solid var(--smd-border);
    }
    .smd-section-head h4 {
        margin: 0;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #475569;
    }
    .smd-section-head span {
        font-size: 11px;
        font-weight: 600;
        color: #94a3b8;
    }
    .smd-btn, .smd-link {
        border: 0;
        background: #fff;
        font-weight: 700;
        cursor: pointer;
    }
    .smd-kpis {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }
    .smd-page .smd-kpi {
        padding: 18px 18px 16px;
        min-height: 128px;
        position: relative;
        border: none;
        border-radius: var(--smd-radius);
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.12);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        color: #fff;
        overflow: hidden;
    }
    .smd-page .smd-kpi::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.14) 0%, transparent 42%);
        pointer-events: none;
    }
    .smd-page .smd-kpi::after {
        content: '';
        position: absolute;
        right: -28px;
        top: -28px;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        pointer-events: none;
    }
    .smd-page .smd-kpi:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.14);
    }
    .smd-kpi-top { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; position: relative; z-index: 1; }
    .smd-kpi-icon {
        width: 42px; height: 42px; border-radius: 12px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 18px; font-weight: 800; flex-shrink: 0;
        background: rgba(255, 255, 255, 0.22);
        color: #fff;
    }
    .smd-page .smd-kpi--sale { background: linear-gradient(145deg, #1e40af, #2563eb) !important; }
    .smd-page .smd-kpi--daily { background: linear-gradient(145deg, #0f766e, #0d9488) !important; }
    .smd-page .smd-kpi--target { background: linear-gradient(145deg, #5b21b6, #6d28d9) !important; }
    .smd-page .smd-kpi--ytd { background: linear-gradient(145deg, #047857, #059669) !important; }
    .smd-page .smd-kpi--overdue { background: linear-gradient(145deg, #c2410c, #ea580c) !important; }
    .smd-page .smd-kpi-label { font-size: 11px; color: rgba(255, 255, 255, 0.92); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
    .smd-page .smd-kpi-value { font-size: 26px; font-weight: 800; letter-spacing: -0.03em; margin-top: 2px; color: #fff !important; line-height: 1.15; position: relative; z-index: 1; }
    .smd-page .smd-kpi-sub { font-size: 12px; margin-top: 8px; font-weight: 650; color: rgba(255, 255, 255, 0.9); min-height: 22px; position: relative; z-index: 1; }
    .smd-kpi-sub .smd-muted { font-weight: 600; opacity: 0.85; }
    .smd-page .smd-card {
        background: var(--smd-surface);
        border: 1px solid var(--smd-border);
        border-radius: var(--smd-radius);
        box-shadow: var(--smd-shadow);
        padding: 20px 22px 22px;
        overflow: hidden;
        position: relative;
        transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
    }
    .smd-page .smd-card:hover {
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
        border-color: #cbd5e1;
    }
    .smd-page .smd-card::before {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 3px;
        background: var(--smd-card-accent, var(--smd-brand));
    }
    .smd-card--1 { --smd-card-accent: #10b981; }
    .smd-card--2 { --smd-card-accent: #f59e0b; }
    .smd-card--3 { --smd-card-accent: #3b82f6; }
    .smd-card--4 { --smd-card-accent: #ec4899; }
    .smd-card--5 { --smd-card-accent: #0ea5e9; }
    .smd-card--6 { --smd-card-accent: #8b5cf6; }
    .smd-card--7 { --smd-card-accent: #059669; }
    .smd-card--8 { --smd-card-accent: #f43f5e; }
    .smd-card--9 { --smd-card-accent: #0284c7; }
    .smd-pill {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        margin-right: 4px;
    }
    .smd-pill-up { background: rgba(255, 255, 255, 0.28); color: #fff; }
    .smd-pill-down { background: rgba(0, 0, 0, 0.2); color: #ffe4e6; }
    .smd-pill-flat { background: rgba(255, 255, 255, 0.2); color: #fff; }
    .smd-pill-up-table { background: #dcfce7; color: #15803d; }
    .smd-pill-down-table { background: #fee2e2; color: #b91c1c; }
    .smd-pill-flat-table { background: #f1f5f9; color: #64748b; }
    .smd-up { color: #059669; font-weight: 800; }
    .smd-down { color: #dc2626; font-weight: 800; }
    .smd-flat { color: #64748b; font-weight: 700; }
    .smd-grid { display: grid; grid-template-columns: 1.35fr 0.95fr; gap: 20px; margin-bottom: 20px; }
    .smd-card-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        padding-bottom: 12px;
        margin-bottom: 2px;
        border-bottom: 1px solid #eef2f7;
    }
    .smd-page .smd-card h3 {
        font-size: 14px;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #0f172a;
        letter-spacing: -0.01em;
    }
    .smd-page .smd-card h3 i {
        width: 26px; height: 26px; border-radius: 8px;
        background: var(--smd-badge, var(--smd-brand));
        color: #fff;
        display: inline-flex; align-items: center; justify-content: center; font-style: normal; font-size: 11px; font-weight: 800;
    }
    .smd-card--1 h3 i { --smd-badge: #10b981; }
    .smd-card--2 h3 i { --smd-badge: #f59e0b; }
    .smd-card--3 h3 i { --smd-badge: #3b82f6; }
    .smd-card--4 h3 i { --smd-badge: #ec4899; }
    .smd-card--5 h3 i { --smd-badge: #0ea5e9; }
    .smd-card--6 h3 i { --smd-badge: #8b5cf6; }
    .smd-card--7 h3 i { --smd-badge: #059669; }
    .smd-card--8 h3 i { --smd-badge: #f43f5e; }
    .smd-card--9 h3 i { --smd-badge: #0284c7; }
    .smd-sub { margin: 8px 0 16px; color: var(--smd-muted); font-size: 12px; font-weight: 500; }
    .smd-split, .smd-donut, .smd-state { display: grid; gap: 12px; align-items: center; }
    .smd-split { grid-template-columns: 1fr 1.15fr; }
    .smd-donut { grid-template-columns: 200px 1fr; }
    .smd-state { grid-template-columns: 280px 1fr; align-items: start; }
    .smd-canvas { position: relative; height: 230px; }
    .smd-canvas.short { height: 200px; }
    .smd-canvas canvas { width: 100% !important; height: 100% !important; }
    .smd-legend { display: flex; flex-direction: column; gap: 6px; font-size: 12px; }
    .smd-legend-row { display: grid; grid-template-columns: 10px 1fr auto auto; gap: 8px; align-items: center; }
    .smd-legend-row b { font-variant-numeric: tabular-nums; }
    .smd-dot { width: 10px; height: 10px; border-radius: 99px; display: inline-block; }
    .smd-inline-legend { display: flex; gap: 12px; font-size: 12px; color: #475569; font-weight: 700; }
    .smd-inline-legend i { width: 10px; height: 10px; border-radius: 99px; display: inline-block; margin-right: 4px; }
    .smd-inline-legend .ach { background: linear-gradient(90deg, #22c55e, #10b981); }
    .smd-inline-legend .tgt { background: linear-gradient(90deg, #cbd5e1, #94a3b8); }
    .smd-person { display: grid; grid-template-columns: minmax(90px, 130px) 1fr; gap: 8px; align-items: center; margin: 7px 0; font-size: 12px; font-weight: 650; }
    .smd-person-name, .smd-meter-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .smd-track { position: relative; height: 12px; }
    .smd-track .target, .smd-track .achieved { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 99px; }
    .smd-track .target { background: #e2e8f0; }
    .smd-track .achieved { background: linear-gradient(90deg, #22c55e, #14b8a6); }
    .smd-meter { display: grid; grid-template-columns: minmax(90px, 150px) 1fr auto auto; gap: 8px; align-items: center; margin: 6px 0; font-size: 12px; }
    .smd-meter-track, .smd-mini { height: 9px; background: #e8eef7; border-radius: 99px; overflow: hidden; }
    .smd-meter-track span, .smd-mini span { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, #6366f1, #a855f7); }
    .smd-meter-val, .smd-table .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .smd-meter-val { font-weight: 800; }
    .smd-table-wrap, .smd-bars {
        max-height: 380px;
        overflow: auto;
        border-radius: 12px;
        border: 1px solid #eef2f7;
        background: #fafbfc;
    }
    .smd-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .smd-page .smd-table th {
        font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: #e2e8f0; font-weight: 700;
        background: #1e293b;
        position: sticky; top: 0; z-index: 1;
        text-align: left;
    }
    .smd-page .smd-table th.num { text-align: right; }
    .smd-table th, .smd-table td { padding: 10px 12px; border-bottom: 1px solid #eef2f7; }
    .smd-table tbody tr:nth-child(even) { background: #f8fafc; }
    .smd-table tbody tr:hover { background: #eff6ff; }
    .smd-table tfoot td { font-weight: 700; background: #f1f5f9; color: #0f172a; border-top: 2px solid #cbd5e1; }
    .smd-map {
        position: relative; min-height: 420px;
        background: #f8fafc;
        border-radius: 12px;
        border: 1px solid var(--smd-border);
    }
    .smd-map svg { width: 100%; height: 420px; }
    .smd-pin {
        position: absolute; transform: translate(-50%, -50%);
        border-radius: 6px; padding: 2px 4px; text-align: center; line-height: 1.15;
        font-size: 10px; font-weight: 800; min-width: 42px;
    }
    .smd-pin span { display: block; font-weight: 650; font-size: 9px; }
    .smd-note { margin: 8px 0 0; color: #64748b; font-size: 12px; }
    .smd-fy { display: flex; gap: 6px; }
    .smd-fy button {
        border: 1px solid #c7d2fe; background: #fff; border-radius: 99px; padding: 5px 12px;
        font-size: 11px; font-weight: 800; color: #6366f1; cursor: pointer;
    }
    .smd-fy button.is-on {
        background: var(--smd-brand); color: #fff; border-color: var(--smd-brand);
        box-shadow: 0 4px 12px rgba(29, 78, 216, 0.25);
    }
    .smd-link {
        color: var(--smd-brand);
        font-size: 12px; font-weight: 800; padding: 0;
        background: transparent;
    }
    .smd-link:hover { text-decoration: underline; }
    .smd-dep { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 10px; }
    .smd-dep div {
        border-radius: 12px; padding: 12px 14px;
        border: 1px solid var(--smd-border);
        background: #f8fafc;
    }
    .smd-dep div:nth-child(1) { border-left: 4px solid #3b82f6; }
    .smd-dep div:nth-child(2) { border-left: 4px solid #8b5cf6; }
    .smd-dep div:nth-child(3) { border-left: 4px solid #f97316; }
    .smd-dep span { display: block; color: var(--smd-muted); font-size: 10px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
    .smd-dep strong { font-size: 20px; color: var(--smd-text); }
    .smd-empty { color: #64748b; font-size: 13px; padding: 12px 0; }
    .smd-foot {
        margin-top: 20px;
        padding: 12px 18px;
        color: #64748b;
        font-size: 12px;
        font-weight: 500;
        text-align: center;
        background: #fff;
        border: 1px solid var(--smd-border);
        border-radius: 10px;
    }
    @@page { size: A4 landscape; margin: 10mm; }
    @@media print {
        filter-side-panel-control,
        .smd-no-print { display: none !important; }
        .smd-page, .smd-page * {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        .smd-page {
            background: #fff !important;
            padding: 0 !important;
            box-shadow: none !important;
        }
        .smd-shell { max-width: none; }
        .smd-hero {
            box-shadow: none !important;
            break-inside: avoid;
            margin-bottom: 12px;
        }
        .smd-hero-body { padding: 12px 16px; }
        .smd-hero-actions { display: none !important; }
        .smd-kpis { gap: 10px; margin-bottom: 14px; }
        .smd-page .smd-kpi { min-height: 100px; box-shadow: none !important; }
        .smd-grid { gap: 12px; margin-bottom: 12px; }
        .smd-kpi, .smd-card {
            break-inside: avoid;
            page-break-inside: avoid;
            box-shadow: none !important;
            border: 1px solid #e2e8f0;
            transform: none !important;
        }
        .smd-section-head { margin-bottom: 8px; }
        .smd-table-wrap, .smd-bars { max-height: none !important; overflow: visible !important; }
        .smd-canvas { height: 200px; }
        .smd-map, .smd-map svg { min-height: 320px; height: 320px; }
    }
    /* ===== Attractive theme layer ===== */
    @@keyframes smdRise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes smdGlow { 0%, 100% { opacity: .55; } 50% { opacity: .9; } }
    .smd-page {
        background:
            radial-gradient(900px 380px at 0% 0%, rgba(99, 102, 241, 0.10), transparent 60%),
            radial-gradient(800px 360px at 100% 8%, rgba(14, 165, 233, 0.10), transparent 60%),
            radial-gradient(700px 400px at 50% 100%, rgba(16, 185, 129, 0.07), transparent 60%),
            #f4f6fb;
    }
    .smd-hero {
        border: none;
        border-radius: 20px;
        background:
            radial-gradient(420px 220px at 92% 0%, rgba(56, 189, 248, 0.55), transparent 70%),
            radial-gradient(360px 200px at 8% 110%, rgba(236, 72, 153, 0.35), transparent 70%),
            linear-gradient(120deg, #312e81 0%, #1d4ed8 52%, #0ea5e9 100%);
        box-shadow: 0 18px 40px rgba(37, 99, 235, 0.32), 0 4px 10px rgba(15, 23, 42, 0.12);
        animation: smdRise .5s ease both;
    }
    .smd-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1.2px, transparent 1.2px);
        background-size: 18px 18px;
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 70%);
        mask-image: linear-gradient(90deg, transparent, #000 70%);
        pointer-events: none;
    }
    .smd-hero::after {
        content: '';
        position: absolute;
        width: 220px; height: 220px;
        right: 120px; top: -110px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.35), transparent 70%);
        animation: smdGlow 5s ease-in-out infinite;
        pointer-events: none;
    }
 
    .smd-hero-body { padding: 22px 28px; padding-right: 76px; }
    .smd-hero-title .smd-date-from,
    .smd-hero-title .smd-date-to {
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.35);
        backdrop-filter: blur(8px);
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.18);
        font-weight: 700;
        letter-spacing: .01em;
    }
    .smd-hero-title .smd-date-arrow { color: #fde68a; font-size: 1.3rem; }
    .smd-hero-btn {
        border: none;
        border-radius: 999px;
        padding: 8px 18px 8px 8px;
        font-weight: 700;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.22);
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .smd-hero-btn:hover { background: #fff; transform: translateY(-2px); box-shadow: 0 12px 24px rgba(15, 23, 42, 0.28); }
    .smd-hero-btn i { width: 30px; height: 30px; border-radius: 50%; font-size: 13px; }
    .smd-hero-btn--excel i { background: linear-gradient(145deg, #10b981, #059669); }
    .smd-hero-btn--print i { background: linear-gradient(145deg, #6366f1, #2563eb); }

    .smd-section-head { border-bottom: none; padding-bottom: 0; margin-bottom: 14px; }
    .smd-section-head h4 {
        display: inline-flex; align-items: center; gap: 10px;
