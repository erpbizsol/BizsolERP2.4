        font-size: 12px; font-weight: 800;
    }
    .smd-sub { margin: 12px 0 14px; font-size: 12px; color: var(--smd-muted); }
    .smd-note { font-size: 11.5px; color: #94a3b8; padding: 8px 12px 10px; }

    .smd-split { grid-template-columns: 1fr 1.2fr; gap: 16px; align-items: start; }
    .smd-donut { grid-template-columns: minmax(160px, 220px) 1fr; gap: 20px; align-items: center; }
    .smd-state { grid-template-columns: minmax(240px, 300px) 1fr; gap: 16px; }

    /* ---------- Marketing person bars ---------- */
    .smd-page .smd-bars { padding: 14px 16px 6px; background: #fff; border: 1px solid #eef2f7; border-radius: 14px; }
    .smd-person { margin: 0 0 14px; grid-template-columns: minmax(80px, 120px) 1fr; gap: 10px; font-size: 12px; font-weight: 600; color: #334155; }
    .smd-track { height: 10px; background: #f1f5f9; }
    .smd-track .target { background: #e2e8f0; }
    .smd-track .achieved { background: linear-gradient(90deg, #10b981, #34d399); box-shadow: none; }
    .smd-inline-legend { gap: 14px; font-size: 11.5px; font-weight: 600; color: #64748b; }
    .smd-inline-legend i { width: 9px; height: 9px; }

    /* ---------- Tables ---------- */
    .smd-page .smd-table-wrap { background: #fff; border: 1px solid #eef2f7; border-radius: 14px; }
    .smd-page .smd-card .smd-table th {
        background: #f8fafc; color: #64748b;
        font-size: 10.5px; font-weight: 700; letter-spacing: .06em;
        border-bottom: 1px solid #e2e8f0; padding: 10px 12px;
    }
    .smd-page .smd-table td { padding: 10px 12px; border-bottom: 1px solid #f1f5f9; color: #1e293b; }
    .smd-page .smd-table tbody tr:nth-child(even) { background: transparent; }
    .smd-page .smd-table tbody tr:hover { background: #f5f7ff; }
    .smd-page .smd-table tbody tr:last-child td { border-bottom: 0; }
    .smd-page .smd-table tfoot td {
        background: #f8fafc; color: #0f172a; font-weight: 700;
        border-top: 1px solid #e2e8f0; position: sticky; bottom: 0;
    }
    .smd-table .num { font-variant-numeric: tabular-nums; }
    .smd-pill { font-size: 10.5px; padding: 2px 8px; }

    /* ---------- Legends / meters ---------- */
    .smd-legend { gap: 2px; }
    .smd-legend-row { padding: 6px 8px; border-radius: 8px; grid-template-columns: 10px 1fr auto auto; gap: 10px; color: #334155; transition: background .12s ease; }
    .smd-legend-row:hover { background: #f5f7ff; }
    .smd-legend-row b { color: #0f172a; font-weight: 700; }
    .smd-dot { width: 10px; height: 10px; border-radius: 4px; }
    .smd-meter { margin: 0; padding: 8px 10px; border-radius: 10px; }
    .smd-meter:hover { background: #f5f7ff; }
    .smd-meter-track, .smd-mini { height: 8px; background: #eef2f7; }
    .smd-meter-name { font-weight: 600; color: #334155; }

    /* ---------- Financial-year switch (segmented control) ---------- */
    .smd-fy { gap: 2px; padding: 3px; background: #f1f5f9; border-radius: 999px; }
    .smd-fy button {
        border: 0; background: transparent; color: #64748b;
        padding: 5px 14px; font-size: 11px; font-weight: 700; border-radius: 999px;
        transition: background .15s ease, color .15s ease;
    }
    .smd-fy button:hover { color: #334155; }
    .smd-fy button.is-on { background: #fff; color: var(--smd-brand); box-shadow: 0 1px 3px rgba(15, 23, 42, 0.14); }

    /* ---------- Month wise: FY totals strip + table ---------- */
    .smd-fytotals { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
    .smd-fychip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 5px 12px; border-radius: 999px;
        background: #f8fafc; border: 1px solid var(--smd-border);
        font-size: 11.5px; font-weight: 600; color: #475569; white-space: nowrap;
    }
    .smd-fychip b { color: #0f172a; font-weight: 800; font-variant-numeric: tabular-nums; }
    .smd-fychip i { width: 9px; height: 9px; border-radius: 3px; display: inline-block; }
    .smd-fychip--prev i { background: #c7d2fe; }
    .smd-fychip--cur i { background: #4f46e5; }
    .smd-fychip .smd-kpi-up, .smd-fychip .smd-kpi-down, .smd-fychip .smd-kpi-flat {
        padding: 1px 7px; border-radius: 999px; font-size: 10.5px; font-weight: 700;
    }
    .smd-fychip .smd-kpi-up { background: #dcfce7; color: #15803d; }
    .smd-fychip .smd-kpi-down { background: #fee2e2; color: #b91c1c; }
    .smd-fychip .smd-kpi-flat { background: #f1f5f9; color: #64748b; }
    .smd-page .smd-month-table { margin-top: 14px; max-height: 320px; }

    /* ---------- Total lines at the end of lists ---------- */
    .smd-legend-total, .smd-meter--total {
        position: sticky; bottom: 0; z-index: 1;
        background: #f8fafc !important;
        border-top: 1px solid #e2e8f0;
        font-weight: 800; color: #0f172a;
    }
    .smd-legend-total { margin-top: 4px; border-radius: 0 0 8px 8px; }
    .smd-dot--sigma {
        width: 10px; height: auto; background: none; border-radius: 0;
        font-style: normal; font-size: 13px; font-weight: 800; line-height: 1; color: #475569;
    }
    .smd-meter--total { margin-top: 6px; border-radius: 10px; padding: 10px; }
    .smd-meter--total .smd-meter-name { font-weight: 800; }
    .smd-meter--total .smd-meter-sub { grid-column: 1 / -1; font-size: 11px; font-weight: 500; color: #64748b; }

    /* ---------- Links / map / dependence boxes ---------- */
    .smd-link { background: #eef2ff; color: #4338ca; padding: 6px 14px; font-size: 12px; font-weight: 700; border-radius: 999px; transition: background .15s ease; }
    .smd-link:hover { background: #e0e7ff; }
    .smd-map { background: linear-gradient(180deg, #f8fafc, #f1f5f9); border-radius: 14px; }
    .smd-dep { gap: 12px; margin-top: 14px; }
    .smd-dep div { background: #f8fafc; border: 1px solid var(--smd-border); box-shadow: none; padding: 12px 14px; }
    .smd-dep strong { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; }

    /* ---------- Footer ---------- */
    .smd-foot { margin-top: 8px; padding: 10px 16px; background: transparent; border: 0; color: #94a3b8; font-size: 11.5px; }

    /* =====================================================================
       Design v4 - richer hero, progress bars, rank badges, share bars
       ===================================================================== */

    /* ---------- Hero ---------- */
    .smd-hero-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; position: relative; z-index: 1; }
    .smd-hero-eyebrow {
        display: inline-flex; align-items: center; gap: 8px; align-self: flex-start;
        font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
        color: rgba(255, 255, 255, 0.82);
    }
    .smd-hero-text .smd-hero-title {
        display: block; flex: none; margin: 0;
        font-size: clamp(1.3rem, 2.4vw, 1.85rem); font-weight: 800; letter-spacing: -0.025em;
        text-shadow: 0 2px 14px rgba(15, 23, 42, 0.28);
    }
    .smd-hero-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 2px; }
    .smd-hero-chip {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 5px 13px; border-radius: 999px;
        background: rgba(255, 255, 255, 0.2); border: 1px solid rgba(255, 255, 255, 0.34);
        backdrop-filter: blur(8px);
        color: #fff; font-size: 12px; font-weight: 600; line-height: 1.3;
    }
    .smd-hero-chip i { font-size: 11px; opacity: .9; }
    .smd-hero-chip--soft { background: rgba(255, 255, 255, 0.09); color: rgba(255, 255, 255, 0.88); }
    .smd-hero-chip:has(> span:empty) { display: none; }

    /* ---------- KPI progress bars ---------- */
    .smd-kpi-bar {
        position: relative; z-index: 1; height: 6px; margin: 8px 0 2px;
        border-radius: 99px; background: #eef2f7;
    }
    .smd-kpi-bar span {
        display: block; height: 100%; width: 0; border-radius: 99px;
        background: var(--bar-c, linear-gradient(90deg, #10b981, #34d399));
        transition: width .8s cubic-bezier(.2, .8, .2, 1);
    }
    .smd-kpi-bar[data-tone="good"] { --bar-c: linear-gradient(90deg, #10b981, #34d399); }
    .smd-kpi-bar[data-tone="warn"] { --bar-c: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .smd-kpi-bar[data-tone="bad"]  { --bar-c: linear-gradient(90deg, #ef4444, #fb923c); }
    .smd-kpi-bar i {
        position: absolute; top: -3px; bottom: -3px; width: 2px; margin-left: -1px;
        border-radius: 2px; background: #0f172a; opacity: .5; display: none;
    }

    /* ---------- Rank badges + meters ---------- */
    .smd-meter { grid-template-columns: minmax(120px, 190px) 1fr auto auto; }
    .smd-meter-name { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .smd-meter-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .smd-rank {
        flex: 0 0 auto; width: 20px; height: 20px; border-radius: 7px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 10.5px; font-weight: 800; background: #f1f5f9; color: #64748b;
    }
    .smd-rank--1 { background: linear-gradient(135deg, #fde68a, #f59e0b); color: #78350f; }
    .smd-rank--2 { background: linear-gradient(135deg, #e2e8f0, #94a3b8); color: #1e293b; }
    .smd-rank--3 { background: linear-gradient(135deg, #fed7aa, #fb923c); color: #7c2d12; }

    /* ---------- Legend rows with a share bar behind ---------- */
    .smd-legend-row {
        background-image: linear-gradient(90deg, color-mix(in srgb, var(--c, #6366f1) 13%, transparent) var(--w, 0%), transparent var(--w, 0%));
    }
    .smd-legend-row:hover {
        background-color: #f5f7ff;
        background-image: linear-gradient(90deg, color-mix(in srgb, var(--c, #6366f1) 22%, transparent) var(--w, 0%), transparent var(--w, 0%));
    }

    /* ---------- Person bars: % at the end of each bar ---------- */
    .smd-person { grid-template-columns: minmax(80px, 120px) 1fr 44px; }
    .smd-person-pct { font-size: 11.5px; font-weight: 700; color: #0f172a; text-align: right; font-variant-numeric: tabular-nums; }

    /* ---------- Empty state ---------- */
    .smd-empty {
        display: flex; align-items: center; justify-content: center; text-align: center;
        padding: 28px 12px; margin: 4px 0;
        border: 1px dashed #cbd5e1; border-radius: 12px; background: #f8fafc;
        color: #94a3b8; font-size: 12.5px; font-weight: 600;
    }

    @@media (max-width: 768px) {
        .smd-hero-text .smd-hero-title { font-size: 1.3rem; }
        .smd-hero-chip { font-size: 11.5px; padding: 4px 11px; }
        /* ranked lists on a phone: name + value on the first line, bar + change on the second */
        .smd-meter { grid-template-columns: minmax(0, 1fr) auto; row-gap: 6px; column-gap: 10px; }
        .smd-meter > .smd-meter-name { grid-column: 1; grid-row: 1; }
        .smd-meter > .smd-meter-val { grid-column: 2; grid-row: 1; }
        .smd-meter > .smd-meter-track { grid-column: 1; grid-row: 2; align-self: center; }
        .smd-meter > div:nth-child(4) { grid-column: 2; grid-row: 2; justify-self: end; }
        .smd-meter > .smd-meter-sub { grid-column: 1 / -1; grid-row: 3; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .smd-kpi-bar span { transition: none; }
    }

    /* =====================================================================
       Design v5 - highlights strip, avatars, status pills
       ===================================================================== */
    .smd-insights {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 12px; margin-bottom: 6px;
    }
    .smd-insight {
        --ic: #4f46e5; --is: #eef2ff;
        display: flex; align-items: center; gap: 12px; min-width: 0;
        padding: 12px 14px; background: #fff;
        border: 1px solid var(--smd-border); border-radius: 16px;
        box-shadow: var(--smd-card-shadow);
        animation: smdRise .5s ease both;
        transition: transform .18s ease, box-shadow .18s ease;
    }
    .smd-insight:hover { transform: translateY(-2px); box-shadow: 0 14px 28px -16px rgba(15, 23, 42, 0.28); }
    .smd-insight--green  { --ic: #059669; --is: #d1fae5; }
    .smd-insight--red    { --ic: #dc2626; --is: #fee2e2; }
    .smd-insight--indigo { --ic: #4f46e5; --is: #e0e7ff; }
    .smd-insight--amber  { --ic: #d97706; --is: #fef3c7; }
    .smd-insight--teal   { --ic: #0d9488; --is: #ccfbf1; }
    .smd-insight--pink   { --ic: #db2777; --is: #fce7f3; }
    .smd-insight--blue   { --ic: #2563eb; --is: #dbeafe; }
    .smd-insight-ico {
        flex: 0 0 auto; width: 40px; height: 40px; border-radius: 12px;
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--is); color: var(--ic); font-size: 16px;
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ic) 16%, transparent);
    }
    .smd-insight-body { min-width: 0; display: flex; flex-direction: column; gap: 1px; }
    .smd-insight-k { font-size: 10.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #94a3b8; }
    .smd-insight-v { font-size: 14px; font-weight: 800; color: #0f172a; letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .smd-insight-s { font-size: 11.5px; font-weight: 500; color: #64748b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* Marketing person table: avatar + coloured achievement pill */
    .smd-person-cell { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .smd-person-cell-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
    .smd-avatar {
        flex: 0 0 auto; width: 28px; height: 28px; border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 10.5px; font-weight: 800; letter-spacing: .02em; color: #fff;
        background: var(--av, linear-gradient(135deg, #6366f1, #8b5cf6));
        box-shadow: 0 4px 10px -4px rgba(15, 23, 42, 0.35);
    }
    .smd-avatar--0 { --av: linear-gradient(135deg, #6366f1, #8b5cf6); }
    .smd-avatar--1 { --av: linear-gradient(135deg, #0ea5e9, #2563eb); }
    .smd-avatar--2 { --av: linear-gradient(135deg, #10b981, #0d9488); }
    .smd-avatar--3 { --av: linear-gradient(135deg, #f59e0b, #f97316); }
    .smd-avatar--4 { --av: linear-gradient(135deg, #ec4899, #e11d48); }
    .smd-avatar--5 { --av: linear-gradient(135deg, #8b5cf6, #d946ef); }
    .smd-pct { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; }
    .smd-pct--good { background: #dcfce7; color: #15803d; }
    .smd-pct--warn { background: #fef3c7; color: #b45309; }
    .smd-pct--bad  { background: #fee2e2; color: #b91c1c; }

    /* Full names: long names wrap onto the next line instead of being cut with "..." */
    .smd-page .smd-meter { grid-template-columns: minmax(150px, 2fr) minmax(60px, 1fr) auto auto; align-items: center; }
    .smd-page .smd-meter-name,
    .smd-page .smd-meter-text,
    .smd-page .smd-person-name,
    .smd-page .smd-person-cell-name {
        overflow: visible; text-overflow: clip;
        white-space: normal; overflow-wrap: anywhere; word-break: normal;
        line-height: 1.3;
    }
    .smd-page .smd-meter-name { align-items: flex-start; }
    .smd-page .smd-meter-name .smd-rank { margin-top: 1px; }
    .smd-page .smd-person { align-items: center; }
    .smd-page .smd-table td { overflow-wrap: anywhere; }
    @@media (max-width: 768px) {
        .smd-page .smd-meter { grid-template-columns: minmax(0, 1fr) auto; }
    }

    /* Card title + sub text: one full-colour header band (colour = the card's accent) */
    .smd-page .smd-card { --cpx: 20px; --cpt: 18px; }
    .smd-page .smd-card::before { display: none; }
    .smd-page .smd-card .smd-card-head {
        margin: calc(var(--cpt) * -1) calc(var(--cpx) * -1) 0;
        padding: 14px var(--cpx) 6px;
        border: 0; border-radius: 0;
        background: linear-gradient(100deg, color-mix(in srgb, var(--smd-card-accent) 66%, #0f172a), var(--smd-card-accent));
        color: #fff;
    }
    .smd-page .smd-card > .smd-sub {
        margin: 0 calc(var(--cpx) * -1) 16px;
        padding: 0 var(--cpx) 14px;
        background: linear-gradient(100deg, color-mix(in srgb, var(--smd-card-accent) 66%, #0f172a), var(--smd-card-accent));
        color: rgba(255, 255, 255, 0.92); font-weight: 500;
    }
    .smd-page .smd-card .smd-card-head h3 { color: #fff; text-shadow: 0 1px 6px rgba(15, 23, 42, 0.25); }
    .smd-page .smd-card .smd-card-head h3 i {
        background: rgba(255, 255, 255, 0.95);
        color: color-mix(in srgb, var(--smd-card-accent) 80%, #0f172a);
        box-shadow: 0 4px 10px -4px rgba(15, 23, 42, 0.4);
    }
    .smd-page .smd-card .smd-inline-legend { color: rgba(255, 255, 255, 0.95); }
    .smd-page .smd-card .smd-inline-legend i { box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.55); }
    .smd-page .smd-card .smd-card-head .smd-link { background: rgba(255, 255, 255, 0.2); color: #fff; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35); }
    .smd-page .smd-card .smd-card-head .smd-link:hover { background: rgba(255, 255, 255, 0.32); }
    .smd-page .smd-card .smd-fychip { background: rgba(255, 255, 255, 0.96); }
    @@media (max-width: 768px) {
        .smd-page .smd-card { --cpx: 14px; --cpt: 14px; }
    }

    /* ---------------------------------------------------------------
       Full-colour tiles: KPI tiles, Highlights tiles, dependence boxes
       --------------------------------------------------------------- */
    .smd-page .smd-kpis .smd-kpi {
        --g1: #4338ca; --g2: #2563eb;
        background: linear-gradient(135deg, var(--g1), var(--g2)) !important;
        color: #fff !important;
        border: 0 !important;
        box-shadow: 0 14px 26px -14px color-mix(in srgb, var(--g1) 80%, #000) !important;
    }
    .smd-page .smd-kpis .smd-kpi--sale        { --g1: #3730a3; --g2: #2563eb; }
    .smd-page .smd-kpis .smd-kpi--best        { --g1: #0f766e; --g2: #14b8a6; }
    .smd-page .smd-kpis .smd-kpi--target      { --g1: #c2410c; --g2: #f59e0b; }
    .smd-page .smd-kpis .smd-kpi--outstanding { --g1: #5b21b6; --g2: #8b5cf6; }
    .smd-page .smd-kpis .smd-kpi--overdue     { --g1: #b91c1c; --g2: #f43f5e; }
    .smd-page .smd-kpis .smd-kpi::before { display: none; }
    .smd-page .smd-kpis .smd-kpi::after { background: radial-gradient(circle, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.03) 70%); opacity: 1; }
    .smd-page .smd-kpis .smd-kpi:hover {
        border: 0 !important;
        box-shadow: 0 20px 34px -14px color-mix(in srgb, var(--g1) 85%, #000) !important;
    }
    .smd-page .smd-kpis .smd-kpi-ico {
        background: rgba(255, 255, 255, 0.22); color: #fff;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    }
    .smd-page .smd-kpis .smd-kpi-label { color: rgba(255, 255, 255, 0.92) !important; }
    .smd-page .smd-kpis .smd-kpi-value { color: #fff !important; text-shadow: 0 2px 8px rgba(15, 23, 42, 0.22); }
    .smd-page .smd-kpis .smd-kpi-sub { color: rgba(255, 255, 255, 0.9) !important; }
    .smd-page .smd-kpis .smd-kpi-sub-r { color: rgba(255, 255, 255, 0.85); }
    .smd-page .smd-kpis .smd-kpi-up,
    .smd-page .smd-kpis .smd-kpi-down,
    .smd-page .smd-kpis .smd-kpi-flat { background: rgba(255, 255, 255, 0.25); color: #fff; }
    .smd-page .smd-kpis .smd-kpi--overdue .smd-kpi-down { background: transparent; color: #fff; }
    .smd-page .smd-kpis .smd-kpi-bar { background: rgba(255, 255, 255, 0.28); }
    .smd-page .smd-kpis .smd-kpi-bar[data-tone] { --bar-c: #fff; }
    .smd-page .smd-kpis .smd-kpi-bar i { background: #fff; opacity: .9; }

    .smd-page .smd-insight {
        --g1: #4338ca; --g2: #6366f1;
        background: linear-gradient(135deg, var(--g1), var(--g2));
        border: 0; color: #fff;
        box-shadow: 0 12px 24px -14px color-mix(in srgb, var(--g1) 80%, #000);
    }
    .smd-page .smd-insight--green  { --g1: #047857; --g2: #10b981; }
    .smd-page .smd-insight--red    { --g1: #b91c1c; --g2: #f43f5e; }
    .smd-page .smd-insight--indigo { --g1: #3730a3; --g2: #6366f1; }
    .smd-page .smd-insight--amber  { --g1: #b45309; --g2: #f59e0b; }
    .smd-page .smd-insight--teal   { --g1: #0f766e; --g2: #14b8a6; }
    .smd-page .smd-insight--pink   { --g1: #9d174d; --g2: #ec4899; }
    .smd-page .smd-insight--blue   { --g1: #1d4ed8; --g2: #38bdf8; }
    .smd-page .smd-insight:hover { box-shadow: 0 18px 30px -14px color-mix(in srgb, var(--g1) 85%, #000); }
    .smd-page .smd-insight-ico { background: rgba(255, 255, 255, 0.22); color: #fff; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35); }
    .smd-page .smd-insight-k { color: rgba(255, 255, 255, 0.8); }
    .smd-page .smd-insight-v { color: #fff; }
    .smd-page .smd-insight-s { color: rgba(255, 255, 255, 0.9); }
    /* full text, no "..." */
    .smd-page .smd-insight-v,
    .smd-page .smd-insight-s { overflow: visible; text-overflow: clip; white-space: normal; overflow-wrap: anywhere; line-height: 1.3; }

    .smd-page .smd-dep div { border: 0; color: #fff; box-shadow: 0 10px 20px -12px rgba(15, 23, 42, 0.45); }
    .smd-page .smd-dep div:nth-child(1) { background: linear-gradient(135deg, #1d4ed8, #3b82f6); }
    .smd-page .smd-dep div:nth-child(2) { background: linear-gradient(135deg, #6d28d9, #a78bfa); }
    .smd-page .smd-dep div:nth-child(3) { background: linear-gradient(135deg, #c2410c, #fb923c); }
    .smd-page .smd-dep span { color: rgba(255, 255, 255, 0.88); }
    .smd-page .smd-dep strong { color: #fff; }

    /* Cards: accent line grows a little on hover */
    .smd-page .smd-card::before { transition: height .2s ease; }
    .smd-page .smd-card:hover::before { height: 5px; }
    @@media (prefers-reduced-motion: reduce) { .smd-insight { animation: none !important; transition: none; } }
    @@media print { .smd-insight { box-shadow: none; animation: none !important; break-inside: avoid; } }

    /* ---------- Scrollbars ---------- */
    .smd-page ::-webkit-scrollbar { width: 6px; height: 6px; }
    .smd-page ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }
    .smd-page ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    .smd-page ::-webkit-scrollbar-track { background: transparent; }

    /* ---------- Responsive: based on the page area width, not the browser window ---------- */
    @@container smdshell (max-width: 1180px) {
        .smd-page .smd-grid { grid-template-columns: 1fr; }
    }
    @@container smdshell (max-width: 1060px) {
        .smd-page .smd-kpis { grid-template-columns: repeat(6, minmax(0, 1fr)); }
        .smd-page .smd-kpis .smd-kpi { grid-column: span 2; }
        .smd-page .smd-kpis .smd-kpi:nth-child(n+4) { grid-column: span 3; }
    }
    @@container smdshell (max-width: 640px) {
        .smd-page .smd-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .smd-page .smd-kpis .smd-kpi,
        .smd-page .smd-kpis .smd-kpi:nth-child(n+4) { grid-column: span 1; }
        .smd-page .smd-kpis .smd-kpi:nth-child(5) { grid-column: 1 / -1; }
        .smd-page .smd-kpis .smd-kpi-value { font-size: 22px; }
    }
    @@container smdshell (max-width: 420px) {
        .smd-page .smd-kpis .smd-kpi { padding: 12px 12px 10px; }
        .smd-page .smd-kpis .smd-kpi-value { font-size: 19px; margin-top: 6px; }
        .smd-kpi-ico { width: 28px; height: 28px; border-radius: 8px; font-size: 12px; }
        .smd-page .smd-kpis .smd-kpi-label { font-size: 11px; }
    }
    @@container smdshell (max-width: 380px) {
        .smd-page .smd-kpis { grid-template-columns: 1fr; }
        .smd-page .smd-kpis .smd-kpi:nth-child(5) { grid-column: auto; }
    }
    @@container smdcard (max-width: 680px) {
        .smd-page .smd-split,
        .smd-page .smd-donut,
        .smd-page .smd-state { grid-template-columns: 1fr; }
        .smd-page .smd-donut .smd-canvas { max-width: 260px; margin: 0 auto; width: 100%; }
        .smd-dep { grid-template-columns: 1fr; }
    }
    @@container smdcard (min-width: 681px) and (max-width: 860px) {
        .smd-dep { grid-template-columns: repeat(3, 1fr); }
        .smd-dep strong { font-size: 17px; }
    }

    /* ---------- Hero: tablet / desktop (filter button floats top-right) ---------- */
    @@media (min-width: 769px) {
        .smd-hero-body { flex-direction: row; align-items: center; padding: 20px 28px; padding-right: 88px; }
        .smd-hero-title { flex-direction: row; align-items: center; gap: 12px 16px; }
        .smd-hero-actions { width: auto; justify-content: flex-end; }
        .smd-hero-btn { flex: 0 0 auto; justify-content: flex-start; }
    }

    /* ---------- Phone: the filter button moves to the bottom-right corner ---------- */
    @@media (max-width: 768px) {
        /* keep the last cards / footer clear of the floating filter button */
        .smd-page { padding-bottom: 96px; }
        .smd-hero { border-radius: 16px; margin-bottom: 14px; }
        .smd-hero-body {
            flex-direction: column; align-items: stretch; gap: 12px;
            padding: 14px 16px;            /* no right gap needed: button is at the bottom now */
        }
        .smd-hero-title { flex-direction: column; align-items: flex-start; gap: 8px; font-size: 1.1rem; }
        .smd-hero-title .smd-date-from,
        .smd-hero-title .smd-date-to { padding: 6px 12px; font-size: 13px; }
        .smd-hero-actions { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .smd-hero-btn {
            width: 100%; min-height: 44px; justify-content: center;
            padding: 6px 12px 6px 6px; font-size: 12px;
        }
        .smd-section-head { margin: 20px 0 10px; }
        .smd-page .smd-banner { padding: 9px 12px; font-size: 12px; align-items: flex-start; }
        .smd-page .smd-banner::before { margin-top: 1px; }
        .smd-page .smd-grid { gap: 14px; margin-bottom: 14px; }
        .smd-page .smd-card { padding: 14px 14px 16px; border-radius: 16px; }
        .smd-card-head { flex-wrap: wrap; gap: 8px; }
        .smd-link, .smd-fy button { min-height: 32px; }
        .smd-page .smd-bars { padding: 12px 12px 4px; }
        .smd-foot { padding: 8px 4px; }
    }
    @@media (max-width: 360px) {
        .smd-hero-actions { grid-template-columns: 1fr; }
    }
    /* phone in landscape: short screen, keep the hero compact */
    @@media (max-width: 900px) and (max-height: 500px) and (orientation: landscape) {
        .smd-hero-body { flex-direction: row; align-items: center; padding: 10px 16px; padding-right: 16px; }
        .smd-hero-actions { width: auto; display: flex; }
        .smd-hero-btn { width: auto; min-height: 38px; }
    }

    @@media print {
        .smd-page { padding-bottom: 0; }
        .smd-page .smd-kpis { grid-template-columns: repeat(5, minmax(0, 1fr)); }
        .smd-page .smd-kpis .smd-kpi, .smd-page .smd-kpis .smd-kpi:nth-child(n+4) { grid-column: auto; box-shadow: none !important; }
        .smd-page .smd-grid { grid-template-columns: 1.35fr 0.95fr; }
        .smd-page .smd-table tfoot td { position: static; }
    }
</style>

<div class="smd-page">
    <filter-side-panel-control id="filterPanel" show-button="true"></filter-side-panel-control>

    <div class="smd-shell">
    <header class="smd-hero">
        <div class="smd-hero-stripe" aria-hidden="true"></div>
        <div class="smd-hero-body">
            <div class="smd-hero-text">
                <span class="smd-hero-eyebrow"><i class="fa-solid fa-chart-line" aria-hidden="true"></i> CRM reports &middot; Sales</span>
                <h2 id="smdRangeTitle" class="smd-hero-title">Sales Management Dashboard</h2>
                <div class="smd-hero-chips">
                    <span id="smdHeroPeriod" class="smd-hero-chip"><i class="fa-regular fa-calendar" aria-hidden="true"></i><span></span></span>
                    <span id="smdHeroCompare" class="smd-hero-chip smd-hero-chip--soft"><i class="fa-solid fa-code-compare" aria-hidden="true"></i><span></span></span>
                </div>
            </div>
            <div class="smd-hero-actions smd-no-print">
                <button type="button" id="btnSmdExportExcel" class="smd-hero-btn smd-hero-btn--excel">
                    <i class="fa-solid fa-file-excel" aria-hidden="true"></i> Export to Excel
                </button>
                <button type="button" id="btnSmdPrintPdf" class="smd-hero-btn smd-hero-btn--print">
                    <i class="fa-solid fa-print" aria-hidden="true"></i> Print / PDF
                </button>
            </div>
        </div>
    </header>

    <div class="smd-section-head">
        <h4>Performance overview</h4>    </div>
    <div class="smd-kpis">
        <div class="smd-kpi smd-kpi--sale">
            <div class="smd-kpi-head"><span class="smd-kpi-ico"><i class="fa-solid fa-indian-rupee-sign" aria-hidden="true"></i></span><div class="smd-kpi-label">Total sale (this month)</div></div>
            <div id="kpiSale" class="smd-kpi-value">₹ 0</div>
            <div class="smd-kpi-sub"><span id="kpiSaleGrowth"></span><span id="kpiSaleVs" class="smd-kpi-sub-r"></span></div>
        </div>
        <div class="smd-kpi smd-kpi--best">
            <div class="smd-kpi-head"><span class="smd-kpi-ico"><i class="fa-solid fa-trophy" aria-hidden="true"></i></span><div class="smd-kpi-label">Best day of the month</div></div>
            <div id="kpiBest" class="smd-kpi-value">₹ 0</div>
            <div class="smd-kpi-sub"><span id="kpiBestDate"></span><span id="kpiBestAvg" class="smd-kpi-sub-r"></span></div>
        </div>
        <div class="smd-kpi smd-kpi--target">
            <div class="smd-kpi-head"><span class="smd-kpi-ico"><i class="fa-solid fa-bullseye" aria-hidden="true"></i></span><div class="smd-kpi-label">Target achievement</div></div>
            <div id="kpiAchieve" class="smd-kpi-value">—</div>
            <div class="smd-kpi-bar" id="kpiAchieveBar" data-tone="good" title="Achieved so far. The tick shows how much of the month is gone."><span></span><i></i></div>
            <div class="smd-kpi-sub"><span id="kpiTarget"></span></div>
        </div>
        <div class="smd-kpi smd-kpi--outstanding">
            <div class="smd-kpi-head"><span class="smd-kpi-ico"><i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i></span><div class="smd-kpi-label">Total outstanding</div></div>
            <div id="kpiOutstanding" class="smd-kpi-value">₹ 0</div>
            <div class="smd-kpi-sub"><span id="kpiOutstandingSub"></span></div>
        </div>
        <div class="smd-kpi smd-kpi--overdue">
            <div class="smd-kpi-head"><span class="smd-kpi-ico"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span><div class="smd-kpi-label">Overdue amount</div></div>
            <div id="kpiOverdue" class="smd-kpi-value">₹ 0</div>
            <div class="smd-kpi-bar" id="kpiOverdueBar" data-tone="bad" title="Overdue share of the outstanding amount"><span></span></div>
            <div class="smd-kpi-sub"><span id="kpiOverdueSub" class="smd-kpi-down"></span></div>
        </div>
        <style>
            /* "Showing ... / Comparisons are against ..." strip above the tiles */
            /* KPI + banner styling lives in the "Design v3" block below */
        </style>
    </div>

    <div class="smd-section-head">
        <h4>Highlights</h4>    </div>
    <div id="smdInsights" class="smd-insights" style="display:none"></div>

    <div class="smd-section-head">
        <h4>Sales analytics</h4>    </div>
    <div class="smd-grid">
                <section class="smd-card smd-card--1">
                    <div class="smd-card-head">
                        <h3><i>1</i> Marketing person target vs achieved</h3>
                        <div class="smd-inline-legend"><span><i class="ach"></i>Achieved</span><span><i class="tgt"></i>Target</span></div>
                    </div>
                    <p class="smd-sub">Selected period and filters</p>
                    <div class="smd-split">
                        <div id="personBars" class="smd-bars"></div>
                        <div class="smd-table-wrap">
                            <table class="smd-table">
                                <thead><tr><th>Marketing person</th><th class="num">Target</th><th class="num">Achieved</th><th class="num">%</th><th class="num">Gap</th></tr></thead>
                                <tbody id="personBody"></tbody>
                                <tfoot id="personFoot"></tfoot>
                            </table>
                        </div>
                    </div>
                </section>
                <section class="smd-card smd-card--2">
                    <div class="smd-card-head"><h3><i>2</i> Industry type wise sale</h3></div>
                    <p class="smd-sub">Share of sale in the selected period</p>
                    <div class="smd-donut">
                        <div class="smd-canvas"><canvas id="chartIndustry"></canvas></div>
                        <div id="industryLegend" class="smd-legend"></div>
                    </div>
                </section>
            </div>

    <div class="smd-grid">
                <section class="smd-card smd-card--3">
                    <div class="smd-card-head">
                        <h3><i>3</i> Month wise sale trend</h3>
                        <div id="fyToggle" class="smd-fytotals"></div>
                    </div>
                    <p class="smd-sub">April to March, month by month. This financial year is compared with the last one (April with April, May with May). It does not follow the date filter.</p>
                    <div class="smd-canvas"><canvas id="chartMonth"></canvas></div>
                    <div class="smd-table-wrap smd-month-table">
                        <table class="smd-table">
                            <thead><tr><th>Month</th><th class="num" id="monthHeadPrev">Last FY</th><th class="num" id="monthHeadCur">This FY</th><th class="num">Change</th></tr></thead>
                            <tbody id="monthBody"></tbody>
                            <tfoot id="monthFoot"></tfoot>
                        </table>
                        <p id="monthNote" class="smd-note"></p>
                    </div>
                </section>
                <section class="smd-card smd-card--4">
                    <div class="smd-card-head"><h3><i>4</i> Sale by type — domestic and export</h3></div>
                    <p class="smd-sub">Selected period</p>
                    <div class="smd-donut">
                        <div class="smd-canvas short"><canvas id="chartSaleType"></canvas></div>
                        <div>
                            <div id="saleTypeLegend" class="smd-legend"></div>
                            <div id="saleTypeBars"></div>
                        </div>
                    </div>
                </section>
            </div>

    <div class="smd-grid">
                <section class="smd-card smd-card--5">
                    <div class="smd-card-head"><h3><i>5</i> Top 10 items for sale</h3></div>
                    <p class="smd-sub">Compared with the previous period</p>
                    <div id="itemBars"></div>
                </section>
                <section class="smd-card smd-card--6">
                    <div class="smd-card-head"><h3><i>6</i> Top 10 parties by sale</h3></div>
                    <p class="smd-sub">Compared with the previous period</p>
                    <div id="partyBars"></div>
                </section>
            </div>

    <div class="smd-section-head">
        <h4>Geography &amp; customers</h4>    </div>
    <section class="smd-card smd-card--7" style="margin-bottom:20px;">
                <div class="smd-card-head">
                    <h3><i>7</i> State wise sale</h3>
                    <button type="button" id="btnDrillCity" class="smd-link">Drill to city</button>
                </div>
                <p class="smd-sub">Domestic sale by state for the selected period.</p>
                <div class="smd-state">
                    <div id="stateMap" class="smd-map">
                        <svg viewBox="0 0 220 260" aria-hidden="true">
                            <path fill="#e7f0fb" stroke="#c5d7ee" stroke-width="1.2" d="M108 16l10 12 16-4 12 14 14 8 12 16 6 10-8 12 16 18 4 14-12 10 10 16 2 12-10 14 8 18-6 16-18 12-8 18-8 16-12 14-8 18-8 6-10-8-8 10-12-6-10-16-8-10-12-6-14 8-16-10-8-18 6-14-12-12-8-16 10-14-6-18 8-16-10-20 6-14 12-18 2-16-8-14 10-16 8-12 10-8z"/>
                            <path fill="#d6e6f8" stroke="#c5d7ee" stroke-width="1" d="M158 86l20 8 18 12 6 10-6 12-14 6-12-6-8 8-8-10-10-8 4-12z"/>
                        </svg>
                    </div>
                    <div class="smd-table-wrap">
                        <table class="smd-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th id="placeHead">State</th>
                                    <th></th>
                                    <th class="num">Sale</th>
                                    <th class="num">Share</th>
                                    <th class="num">Vs compare</th>
                                </tr>
                            </thead>
                            <tbody id="stateBody"></tbody>
                            <tfoot id="stateFoot"></tfoot>
                        </table>
                        <p id="stateNote" class="smd-note"></p>
                    </div>
                </div>
            </section>

    <div class="smd-grid">
                <section class="smd-card smd-card--8">
                    <div class="smd-card-head">
                        <h3><i>8</i> Customer contribution</h3>
                        <button type="button" id="btnAllCustomers" class="smd-link">All customers</button>
                    </div>
                    <p class="smd-sub">Share of sale by customer</p>
                    <div class="smd-donut">
                        <div class="smd-canvas short"><canvas id="chartContribution"></canvas></div>
                        <div class="smd-table-wrap">
                            <table class="smd-table">
                                <thead><tr><th>Customer</th><th class="num">Sale</th><th class="num">Share</th></tr></thead>
                                <tbody id="contributionBody"></tbody>
                            </table>
                        </div>
                    </div>
                    <p id="contributionNote" class="smd-note"></p>
                </section>
                <section class="smd-card smd-card--9">
                    <div class="smd-card-head"><h3><i>9</i> Dependence on top customers</h3></div>
                    <p id="depSummary" class="smd-sub">Customers ranked biggest first</p>
                    <div class="smd-canvas"><canvas id="chartDependence"></canvas></div>
                    <div id="depBoxes" class="smd-dep"></div>
                    <p id="depNote" class="smd-note"></p>
                </section>
            </div>
    <p class="smd-foot">All amounts are invoice value (₹). Charts and tables follow the applied filter.</p>
    </div>
</div>

