@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Reports/Script/OrderReport.js"></script>
<script src="https://cdn.rawgit.com/rainabba/jquery-table2excel/1.1.0/dist/jquery.table2excel.min.js"></script>
<style>

    .without-label-field {
        margin-top: 2.1rem;
    }

    .datepicker td, .datepicker th {
        border-radius: 20px !important;
    }

    .datepicker table tr td, .datepicker table tr td {
        padding: 8px 9px !important;
        height: 16px !important;
    }

    .datepicker table tfoot {
        display: none;
    }

    #hidetexbox {
        display: none;
    }

    .form-label {
        font-weight: bold;
    }
</style>
<div class="">
    <div class="card shadow-sm">
        <div class="card-body  shadow-sm">
            <div class="row">
                <div class="col-md-2">
                    <label for="txtReportType" class="col-form-label-sm fw-bold">Report Type</label>

                    <select id="ddlReportTypelist" class="form-control form-control-sm box_border">
                    </select>
                </div>
                <div class="col-md-2" id="divFromDate">
                    <label for="txtdateFrom" class="col-form-label-sm fw-bold">From Date</label>
                    <input id="txtdateFrom" type="text" name="txtdateFrom" autocomplete="off" class="form-control form-control-sm box_border" placeholder="" required>
                </div>
                <div class="col-md-2">
                    <label for="txtdateTo" class="col-form-label-sm fw-bold" id="lblToDate">To Date</label>
                    <input id="txtdateTo" type="text" name="txtdateTo" autocomplete="off" class="form-control form-control-sm box_border" placeholder="" required>
                </div>

                <div class="col-md-3">
                    <label for="txtSalesPerson" class="col-form-label-sm fw-bold">Sales Person</label>
                   
                    <select id="ddlSalesPersonlist" class="form-control form-control-sm box_border">
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="txtDealerName" class="col-form-label-sm fw-bold">Dealer Name</label>
                    
                    <select id="ddlDealerNamelist" class="form-control form-control-sm box_border">
                    </select>
                </div>
               
            </div>
            <div class="row">
                
                <div class="col-md-3 without-label-field">
                    <button type="button" id="btnShow" class="btn btn-primary btn-height btn-width">Show</button>
                    <button type="button" class="btn btn-primary btn-height btn-width" id="btnLoading" hidden="true">
                        <i class="bx bx-loader bx-spin font-size-14 align-middle me-2"></i>Loading
                    </button>
                    <button type="button" id="btnDownload" class="btn btn-primary btn-height btn-width">Download</button>

                </div>

            </div>
        </div>
    </div>
</div>

<div class="card-body">
    <div class="table-wrapper fixed-height-table">
        <table id="tblOrderReport" style="width:150%" class=" table">
            <thead id="tblOrderReport-header">
            </thead>
            <tbody id="tblOrderReport-body">
            </tbody>

        </table>

    </div>
    <!-- Paginator -->
    <div class="paginator" id="paginator-tblOrderReport">
    </div>
</div>
<div class="table-wrapper fixed-height-table" hidden="hidden">
    <table id="tblReport" hidden="hidden">
        <thead id="tblReport-headerPrint">
            <tr></tr>
        </thead>
        <tbody id="tblReport-bodyPrint">
        </tbody>
    </table>
</div>



