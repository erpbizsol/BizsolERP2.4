@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.CRM.Transactions/css/ExpenseEntry.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Reports/Script/ProjectManagementReport.js"></script>
<script src="https://cdn.rawgit.com/rainabba/jquery-table2excel/1.1.0/dist/jquery.table2excel.min.js"></script>
<style>
    .pmr-page .pmr-filter-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
        gap: 0.75rem 2rem;
        align-items: end;
    }
    #tblPMR thead th.pmr-budget-col {
        display: none;
    }
    @@media (min-width: 992px) {
        .pmr-page.pmr-budget-mode .pmr-filter-row {
            grid-template-columns: minmax(220px, 1fr) minmax(130px, 1fr) minmax(160px, 1fr) auto;
        }
        .pmr-page.pmr-pogr-mode .pmr-filter-row {
            grid-template-columns: minmax(180px, 1fr) minmax(130px, 1fr) minmax(160px, 1fr) minmax(160px, 1fr) auto;
        }
        .pmr-page.pmr-pogr-mode.pmr-pogr-sub .pmr-filter-row {
            grid-template-columns: minmax(160px, 1fr) minmax(120px, 1fr) minmax(150px, 1fr) minmax(150px, 1fr) minmax(150px, 1fr) auto;
        }
        .pmr-page.pmr-pogr-mode.pmr-pogr-detail .pmr-filter-row {
            grid-template-columns: minmax(140px, 1fr) minmax(110px, 1fr) minmax(140px, 1fr) minmax(140px, 1fr) minmax(140px, 1fr) minmax(120px, 1fr) auto;
        }
    }
    .pmr-page.pmr-budget-mode #tblPMR,
    .pmr-page.pmr-pogr-mode #tblPOGRN {
        table-layout: auto;
    }
    .pmr-page.pmr-budget-detail #tblPMR {
        display: none !important;
    }
    #pmrBudgetDetail {
        display: none;
        padding: 0.85rem 1rem 1.1rem;
    }
    .pmr-page.pmr-budget-detail #pmrBudgetDetail {
        display: block;
    }
    .pmr-budget-detail-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        gap: 1.1rem;
        align-items: start;
    }
    .pmr-budget-detail-card {
        min-width: 0;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }
    .pmr-budget-detail-card h3 {
        margin: 0;
        padding: 0.55rem 0.75rem;
        font-size: 0.82rem;
        font-weight: 800;
        color: #1e293b;
        background: #f4c430;
        border-bottom: 1px solid #e0b000;
    }
    .pmr-budget-detail-card table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }
    .pmr-budget-detail-card thead th {
        background: #f4c430 !important;
        color: #1e293b !important;
        font-size: 0.72rem;
        font-weight: 800;
        text-align: left;
        padding: 0.45rem 0.6rem;
        border: 1px solid #e0b000 !important;
    }
    .pmr-budget-detail-card thead th.num,
    .pmr-budget-detail-card td.num {
        text-align: right;
    }
    .pmr-budget-detail-card td {
        font-size: 0.76rem;
        padding: 0.4rem 0.6rem;
        border: 1px solid #e2e8f0;
        vertical-align: middle;
    }
    .pmr-budget-detail-card tr.row-total td {
        font-weight: 700;
        background: #fff8d6;
    }
    .pmr-budget-detail-empty {
        padding: 0.85rem 0.75rem;
        color: #64748b;
        font-size: 0.78rem;
        text-align: center;
    }
    .pmr-page.pmr-pogr-mode #tblPMR,
    .pmr-page:not(.pmr-pogr-mode) #tblPOGRN {
        display: none;
    }
    #tblPMRBody a.pmr-budget-drill-link {
        color: #4338ca;
        font-weight: 600;
        text-decoration: underline;
        cursor: pointer;
    }
    #tblPMRBody a.pmr-budget-drill-link:hover {
        color: #312e81;
    }
    #tblPMRBody tr.pmr-budget-drill {
        cursor: pointer;
    }
    #tblPMRBody tr.pmr-budget-drill:hover {
        background: #eef2ff;
    }
    #pogrTableBody a.pogr-drill-link {
        color: #4338ca;
        font-weight: 600;
        text-decoration: underline;
        cursor: pointer;
    }
    #pogrTableBody a.pogr-drill-link:hover {
        color: #312e81;
    }
    #pogrTableBody tr.pogr-drill {
        cursor: pointer;
    }
    #pogrTableBody tr.pogr-drill:hover {
        background: #eef2ff;
    }
    .pmr-drill-crumb #pmrDrillPath {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem 0.4rem;
    }
    .pmr-selected-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }
    .pmr-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.28rem 0.7rem;
        border-radius: 999px;
        background: #fff;
        border: 1px solid #c7d2fe;
        font-size: 0.78rem;
        color: #1e293b;
        max-width: 100%;
    }
    .pmr-chip .lbl {
        color: #64748b;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.65rem;
        letter-spacing: 0.03em;
    }
    .pmr-chip .val {
        font-weight: 800;
        color: #312e81;
        word-break: break-word;
    }
    .pmr-page .pmr-filter-field {
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }
    .pmr-page .pmr-filter-field .form-label {
        font-size: 0.77rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 0.35rem;
    }
    .pmr-page .pmr-filter-field input.form-control.form-control-sm,
    .pmr-page .pmr-filter-field select.form-control.form-control-sm {
        height: 38px !important;
        min-height: 38px !important;
        border: 1.5px solid #cbd5e1 !important;
        border-radius: 10px !important;
        font-size: 13px !important;
    }
    .pmr-page .pmr-filter-field .select2-container--default .select2-selection--single {
        height: 38px !important;
        min-height: 38px !important;
        border: 1.5px solid #cbd5e1 !important;
        border-radius: 10px !important;
    }
    .pmr-page .pmr-filter-field .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 34px !important;
        font-size: 13px;
    }
    .pmr-page .pmr-filter-field .select2-container {
        width: 100% !important;
        max-width: 100%;
    }
    .pmr-page .pmr-filter-actions {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-self: end;
    }
    .pmr-page .pmr-filter-actions .pmr-btn-show {
        height: 38px;
        border: none !important;
        color: #fff !important;
        background: linear-gradient(135deg, #667eea, #764ba2) !important;
        border-radius: 999px;
        font-weight: 700;
        padding: 0 1.2rem;
    }
    .pmr-page .ee-list-stats-strip .ee-list-stat-chip {
        cursor: default;
        pointer-events: none;
    }
    @@media (min-width: 769px) {
        .pmr-page .expense-entry-table-wrapper {
            overflow-x: hidden !important;
        }
    }
    .pmr-page.pmr-pogr-mode,
    .pmr-page.pmr-pogr-mode .expense-entry-card.ee-list-grid-wrap {
        overflow: visible;
        max-width: 100%;
        min-width: 0;
    }
    .pmr-page.pmr-pogr-mode .expense-entry-table-wrapper.pmr-table-wrap {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        max-height: none !important;
        overflow-x: auto !important;
        overflow-y: visible !important;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: auto;
        touch-action: pan-x pan-y;
        scrollbar-width: thin;
        scrollbar-color: #64748b #e2e8f0;
    }
    .pmr-page.pmr-pogr-mode .expense-entry-table-wrapper.pmr-table-wrap::-webkit-scrollbar {
        height: 12px;
        display: block;
    }
    .pmr-page.pmr-pogr-mode .expense-entry-table-wrapper.pmr-table-wrap::-webkit-scrollbar-thumb {
        background: #94a3b8;
        border-radius: 999px;
    }
    .pmr-page.pmr-pogr-mode .pmr-scroll-hint {
        display: flex;
    }
    #tblPMR {
        table-layout: fixed;
        width: 100%;
    }
    #tblPMR thead th {
        white-space: normal;
        line-height: 1.15;
        font-size: 0.68rem;
        font-weight: 700;
        padding: 0.35rem 0.2rem;
        vertical-align: middle;
        text-align: center;
    }
    #tblPMR thead th.num {
        word-break: break-word;
    }
    #tblPMR td.num, #tblPMR th.num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }
    #tblPMR td.num {
        white-space: nowrap;
        font-size: 0.74rem;
        padding: 0.3rem 0.25rem;
    }
    #tblPMR th.pmr-th-dim,
    #tblPMR td.pmr-particulars-cell {
        text-align: left;
        min-width: 8.5rem;
        width: 11%;
        word-break: normal;
        overflow-wrap: normal;
        hyphens: none;
        line-height: 1.3;
        vertical-align: middle;
    }
    #tblPMR .pmr-particulars-text {
        display: inline-block;
        max-width: 100%;
        font-weight: 600;
        word-break: normal;
        overflow-wrap: normal;
        white-space: normal;
    }
    .pmr-nested-table th:nth-child(2),
    .pmr-nested-table td:nth-child(2) {
        min-width: 9rem;
        word-break: normal;
        overflow-wrap: normal;
        white-space: normal;
        line-height: 1.3;
    }
    #tblPMR tr.row-total td {
        font-weight: 700;
        background: rgba(102, 126, 234, 0.12) !important;
        color: #4338ca !important;
    }
    #tblPMR td.pmr-balance-negative,
    #tblPMR tr.row-total td.pmr-balance-negative {
        color: #dc2626 !important;
    }
    .pmr-drill-crumb {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        padding: 0.75rem 0.95rem;
        margin: 0 0 0.65rem;
        background: linear-gradient(135deg, #eef2ff, #e0e7ff);
        border: 1px solid #c7d2fe;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(67, 56, 202, 0.1);
    }
    .pmr-drill-crumb-top {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.65rem 0.85rem;
    }
    .pmr-drill-crumb #btnDrillBack {
        height: 38px !important;
        min-height: 38px !important;
        min-width: 118px;
        padding: 0 16px !important;
        border: none !important;
        border-radius: 999px !important;
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
        color: #fff !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        line-height: 1 !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        gap: 7px;
        box-shadow: 0 3px 10px rgba(79, 70, 229, 0.3);
        cursor: pointer;
        text-decoration: none !important;
    }
    .pmr-drill-crumb #btnDrillBack:hover {
        background: linear-gradient(135deg, #4338ca, #5b4fd4) !important;
        color: #fff !important;
    }
    .pmr-drill-crumb #btnDrillBack i {
        font-size: 13px !important;
    }
    .pmr-drill-current-title {
        font-size: 0.98rem;
        font-weight: 800;
        color: #312e81;
    }
    .pmr-drill-crumb .pmr-crumb-link {
        display: inline-flex;
        align-items: center;
        border: 1px solid #c7d2fe;
        background: #fff;
        padding: 0.28rem 0.75rem;
        border-radius: 999px;
        color: #4338ca;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        min-height: 30px;
        font-size: 12.5px;
    }
    .pmr-drill-crumb .pmr-crumb-link:hover {
        background: #e0e7ff;
        color: #312e81;
        text-decoration: none;
    }
    .pmr-drill-crumb .pmr-crumb-current {
        display: inline-flex;
        align-items: center;
        background: #4f46e5;
        color: #fff;
        padding: 0.28rem 0.75rem;
        border-radius: 999px;
        font-weight: 800;
        font-size: 12.5px;
        min-height: 30px;
    }
    .pmr-drill-crumb .pmr-crumb-sep {
        color: #4f46e5;
        font-weight: 800;
        padding: 0 0.15rem;
        font-size: 1rem;
    }
    .pmr-project-drill {
        border: none;
        background: none;
        padding: 0;
        color: #4338ca;
        font-weight: 600;
        text-align: left;
        cursor: pointer;
        text-decoration: underline;
        font-size: inherit;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .pmr-project-drill:hover {
        color: #312e81;
    }
    .pmr-tree-root,
    .pmr-tree-parent {
        cursor: pointer;
        background: #f8fafc;
        font-weight: 600;
    }
    .pmr-tree-root:hover,
    .pmr-tree-parent:hover {
        background: #eef2ff;
    }
    .pmr-tree-toggle {
        width: 14px;
        color: #4338ca;
    }
    .pmr-tree-child-panel {
        margin: 0.25rem 0 0.35rem 1rem;
        border-left: 3px solid rgba(102, 126, 234, 0.35);
        padding-left: 0.5rem;
    }
    .pmr-tree-child-panel--root {
        margin-left: 0.75rem;
    }
    /* Main grid only — ExpenseEntry.css sticky thead applies to every .table in the wrapper */
    .pmr-page .expense-entry-table-wrapper #tblPMR > thead {
        position: sticky;
        top: 0;
        z-index: 5;
        background: linear-gradient(135deg, #4f46e5, #667eea) !important;
    }
    .pmr-page .expense-entry-table-wrapper #tblPMR > thead th {
        color: #fff !important;
        background: transparent !important;
    }
    .pmr-nested-table {
        width: 100%;
        table-layout: auto;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        margin: 0;
    }
    /* Nested drill headers — override ExpenseEntry.css transparent thead th */
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table thead {
        position: static !important;
        top: auto !important;
        z-index: auto !important;
        display: table-header-group !important;
        background: transparent !important;
        background-image: none !important;
        --bs-table-bg: transparent;
        --bs-table-striped-bg: transparent;
        --bs-table-hover-bg: transparent;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table thead tr.pmr-nested-head,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table thead th {
        position: static !important;
        color: #fff !important;
        background-image: none !important;
        font-size: 0.66rem !important;
        font-weight: 700 !important;
        padding: 0.35rem 0.25rem !important;
        white-space: normal !important;
        line-height: 1.15 !important;
        text-align: center;
        border: none !important;
        visibility: visible !important;
        opacity: 1 !important;
        letter-spacing: normal !important;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--default > thead,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--default > thead tr.pmr-nested-head,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--default > thead th {
        background: #5b9bd5 !important;
        background-color: #5b9bd5 !important;
        color: #fff !important;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--subproject > thead,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--subproject > thead tr.pmr-nested-head,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--subproject > thead th {
        background: #2563eb !important;
        background-color: #2563eb !important;
        color: #fff !important;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--projectVendor > thead,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--projectVendor > thead tr.pmr-nested-head,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--projectVendor > thead th {
        background: #0d9488 !important;
        background-color: #0d9488 !important;
        color: #fff !important;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--vendor > thead,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--vendor > thead tr.pmr-nested-head,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--vendor > thead th {
        background: #7c3aed !important;
        background-color: #7c3aed !important;
        color: #fff !important;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--categoryItem > thead,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--categoryItem > thead tr.pmr-nested-head,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--categoryItem > thead th {
        background: #ea580c !important;
        background-color: #ea580c !important;
        color: #fff !important;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--categoryGroup > thead,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--categoryGroup > thead tr.pmr-nested-head,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--categoryGroup > thead th {
        background: #db2777 !important;
        background-color: #db2777 !important;
        color: #fff !important;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--categoryItemLeaf > thead,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--categoryItemLeaf > thead tr.pmr-nested-head,
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table.pmr-nested--categoryItemLeaf > thead th {
        background: #16a34a !important;
        background-color: #16a34a !important;
        color: #fff !important;
    }
    .pmr-tree-child-panel[data-fetch-level="subproject"] { border-left-color: #2563eb; }
    .pmr-tree-child-panel[data-fetch-level="projectVendor"] { border-left-color: #0d9488; }
    .pmr-tree-child-panel[data-fetch-level="vendor"] { border-left-color: #7c3aed; }
    .pmr-tree-child-panel[data-fetch-level="categoryItem"] { border-left-color: #ea580c; }
    .pmr-tree-child-panel[data-fetch-level="categoryItemLeaf"] { border-left-color: #16a34a; }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table thead th:nth-child(2) {
        text-align: left;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table thead th.num {
        text-align: right;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table tbody td {
        font-size: 0.74rem;
        vertical-align: middle;
        padding: 0.35rem 0.25rem !important;
    }
    .pmr-page .expense-entry-table-wrapper .pmr-nested-table .pmr-tree-parent {
        background: #f1f5f9;
        font-weight: 600;
    }
    .pmr-tree-child-wrap > td {
        padding: 0 !important;
        border: none !important;
        background: transparent !important;
    }
    /* Override layout app.min.css: button { height:25px; font-size:7pt } — same fix as Expenses Ledger */
    .pmr-page .ee-list-header .pmr-header-toolbar {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }
    .pmr-page .ee-list-header .pmr-header-icon-btn {
        width: 46px;
        height: auto !important;
        min-width: 46px;
        min-height: 46px !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        border: 2px solid rgba(255, 255, 255, 0.92);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18), 0 2px 4px rgba(0, 0, 0, 0.06);
        cursor: pointer;
        line-height: 1 !important;
        font-size: 1rem !important;
        -webkit-appearance: none;
        appearance: none;
        box-sizing: border-box;
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }
    .pmr-page .ee-list-header .pmr-header-icon-btn:hover {
        background: #fff;
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.22), 0 2px 6px rgba(0, 0, 0, 0.08);
        border-color: #fff;
    }
    .pmr-page .ee-list-header .pmr-header-icon-btn i {
        font-size: 1.25rem !important;
        line-height: 1 !important;
        display: inline-block;
        pointer-events: none;
    }
    .pmr-page .ee-list-header .pmr-header-icon-btn--excel i { color: #0f7c3a !important; }
    .pmr-page .ee-list-header .pmr-header-icon-btn--excel:hover i { color: #0a5c2a !important; }
