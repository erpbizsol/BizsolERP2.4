@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Reports/Script/StockReport.js"></script>
<style>
    #fetchReportButton {
        width: 100% !important;
        height: 29px;
        text-align: center !important;
        padding: 0px;
    }
</style>
<div class="">
    <div class="card shadow-sm">
        <div class="card-body  shadow-sm">
            <div class="row">
                <div class="col-md-3">
                    <label for="txtReportType" class="col-form-label-sm fw-bold">Report Type</label>
                    <datalist id="txtReportTypelists"></datalist>
                    <input list="txtReportTypelists" id="txtReportType" type="text" name="txtReportType" autocomplete="off" class="form-control form-control-sm box_border" placeholder="" required>
                </div>
                <div class="col-md-3">
                    <label for="txtItemName" class="col-form-label-sm fw-bold">Item Name</label>
                    <datalist id="txtItemNamelist"></datalist>
                    <input list="txtItemNamelist" id="txtItemName" type="text" name="txtItemName" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Item Name" required>
                </div>
                <div class="col-md-1 text-end" style="margin-top:30px;">
                    <button type="button" id="fetchReportButton" class="btn btn-primary btn-sm waves-effect waves-light">Show</button>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="card-body">
    <div class="table-wrapper fixed-height-table">
        <table id="table" class="fixed-width-table table">
            <thead id="table-header">
            </thead>
            <tbody id="table-body">
            </tbody>
        </table>
    </div>
    <!-- Paginator -->
    <div class="paginator" id="paginator-table">
    </div>
</div>



