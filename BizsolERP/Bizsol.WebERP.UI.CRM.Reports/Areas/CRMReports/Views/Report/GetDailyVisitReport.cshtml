@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/_content/Bizsol.WebERP.UI.Shared/css/filter.css" rel="stylesheet" />
<script src="~/_content/Bizsol.WebERP.UI.Shared/js/filter.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Reports/Script/DailyVisitReport.js"></script>
<style>
    #fetchReportButton {
        width: 100% !important;
        height: 29px;
        text-align: center !important;
        padding: 0px;
    }
</style>
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h5 class="m-0">Daily Visit Report</h5>
            </div><!-- /.col -->

        </div><!-- /.row -->
    </div><!-- /.container-fluid -->

</div>
<div class="">
    <div class="card shadow-sm">
        <div class="card-body  shadow-sm">
            <div class="row">
                <div class="col-md-3">
                    <label for="txtdateFrom" class="col-form-label-sm fw-bold">From Date</label>
                    <input id="txtdateFrom" type="date" name="txtdateFrom" autocomplete="off" class="form-control form-control-sm box_border" placeholder="" required>
                </div>
                <div class="col-md-3">
                    <label for="txtdateTo" class="col-form-label-sm fw-bold">To Date</label>
                    <input id="txtdateTo" type="date" name="txtdateTo" autocomplete="off" class="form-control form-control-sm box_border" placeholder="" required>
                </div>

                <div class="col-md-3">
                    <label for="txtSalesPerson" class="col-form-label-sm fw-bold">Sales Person</label>
                    <input list="txtSalesPersonlist" id="txtSalesPerson" name="txtSalesPerson" class="form-control form-control-sm box_border" placeholder="Sales Person" value="All">
                    <datalist id="txtSalesPersonlist"></datalist>
                </div>

                <div class="col-md-3">
                    <label for="txtDealerName" class="col-form-label-sm fw-bold">Dealer Name</label>
                    <input list="txtDealerNamelist" id="txtDealerName" name="txtDealerName" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Dealer Name" value="All">
                    <datalist id="txtDealerNamelist"></datalist>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <label for="txtOrderType" class="col-form-label-sm fw-bold">Order Type</label>
                    <input list="txtOrderTypelist" id="txtOrderType" name="txtOrderType" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Order Type" value="All">
                    <datalist id="txtOrderTypelist"></datalist>
                </div>
                <div class="col-md-3">
                    <label for="txtOrderStatus" class="col-form-label-sm fw-bold">Order Status</label>
                    <datalist id="txtOrderStatuslist"></datalist>
                    <input list="txtOrderStatuslist" id="txtOrderStatus" name="txtOrderStatus" class="form-control form-control-sm box_border" placeholder="Order Status" autocomplete="off" value="All">
                </div>
                <div class="col-md-3">
                    <label for="txtReportType" class="col-form-label-sm fw-bold">Report Type</label>
                    <datalist id="txtReportTypelist"></datalist>
                    <input list="txtReportTypelist" id="txtReportType" name="txtReportType" class="form-control form-control-sm box_border" placeholder="Report Type" autocomplete="off">
                </div>
                <div class="col-md-1 text-end" style="margin-top: 30px !important;">

                    <button type="button" id="fetchReportButton" class="btn btn-primary btn-sm waves-effect waves-light">Show</button>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="card-body">
    <div class="table-wrapper fixed-height-table">
        <table id="table" class="fixed-width-table table">
            <thead id="table-header">
            </thead>
            <tbody id="table-body">
            </tbody>

        </table>

    </div>
    <!-- Paginator -->
    <div class="paginator" id="paginator-table">
    </div>
</div>



