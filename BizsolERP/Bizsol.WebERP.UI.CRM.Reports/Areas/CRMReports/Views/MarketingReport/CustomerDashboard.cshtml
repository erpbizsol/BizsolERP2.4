@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-3">
    <div class="row">
        <!-- Left column: KPI Cards -->
        <div class="col-lg-3">
            <div class="card mb-3">
                <div class="card-body text-center">
                    <h6 class="text-muted">Current Year Sales</h6>
                    <h3 id="kpi-selected-year" class="fw-bold">52.89</h3>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body text-center">
                    <h6 class="text-muted">Best Month</h6>
                    <h5 id="kpi-best-month">June</h5>
                    <div id="kpi-best-month-amt" class="fw-bold">58.78</div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body text-center">
                    <h6 class="text-muted">Best Day</h6>
                    <div id="kpi-best-day-date">11-06-2025</div>
                    <div id="kpi-best-day-amt" class="fw-bold">99.43</div>
                </div>
            </div>
        </div>

        <!-- Right column: Charts with fixed horizontal scrolling -->
        <div class="col-lg-9">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Current Year vs Previous Year Sales</h5>
                    <div style="overflow-x: auto; width: 100%;">
                        <canvas id="barSalesChart" height="200" style="min-width:600px;"></canvas>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Sales over Time</h5>
                    <div style="overflow-x: auto; width: 100%;">
                        <canvas id="lineSalesChart" height="220" style="min-width:600px;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Reports/Script/CustomerDashboard.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
    // Sample data matching the uploaded image reference.
    const labels = ['Apr', 'May', 'Jun', 'Jul'];
    const previousYearSales = [55, 87, 59, 52];
    const currentYearSales = [41, 9, 28, 51];

    // Bar chart: Current vs Previous Year (grouped)
    function renderBarChart() {
        const ctx = document.getElementById('barSalesChart').getContext('2d');

        const barChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Current Year Sales',
                        data: previousYearSales,
                        backgroundColor: 'rgba(192,57,43,0.85)', // red-ish
                        borderColor: 'rgba(192,57,43,1)',
                        borderWidth: 1
                    },
                    {
                        label: 'Last Year Sales',
                        data: currentYearSales,
                        backgroundColor: 'rgba(24,67,135,0.95)', // blue-ish
                        borderColor: 'rgba(24,67,135,1)',
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                //interaction: { mode: 'index', intersect: true },
                plugins: {
                    legend: { position: 'top' },
                    tooltip: { enabled: true }
                },
                scales: {
                    x: {
                       // stacked: true,
                        grid: { display: false }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0 },
                        title: { display: true, text: 'Sales' }
                    }
                }
            }
        });
    };

    // Line chart: Sales over Time (area under line filled)
    function renderLineChart() {
        const ctx = document.getElementById('lineSalesChart').getContext('2d');

        // Use currentYearSales aggregated for the line as in image
        const areaGradient = ctx.createLinearGradient(0, 0, 0, 300);
        areaGradient.addColorStop(0, 'rgba(192,57,43,0.28)');
        areaGradient.addColorStop(1, 'rgba(192,57,43,0.02)');

        const lineChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Sales',
                        data: currentYearSales,
                        fill: true,
                        backgroundColor: areaGradient,
                        borderColor: 'rgba(192,57,43,0.9)',
                        tension: 0.35,
                        pointRadius: 4,
                        pointBackgroundColor: 'rgba(192,57,43,1)',
                        pointBorderColor: '#fff',
                        pointHoverRadius: 6
                    },
                    {
                        label: 'Target (dashed)',
                        data: Array(labels.length).fill(100), // example threshold line
                        type: 'line',
                        borderColor: 'rgba(54, 162, 235, 0.6)',
                        borderDash: [6, 6],
                        pointRadius: 0,
                        tension: 0
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { mode: 'index', intersect: false }
                },
                scales: {
                    x: {
                        title: { display: true, text: 'Month' },
                        grid: { display: false }
                    },
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'Sales' },
                        ticks: { precision: 0 }
                    }
                }
            }
        });
    };

    renderBarChart();
    renderLineChart();
</script>

