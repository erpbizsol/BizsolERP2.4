@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}



@* <div class="container-fluid mt-3"> *@
<div class="d-flex justify-content-between align-items-center mb-2">
    <button class="btn btn-primary btn-height" type="button" data-bs-toggle="collapse" data-bs-target="#customerFilterCollapse" aria-expanded="true" aria-controls="customerFilterCollapse">
        <i class="fa-solid fa-filter"></i>
    </button>

    <button type="button" id="btnShow" class="btn btn-primary btn-height btn-width" onclick="CustomerDashboard_ShowReport()">Show</button>
</div>
<div class="collapse " id="customerFilterCollapse">
    <div class="row">
        <div class="col-md-3">
            <label for="txtSalesPerson" class="col-form-label-sm fw-bold">Sales Person</label>

            <select id="ddlSalesPersonlist" class="form-control form-control-sm box_border">
            </select>
        </div>

        <div class="col-md-3">
            <label for="txtDealerName" class="col-form-label-sm fw-bold">Dealer Name</label>

            <select id="ddlDealerNamelist" class="form-control form-control-sm box_border">
            </select>
        </div>
      @*   <div class="col-md-3 without-label-field text-end">
            <label></label>
            
            <button type="button" id="btnDownload" class="btn btn-primary btn-height btn-width">Download</button>
        </div> *@
    </div>
</div>
   
   
    <br />
    <ul class="nav nav-tabs" id="customerDashboardTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="dashboard-tab" data-bs-toggle="tab" data-bs-target="#dashboard" type="button" role="tab" aria-controls="dashboard" aria-selected="true">
                Dashboard
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab" aria-controls="details" aria-selected="false">
                Details
            </button>
        </li>
    </ul>

    <div class="tab-content pt-3" id="customerDashboardTabsContent">
        <div class="tab-pane fade show active" id="dashboard" role="tabpanel" aria-labelledby="dashboard-tab">
            <div class="row">
                <!-- Left column: KPI Cards -->
                <div class="col-lg-3">
                    <div class="card mb-3">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Current Year Sales</h6>
                            <h3 id="kpi-selected-year" class="fw-bold">52.89</h3>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Best Month</h6>
                            <h5 id="kpi-best-month">June</h5>
                            <div id="kpi-best-month-amt" class="fw-bold">58.78</div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Best Day</h6>
                            <div id="kpi-best-day-date">11-06-2025</div>
                            <div id="kpi-best-day-amt" class="fw-bold">99.43</div>
                        </div>
                    </div>
                </div>

                <!-- Right column: Charts with fixed horizontal scrolling -->
                <div class="col-lg-9">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Current Year vs Previous Year Sales</h5>
                            <div style="overflow-x: auto; width: 100%;">
                                <canvas id="barSalesChart" height="200" style="min-width:600px;"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Sales over Time</h5>
                            <div style="overflow-x: auto; width: 100%;">
                                <canvas id="lineSalesChart" height="220" style="min-width:600px;"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="details" role="tabpanel" aria-labelledby="details-tab">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Details</h5>
                    <p class="mb-0">Additional details or filters can go here.</p>
                </div>
            </div>
        </div>
    </div>
@* </div> *@

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script type="module" src="~/_content/Bizsol.WebERP.UI.CRM.Reports/Script/CustomerDashboard.js"></script>



