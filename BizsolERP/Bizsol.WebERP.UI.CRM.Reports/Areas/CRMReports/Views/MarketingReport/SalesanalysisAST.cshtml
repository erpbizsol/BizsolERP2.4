@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.Shared/components/DateRangeControl/DateRangeControl.css" rel="stylesheet" />
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>

<style>
    

    /* Custom column for 5 columns in a row */
    @@media (min-width: 1200px) {
        .col-xl-2-4 {
            flex: 0 0 20%;
            max-width: 20%;
        }
    }
    
    /* KPI card styling */
    .kpi-card {
        transition: transform 0.2s;
    }
    
    .kpi-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    /* Summary Dashboard KPI Cards */
    .summary-panel {
        padding: 16px;
    }

    .summary-kpi-scroll {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
    }

    .summary-kpi-card {
        background: #fff;
        border: 1px solid #e3e8ef;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        overflow: hidden;
        min-width: 0;
    }

    .summary-kpi-header {
        background: linear-gradient(135deg, #365e9a 0%, #1e3a6e 100%);
        color: #fff;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        padding: 7px 10px;
        line-height: 1.25;
        min-height: 34px;
    }

    .summary-kpi-header small {
        display: block;
        font-size: 8px;
        opacity: 0.88;
        font-weight: 500;
        margin-top: 2px;
        text-transform: none;
    }

    .summary-kpi-body {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px;
    }

    .summary-kpi-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 14px;
        flex-shrink: 0;
    }

    .summary-kpi-icon.icon-blue { background: #4e73df; }
    .summary-kpi-icon.icon-green { background: #1cc88a; }
    .summary-kpi-icon.icon-red { background: #e74a3b; }
    .summary-kpi-icon.icon-teal { background: #36b9cc; }
    .summary-kpi-icon.icon-orange { background: #f6c23e; }
    .summary-kpi-icon.icon-purple { background: #6f42c1; }
    .summary-kpi-icon.icon-indigo { background: #224abe; }

    .summary-kpi-value-wrap {
        flex: 1;
        min-width: 0;
    }

    .summary-kpi-value {
        font-size: 15px;
        font-weight: 800;
        color: #1a202c;
        line-height: 1.15;
        word-break: break-word;
    }

    .summary-kpi-value.value-red { color: #e74a3b; }
    .summary-kpi-value.value-blue { color: #224abe; }

    .summary-kpi-trend {
        font-size: 9px;
        font-weight: 700;
        margin-top: 4px;
        line-height: 1.2;
    }

    .summary-kpi-trend span {
        font-weight: 500;
        color: #718096;
    }

    .summary-kpi-trend.trend-positive { color: #1cc88a; }
    .summary-kpi-trend.trend-negative { color: #e74a3b; }
    .summary-kpi-trend.trend-neutral { color: #718096; }

    .summary-kpi-lines {
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: 11px;
        color: #2d3748;
    }

    .summary-kpi-lines strong {
        font-size: 14px;
        font-weight: 800;
    }

    .summary-kpi-footer {
        border-top: 1px solid #edf2f7;
        padding: 6px 10px 8px;
        font-size: 11px;
        color: #2d3748;
    }

    .summary-kpi-footer strong {
        color: #224abe;
        font-weight: 800;
    }

    .summary-chart-card {
        background: #fff;
        border: 1px solid #e3e8ef;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        height: 100%;
        overflow: hidden;
    }

    .summary-chart-header {
        background: linear-gradient(135deg, #365e9a 0%, #1e3a6e 100%);
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        padding: 8px 12px;
        text-align: center;
    }

    .summary-chart-body {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        min-height: 210px;
    }

    .summary-chart-canvas {
        position: relative;
        flex: 1;
        min-width: 0;
        height: 190px;
    }

    .summary-chart-legend {
        flex: 0 0 130px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .summary-legend-item {
        display: flex;
        gap: 8px;
        align-items: flex-start;
    }

    .summary-legend-swatch {
        width: 10px;
        height: 10px;
        border-radius: 2px;
        margin-top: 2px;
        flex-shrink: 0;
    }

    .summary-legend-label {
        font-size: 11px;
        font-weight: 700;
        color: #1a202c;
        line-height: 1.2;
    }

    .summary-legend-meta {
        font-size: 9px;
        color: #718096;
        margin-top: 1px;
    }

    .summary-donut-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        text-align: center;
    }

    .summary-donut-center .label {
        font-size: 11px;
        color: #718096;
        font-weight: 600;
    }

    .summary-donut-center .value {
        font-size: 22px;
        font-weight: 800;
        color: #1a202c;
        line-height: 1.1;
    }

    .summary-grid-card {
        border: 1px solid #e3e8ef;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    }

    .summary-grid-card .card-body {
        padding: 14px;
    }

    .summary-grid-card .card-title {
        font-size: 15px;
        font-weight: 700;
        color: #1e3a6e;
        margin-bottom: 10px;
    }

    #partyScoring.tab-pane.active {
        display: flex;
        flex-direction: column;
        gap: 14px;
        overflow: visible;
    }

    .ps-title {
        font-size: 16px;
        font-weight: 800;
        color: #1e3a6e;
        margin-bottom: 10px;
    }

    .ps-title small {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #2d3748;
        margin-top: 2px;
    }

    .ps-top-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 16px;
        align-items: start;
        margin-bottom: 0;
    }

    .ps-top-row > * {
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .ps-section-bar {
        background: #d8f3dc;
        border-radius: 6px;
        padding: 10px 16px;
        text-align: center;
        font-size: 15px;
        font-weight: 800;
        color: #1e3a6e;
        margin: 0;
        position: relative;
        z-index: 1;
        flex: 0 0 auto;
    }

    .ps-card {
        background: #fff;
        border: 1px solid #e3e8ef;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        padding: 14px 16px;
        height: auto;
        overflow: hidden;
    }

    .ps-dist-body {
        display: flex;
        gap: 12px;
        align-items: center;
        min-height: 0;
        flex-wrap: nowrap;
    }

    .ps-donut-wrap {
        position: relative;
        flex: 0 0 200px;
        width: 200px;
        height: 200px;
        overflow: hidden;
    }

    .ps-donut-wrap canvas {
        width: 200px !important;
        height: 200px !important;
        max-width: 100%;
        max-height: 100%;
    }

    .ps-donut-center {
        position: absolute;
        inset: 24%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        text-align: center;
        overflow: hidden;
        padding: 2px;
    }

    .ps-donut-center .label {
        font-size: 9px;
        color: #4a5568;
        font-weight: 600;
        line-height: 1.1;
    }

    .ps-donut-center .value {
        font-size: 11px;
        font-weight: 800;
        color: #1a202c;
        line-height: 1.15;
        max-width: 100%;
        white-space: nowrap;
    }

    .ps-donut-center .meta {
        font-size: 8px;
        color: #718096;
        line-height: 1.1;
    }

    .ps-range-table {
        width: 100%;
        font-size: 12px;
    }

    .ps-range-table th {
        color: #224abe;
        font-weight: 700;
        padding: 6px 8px;
        border-bottom: 1px solid #edf2f7;
    }

    .ps-range-table td {
        padding: 7px 8px;
        border-bottom: 1px solid #f1f5f9;
        color: #2d3748;
    }

    .ps-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: 8px;
        vertical-align: middle;
    }

    .ps-range-total {
        margin-top: 8px;
        border: 1px solid #224abe;
        border-radius: 6px;
        padding: 8px 10px;
        display: flex;
        justify-content: space-between;
        font-weight: 800;
        color: #224abe;
        font-size: 13px;
    }

    .ps-kpi-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border: 1px solid #e3e8ef;
        border-radius: 10px;
        background: #fff;
        overflow: hidden;
    }

    .ps-kpi-box {
        padding: 16px 18px;
        border-right: 1px solid #edf2f7;
    }

    .ps-kpi-box:last-child { border-right: none; }

    .ps-kpi-label {
        font-size: 12px;
        font-weight: 700;
        color: #4a5568;
        margin-bottom: 8px;
    }

    .ps-kpi-value {
        font-size: 20px;
        font-weight: 800;
        color: #1a202c;
    }

    .ps-kpi-value small {
        font-size: 14px;
        font-weight: 700;
        color: #718096;
    }

    .ps-split-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border: 1px solid #e3e8ef;
        border-radius: 10px;
        background: #fff;
        overflow: hidden;
        margin-top: 10px;
    }

    .ps-split-box {
        padding: 16px 18px;
        border-right: 1px solid #edf2f7;
    }

    .ps-split-box:last-child { border-right: none; }

    .ps-split-count {
        font-size: 24px;
        font-weight: 800;
        line-height: 1.1;
    }

    .ps-split-pct {
        font-size: 16px;
        font-weight: 800;
        margin-top: 4px;
    }

    .ps-good { color: #1cc88a; }
    .ps-bad { color: #e74a3b; }

    .ps-party-table thead th {
        background: #1e3a6e;
        color: #fff !important;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
        text-align: center;
        vertical-align: middle;
    }

    .ps-party-table .filter-table-heading,
    .ps-party-table .table-filter-arrow i {
        color: #fff !important;
    }

    .ps-party-table tbody td {
        font-size: 12px;
        vertical-align: middle;
        padding: 8px 10px;
    }

    .ps-party-scroll {
        max-height: 520px;
        overflow: auto;
    }

    .ps-party-table td.ps-num { text-align: right; }
    .ps-party-table td.ps-center { text-align: center; }
    .ps-party-table td.ps-name { text-align: left; font-weight: 600; }

    .ps-party-table tbody tr:nth-child(even) {
        background: #f7fafc;
    }

    .ps-badge {
        display: inline-block;
        min-width: 110px;
        padding: 3px 10px;
        border-radius: 12px;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        text-align: center;
    }

    .ps-badge-excellent { background: #1e7e34; }
    .ps-badge-verygood { background: #28a745; }
    .ps-badge-good { background: #8bc34a; color: #1a202c; }
    .ps-badge-average { background: #d4a017; }
    .ps-badge-attention { background: #e67e22; }
    .ps-badge-poor { background: #e74a3b; }

    .ps-trend-up { color: #1cc88a; font-weight: 700; }
    .ps-trend-down { color: #e74a3b; font-weight: 700; }
    .ps-trend-flat { color: #718096; font-weight: 600; }

    @@media (max-width: 1199px) {
        .ps-dist-body { flex-direction: column; }
        .ps-donut-wrap,
        .ps-donut-wrap canvas {
            width: 180px !important;
            height: 180px !important;
        }
        .ps-donut-center .value { font-size: 10px; }
    }

    @@media (max-width: 991px) {
        .ps-top-row { grid-template-columns: 1fr; }
        .ps-dist-body { flex-direction: column; }
        .ps-kpi-row, .ps-split-row { grid-template-columns: 1fr; }
        .ps-kpi-box, .ps-split-box { border-right: none; border-bottom: 1px solid #edf2f7; }
    }

    @@media (max-width: 1400px) {
        .summary-kpi-scroll {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991px) {
        .summary-kpi-scroll {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .summary-chart-body {
            flex-direction: column;
            min-height: auto;
        }

        .summary-chart-canvas {
            width: 100%;
            height: 180px;
        }

        .summary-chart-legend {
            flex: 1 1 auto;
            width: 100%;
            flex-direction: row;
            flex-wrap: wrap;
        }
    }

    @@media (max-width: 576px) {
        .summary-kpi-scroll {
            grid-template-columns: 1fr;
        }
    }

    /* Sales Comparison */
    .sc-panel {
        padding: 16px;
    }

    .sc-chart-wrap {
        position: relative;
        height: 360px;
        padding: 12px 8px 0;
    }

    .sc-growth-badge {
        position: absolute;
        top: 18px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        font-size: 14px;
        font-weight: 800;
        padding: 4px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
        pointer-events: none;
    }

    .sc-growth-badge.positive { color: #1cc88a; }
    .sc-growth-badge.negative { color: #e74a3b; }
    .sc-growth-badge.neutral { color: #718096; }

    .sc-period-labels {
        display: flex;
        justify-content: space-around;
        gap: 12px;
        padding: 0 12px 12px;
        text-align: center;
    }

    .sc-period-label {
        flex: 1;
        font-size: 12px;
        color: #4a5568;
        font-weight: 600;
        line-height: 1.35;
    }

    .sc-period-label strong {
        display: block;
        color: #1e3a6e;
        font-size: 13px;
        margin-bottom: 2px;
    }

    .sc-summary-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
    }

    .sc-summary-card {
        flex: 1 1 180px;
        background: #fff;
        border: 1px solid #e3e8ef;
        border-radius: 10px;
        padding: 12px 14px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    }

    .sc-summary-card .label {
        font-size: 11px;
        font-weight: 700;
        color: #718096;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .sc-summary-card .value {
        font-size: 22px;
        font-weight: 800;
        color: #1a202c;
        margin-top: 4px;
    }

    .sc-summary-card.current .value { color: #4e73df; }
    .sc-summary-card.previous .value { color: #6c757d; }
    /* Summary grid styling */
    .sticky-top {
        position: sticky;
        top: 0;
        z-index: 10;
    }

    /* Summary grid table hover effect */
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.1);
    }

    /* Summary grid scrollbar styling */
    .table-responsive::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

    .table-responsive::-webkit-scrollbar-thumb:hover {
        background: #555;
    }

    /* Dashboard chart styling */
    .chart-container {
        position: relative;
        height: 300px;
        margin: 20px 0;
    }

    .dashboard-card {
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        background: #ffffff;
    }

    .dashboard-title {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin-bottom: 15px;
        text-align: center;
        padding: 10px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 5px;
    }

    .table-compact {
        font-size: 13px;
        table-layout: fixed;
        width: 100%;
    }

    .table-compact th {
        background-color: #f0f0f0;
        font-weight: 600;
        padding: 8px;
        border: 1px solid #ddd;
    }

    .table-compact td {
        padding: 6px 8px;
        border: 1px solid #ddd;
    }

    .grand-total-row {
        background-color: #e8f4f8;
        font-weight: bold;
        position: sticky;
        bottom: 0;
        z-index: 5;
    }

    .gp-weight-table {
        background-color: #e0f7fa;
    }

    .base-table {
        background-color: #fff9c4;
    }

    .gc-grid-top,
    .gc-grid-bottom {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
        align-items: stretch;
    }

    .gc-grid-top {
        grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    }

    .gc-grid-bottom {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .gc-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.08);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 360px;
    }

    .gc-head {
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        text-align: center;
        padding: 10px 12px;
    }

    .gc-head-purple { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    .gc-head-pink { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
    .gc-head-coral { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); }
    .gc-head-blue { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
    .gc-head-green { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); }

    .gc-body {
        padding: 12px;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .gc-table {
        width: 100%;
        font-size: 12px;
        margin-bottom: 0;
    }

    .gc-table th {
        background: #1e54a4;
        color: #fff !important;
        font-weight: 700;
        padding: 7px 8px;
        white-space: nowrap;
        text-align: center;
        vertical-align: middle;
    }

    .gc-table td {
        padding: 6px 8px;
        border-bottom: 1px solid #edf2f7;
        color: #2d3748;
    }

    .gc-table tbody tr:nth-child(even) { background: #f8fafc; }

    .gc-table tbody td:first-child,
    .gc-table tfoot td:first-child {
        text-align: left;
    }

    .gc-scroll {
        max-height: 280px;
        overflow: auto;
        flex: 1;
    }

    .gc-total {
        font-weight: 800;
        color: #224abe;
        border-top: 2px solid #cbd5e0;
        background: #eef4ff;
    }

    .gc-split {
        display: flex;
        gap: 12px;
        align-items: center;
        min-height: 0;
        flex: 1;
    }

    .gc-donut-wrap {
        position: relative;
        flex: 0 0 180px;
        width: 180px;
        height: 180px;
    }

    .gc-donut-wrap canvas,
    .gc-pie-wrap canvas {
        width: 100% !important;
        height: 100% !important;
    }

    .gc-donut-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        text-align: center;
    }

    .gc-donut-center .label { font-size: 11px; color: #4a5568; font-weight: 600; }
    .gc-donut-center .value { font-size: 15px; font-weight: 800; color: #1a202c; line-height: 1.2; }
    .gc-donut-center .meta { font-size: 11px; color: #718096; font-weight: 700; }

    .gc-pie-wrap {
        position: relative;
        flex: 0 0 200px;
        width: 200px;
        height: 200px;
    }

    .gc-legend {
        flex: 1;
        min-width: 0;
        font-size: 12px;
        max-height: 260px;
        overflow: auto;
    }

    .gc-legend-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 0;
    }

    .gc-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex: 0 0 10px;
    }

    .gc-sq {
