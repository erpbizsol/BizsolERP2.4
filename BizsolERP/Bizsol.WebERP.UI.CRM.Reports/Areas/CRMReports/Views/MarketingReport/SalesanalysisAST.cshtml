@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.Shared/components/DateRangeControl/DateRangeControl.css" rel="stylesheet" />

<style>
    /* Custom column for 5 columns in a row */
    @@media (min-width: 1200px) {
        .col-xl-2-4 {
            flex: 0 0 20%;
            max-width: 20%;
        }
    }
    
    /* KPI card styling */
    .kpi-card {
        transition: transform 0.2s;
    }
    
    .kpi-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    /* Summary grid styling */
    .sticky-top {
        position: sticky;
        top: 0;
        z-index: 10;
    }

    /* Summary grid table hover effect */
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.1);
    }

    /* Summary grid scrollbar styling */
    .table-responsive::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

    .table-responsive::-webkit-scrollbar-thumb:hover {
        background: #555;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-2">
    <button class="btn btn-primary btn-height" type="button" data-bs-toggle="collapse" data-bs-target="#customerFilterCollapse" aria-expanded="true" aria-controls="customerFilterCollapse">
        <i class="fa-solid fa-filter"></i> Filters
    </button>

    <button type="button" id="btnShow" class="btn btn-primary btn-height btn-width" onclick="SalesanalysisAST_ShowReport()">Show</button>
</div>
<div class="collapse " id="customerFilterCollapse">
    <div class="row">
        <div class="col-md-3">
            
            <date-range-control id="dateRange"></date-range-control>

        </div>
        <div class="col-md-3">
            <label for="txtSalesPerson" class="col-form-label-sm fw-bold">Sales Person</label>

            <select id="ddlSalesPersonlist" class="form-control form-control-sm box_border">
            </select>
        </div>

        <div class="col-md-3">
            <label for="txtDealerName" class="col-form-label-sm fw-bold">Dealer Name</label>

            <select id="ddlDealerNamelist" class="form-control form-control-sm box_border">
            </select>
        </div>
        <div class="col-md-3">
            <label for="txtCitiesName" class="col-form-label-sm fw-bold">Location</label>

            <select id="ddlCitiesNamelist" class="form-control form-control-sm box_border">
            </select>
        </div>
        <div class="col-md-3">
            <label for="txtStatusName" class="col-form-label-sm fw-bold">Status</label>

            <select id="ddlStatusNamelist" class="form-control form-control-sm box_border">
            </select>
        </div>
        <div class="col-md-3">
            <label for="txtGP" class="col-form-label-sm fw-bold">GP</label>

            <select id="ddlGPlist" class="form-control form-control-sm box_border">
            </select>
        </div>
        <div class="col-md-3">
            <label for="txtIndustryType" class="col-form-label-sm fw-bold">Segment</label>

            <select id="ddlIndustryTypelist" class="form-control form-control-sm box_border">
            </select>
        </div>
       
    </div>
</div>


<br />
<ul class="nav nav-tabs" id="salesAnalysisTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="summaryReport-tab" data-bs-toggle="tab" data-bs-target="#summaryReport" type="button" role="tab" aria-controls="summaryReport" aria-selected="true">
            Summary Report
        </button>
    </li>

    <li class="nav-item" role="presentation">
        <button class="nav-link" id="partyScoring-tab" data-bs-toggle="tab" data-bs-target="#partyScoring" type="button" role="tab" aria-controls="partyScoring" aria-selected="false">
            Party Scoring
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="goldenCircle-tab" data-bs-toggle="tab" data-bs-target="#goldenCircle" type="button" role="tab" aria-controls="goldenCircle" aria-selected="false">
            Golden Circle Client
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="manifestation-tab" data-bs-toggle="tab" data-bs-target="#manifestation" type="button" role="tab" aria-controls="manifestation" aria-selected="false">
            Manifestation
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="nbdCrr-tab" data-bs-toggle="tab" data-bs-target="#nbdCrr" type="button" role="tab" aria-controls="nbdCrr" aria-selected="false">
            NBD CRR
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="segmentWise-tab" data-bs-toggle="tab" data-bs-target="#segmentWise" type="button" role="tab" aria-controls="segmentWise" aria-selected="false">
            Segment Wise
