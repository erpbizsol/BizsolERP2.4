<style>
    /* Custom column for 5 columns in a row */
    @@media (min-width: 1200px) {
        .col-xl-2-4 {
            flex: 0 0 20%;
            max-width: 20%;
        }
    }
    
    /* KPI card styling */
    .kpi-card {
        transition: transform 0.2s;
    }
    
    .kpi-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    /* Summary grid styling */
    .sticky-top {
        position: sticky;
        top: 0;
        z-index: 10;
    }

    /* Summary grid table hover effect */
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.1);
    }

    /* Summary grid scrollbar styling */
    .table-responsive::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

    .table-responsive::-webkit-scrollbar-thumb:hover {
        background: #555;
    }

    /* Dashboard chart styling */
    .chart-container {
        position: relative;
        height: 300px;
        margin: 20px 0;
    }

    .dashboard-card {
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        background: #ffffff;
    }

    .dashboard-title {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin-bottom: 15px;
        text-align: center;
        padding: 10px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 5px;
    }

    .table-compact {
        font-size: 13px;
        table-layout: fixed;
        width: 100%;
    }

    .table-compact th {
        background-color: #f0f0f0;
        font-weight: 600;
        padding: 8px;
        border: 1px solid #ddd;
    }

    .table-compact td {
        padding: 6px 8px;
        border: 1px solid #ddd;
    }

    .grand-total-row {
        background-color: #e8f4f8;
        font-weight: bold;
        position: sticky;
        bottom: 0;
        z-index: 5;
    }

    .gp-weight-table {
        background-color: #e0f7fa;
    }

    .base-table {
        background-color: #fff9c4;
    }

    /* Scrollable table container with sticky footer */
    .table-with-sticky-footer {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .table-scroll-wrapper {
        overflow-y: auto;
        flex: 1;
    }

    .table-footer-sticky {
        border-top: 2px solid #333;
        background-color: #e8f4f8;
        font-weight: bold;
        table-layout: fixed;
        width: 100%;
    }

    .dashboard-table-container {
        display: flex;
        flex-direction: column;
        height: 350px;
    }

    /* Column width specifications for 2-column tables */
    .col-width-2-name {
        width: 60%;
    }

    .col-width-2-value {
        width: 40%;
    }

    /* Column width specifications for 4-column GP table */
    .col-width-4-party {
        width: 60%;
    }

    .col-width-4-value {
        width: 20%;
    }
</style>

