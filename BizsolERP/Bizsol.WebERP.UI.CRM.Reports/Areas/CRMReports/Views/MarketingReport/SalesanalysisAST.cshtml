@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.Shared/components/DateRangeControl/DateRangeControl.css" rel="stylesheet" />
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>

<style>
    

    /* Custom column for 5 columns in a row */
    @@media (min-width: 1200px) {
        .col-xl-2-4 {
            flex: 0 0 20%;
            max-width: 20%;
        }
    }
    
    /* KPI card styling */
    .kpi-card {
        transition: transform 0.2s;
    }
    
    .kpi-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    /* Summary Dashboard KPI Cards */
    .summary-panel {
        padding: 16px;
    }

    .summary-kpi-scroll {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
    }

    .summary-kpi-card {
        background: #fff;
        border: 1px solid #e3e8ef;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        overflow: hidden;
        min-width: 0;
    }

    .summary-kpi-header {
        background: linear-gradient(135deg, #365e9a 0%, #1e3a6e 100%);
        color: #fff;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        padding: 7px 10px;
        line-height: 1.25;
        min-height: 34px;
    }

    .summary-kpi-header small {
        display: block;
        font-size: 8px;
        opacity: 0.88;
        font-weight: 500;
        margin-top: 2px;
        text-transform: none;
    }

    .summary-kpi-body {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px;
    }

    .summary-kpi-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 14px;
        flex-shrink: 0;
    }

    .summary-kpi-icon.icon-blue { background: #4e73df; }
    .summary-kpi-icon.icon-green { background: #1cc88a; }
    .summary-kpi-icon.icon-red { background: #e74a3b; }
    .summary-kpi-icon.icon-teal { background: #36b9cc; }
    .summary-kpi-icon.icon-orange { background: #f6c23e; }
    .summary-kpi-icon.icon-purple { background: #6f42c1; }
    .summary-kpi-icon.icon-indigo { background: #224abe; }

    .summary-kpi-value-wrap {
        flex: 1;
        min-width: 0;
    }

    .summary-kpi-value {
        font-size: 15px;
        font-weight: 800;
        color: #1a202c;
        line-height: 1.15;
        word-break: break-word;
    }

    .summary-kpi-value.value-red { color: #e74a3b; }
    .summary-kpi-value.value-blue { color: #224abe; }

    .summary-kpi-trend {
        font-size: 9px;
        font-weight: 700;
        margin-top: 4px;
        line-height: 1.2;
    }

    .summary-kpi-trend span {
        font-weight: 500;
        color: #718096;
    }

    .summary-kpi-trend.trend-positive { color: #1cc88a; }
    .summary-kpi-trend.trend-negative { color: #e74a3b; }
    .summary-kpi-trend.trend-neutral { color: #718096; }

    .summary-kpi-lines {
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: 11px;
        color: #2d3748;
    }

    .summary-kpi-lines strong {
        font-size: 14px;
        font-weight: 800;
    }

    .summary-kpi-footer {
        border-top: 1px solid #edf2f7;
        padding: 6px 10px 8px;
        font-size: 11px;
        color: #2d3748;
    }

    .summary-kpi-footer strong {
        color: #224abe;
        font-weight: 800;
    }

    .summary-chart-card {
        background: #fff;
        border: 1px solid #e3e8ef;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        height: 100%;
        overflow: hidden;
    }

    .summary-chart-header {
        background: linear-gradient(135deg, #365e9a 0%, #1e3a6e 100%);
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        padding: 8px 12px;
        text-align: center;
    }

    .summary-chart-body {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        min-height: 210px;
    }

    .summary-chart-canvas {
        position: relative;
        flex: 1;
        min-width: 0;
        height: 190px;
    }

    .summary-chart-legend {
        flex: 0 0 130px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .summary-legend-item {
        display: flex;
        gap: 8px;
        align-items: flex-start;
    }

    .summary-legend-swatch {
        width: 10px;
        height: 10px;
        border-radius: 2px;
        margin-top: 2px;
        flex-shrink: 0;
    }

    .summary-legend-label {
        font-size: 11px;
        font-weight: 700;
        color: #1a202c;
        line-height: 1.2;
    }

    .summary-legend-meta {
        font-size: 9px;
        color: #718096;
        margin-top: 1px;
    }

    .summary-donut-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        text-align: center;
    }

    .summary-donut-center .label {
        font-size: 11px;
        color: #718096;
        font-weight: 600;
    }

    .summary-donut-center .value {
        font-size: 22px;
        font-weight: 800;
        color: #1a202c;
        line-height: 1.1;
    }

    .summary-grid-card {
        border: 1px solid #e3e8ef;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    }

    .summary-grid-card .card-body {
        padding: 14px;
    }

    .summary-grid-card .card-title {
        font-size: 15px;
        font-weight: 700;
        color: #1e3a6e;
        margin-bottom: 10px;
    }

    @@media (max-width: 1400px) {
        .summary-kpi-scroll {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991px) {
        .summary-kpi-scroll {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .summary-chart-body {
            flex-direction: column;
            min-height: auto;
        }

        .summary-chart-canvas {
            width: 100%;
            height: 180px;
        }

        .summary-chart-legend {
            flex: 1 1 auto;
            width: 100%;
            flex-direction: row;
            flex-wrap: wrap;
        }
    }

    @@media (max-width: 576px) {
        .summary-kpi-scroll {
            grid-template-columns: 1fr;
        }
    }

    /* Sales Comparison */
    .sc-panel {
        padding: 16px;
    }

    .sc-chart-wrap {
        position: relative;
        height: 360px;
        padding: 12px 8px 0;
    }

    .sc-growth-badge {
        position: absolute;
        top: 18px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        font-size: 14px;
        font-weight: 800;
        padding: 4px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
        pointer-events: none;
    }

    .sc-growth-badge.positive { color: #1cc88a; }
    .sc-growth-badge.negative { color: #e74a3b; }
    .sc-growth-badge.neutral { color: #718096; }

    .sc-period-labels {
        display: flex;
        justify-content: space-around;
        gap: 12px;
        padding: 0 12px 12px;
        text-align: center;
    }

    .sc-period-label {
        flex: 1;
        font-size: 12px;
        color: #4a5568;
        font-weight: 600;
        line-height: 1.35;
    }

    .sc-period-label strong {
        display: block;
        color: #1e3a6e;
        font-size: 13px;
        margin-bottom: 2px;
    }

    .sc-summary-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
    }

    .sc-summary-card {
        flex: 1 1 180px;
        background: #fff;
        border: 1px solid #e3e8ef;
        border-radius: 10px;
        padding: 12px 14px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    }

    .sc-summary-card .label {
        font-size: 11px;
        font-weight: 700;
        color: #718096;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .sc-summary-card .value {
        font-size: 22px;
        font-weight: 800;
        color: #1a202c;
        margin-top: 4px;
    }

    .sc-summary-card.current .value { color: #4e73df; }
    .sc-summary-card.previous .value { color: #6c757d; }
    /* Summary grid styling */
    .sticky-top {
        position: sticky;
        top: 0;
        z-index: 10;
    }

    /* Summary grid table hover effect */
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.1);
    }

    /* Summary grid scrollbar styling */
    .table-responsive::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

    .table-responsive::-webkit-scrollbar-thumb:hover {
        background: #555;
    }

    /* Dashboard chart styling */
    .chart-container {
        position: relative;
        height: 300px;
        margin: 20px 0;
    }

    .dashboard-card {
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        background: #ffffff;
    }

    .dashboard-title {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin-bottom: 15px;
        text-align: center;
        padding: 10px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 5px;
    }

    .table-compact {
        font-size: 13px;
        table-layout: fixed;
        width: 100%;
    }

    .table-compact th {
        background-color: #f0f0f0;
        font-weight: 600;
        padding: 8px;
        border: 1px solid #ddd;
    }

    .table-compact td {
        padding: 6px 8px;
        border: 1px solid #ddd;
    }

    .grand-total-row {
        background-color: #e8f4f8;
        font-weight: bold;
        position: sticky;
        bottom: 0;
        z-index: 5;
    }

    .gp-weight-table {
        background-color: #e0f7fa;
    }

    .base-table {
        background-color: #fff9c4;
    }

    /* Scrollable table container with sticky footer */
    .table-with-sticky-footer {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .table-scroll-wrapper {
        overflow-y: auto;
        flex: 1;
    }

    .table-footer-sticky {
        border-top: 2px solid #333;
        background-color: #e8f4f8;
        font-weight: bold;
        table-layout: fixed;
        width: 100%;
    }

    .dashboard-table-container {
        display: flex;
        flex-direction: column;
        height: 350px;
    }

    /* Regional Analysis drill-down */
    .regional-analysis-panel {
        border: 1px solid #e0e6ed;
        border-radius: 12px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        padding: 20px;
        margin-bottom: 20px;
    }

    .regional-breadcrumb {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        background: #eef4ff;
        border: 1px solid #d7e3ff;
        border-radius: 10px;
    }

    .regional-breadcrumb-item {
        color: #4e73df;
        cursor: pointer;
        font-weight: 600;
        text-decoration: none;
    }

    .regional-breadcrumb-item:hover {
        text-decoration: underline;
    }

    .regional-breadcrumb-item.active {
        color: #1f2937;
        cursor: default;
        text-decoration: none;
    }

    .regional-breadcrumb-separator {
        color: #94a3b8;
        font-weight: 700;
    }

    .regional-chart-container {
        position: relative;
        height: 380px;
    }

    .regional-table-container {
        max-height: 380px;
        overflow-y: auto;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #fff;
    }

    .regional-drill-hint {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 12px;
    }

    .regional-level-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        margin-left: 8px;
        vertical-align: middle;
    }

    .regional-back-btn {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-width: 120px;
        min-height: 36px;
        padding: 8px 16px;
        border: 1px solid #4e73df;
        border-radius: 8px;
        background: #4e73df;
        color: #ffffff !important;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.2;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(78, 115, 223, 0.25);
    }

    .regional-back-btn:hover,
    .regional-back-btn:focus {
        background: #3b5cc9;
        border-color: #3b5cc9;
        color: #ffffff !important;
        outline: none;
    }

    /* Target Vs Growth */
    .tvg-panel {
        border: 1px solid #e0e6ed;
        border-radius: 14px;
        background: linear-gradient(180deg, #ffffff 0%, #f7faff 100%);
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
        padding: 20px;
    }

    .tvg-kpi-card {
        border: none;
        border-radius: 14px;
        overflow: hidden;
        color: #fff;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
        min-height: 110px;
    }

    .tvg-kpi-card .card-body {
        padding: 18px 20px;
    }

    .tvg-kpi-label {
        font-size: 13px;
        opacity: 0.92;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .tvg-kpi-value {
        font-size: 32px;
        font-weight: 800;
        margin-top: 6px;
        line-height: 1.1;
    }

    .tvg-kpi-lost {
        background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
    }

    .tvg-kpi-manifest {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
    }

    .tvg-kpi-actual {
        background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%);
    }

    .tvg-section-card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
        height: 100%;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }

    .tvg-section-title {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        padding: 12px 16px;
        border-radius: 12px 12px 0 0;
        margin: 0;
    }

    .tvg-section-body {
        padding: 16px;
    }

    .tvg-metric-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 14px;
        border-radius: 10px;
        margin-bottom: 10px;
        background: #f8fafc;
        border: 1px solid #eef2f7;
    }

    .tvg-metric-row strong {
        font-size: 15px;
    }

    .tvg-chart-box {
        position: relative;
        height: 300px;
    }

    .tvg-table thead th {
        background: #365e9a !important;
        color: #fff !important;
        border-color: #2f5287 !important;
    }

    /* Client Analysis */
    .ca-kpi-total {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
    }

    .ca-kpi-lost {
        background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
    }

    .ca-kpi-sales {
        background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%);
    }

    .ca-kpi-avg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .ca-kpi-dream {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
    }

    .ca-kpi-panel {
        min-height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ca-kpi-panel .card-body {
        text-align: center;
        width: 100%;
    }

    .ca-table-scroll {
        max-height: 360px;
        overflow-y: auto;
    }

    .ca-status-badge {
        display: inline-block;
        min-width: 52px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        text-align: center;
    }

    .ca-status-high {
        background: #d1fae5;
        color: #065f46;
    }

    .ca-status-mid {
        background: #fef3c7;
        color: #92400e;
    }

    .ca-status-low {
        background: #fee2e2;
        color: #991b1b;
    }

    .ca-segment-total-row td {
        background: #eef2ff;
        font-weight: 700;
    }

    /* Column width specifications for 2-column tables */
    .col-width-2-name {
        width: 60%;
    }

    .col-width-2-value {
        width: 40%;
    }

    /* Column width specifications for 4-column GP table */
    .col-width-4-party {
        width: 60%;
    }

    .col-width-4-value {
        width: 20%;
    }

    /* GP Wise Summary Table Styling */
    #gpWiseTable thead th {
        background-color: #e9ecef !important;
        position: sticky;
        z-index: 10;
    }

    #gpWiseTable thead tr:first-child th {
        top: 0;
    }

    #gpWiseTable thead tr:nth-child(2) th {
        top: 38px; /* Adjust based on first row height */
    }

    #gpWiseTable tbody tr:last-child {
        position: sticky;
        bottom: 0;
        background-color: #d4edda !important;
        font-weight: bold;
        border-top: 2px solid #333 !important;
        z-index: 9;
    }

    /* Ensure table borders are visible */
    #gpWiseTable {
        border-collapse: separate;
        border-spacing: 0;
    }

    #gpWiseTable th,
    #gpWiseTable td {
        border: 1px solid #dee2e6;
        padding: 8px;
    }

    /* Column widths for GP Wise Summary */
    #gpWiseTable th:first-child,
    #gpWiseTable td:first-child {
        min-width: 200px;
    }

    #gpWiseTable th:not(:first-child),
    #gpWiseTable td:not(:first-child) {
        min-width: 100px;
    }

    /* Highlight Total and % of Total columns */
    #gpWiseTable tbody tr td:nth-child(5),
    #gpWiseTable tbody tr td:nth-child(6) {
        background-color: #f8f9fa;
    }

    #gpWiseTable tbody tr:hover td {
        background-color: rgba(0, 123, 255, 0.1);
    }

    #gpWiseTable tbody tr:hover td:nth-child(5),
    #gpWiseTable tbody tr:hover td:nth-child(6) {
        background-color: rgba(0, 123, 255, 0.15);
    }

    /* Responsive adjustments */
    /* @@media (max-width: 768px) {
        .floating-buttons {
            right: 15px;
            top: 80px;
        }
        
        .floating-btn {
            width: 40px;
            height: 40px;
        }
        
        .floating-btn i {
            font-size: 16px;
        }
        
        .offcanvas-filter {
            width: 90% !important;
        }
    } */

    /* Mobile-friendly tabs styling */
    #salesAnalysisTabs {
        flex-wrap: nowrap;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        border-bottom: 2px solid #dee2e6;
        position: relative;
        z-index: 1;
    }
    
    /* Add padding to tab content on mobile to prevent filter button overlap */
    @@media (max-width: 768px) {
        .tab-content {
            padding-bottom: 80px !important;
        }
    }
    
    @@media (max-width: 576px) {
        .tab-content {
            padding-bottom: 70px !important;
        }
    }

        #salesAnalysisTabs::-webkit-scrollbar {
            height: 4px;
        }

        #salesAnalysisTabs::-webkit-scrollbar-thumb {
            background: #cbd5e0;
            border-radius: 4px;
        }

        #salesAnalysisTabs .nav-item {
            flex-shrink: 0;
        }

        #salesAnalysisTabs .nav-link {
            white-space: nowrap;
            border-radius: 8px 8px 0 0;
            padding: 12px 20px;
            font-weight: 500;
            transition: all 0.3s ease;
            border: none;
            margin-right: 4px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            #salesAnalysisTabs .nav-link i {
                font-size: 16px;
            }

            #salesAnalysisTabs .nav-link:not(.active) {
                background-color: #f8f9fa;
                color: #495057;
            }

                #salesAnalysisTabs .nav-link:not(.active):hover {
                    background-color: #e9ecef;
                    color: #212529;
                }

            #salesAnalysisTabs .nav-link.active {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                box-shadow: 0 2px 8px rgba(102, 126, 234, 0.4);
            }

    /* Mobile specific styles */
    @@media (max-width: 768px) {
        #salesAnalysisTabs .nav-link {
            font-size: 13px;
            padding: 10px 16px;
            gap: 6px;
        }

            #salesAnalysisTabs .nav-link i {
                font-size: 14px;
            }
    }

