            <!-- Row 2: Partywise Share Pie Chart and GP/Weight Table -->
            <div class="row">
                <!-- Partywise Share % Pie Chart -->
                <div class="col-lg-5">
                    <div class="dashboard-card">
                        <div class="dashboard-title" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">Partywise Share % in Sales</div>
                        <div class="chart-container">
                            <canvas id="partySharePieChart"></canvas>
