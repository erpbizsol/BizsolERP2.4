                        <div class="table-responsive" style="flex: 1; max-height: 230px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 40px;">S.no.</th>
                                        <th>MGKT Person</th>
                                        <th class="text-end" style="width: 120px;">Record Count</th>
                                    </tr>
                                </thead>
                                <tbody id="mgktPersonSummaryBody">
                                    <tr>
                                        <td colspan="3" class="text-center text-muted">Loading...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="summary-grid-footer" style="border-top: 2px solid #dee2e6; background: #f8f9fa;">
                            <table class="table table-sm mb-0">
                                <tr style="font-weight: bold;">
                                    <td colspan="2" style="padding: 8px 12px;">Grand total</td>
                                    <td class="text-end grand-total-value" style="padding: 8px 12px; width: 120px;">0</td>
                                </tr>
                                <tr style="font-weight: bold;">
                                    <td colspan="3" class="mb-0 summary-grid-title" style="padding: 8px 12px; width: 120px;">0</td>
                                </tr>
                            </table>
