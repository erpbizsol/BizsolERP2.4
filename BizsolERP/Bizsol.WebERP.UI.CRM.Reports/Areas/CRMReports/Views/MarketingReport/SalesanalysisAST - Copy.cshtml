@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/_content/Bizsol.WebERP.UI.Shared/css/Filter.css" rel="stylesheet" />
<link href="~/_content/Bizsol.WebERP.UI.Shared/components/DateRangeControl/DateRangeControl.css" rel="stylesheet" />
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
    

    /* Custom column for 5 columns in a row */
    @@media (min-width: 1200px) {
        .col-xl-2-4 {
            flex: 0 0 20%;
            max-width: 20%;
        }
    }
    
    /* KPI card styling */
    .kpi-card {
        transition: transform 0.2s;
    }
    
    .kpi-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    /* Summary grid styling */
    .sticky-top {
        position: sticky;
        top: 0;
        z-index: 10;
    }

    /* Summary grid table hover effect */
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.1);
    }

    /* Summary grid scrollbar styling */
    .table-responsive::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

    .table-responsive::-webkit-scrollbar-thumb:hover {
        background: #555;
    }

    /* Dashboard chart styling */
    .chart-container {
        position: relative;
        height: 300px;
        margin: 20px 0;
    }

    .dashboard-card {
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        background: #ffffff;
    }

    .dashboard-title {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin-bottom: 15px;
        text-align: center;
        padding: 10px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 5px;
    }

    .table-compact {
        font-size: 13px;
        table-layout: fixed;
        width: 100%;
    }

    .table-compact th {
        background-color: #f0f0f0;
        font-weight: 600;
        padding: 8px;
        border: 1px solid #ddd;
    }

    .table-compact td {
        padding: 6px 8px;
        border: 1px solid #ddd;
    }

    .grand-total-row {
        background-color: #e8f4f8;
        font-weight: bold;
        position: sticky;
        bottom: 0;
        z-index: 5;
    }

    .gp-weight-table {
        background-color: #e0f7fa;
    }

    .base-table {
        background-color: #fff9c4;
    }

    /* Scrollable table container with sticky footer */
    .table-with-sticky-footer {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .table-scroll-wrapper {
        overflow-y: auto;
        flex: 1;
    }

    .table-footer-sticky {
        border-top: 2px solid #333;
        background-color: #e8f4f8;
        font-weight: bold;
        table-layout: fixed;
        width: 100%;
    }

    .dashboard-table-container {
        display: flex;
        flex-direction: column;
        height: 350px;
    }

    /* Column width specifications for 2-column tables */
    .col-width-2-name {
        width: 60%;
    }

    .col-width-2-value {
        width: 40%;
    }

    /* Column width specifications for 4-column GP table */
    .col-width-4-party {
        width: 60%;
    }

    .col-width-4-value {
        width: 20%;
    }

    /* GP Wise Summary Table Styling */
    #gpWiseTable thead th {
        background-color: #e9ecef !important;
        position: sticky;
        z-index: 10;
    }

    #gpWiseTable thead tr:first-child th {
        top: 0;
    }

    #gpWiseTable thead tr:nth-child(2) th {
        top: 38px; /* Adjust based on first row height */
    }

    #gpWiseTable tbody tr:last-child {
        position: sticky;
        bottom: 0;
        background-color: #d4edda !important;
        font-weight: bold;
        border-top: 2px solid #333 !important;
        z-index: 9;
    }

    /* Ensure table borders are visible */
    #gpWiseTable {
        border-collapse: separate;
        border-spacing: 0;
    }

    #gpWiseTable th,
    #gpWiseTable td {
        border: 1px solid #dee2e6;
        padding: 8px;
    }

    /* Column widths for GP Wise Summary */
    #gpWiseTable th:first-child,
    #gpWiseTable td:first-child {
        min-width: 200px;
    }

    #gpWiseTable th:not(:first-child),
    #gpWiseTable td:not(:first-child) {
        min-width: 100px;
    }

    /* Highlight Total and % of Total columns */
    #gpWiseTable tbody tr td:nth-child(5),
    #gpWiseTable tbody tr td:nth-child(6) {
        background-color: #f8f9fa;
    }

    #gpWiseTable tbody tr:hover td {
        background-color: rgba(0, 123, 255, 0.1);
    }

    #gpWiseTable tbody tr:hover td:nth-child(5),
    #gpWiseTable tbody tr:hover td:nth-child(6) {
        background-color: rgba(0, 123, 255, 0.15);
    }

    /* Responsive adjustments */
    /* @@media (max-width: 768px) {
        .floating-buttons {
            right: 15px;
            top: 80px;
        }
        
        .floating-btn {
            width: 40px;
            height: 40px;
        }
        
        .floating-btn i {
            font-size: 16px;
        }
        
        .offcanvas-filter {
            width: 90% !important;
        }
    } */

    /* Mobile-friendly tabs styling */
    #salesAnalysisTabs {
        flex-wrap: nowrap;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        border-bottom: 2px solid #dee2e6;
        position: relative;
        z-index: 1;
    }
    
    /* Add padding to tab content on mobile to prevent filter button overlap */
    @@media (max-width: 768px) {
        .tab-content {
            padding-bottom: 80px !important;
        }
    }
    
    @@media (max-width: 576px) {
        .tab-content {
            padding-bottom: 70px !important;
        }
    }

        #salesAnalysisTabs::-webkit-scrollbar {
            height: 4px;
        }

        #salesAnalysisTabs::-webkit-scrollbar-thumb {
            background: #cbd5e0;
            border-radius: 4px;
        }

        #salesAnalysisTabs .nav-item {
            flex-shrink: 0;
        }

        #salesAnalysisTabs .nav-link {
            white-space: nowrap;
            border-radius: 8px 8px 0 0;
            padding: 12px 20px;
            font-weight: 500;
            transition: all 0.3s ease;
            border: none;
            margin-right: 4px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            #salesAnalysisTabs .nav-link i {
                font-size: 16px;
            }

            #salesAnalysisTabs .nav-link:not(.active) {
                background-color: #f8f9fa;
                color: #495057;
            }

                #salesAnalysisTabs .nav-link:not(.active):hover {
                    background-color: #e9ecef;
                    color: #212529;
                }

            #salesAnalysisTabs .nav-link.active {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                box-shadow: 0 2px 8px rgba(102, 126, 234, 0.4);
            }

    /* Mobile specific styles */
    @@media (max-width: 768px) {
        #salesAnalysisTabs .nav-link {
            font-size: 13px;
            padding: 10px 16px;
            gap: 6px;
        }

            #salesAnalysisTabs .nav-link i {
                font-size: 14px;
            }
    }

    @@media (max-width: 576px) {
        #salesAnalysisTabs {
            border-bottom: 1px solid #dee2e6;
        }

            #salesAnalysisTabs .nav-link {
                font-size: 11px;
                padding: 8px 12px;
                margin-right: 2px;
                gap: 4px;
            }

                #salesAnalysisTabs .nav-link i {
                    font-size: 13px;
                }
    }
</style>

<!-- FilterSidePanelControl Web Component -->
<filter-side-panel-control id="filterPanel" show-button="true"></filter-side-panel-control>

<!-- Tabs Navigation -->
<ul class="nav nav-tabs" id="salesAnalysisTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="summaryReport-tab" data-bs-toggle="tab" data-bs-target="#summaryReport" type="button" role="tab" aria-controls="summaryReport" aria-selected="true">
            <i class="fas fa-file-alt"></i>Summary Report
        </button>
    </li>

    <li class="nav-item" role="presentation">
        <button class="nav-link" id="partyScoring-tab" data-bs-toggle="tab" data-bs-target="#partyScoring" type="button" role="tab" aria-controls="partyScoring" aria-selected="false">
            <i class="fas fa-star"></i>Party Scoring
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="goldenCircle-tab" data-bs-toggle="tab" data-bs-target="#goldenCircle" type="button" role="tab" aria-controls="goldenCircle" aria-selected="false">
            <i class="fas fa-crown"></i>Golden Circle Client
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="manifestation-tab" data-bs-toggle="tab" data-bs-target="#manifestation" type="button" role="tab" aria-controls="manifestation" aria-selected="false">
            <i class="fas fa-clipboard-check"></i>Manifestation
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="nbdCrr-tab" data-bs-toggle="tab" data-bs-target="#nbdCrr" type="button" role="tab" aria-controls="nbdCrr" aria-selected="false">
            <i class="fas fa-user-plus"></i>NBD CRR
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="segmentWise-tab" data-bs-toggle="tab" data-bs-target="#segmentWise" type="button" role="tab" aria-controls="segmentWise" aria-selected="false">
            <i class="fas fa-chart-pie"></i>Segment Wise
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="gpWiseSummary-tab" data-bs-toggle="tab" data-bs-target="#gpWiseSummary" type="button" role="tab" aria-controls="gpWiseSummary" aria-selected="false">
            <i class="fas fa-chart-bar"></i>GP Wise Summary
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="highGPLostClient-tab" data-bs-toggle="tab" data-bs-target="#highGPLostClient" type="button" role="tab" aria-controls="highGPLostClient" aria-selected="false">
            <i class="fas fa-user-times"></i>High GP Lost Client
        </button>
    </li>
</ul>

<!-- Report Date Range Display - MOVED HERE TO BE VISIBLE FOR ALL TABS -->
<div class="row mt-2 mb-2">
    <div class="col-lg-12">
        <div class="alert-warning text-center" role="alert" style="background-color:#ff9800; color:#fff; border:none;">
            <h5 id="report-date-range" class="mb-0" style="font-weight:bold;">Report Showing From : </h5>
        </div>
    </div>
</div>

<!-- Tab Content -->
<div class="tab-content pt-3" id="salesAnalysisTabsContent">
    <div class="tab-pane fade show active" id="summaryReport" role="tabpanel" aria-labelledby="summaryReport-tab">
        <!-- KPI Cards Row -->
        <div class="row g-2">
            <div class="col-6 col-md-4 col-lg-2">
