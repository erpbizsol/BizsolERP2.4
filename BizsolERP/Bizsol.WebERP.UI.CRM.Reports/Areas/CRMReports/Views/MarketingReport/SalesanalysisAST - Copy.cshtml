            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="card kpi-card" style="border:1px solid #dcdcdc;">
                    <div class="card-body text-center p-1">
                        <small class="text-muted">Manifested Sales</small>
                        <div id="kpi-manifested-sales" class="fw-bold" style="font-size:28px; color:#fd7e14; margin-top:4px;">0</div>
